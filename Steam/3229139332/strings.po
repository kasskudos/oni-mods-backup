msgid "<link=\"HEATBULBSEED\">Fervine Bulb</link>"
msgstr "<link=\"HEATBULBSEED\">Bulbo de Termovinha</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.BABY.DESC"
msgid ""
"A floofy little Bammini.\n"
"\n"
"In time it will mature into a fully grown <link=\"ICEBELLY\">Bammoth</link>."
msgstr ""
"Um Bamutinho pequeno e peludinho.\n"
"\n"
"Com o tempo, ele vai virar um <link=\"ICEBELLY\">Bamute</link> totalmente crescido."

#. STRINGS.CREATURES.SPECIES.ICEBELLY.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.BABY.NAME"
msgid "<link=\"ICEBELLY\">Bammini</link>"
msgstr "<link=\"ICEBELLY\">Bamutinho</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.DESC"
msgid ""
"Bammoths are lumbering, nonhostile creatures that subsist on <link=\"CARROT\">Plume Squash</link>, "
"<link=\"BEANPLANTSEED\">Nosh Beans</link> and <link=\"FRIESCARROT\">Squash Fries</link>.\n"
"\n"
"Their thick overcoats can be shorn for <link=\"BASICFABRIC\">Reed Fiber</link>."
msgstr ""
"Bamutes são criaturas pesadas e não-hostis que subsistem de <link=\"CARROT\">Abóbora Plumosa</link>, "
"<link=\"BEANPLANTSEED\">Brotossoja</link> and <link=\"FRIESCARROT\">Plumofritas</link>.\n"
"\n"
"Sua pelagem espessa pode ser tosquiados para obter <link=\"BASICFABRIC\">Fibra de Junco</link>."

#. STRINGS.CREATURES.SPECIES.ICEBELLY.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.EGG_NAME"
msgid "<link=\"ICEBELLY\">Bammoth Egg</link>"
msgstr "<link=\"ICEBELLY\">Ovo de Bamute</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.NAME"
msgid "<link=\"ICEBELLY\">Bammoth</link>"
msgstr "<link=\"ICEBELLY\">Bamute</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.BABY.DESC"
msgid ""
"A haughty little Regal Bammini.\n"
"\n"
"In time it will mature into a fully grown <link=\"GOLDBELLY\">Regal Bammoth</link>."
msgstr ""
"Um jovem Bamutinho Real presunçoso.\n"
"\n"
"Com o tempo, ele se tornará um <link=\"GOLDBELLY\">Bamute Real</link> adulto."

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.BABY.NAME"
msgid "<link=\"GOLDBELLY\">Regal Bammini</link>"
msgstr "<link=\"GOLDBELLY\">Bamutinho Real</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.DESC"
msgid ""
"Regal Bammoths are nonhostile creatures that subsist on <link=\"CARROT\">Plume Squash</link> and "
"<link=\"BEANPLANTSEED\">Nosh Beans</link>.\n"
"\n"
"Their ornate crests grow only when they are fed <link=\"FRIESCARROT\">Squash Fries</link>."
msgstr ""
"Bamutes Real são criaturas não hostis que subsistem com <link=\"CARROT\">Abóbora Plumosa</link> e "
"<link=\"BEANPLANTSEED\">Grão de Brotossoja</link>.\n"
"\n"
"Suas coroas ornamentadas crescem somente quando são alimentados com <link=\"FRIESCARROT\">Plumofritas</link>."

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.EGG_NAME"
msgid "<link=\"GOLDBELLY\">Regal Bammoth Egg</link>"
msgstr "<link=\"GOLDBELLY\">Ovo de Bamute Real</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.NAME"
msgid "<link=\"GOLDBELLY\">Regal Bammoth</link>"
msgstr "<link=\"GOLDBELLY\">Bamute Real</link>"

#. STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.DESC"
msgid "Sherberries are incapable of propagating, but can be harvested for a single <link=\"FOOD\">Food</link> serving."
msgstr ""
"As Frimifrutas são incapazes de se propagar, mas podem ser colhidas para uma única porção de <link=\"FOOD\">Alimento</link>."

#. STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.NAME"
msgid "<link=\"ICECAVESFORAGEPLANTPLANTED\">Sherberry Plant</link>"
msgstr "<link=\"ICECAVESFORAGEPLANTPLANTED\">Vinha de Frimi</link>"

#. STRINGS.CREATURES.SPECIES.ICEFLOWER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEFLOWER.DESC"
msgid ""
"Idyllas are <link=\"DECOR\">Decorative</link> <link=\"PLANTS\">Plants</link> with soft, pompom-shaped blossoms.\n"
"\n"
"Gazing dreamily at them has a positive effect on <link=\"MORALE\">Morale</link>."
msgstr ""
"Idílicas são <link=\"DECOR\">Plantas</link> <link=\"PLANTS\">Decorativas</link> com flores macias em forma de pompom.\n"
"\n"
"Olhar para elas de forma sonhadora tem um efeito positivo no <link=\"MORALE\">Moral</link>."

#. STRINGS.CREATURES.SPECIES.ICEFLOWER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEFLOWER.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decor</link> do ambiente."

