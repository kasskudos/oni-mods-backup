#. STRINGS.CODEX.POLLINATORS.BODY.CONTAINER1
msgctxt "STRINGS.CODEX.POLLINATORS.BODY.CONTAINER1"
msgid ""
"Pollination is a symbiotic interaction between <link=\"PLANTS\">Plants</link> and certain <link=\"CREATURES\">Critter</"
"link> species, which benefits plant growth.\n"
"\n"
"Some <link=\"PLANTS\">Plants</link> rely on pollinators in order to grow at all, while others receive a valuable "
"acceleration to their natural growth speed."
msgstr ""
"A polinização é uma interação simbiótica entre <link=\"PLANTS\">Plantas</link> e certas espécies de "
"<link=\"CREATURES\">Criaturas</link>, que beneficia o crescimento das plantas.\n"
"\n"
"Algumas <link=\"PLANTS\">Plantas</link> dependem de polinizadores para crescerem, enquanto outras recebem uma valiosa "
"aceleração em sua velocidade de crescimento natural."

#. STRINGS.CODEX.POLLINATORS.SUBTITLE
msgctxt "STRINGS.CODEX.POLLINATORS.SUBTITLE"
msgid "Critter-Boosted Growth"
msgstr "Crescimento Acelerado por Criaturas"

#. STRINGS.CODEX.POLLINATORS.TITLE
msgctxt "STRINGS.CODEX.POLLINATORS.TITLE"
msgid "Pollination"
msgstr "Polinização"

