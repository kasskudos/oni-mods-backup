#. STRINGS.DUPLICANTS.NEEDS.FOOD_QUALITY.EXPECTATION_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.NEEDS.FOOD_QUALITY.EXPECTATION_TOOLTIP"
msgid ""
"Each Duplicant has a minimum quality of <style=\"KKeyword\">Food</style> they'll tolerate eating.\n"
"This Duplicant desires <b>Tier {0}<b> or better <style=\"KKeyword\">Food</style>, and becomes <style=\"KKeyword\">Stressed</"
"style> when they eat meals of lower quality."
msgstr ""
"Cada Duplicante tem uma qualidade mínima de <style=\"KKeyword\">Alimento</style> que tolerará comer.\n"
"Este Duplicante deseja <b>Nível {0}</b> ou melhor <style=\"KKeyword\">Alimento</style>, e fica "
"<style=\"KKeyword\">Estressado</style> quando come refeições de qualidade inferior."

#. STRINGS.DUPLICANTS.NEEDS.FOOD_QUALITY.FOODQUALITY
msgctxt "STRINGS.DUPLICANTS.NEEDS.FOOD_QUALITY.FOODQUALITY"
msgid ""
"\n"
"Food Quality Score of {0}"
msgstr ""
"\n"
"Índice de Qualidade Alimentar de {0}"

#. STRINGS.DUPLICANTS.NEEDS.FOOD_QUALITY.FOODQUALITY_EXPECTATION
msgctxt "STRINGS.DUPLICANTS.NEEDS.FOOD_QUALITY.FOODQUALITY_EXPECTATION"
msgid ""
"\n"
"This Duplicant is content to eat <style=\"KKeyword\">Food</style> with a <style=\"KKeyword\">Food Quality</style> of <b>{0}"
"</b> or higher"
msgstr ""
"\n"
"Este Duplicante se contenta em comer <style=\"KKeyword\">Comida</style> com uma <style=\"KKeyword\">Qualidade de Comida</"
"style> de <b>{0}</b> ou superior"

#. STRINGS.DUPLICANTS.NEEDS.FOOD_QUALITY.GOOD_FOOD_MOD
