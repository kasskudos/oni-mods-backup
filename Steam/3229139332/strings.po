msgctxt "STRINGS.BUILDINGS.PREFABS.CANVASWIDE.FACADES.ART_WIDE_C.DESC"
msgid "Food this good deserves to be immortalized."
msgstr "Alimentos tão bons merecem ser eternizados."

#. STRINGS.BUILDINGS.PREFABS.CANVASWIDE.FACADES.ART_WIDE_C.NAME
