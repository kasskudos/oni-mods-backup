msgstr "Pijamas Rasgados"

#. STRINGS.EQUIPMENT.PREFABS.SLEEPCLINICPAJAMAS.EFFECT
msgctxt "STRINGS.EQUIPMENT.PREFABS.SLEEPCLINICPAJAMAS.EFFECT"
msgid ""
"Helps Duplicants fall asleep by reducing <link=\"HEALTH\">Stamina</link>.\n"
"\n"
"Enables the wearer to dream and produce Dream Journals."
msgstr ""
"Ajuda os duplicantes a adormecer reduzindo a <link=\"HEALTH\">Energia</link>.\n"
"\n"
"Permite que o usuário sonhe e produza Diários de Sonhos."

#. STRINGS.EQUIPMENT.PREFABS.SLEEPCLINICPAJAMAS.GENERICNAME
