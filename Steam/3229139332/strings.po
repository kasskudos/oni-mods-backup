msgstr "Duplicantes começam a se preparar para lutar."

#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.FOOD_FIGHT.DESCRIPTION
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.FOOD_FIGHT.DESCRIPTION"
msgid ""
"Duplicants will throw food at each other for recreation\n"
"\n"
"It may be wasteful, but everyone who participates will benefit from a major stress reduction."
msgstr ""
"Duplicantes irão jogar comida uns nos outros por diversão.\n"
"\n"
"Pode ser um desperdício, mas todos que participarem se beneficiarão de uma grande redução de estresse."

