msgid "<link=\"COMPOSTABLE\">Compostable</link>"
msgstr "<link=\"COMPOSTABLE\">Compostável</link>"

#. STRINGS.MISC.TAGS.COMPOSTABLE_DESC
msgctxt "STRINGS.MISC.TAGS.COMPOSTABLE_DESC"
msgid ""
"Compostables are biological materials which can be put into a <link=\"COMPOST\">Compost</link> to generate clean "
"<link=\"DIRT\">Dirt</link>.\n"
"\n"
"Composting also generates a small amount of <link=\"HEAT\">Heat</link>.\n"
"\n"
"Once it starts to rot, consumable food should be composted to prevent <link=\"FOODPOISONING\">Food Poisoning</link>."
msgstr ""
"Compostáveis são materiais biológicos que podem ser colocados em uma <link=\"COMPOST\">Composteira</link> para gerar "
"<link=\"DIRT\">Terra</link> limpa.\n"
"\n"
"A compostagem também gera uma pequena quantidade de <link=\"HEAT\">Calor</link>.\n"
"\n"
"Assim que começa a apodrecer, os alimentos consumíveis devem ser compostados para evitar "
"<link=\"FOODPOISONING\">Intoxicação Alimentar</link>."

