#. STRINGS.DUPLICANTS.STATS.BIONICGUNK.NAME
msgctxt "STRINGS.DUPLICANTS.STATS.BIONICGUNK.NAME"
msgid "Gunk"
msgstr "Graxa Biônica"

#. STRINGS.DUPLICANTS.STATS.BIONICGUNK.TOOLTIP
msgctxt "STRINGS.DUPLICANTS.STATS.BIONICGUNK.TOOLTIP"
msgid ""
"Bionic Duplicants become <style=\"KKeyword\">Stressed</style> when too much <style=\"KKeyword\">Gunk</style> builds up in "
"their bionic parts\n"
"\n"
"Regular visits to the <style=\"KKeyword\">Gunk Extractor</style> are required"
msgstr ""
"Duplicantes biônicos ficam <style=\"KKeyword\">Estressados</style> quando muita <style=\"KKeyword\">Graxa</style> se "
"acumula em suas partes biônicas\n"
"\n"
"Visitas regulares ao <style=\"KKeyword\">Extrator de Graxa Biônica</style> são necessárias"

#. STRINGS.DUPLICANTS.STATS.BIONICINTERNALBATTERY.NAME
msgctxt "STRINGS.DUPLICANTS.STATS.BIONICINTERNALBATTERY.NAME"
msgid "Power Banks"
msgstr "Baterias Biônicas"

#. STRINGS.DUPLICANTS.STATS.BIONICINTERNALBATTERY.TOOLTIP
msgctxt "STRINGS.DUPLICANTS.STATS.BIONICINTERNALBATTERY.TOOLTIP"
msgid ""
"A Bionic Duplicant with zero remaining <style=\"KKeyword\">Power</style> will become incapacitated until replacement "
"<style=\"KKeyword\">Power Banks</style> are installed"
msgstr ""
"Um Duplicante Biônico com zero de <style=\"KKeyword\">Energia</style> restante ficará incapacitado até que as "
"<style=\"KKeyword\">Baterias Biônicas</style> de reposição sejam instalados"

#. STRINGS.DUPLICANTS.STATS.BIONICOIL.NAME
msgctxt "STRINGS.DUPLICANTS.STATS.BIONICOIL.NAME"
msgid "Gear Oil"
msgstr "Óleo de Engrenagem"

#. STRINGS.DUPLICANTS.STATS.BIONICOIL.TOOLTIP
msgctxt "STRINGS.DUPLICANTS.STATS.BIONICOIL.TOOLTIP"
msgid ""
"Bionic Duplicants will slow down significantly when <style=\"KKeyword\">Gear Oil</style> levels reach zero\n"
"\n"
"They can oil their joints by visiting a <style=\"KKeyword\">Lubrication Station</style> or using <style=\"KKeyword\">Gear "
"Balm</style> "
msgstr ""
"Duplicantes Biônicos ficarão significativamente mais lentos quando os níveis de <style=\"KKeyword\">Óleo de Engrenagem</"
"style> chegarem a zero\n"
"\n"
"Eles podem lubrificar suas juntas visitando uma <style=\"KKeyword\">Estação de Lubrificação</style> ou usando "
"<style=\"KKeyword\">Bálsamo de Engrenagem</style> "

#. STRINGS.DUPLICANTS.STATS.BIONICOXYGENTANK.NAME
msgctxt "STRINGS.DUPLICANTS.STATS.BIONICOXYGENTANK.NAME"
msgid "Oxygen Tank"
msgstr "Tanque de Oxigênio"

#. STRINGS.DUPLICANTS.STATS.BIONICOXYGENTANK.TOOLTIP
msgctxt "STRINGS.DUPLICANTS.STATS.BIONICOXYGENTANK.TOOLTIP"
msgid ""
"Bionic Duplicants have internal <style=\"KKeyword\">Oxygen</style> tanks that enable them to work in low breathability "
"areas\n"
"\n"
"They will prioritize <style=\"KKeyword\">Oxygen</style> intake from equipped <style=\"KKeyword\">Exosuits</style> to "
"conserve their internal tanks"
msgstr ""
"Duplicantes Biônicos possuem tanques internos de <style=\"KKeyword\">Oxigênio</style> que os permitem trabalhar em áreas de "
"baixa respirabilidade\n"
"\n"
"Eles priorizarão a absorção de <style=\"KKeyword\">Oxigênio</style> de <style=\"KKeyword\">Exotrajes</style> equipados para "
"conservar seus tanques internos"

