msgstr "<link=\"SOLIDSUPERCOOLANT\">Super Resfriador Sólido</link>"

#. STRINGS.ELEMENTS.SOLIDSYNGAS.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDSYNGAS.DESC"
msgid ""
"Solid Synthesis Gas is an artificial, unbreathable <link=\"ELEMENTSSOLID\">Solid</link>.\n"
"\n"
"It can be converted into an efficient fuel."
msgstr ""
"O Gás de Síntese Sólido é um <link=\"ELEMENTSSOLID\">Sólido</link> artificial e não respirável.\n"
"\n"
"Ele pode ser convertido em um combustível eficiente."

