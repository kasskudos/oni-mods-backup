msgstr "Caixa de Presentes de Fim de Ano"

#. STRINGS.EQUIPMENT.PREFABS.JET_SUIT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.JET_SUIT.DESC"
msgid "Allows my Duplicants to take to the skies, for a time."
msgstr "Permite que meus Duplicantes subam aos céus por um tempo."

#. STRINGS.EQUIPMENT.PREFABS.JET_SUIT.EFFECT
msgctxt "STRINGS.EQUIPMENT.PREFABS.JET_SUIT.EFFECT"
msgid ""
"Supplies Duplicants with <link=\"OXYGEN\">Oxygen</link> in toxic and low breathability environments.\n"
"\n"
"Must be refilled with <link=\"OXYGEN\">Oxygen</link> and <link=\"COMBUSTIBLELIQUID\">Combustible Liquid</link> at a "
"<link=\"JETSUITLOCKER\">Jet Suit Dock</link> when depleted."
msgstr ""
"Fornece <link=\"OXYGEN\">Oxigênio</link> aos Duplicantes em ambientes tóxicos e com baixa respirabilidade.\n"
"\n"
"Deve ser reabastecido com <link=\"OXYGEN\">Oxigênio</link> e <link=\"COMBUSTIBLELIQUID\">Combustível Líquido</link> em um "
"<link=\"JETSUITLOCKER\">Estação de Traje a Jato</link> quando esgotado."

#. STRINGS.EQUIPMENT.PREFABS.JET_SUIT.GENERICNAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.JET_SUIT.GENERICNAME"
msgid "Jet Suit"
msgstr "Traje a Jato"

#. STRINGS.EQUIPMENT.PREFABS.JET_SUIT.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.JET_SUIT.NAME"
msgid "<link=\"JETSUIT\">Jet Suit</link>"
msgstr "<link=\"JETSUIT\">Traje a Jato</link>"

#. STRINGS.EQUIPMENT.PREFABS.JET_SUIT.RECIPE_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.JET_SUIT.RECIPE_DESC"
msgid ""
"Supplies Duplicants with <link=\"OXYGEN\">Oxygen</link> in toxic and low breathability environments.\n"
"\n"
"Allows Duplicant flight."
msgstr ""
"Fornece <link=\"OXYGEN\">Oxigênio</link> aos Duplicantes em ambientes tóxicos e com baixa respirabilidade.\n"
"\n"
"Permite que os Duplicantes voem."

#. STRINGS.EQUIPMENT.PREFABS.JET_SUIT.REPAIR_WORN_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.JET_SUIT.REPAIR_WORN_DESC"
