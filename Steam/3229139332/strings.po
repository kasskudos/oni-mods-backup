msgctxt "STRINGS.CODEX.QUESTS.KNOCKQUEST.NAME"
msgid "Greet Occupant"
msgstr "Cumprimentar o Ocupante"

#. STRINGS.CODEX.QUESTS.PLUGGEDIN.COMPLETE
msgctxt "STRINGS.CODEX.QUESTS.PLUGGEDIN.COMPLETE"
msgid ""
"Success! The hermit is very excited about being on the grid.\n"
"\n"
"The bright lights illuminate an unfamiliar file on the ground nearby."
msgstr ""
"Sucesso! O eremita está muito animado por estar na rede.\n"
"\n"
"As luzes brilhantes iluminam um arquivo desconhecido no chão próximo."

#. STRINGS.CODEX.QUESTS.PLUGGEDIN.NAME
msgctxt "STRINGS.CODEX.QUESTS.PLUGGEDIN.NAME"
