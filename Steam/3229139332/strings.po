#. STRINGS.EQUIPMENT.PREFABS.FUNKY_VEST.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.FUNKY_VEST.DESC"
msgid "This transforms my Duplicant into a walking beacon of charm and style."
msgstr "Isso transforma meu Duplicante em um farol ambulante de charme e estilo."

#. STRINGS.EQUIPMENT.PREFABS.FUNKY_VEST.EFFECT
msgctxt "STRINGS.EQUIPMENT.PREFABS.FUNKY_VEST.EFFECT"
msgid ""
"Increases Decor in a small area effect around the wearer. Can be upgraded to <link=\"CUSTOMCLOTHING\">Primo Garb</link> at "
"the <link=\"CLOTHINGALTERATIONSTATION\">Clothing Refashionator</link>."
msgstr ""
"Aumenta a Decor em uma pequena área ao redor do usuário. Pode ser atualizado para <link=\"CUSTOMCLOTHING\">Traje Primo</"
"link> na <link=\"CLOTHINGALTERATIONSTATION\">Remodelador de Roupas</link>."

#. STRINGS.EQUIPMENT.PREFABS.FUNKY_VEST.GENERICNAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.FUNKY_VEST.GENERICNAME"
