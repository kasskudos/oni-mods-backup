"An egg laid by a <link=\"PUFT\">Puft</link>.\n"
"\n"
"If incubated, it will hatch into a <link=\"PUFT\">Puftlet</link>."
msgstr ""
"Um ovo posto por um <link=\"PUFT\">Pufão</link>.\n"
"\n"
"Se incubado, eclodirá em um <link=\"PUFT\">Pufinho</link>."

#. STRINGS.ITEMS.FOOD.PUFTEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.PUFTEGG.NAME"
msgid "<link=\"PUFT\">Puft Egg</link>"
msgstr "<link=\"PUFT\">Ovo de Pufão</link>"

#. STRINGS.ITEMS.FOOD.PUFTEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PUFTEGG.RECIPEDESC"
msgid "An egg laid by a <link=\"PUFT\">Puft</link>."
msgstr "Um ovo posto por um <link=\"PUFT\">Pufão</link>."

#. STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.DESC"
msgid ""
"A dehydrated <link=\"QUICHE\">Mushroom Quiche</link> ration. It must be rehydrated in order to be considered "
"<link=\"FOOD\">Food</link>.\n"
"\n"
"Dry rations have no expiry date."
msgstr ""
"Uma ração desidratada de <link=\"QUICHE\">Quiche de Cogumelos</link>. Deve ser reidratada para ser considerada "
"<link=\"FOOD\">Comida</link>.\n"
"\n"
"Rações secas não têm data de validade."

