#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.URCHIN.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.URCHIN.DESC"
msgid ""
"Pinpoki are aquatic organisms grown in <link=\"URCHINPLANT\">Pinpokets</link>.\n"
"\n"
"They can be processed into <link=\"DIAMOND\">Diamond</link> or <link=\"URCHINMEAT\">Uni</link>, or used as "
"<link=\"DECOR\">Decor</link>."
msgstr ""
"Ouriços são organismos aquáticos cultivados em <link=\"URCHINPLANT\">Ouriçeiras</link>.\n"
"\n"
"Podem ser processados em <link=\"DIAMOND\">Diamante</link> ou <link=\"URCHINMEAT\">Uni</link>, ou usados como "
"<link=\"DECOR\">Decoração</link>."

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.URCHIN.NAME
