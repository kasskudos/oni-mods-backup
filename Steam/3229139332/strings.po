#. STRINGS.WORLD_TRAITS.IRREGULAR_OIL.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.IRREGULAR_OIL.DESCRIPTION"
msgid "The <style=\"KKeyword\">Oil</style> on this asteroid is anything but regular!"
msgstr "O <style=\"KKeyword\">Petróleo</style> neste asteroide é tudo, menos regular!"

#. STRINGS.WORLD_TRAITS.IRREGULAR_OIL.NAME
msgctxt "STRINGS.WORLD_TRAITS.IRREGULAR_OIL.NAME"
msgid "Irregular Oil"
msgstr "Óleo Irregular"

#. STRINGS.WORLD_TRAITS.LUSH_CORE.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.LUSH_CORE.DESCRIPTION"
msgid "This world has a lush forest core"
msgstr "Este mundo tem um núcleo florestal exuberante"

#. STRINGS.WORLD_TRAITS.LUSH_CORE.NAME
msgctxt "STRINGS.WORLD_TRAITS.LUSH_CORE.NAME"
msgid "Lush Core"
msgstr "Núcleo Exuberante"

#. STRINGS.WORLD_TRAITS.MAGMA_VENTS.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.MAGMA_VENTS.DESCRIPTION"
msgid "The <link=\"MAGMA\">Magma</link> from this world's core has leaked into the mantle and crust"
msgstr "O <link=\"MAGMA\">Magma</link> do núcleo deste mundo vazou para o manto e para a crosta"

#. STRINGS.WORLD_TRAITS.MAGMA_VENTS.NAME
msgctxt "STRINGS.WORLD_TRAITS.MAGMA_VENTS.NAME"
msgid "Magma Channels"
msgstr "Canais de Magma"

#. STRINGS.WORLD_TRAITS.METAL_CAVES.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.METAL_CAVES.DESCRIPTION"
msgid "This world has caves of metal ore"
msgstr "Este mundo tem cavernas de minério de metal"

#. STRINGS.WORLD_TRAITS.METAL_CAVES.NAME
msgctxt "STRINGS.WORLD_TRAITS.METAL_CAVES.NAME"
msgid "Metallic Caves"
msgstr "Cavernas Metálicas"

#. STRINGS.WORLD_TRAITS.METAL_POOR.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.METAL_POOR.DESCRIPTION"
msgid "There is a reduced amount of <style=\"KKeyword\">Metal Ore</style> on this world, proceed with caution!"
msgstr "Há uma quantidade reduzida de <style=\"KKeyword\">Minério de Metal</style> neste mundo, proceda com cautela!"

#. STRINGS.WORLD_TRAITS.METAL_POOR.NAME
msgctxt "STRINGS.WORLD_TRAITS.METAL_POOR.NAME"
msgid "Metal Poor"
msgstr "Pobre em Metal"

#. STRINGS.WORLD_TRAITS.METAL_RICH.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.METAL_RICH.DESCRIPTION"
msgid "This asteroid is an abundant source of <style=\"KKeyword\">Metal Ore</style>"
msgstr "Este asteroide é uma fonte abundante de <style=\"KKeyword\">Minério de Metal</style>"

#. STRINGS.WORLD_TRAITS.METAL_RICH.NAME
msgctxt "STRINGS.WORLD_TRAITS.METAL_RICH.NAME"
msgid "Metal Rich"
msgstr "Rico em Metal"

#. STRINGS.WORLD_TRAITS.MISALIGNED_START.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.MISALIGNED_START.DESCRIPTION"
msgid ""
"The <link=\"HEADQUARTERS\">Printing Pod</link> didn't end up in the asteroid's exact center this time... but it's still "
"nowhere near the surface"
msgstr ""
"O <link=\"HEADQUARTERS\">Módulo Duplicador</link> acabou não ficando exatamente no centro do asteroide desta vez... mas "
"ainda não está nem perto da superfície"

#. STRINGS.WORLD_TRAITS.MISALIGNED_START.NAME
msgctxt "STRINGS.WORLD_TRAITS.MISALIGNED_START.NAME"
msgid "Alternate Pod Location"
msgstr "Localização alternativa do Módulo Duplicador"

#. STRINGS.WORLD_TRAITS.MISSING_TRAIT
msgctxt "STRINGS.WORLD_TRAITS.MISSING_TRAIT"
msgid "<missing traits>"
msgstr "<traços ausentes>"

#. STRINGS.WORLD_TRAITS.NO_TRAITS.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.NO_TRAITS.DESCRIPTION"
msgid "This world exists in a particularly stable configuration each time it is encountered"
msgstr "Este mundo existe em uma configuração particularmente estável cada vez que é encontrado"

#. STRINGS.WORLD_TRAITS.NO_TRAITS.NAME
msgctxt "STRINGS.WORLD_TRAITS.NO_TRAITS.NAME"
msgid "<i>This world is stable and has no unusual features.</i>"
msgstr "<i>Este mundo é estável e não possui recursos incomuns.</i>"

#. STRINGS.WORLD_TRAITS.NO_TRAITS.NAME_SHORTHAND
msgctxt "STRINGS.WORLD_TRAITS.NO_TRAITS.NAME_SHORTHAND"
msgid "No unusual features"
msgstr "Sem Recursos Incomuns"

#. STRINGS.WORLD_TRAITS.RADIOACTIVE_CRUST.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.RADIOACTIVE_CRUST.DESCRIPTION"
msgid "Deposits of <link=\"URANIUMORE\">Uranium Ore</link> are found in this world's crust"
msgstr "Depósitos de <link=\"URANIUMORE\">Minério de Urânio</link> são encontrados na crosta deste mundo"

#. STRINGS.WORLD_TRAITS.RADIOACTIVE_CRUST.NAME
msgctxt "STRINGS.WORLD_TRAITS.RADIOACTIVE_CRUST.NAME"
msgid "Radioactive Crust"
msgstr "Crosta Radioativa"

#. STRINGS.WORLD_TRAITS.SLIME_SPLATS.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.SLIME_SPLATS.DESCRIPTION"
msgid "Sickly <link=\"SLIMEMOLD\">Slime</link> growths have crept all over this world"
msgstr "Bolores de <link=\"SLIMEMOLD\">Limo</link> infestaram todo o planeta"

#. STRINGS.WORLD_TRAITS.SLIME_SPLATS.NAME
msgctxt "STRINGS.WORLD_TRAITS.SLIME_SPLATS.NAME"
msgid "Slime Molds"
msgstr "Bolores de Limo"

#. STRINGS.WORLD_TRAITS.SUBSURFACE_OCEAN.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.SUBSURFACE_OCEAN.DESCRIPTION"
msgid "Below the crust of this world is a <link=\"SALTWATER\">Salt Water</link> sea"
msgstr "Abaixo da crosta deste mundo há um mar de <link=\"SALTWATER\">Água Salgada</link>"

#. STRINGS.WORLD_TRAITS.SUBSURFACE_OCEAN.NAME
msgctxt "STRINGS.WORLD_TRAITS.SUBSURFACE_OCEAN.NAME"
msgid "Subsurface Ocean"
msgstr "Oceano Subterrâneo"

#. STRINGS.WORLD_TRAITS.VOLCANOES.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.VOLCANOES.DESCRIPTION"
msgid "Several active <style=\"KKeyword\">Volcanoes</style> have been detected in this world"
msgstr "Vários <style=\"KKeyword\">Vulcões</style> ativos foram detectados neste mundo"

#. STRINGS.WORLD_TRAITS.VOLCANOES.NAME
msgctxt "STRINGS.WORLD_TRAITS.VOLCANOES.NAME"
msgid "Volcanic Activity"
msgstr "Atividade Vulcânica"

#. STRINGS.WORLDS.AQUATICBASEGAME.DESCRIPTION
msgctxt "STRINGS.WORLDS.AQUATICBASEGAME.DESCRIPTION"
msgid ""
"A salty water-rich starting world with abundant food resources.\n"
"\n"
"<smallcaps>Marinea's biodiversity makes reliable food production more attainable for new colonies, provided they can "
"navigate its ubiquitous liquid pools. Construction materials are a bit limited.</smallcaps>"
msgstr ""
"Um mundo inicial rico em água salgada e abundantes recursos alimentares.\n"
"\n"
"<smallcaps>A biodiversidade de Marinea torna a produção de alimentos mais acessível para novas colônias, desde que possam "
"navegar em suas abundantes poças líquidas. Os materiais de construção são um pouco limitados.</smallcaps>"

#. STRINGS.WORLDS.AQUATICBASEGAME.NAME
msgctxt "STRINGS.WORLDS.AQUATICBASEGAME.NAME"
msgid "Marinea"
msgstr "Marinea"

#. STRINGS.WORLDS.AQUATICCLASSIC.DESCRIPTION
msgctxt "STRINGS.WORLDS.AQUATICCLASSIC.DESCRIPTION"
msgid ""
"A salty water-rich starting world with abundant food resources.\n"
"\n"
"<smallcaps>Marinea's biodiversity makes reliable food production more attainable for new colonies, provided they can "
"navigate its ubiquitous liquid pools. Construction materials are a bit limited.</smallcaps>"
msgstr ""
"Um mundo inicial rico em água salgada e abundantes recursos alimentares.\n"
"\n"
"<smallcaps>A biodiversidade de Marinea torna a produção de alimentos mais acessível para novas colônias, desde que possam "
"navegar em suas abundantes poças líquidas. Os materiais de construção são um pouco limitados.</smallcaps>"

#. STRINGS.WORLDS.AQUATICCLASSIC.NAME
msgctxt "STRINGS.WORLDS.AQUATICCLASSIC.NAME"
msgid "Marinea Asteroid"
msgstr "Asteroide Marinea"

#. STRINGS.WORLDS.AQUATICMIXING.DESCRIPTION
msgctxt "STRINGS.WORLDS.AQUATICMIXING.DESCRIPTION"
msgid ""
"A fragment of an aquatic starting world. It has abundant food resources.\n"
"\n"
"<smallcaps>Marinea's biodiversity makes reliable food production more attainable for new colonies, provided they can "
"navigate its many liquid pools. Construction materials are a bit limited.</smallcaps>"
msgstr ""
"Um fragmento de um mundo inicial aquático. Possui recursos alimentares abundantes.\n"
"\n"
"<smallcaps>A biodiversidade de Marinea torna a produção confiável de alimentos mais acessível para novas colônias, desde "
"que consigam navegar suas muitas poças líquidas. Materiais de construção são um pouco limitados.</smallcaps>"

#. STRINGS.WORLDS.AQUATICMIXING.NAME
msgctxt "STRINGS.WORLDS.AQUATICMIXING.NAME"
msgid "Marinea Fragment"
msgstr "Fragmento Marinea"

#. STRINGS.WORLDS.AQUATICSPACEDOUT.DESCRIPTION
msgctxt "STRINGS.WORLDS.AQUATICSPACEDOUT.DESCRIPTION"
msgid ""
"A smaller inundated starting world with abundant food resources.\n"
"\n"
"<smallcaps>Marinea's biodiversity makes reliable food production more attainable for new colonies, provided they can "
"navigate its ubiquitous liquid pools. Construction materials are a bit limited.</smallcaps>"
msgstr ""
"Um mundo inicial menor inundado, com abundantes recursos alimentares.\n"
"\n"
"<smallcaps>A biodiversidade de Marinea torna a produção confiável de alimentos mais acessível para novas colônias, desde "
"que consigam navegar suas poças líquidas ubíquas. Materiais de construção são um pouco limitados.</smallcaps>"

#. STRINGS.WORLDS.AQUATICSPACEDOUT.NAME
msgctxt "STRINGS.WORLDS.AQUATICSPACEDOUT.NAME"
msgid "Marinea Minor"
msgstr "Marinea Menor"

#. STRINGS.WORLDS.BADLANDS.DESCRIPTION
msgctxt "STRINGS.WORLDS.BADLANDS.DESCRIPTION"
msgid ""
"A barren location with an overabundance of mineral resources.\n"
"\n"
"<smallcaps>The rocky terrain of The Badlands poses no immediate threats, but sparse resource availability will make "
"expansion and technological progress challenging.</smallcaps>\n"
"\n"
msgstr ""
"Um local árido com uma superabundância de recursos minerais.\n"
"\n"
"<smallcaps>O terreno rochoso das Terras Desoladas não representa ameaças imediatas, mas a escassa disponibilidade de "
"recursos tornará a expansão e o progresso tecnológico um desafio.</smallcaps>\n"

#. STRINGS.WORLDS.BADLANDS.NAME
msgctxt "STRINGS.WORLDS.BADLANDS.NAME"
msgid "The Badlands"
msgstr "As Terras Desoladas"

#. STRINGS.WORLDS.BIGEMPTY.DESCRIPTION
msgctxt "STRINGS.WORLDS.BIGEMPTY.DESCRIPTION"
msgid "A big ol' biome-free spacerock for claustrophobic devs."
msgstr "Uma grande e velha rocha espacial livre de bioma para desenvolvedores claustrofóbicos."

#. STRINGS.WORLDS.BIGEMPTY.NAME
msgctxt "STRINGS.WORLDS.BIGEMPTY.NAME"
msgid "Big Empty FOR DEVS"
msgstr "Grande Vazio PARA DEVS"

#. STRINGS.WORLDS.CERESBASEGAME.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESBASEGAME.DESCRIPTION"
msgid ""
"A frosty location with sub-zero temperatures throughout.\n"
"\n"
"<smallcaps>Duplicants who work in Ceres's sub-zero temperatures will need to wear or build warming equipment. Abundant "
"natural fuel sources could lead to a well-powered colony.</smallcaps>"
msgstr ""
"Um lugar extremamente frio, com temperaturas abaixo de zero em toda a sua extensão.\n"
"\n"
"<smallcaps>Os Duplicantes em Ceres precisarão se equipar com roupas e estruturas de aquecimento para resistir ao frio "
"intenso. A abundância de combustível natural garante energia para a colônia.</smallcaps>"

#. STRINGS.WORLDS.CERESBASEGAME.NAME
msgctxt "STRINGS.WORLDS.CERESBASEGAME.NAME"
msgid "Ceres"
msgstr "Ceres"

#. STRINGS.WORLDS.CERESBASEGAMESHATTERED.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESBASEGAMESHATTERED.DESCRIPTION"
msgid ""
"The heavily damaged remnants of a frosty location with sub-zero temperatures throughout.\n"
"\n"
"<smallcaps>Exploring the rubble of Blasted Ceres's sub-zero temperatures is particularly challenging, yet natural fuel "
"sources provide a valuable payoff.</smallcaps>"
msgstr ""
"Os restos severamente danificados de um mundo congelado com temperaturas abaixo de zero em toda a sua extensão..\n"
"\n"
"<smallcaps>Explorar os escombros de Ceres Despedaçado, com suas temperaturas abaixo de zero, é particularmente desafiador, "
"mas as fontes de combustível natural oferecem uma recompensa valiosa.</smallcaps>"

#. STRINGS.WORLDS.CERESBASEGAMESHATTERED.NAME
msgctxt "STRINGS.WORLDS.CERESBASEGAMESHATTERED.NAME"
msgid "Blasted Ceres"
msgstr "Ceres Despedaçado"

#. STRINGS.WORLDS.CERESCLASSIC.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESCLASSIC.DESCRIPTION"
msgid ""
"A frosty starting world with sub-zero temperatures throughout.\n"
"\n"
"<smallcaps>Duplicants who work in Ceres's sub-zero temperatures will need to wear or build warming equipment. Abundant "
"natural fuel sources could lead to a well-powered colony.</smallcaps>"
msgstr ""
"Um mundo inicial congelado com temperaturas abaixo de zero em toda a sua extensão.\n"
"\n"
"<smallcaps>Os Duplicantes em Ceres precisarão se equipar com roupas e estruturas de aquecimento para resistir ao frio "
"intenso. A abundância de combustível natural garante energia para a colônia.</smallcaps>"

#. STRINGS.WORLDS.CERESCLASSIC.NAME
msgctxt "STRINGS.WORLDS.CERESCLASSIC.NAME"
msgid "Ceres Asteroid"
msgstr "Asteroide Ceres"

#. STRINGS.WORLDS.CERESCLASSICSHATTERED.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESCLASSICSHATTERED.DESCRIPTION"
msgid ""
"The heavily damaged remnants of a frosty location with sub-zero temperatures throughout.\n"
"\n"
"<smallcaps>Exploring the rubble of Blasted Ceres's sub-zero temperatures is particularly challenging, yet natural fuel "
"sources provide a valuable payoff.</smallcaps>"
msgstr ""
"Os restos severamente danificados de um mundo congelado com temperaturas abaixo de zero em toda a sua extensão..\n"
"\n"
"<smallcaps>Explorar os escombros de Ceres Despedaçado, com suas temperaturas abaixo de zero, é particularmente desafiador, "
"mas as fontes de combustível natural oferecem uma recompensa valiosa.</smallcaps>"

#. STRINGS.WORLDS.CERESCLASSICSHATTERED.NAME
msgctxt "STRINGS.WORLDS.CERESCLASSICSHATTERED.NAME"
msgid "Blasted Ceres"
msgstr "Ceres Despedaçado"

#. STRINGS.WORLDS.CERESMIXING.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESMIXING.DESCRIPTION"
msgid ""
"A fragment of a frosty starting world with sub-zero temperatures throughout.\n"
"\n"
"<smallcaps>Duplicants who work in sub-zero temperatures will need to wear or build warming equipment. Abundant natural fuel "
"sources could lead to a well-powered colony.</smallcaps>"
msgstr ""
"Um fragmento de um mundo inicial congelado, com temperaturas sempre abaixo de zero.\n"
"\n"
"<smallcaps>Os Duplicantes em Ceres precisarão se equipar com roupas e estruturas de aquecimento para resistir ao frio "
"intenso. A abundância de combustível natural garante energia para a colônia.</smallcaps>"

#. STRINGS.WORLDS.CERESMIXING.NAME
msgctxt "STRINGS.WORLDS.CERESMIXING.NAME"
msgid "Ceres Fragment"
msgstr "Ceres Fragmentado"

#. STRINGS.WORLDS.CERESSPACEDOUT.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESSPACEDOUT.DESCRIPTION"
msgid ""
"A smaller frosty starting world with sub-zero temperatures throughout.\n"
"\n"
"<smallcaps>Duplicants who work in Ceres's sub-zero temperatures will need to wear or build warming equipment. Abundant "
"natural fuel sources could lead to a well-powered colony.</smallcaps>"
msgstr ""
"Um mundo inicial congelado menor, com temperaturas abaixo de zero em toda a sua extensão.\n"
"\n"
"<smallcaps>Os Duplicantes em Ceres precisarão se equipar com roupas e estruturas de aquecimento para resistir ao frio "
"intenso. A abundância de combustível natural garante energia para a colônia.</smallcaps>"

#. STRINGS.WORLDS.CERESSPACEDOUT.NAME
msgctxt "STRINGS.WORLDS.CERESSPACEDOUT.NAME"
msgid "Ceres Minor"
msgstr "Ceres Menor"

#. STRINGS.WORLDS.FOREST_DEFAULT.DESCRIPTION
msgctxt "STRINGS.WORLDS.FOREST_DEFAULT.DESCRIPTION"
msgid ""
"A location with a natural abundance of trees.\n"
"\n"
"<smallcaps>Colonizing Arboria will require careful planning right from the start. Because of its lack of metals, finding "
"biological solutions to problems is a must.</smallcaps>\n"
"\n"
msgstr ""
"Local com abundância natural de árvores.\n"
"\n"
"<smallcaps>Colonizar Arboria exigirá um planejamento cuidadoso desde o início. Devido à falta de metais, é fundamental "
"encontrar soluções biológicas para os problemas.</smallcaps>\n"

#. STRINGS.WORLDS.FOREST_DEFAULT.NAME
msgctxt "STRINGS.WORLDS.FOREST_DEFAULT.NAME"
msgid "Arboria"
msgstr "Arboria"

#. STRINGS.WORLDS.FOREST_HOT.DESCRIPTION
msgctxt "STRINGS.WORLDS.FOREST_HOT.DESCRIPTION"
msgid ""
"A location with oppressively hot temperatures.\n"
"\n"
"<smallcaps>Temperatures on Aridio are much higher than expected. While resources are abundant, maintaining food and "
"infrastructure could be difficult as our colony warms.</smallcaps>\n"
"\n"
msgstr ""
"Um local com temperaturas opressivamente quentes.\n"
"\n"
"<smallcaps>As temperaturas em Arídio estão muito mais altas do que o esperado. Embora os recursos sejam abundantes, a "
"manutenção de alimentos e infraestrutura pode ser difícil à medida que nossa colônia aquece.</smallcaps>\n"

#. STRINGS.WORLDS.FOREST_HOT.NAME
msgctxt "STRINGS.WORLDS.FOREST_HOT.NAME"
msgid "Aridio"
msgstr "Arídio"

#. STRINGS.WORLDS.FOREST_LUSH.DESCRIPTION
msgctxt "STRINGS.WORLDS.FOREST_LUSH.DESCRIPTION"
msgid ""
"A lush location rich in wildlife and life-sustaining resources.\n"
"\n"
"<smallcaps>Establishing a foothold on Verdante will be challenging due to reduced food and oxygen options. However, "
"abundant biological and mineral resources should afford excellent long-term growth.</smallcaps>\n"
"\n"
msgstr ""
"Um local exuberante, rico em vida selvagem e recursos de sustentação da vida.\n"
"\n"
"<smallcaps>Estabelecer uma posição segura em Verdejante será um desafio devido às opções reduzidas de alimentos e oxigênio. "
"No entanto, recursos biológicos e minerais abundantes deverão proporcionar um excelente crescimento a longo prazo.</"
"smallcaps>\n"

#. STRINGS.WORLDS.FOREST_LUSH.NAME
msgctxt "STRINGS.WORLDS.FOREST_LUSH.NAME"
msgid "Verdante"
msgstr "Verdante"

#. STRINGS.WORLDS.FORESTMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.FORESTMOONLET.DESCRIPTION"
msgid ""
"A small moon with a forest start.\n"
"\n"
"<smallcaps>Folia Asteroids have plenty of organic material but Duplicants will have to venture outside their starting biome "
"quickly to find any metal.</smallcaps>"
msgstr ""
"Uma pequena lua com início de floresta.\n"
"\n"
"<smallcaps>Os Asteroides Folia têm bastante material orgânico, mas os Duplicantes terão que se aventurar fora de seu bioma "
"inicial rapidamente para encontrar qualquer metal.</smallcaps>"

#. STRINGS.WORLDS.FORESTMOONLET.NAME
msgctxt "STRINGS.WORLDS.FORESTMOONLET.NAME"
msgid "Folia Asteroid"
msgstr "Asteroide Folia"

#. STRINGS.WORLDS.HELICONA.DESCRIPTION
msgctxt "STRINGS.WORLDS.HELICONA.DESCRIPTION"
msgid ""
"Due to its highly elliptical orbit around its host star, this rock is cold. Oh so very cold.\n"
"\n"
"<smallcaps></smallcaps>\n"
"\n"
msgstr ""
"Devido à sua órbita altamente elíptica em torno da sua estrela hospedeira, esta rocha é fria. Ah, muito fria.\n"
"\n"
"<smallcaps></smallcaps>\n"

#. STRINGS.WORLDS.HELICONA.NAME
msgctxt "STRINGS.WORLDS.HELICONA.NAME"
msgid "Helicona"
msgstr "Helicona"

#. STRINGS.WORLDS.IDEALLANDINGSITE.DESCRIPTION
msgctxt "STRINGS.WORLDS.IDEALLANDINGSITE.DESCRIPTION"
msgid ""
"A sandstone and forest world with significant radiation.\n"
"\n"
"<smallcaps>Irradiated Forest Asteroids have an abundance of metal for the taking if Duplicants can withstand the "
"planetoid's radiation.</smallcaps>"
msgstr ""
"Um mundo de arenito e floresta com radiação significativa.\n"
"\n"
"<smallcaps>Asteroides Florestais Irradiados possuem uma abundância de metal à disposição, se os Duplicantes conseguirem "
"suportar a radiação do planetóide.</smallcaps>"

#. STRINGS.WORLDS.IDEALLANDINGSITE.NAME
msgctxt "STRINGS.WORLDS.IDEALLANDINGSITE.NAME"
msgid "Irradiated Forest Asteroid"
msgstr "Asteroide Florestal Irradiado"

#. STRINGS.WORLDS.MARSHYMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.MARSHYMOONLET.DESCRIPTION"
msgid ""
"A small location with an abundance of marshland.\n"
"\n"
"<smallcaps>While Marshy Asteroids offer an abundance of organic resources like Slime Mold and Algae, their air quality "
"poses a significant disease risk for Duplicants.</smallcaps>"
msgstr ""
"Um pequeno local com abundância de pântanos.\n"
"\n"
"<smallcaps>Embora os Asteroides Pantanosos ofereçam uma abundância de recursos orgânicos, como fungos viscosos e algas, a "
"qualidade do ar representa um risco significativo de doenças para os Duplicantes.</smallcaps>"

#. STRINGS.WORLDS.MARSHYMOONLET.NAME
msgctxt "STRINGS.WORLDS.MARSHYMOONLET.NAME"
msgid "Marshy Asteroid"
msgstr "Asteroide Pantanoso"

#. STRINGS.WORLDS.MEDIUMFORESTYRADIOACTIVEVANILLAWARPPLANET.DESCRIPTION
msgctxt "STRINGS.WORLDS.MEDIUMFORESTYRADIOACTIVEVANILLAWARPPLANET.DESCRIPTION"
msgid ""
"A large-ish forested asteroid with a frozen radioactive core.\n"
"\n"
"<smallcaps>While Radioactive Forest Asteroid are largely foresty, they also contain a great deal of rust.</smallcaps>"
msgstr ""
"Um asteroide florestal grandinho com um núcleo radioativo congelado.\n"
"\n"
"<smallcaps>Embora os Asteroides Florestais Radioativos sejam em grande parte florestais, eles também contêm muita ferrugem."
"</smallcaps>"

#. STRINGS.WORLDS.MEDIUMFORESTYRADIOACTIVEVANILLAWARPPLANET.NAME
msgctxt "STRINGS.WORLDS.MEDIUMFORESTYRADIOACTIVEVANILLAWARPPLANET.NAME"
msgid "Radioactive Forest Asteroid"
msgstr "Asteroide Florestal Radioativo"

#. STRINGS.WORLDS.MEDIUMFORESTYWASTELAND.DESCRIPTION
msgctxt "STRINGS.WORLDS.MEDIUMFORESTYWASTELAND.DESCRIPTION"
msgid ""
"A large-ish forested asteroid with a frozen radioactive core.\n"
"\n"
"<smallcaps>While Glowood Wasteland Asteroids are largely foresty, they also contain a great deal of rust and wasteland.</"
"smallcaps>"
msgstr ""
"Um grande asteroide florestado com um núcleo radioativo congelado.\n"
"\n"
"<smallcaps>Embora os Asteroides Ermo de Lumiflor sejam em grande parte florestados, eles também contêm uma grande "
"quantidade de ferrugem e terrenos baldios.</smallcaps>"

#. STRINGS.WORLDS.MEDIUMFORESTYWASTELAND.NAME
msgctxt "STRINGS.WORLDS.MEDIUMFORESTYWASTELAND.NAME"
msgid "Glowood Wasteland Asteroid"
msgstr "Asteroide Ermo de Lumiflor"

#. STRINGS.WORLDS.MEDIUMRADIOACTIVEVANILLAWARPPLANET.DESCRIPTION
msgctxt "STRINGS.WORLDS.MEDIUMRADIOACTIVEVANILLAWARPPLANET.DESCRIPTION"
msgid ""
"A large-ish partially frozen world with a radioactive core.\n"
"\n"
"<smallcaps>While Radioactive Swamp Asteroids are largely swampy, they also contain a great deal of rust.</smallcaps>"
msgstr ""
"Um mundo grande parcialmente congelado com um núcleo radioativo.\n"
"\n"
"<smallcaps>Embora os Asteroides Radioativos do Pântanos sejam em grande parte pantanosos, eles também contêm uma grande "
"quantidade de ferrugem.</smallcaps>"

#. STRINGS.WORLDS.MEDIUMRADIOACTIVEVANILLAWARPPLANET.NAME
msgctxt "STRINGS.WORLDS.MEDIUMRADIOACTIVEVANILLAWARPPLANET.NAME"
msgid "Radioactive Swamp Asteroid"
msgstr "Asteroide Radioativo do Pântano"

#. STRINGS.WORLDS.MEDIUMSANDYRADIOACTIVEVANILLAWARPPLANET.DESCRIPTION
msgctxt "STRINGS.WORLDS.MEDIUMSANDYRADIOACTIVEVANILLAWARPPLANET.DESCRIPTION"
msgid ""
"A large-ish terra world with a radioactive core.\n"
"\n"
"<smallcaps>The Radioactive Terra Asteroid is fairly dry and sandy, but does contain areas of jungle.</smallcaps>"
msgstr ""
"Um grande mundo terrestre com um núcleo radioativo.\n"
"\n"
"<smallcaps>O Asteroide Terra Radioativo é bastante seco e arenoso, mas contém áreas de selva.</smallcaps>"

#. STRINGS.WORLDS.MEDIUMSANDYRADIOACTIVEVANILLAWARPPLANET.NAME
msgctxt "STRINGS.WORLDS.MEDIUMSANDYRADIOACTIVEVANILLAWARPPLANET.NAME"
msgid "Radioactive Terra Asteroid"
msgstr "Asteroide Terra Radioativo"

#. STRINGS.WORLDS.MEDIUMSANDYSWAMP.DESCRIPTION
msgctxt "STRINGS.WORLDS.MEDIUMSANDYSWAMP.DESCRIPTION"
msgid ""
"A large-ish terra world with a radioactive core.\n"
"\n"
"<smallcaps>The Radioactive Terrabog Asteroid is fairly dry and sandy, but does contain swampy areas with a partially frozen "
"surface.</smallcaps>"
msgstr ""
"Um mundo terrestre grande com um núcleo radioativo.\n"
"\n"
"<smallcaps>O Asteroide Terraturfeira Radioativo é bastante seco e arenoso, mas contém áreas pantanosas com uma superfície "
"parcialmente congelada.</smallcaps>"

#. STRINGS.WORLDS.MEDIUMSANDYSWAMP.NAME
msgctxt "STRINGS.WORLDS.MEDIUMSANDYSWAMP.NAME"
msgid "Radioactive Terrabog Asteroid"
msgstr "Asteroide Terraturfeira Radioativo"

#. STRINGS.WORLDS.MEDIUMSWAMPY.DESCRIPTION
msgctxt "STRINGS.WORLDS.MEDIUMSWAMPY.DESCRIPTION"
msgid ""
"A large-ish, polluted swamp world.\n"
"\n"
"<smallcaps>Stinko Swamp Asteroids are full of swampy and marshy areas, but also contain a variety of other biomes diverse "
"enough to keep a determined colony supplied with essentials.</smallcaps>"
msgstr ""
"Um mundo pantanoso grande e poluído.\n"
"\n"
"<smallcaps>Os Asteroides do Pântano Stinko estão cheios de áreas pantanosas, mas também contêm uma variedade de outros "
"biomas diversos o suficiente para manter uma determinada colônia abastecida com itens essenciais.</smallcaps>"

#. STRINGS.WORLDS.MEDIUMSWAMPY.NAME
msgctxt "STRINGS.WORLDS.MEDIUMSWAMPY.NAME"
msgid "Stinko Swamp Asteroid"
msgstr "Asteroide Fedorento"

#. STRINGS.WORLDS.METALHEAVYLANDINGSITE.DESCRIPTION
msgctxt "STRINGS.WORLDS.METALHEAVYLANDINGSITE.DESCRIPTION"
msgid ""
"A marshy world with significant radiation.\n"
"\n"
"<smallcaps>Irradiated Marsh Asteroids have an abundance of metal for the taking if Duplicants can withstand the planetoid's "
"radiation.</smallcaps>"
msgstr ""
"Um mundo pantanoso com radiação significativa.\n"
"\n"
"<smallcaps>Os Asteroides do Pântano Irradiados têm uma abundância de metal para serem capturados se os Duplicantes puderem "
"suportar a radiação do planetoide.</smallcaps>"

#. STRINGS.WORLDS.METALHEAVYLANDINGSITE.NAME
msgctxt "STRINGS.WORLDS.METALHEAVYLANDINGSITE.NAME"
msgid "Irradiated Marsh Asteroid"
msgstr "Asteroide Irradiado do Pântano"

#. STRINGS.WORLDS.MINIBADLANDS.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINIBADLANDS.DESCRIPTION"
msgid ""
"A barren location with an overabundance of mineral resources and oil.\n"
"\n"
"<smallcaps>The rocky terrain of The Desolands poses no immediate threats, but the limited variety of resources will make "
"expansion and technological progress challenging.</smallcaps>\n"
"\n"
msgstr ""
"Um local árido com uma superabundância de recursos minerais e petróleo.\n"
"\n"
"<smallcaps>O terreno rochoso do Asteroide das Terras Desoladas não representa ameaças imediatas, mas a variedade limitada "
"de recursos tornará a expansão e o progresso tecnológico um desafio.</smallcaps>\n"

#. STRINGS.WORLDS.MINIBADLANDS.NAME
msgctxt "STRINGS.WORLDS.MINIBADLANDS.NAME"
msgid "The Desolands Asteroid"
msgstr "O Asteroide das Terras Desoladas"

#. STRINGS.WORLDS.MINIFLIPPED.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINIFLIPPED.DESCRIPTION"
msgid ""
"An asteroid in which the surface is molten hot lava and the core is livable.\n"
"\n"
"<smallcaps>The lava surface of the Flipped Asteroid will make it challenging to start a rocketry program.</smallcaps>\n"
"\n"
msgstr ""
"Um asteroide em que a superfície é de lava quente derretida e o núcleo é habitável.\n"
"\n"
"<smallcaps>A superfície de lava do asteroide invertido tornará um desafio iniciar um programa de foguetes.</smallcaps>\n"

#. STRINGS.WORLDS.MINIFLIPPED.NAME
msgctxt "STRINGS.WORLDS.MINIFLIPPED.NAME"
msgid "Flipped Asteroid"
msgstr "Asteroide Invertido"

#. STRINGS.WORLDS.MINIFORESTFROZEN.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINIFORESTFROZEN.DESCRIPTION"
msgid ""
"A frigid location marked by inhospitably low temperatures throughout.\n"
"\n"
"<smallcaps>The Frozen Forest Asteroid's low temperatures will make finding water and establishing farms or ranches "
"problematic.</smallcaps>\n"
"\n"
msgstr ""
"Um local frígido marcado por temperaturas inóspitas por toda parte.\n"
"\n"
"<smallcaps>As baixas temperaturas do Asteroide da Floresta Congelada tornarão problemático encontrar água e estabelecer "
"fazendas ou estábulos.</smallcaps>\n"

#. STRINGS.WORLDS.MINIFORESTFROZEN.NAME
msgctxt "STRINGS.WORLDS.MINIFORESTFROZEN.NAME"
msgid "Frozen Forest Asteroid"
msgstr "Asteroide Floresta Congelada"

#. STRINGS.WORLDS.MINIMETALLICSWAMPY.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINIMETALLICSWAMPY.DESCRIPTION"
msgid ""
"A small swampy world with an abundance of renewable metal.\n"
"\n"
"<smallcaps>Metallic Swampy Asteroids have a high concentration of metal and a swampy, polluted atmosphere.</smallcaps>"
msgstr ""
"Um pequeno mundo pantanoso com abundância de metal renovável.\n"
"\n"
"<smallcaps>Asteroides Pantanosos Metálicos têm uma alta concentração de metal e uma atmosfera pantanosa e poluída.</"
"smallcaps>"

#. STRINGS.WORLDS.MINIMETALLICSWAMPY.NAME
msgctxt "STRINGS.WORLDS.MINIMETALLICSWAMPY.NAME"
msgid "Metallic Swampy Asteroid"
msgstr "Asteroide Pantanoso Metálico"

#. STRINGS.WORLDS.MINIRADIOACTIVEOCEAN.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINIRADIOACTIVEOCEAN.DESCRIPTION"
msgid ""
"An irradiated world with renewable water sources.\n"
"\n"
"<smallcaps>Both the radioactive biome and the ocean biome present unique challenges yet considerable payoffs.</smallcaps>\n"
"\n"
msgstr ""
"Um mundo irradiado com fontes de água renováveis.\n"
"\n"
"<smallcaps>Tanto o bioma radioativo quanto o bioma oceânico apresentam desafios únicos, mas com recompensas consideráveis.</"
"smallcaps>\n"

#. STRINGS.WORLDS.MINIRADIOACTIVEOCEAN.NAME
msgctxt "STRINGS.WORLDS.MINIRADIOACTIVEOCEAN.NAME"
msgid "Radioactive Ocean Asteroid"
msgstr "Asteroide Oceânico Radioativo"

#. STRINGS.WORLDS.MINISHATTEREDGEO.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINISHATTEREDGEO.DESCRIPTION"
msgid ""
"A molten mini asteroid with a failed experiment buried inside.\n"
"\n"
"<smallcaps>Extremely high temperatures threaten colony safety but could yield an unimaginably powerful payoff.</smallcaps>"
msgstr ""
"Um fragmento ígneo de um mundo menor e gelado, com um experimento falho enterrado em seu interior.\n"
"\n"
"<smallcaps>s temperaturas extremamente altas representam uma ameaça à segurança da colônia, mas possuem um potencial de "
"recompensa inimaginável.</smallcaps>"

#. STRINGS.WORLDS.MINISHATTEREDGEO.NAME
msgctxt "STRINGS.WORLDS.MINISHATTEREDGEO.NAME"
msgid "Ceres Core Asteroid"
msgstr "Asteroide Núcleo de Ceres"

#. STRINGS.WORLDS.MINISHATTEREDSTART.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINISHATTEREDSTART.DESCRIPTION"
msgid ""
"A battered chunk of a smaller frosty starting world with sub-zero temperatures throughout.\n"
"\n"
"<smallcaps>Surviving Ceres Mantle's frigid landscape is no easy task, but natural fuel sources provide a valuable payoff.</"
"smallcaps>"
msgstr ""
"Um fragmento acidentado de um mundo gelado menor, com temperaturas baixo de zero em toda a sua extensão.\n"
"\n"
"<smallcaps>Sobreviver à paisagem congelada do Manto de Ceres não é tarefa fácil, mas as fontes de combustível naturais "
"oferecem uma recompensa valiosa.</smallcaps>"

#. STRINGS.WORLDS.MINISHATTEREDSTART.NAME
msgctxt "STRINGS.WORLDS.MINISHATTEREDSTART.NAME"
msgid "Ceres Mantle Asteroid"
msgstr "Asteroide Manto de Ceres"

#. STRINGS.WORLDS.MINISHATTEREDWARP.DESCRIPTION
msgctxt "STRINGS.WORLDS.MINISHATTEREDWARP.DESCRIPTION"
msgid ""
"A small, snow-laden world rich with oil and nectar resources.\n"
"\n"
"<smallcaps>Sub-zero temperatures pose unique challenges but the potential for power production is very valuable.</smallcaps>"
msgstr ""
"Um pequeno mundo coberto de neve, rico em petróleo e néctar.\n"
"\n"
"<smallcaps>As temperaturas subzero apresentam desafios únicos, mas o potencial de produção de energia é muito valioso.</"
"smallcaps>"

#. STRINGS.WORLDS.MINISHATTEREDWARP.NAME
msgctxt "STRINGS.WORLDS.MINISHATTEREDWARP.NAME"
msgid "Sweet Ceres Asteroid"
msgstr "Asteroide Ceres Gelado"

#. STRINGS.WORLDS.MOOMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.MOOMOONLET.DESCRIPTION"
msgid ""
"A small world with unique local lifeforms.\n"
"\n"
"<smallcaps>Moo Asteroids are the natural breeding ground of Gassy Moos due to their abundance of Gas Grass and Methane.</"
"smallcaps>"
msgstr ""
"Um mundo pequeno com formas de vida locais únicas.\n"
"\n"
"<smallcaps>Asteroides Muu são terrenos férteis naturais de Muus Gasosos devido à sua abundância de Grama Gasosa e Metano.</"
"smallcaps>"

#. STRINGS.WORLDS.MOOMOONLET.NAME
msgctxt "STRINGS.WORLDS.MOOMOONLET.NAME"
msgid "Moo Asteroid"
msgstr "Asteroide Muu"

#. STRINGS.WORLDS.MOON_BARREN.DESCRIPTION
msgctxt "STRINGS.WORLDS.MOON_BARREN.DESCRIPTION"
msgid ""
"A smaller planetoid in orbit around a larger, resource rich world.\n"
"\n"
"<smallcaps>Barren Moons are rich in minerals, but Duplicants will need to branch out into space early to find the resources "
"the colony needs to stay alive.</smallcaps>\n"
"\n"
msgstr ""
"Um planetoide menor em órbita em torno de um mundo maior e rico em recursos.\n"
"\n"
"<smallcaps>As Luas Estéreis são ricas em minerais, mas os Duplicantes precisarão partir para o espaço mais cedo para "
"encontrar os recursos que a colônia precisa para se manter viva.</smallcaps>\n"

#. STRINGS.WORLDS.MOON_BARREN.NAME
msgctxt "STRINGS.WORLDS.MOON_BARREN.NAME"
msgid "Barren Moon"
msgstr "Lua Árida"

#. STRINGS.WORLDS.NIOBIUMMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.NIOBIUMMOONLET.DESCRIPTION"
msgid ""
"A small location with an abundance of solid Niobium.\n"
"\n"
"<smallcaps>Superconductive Asteroids offer rich veins of Niobium to Duplicants that can withstand its molten rivers of "
"magma.</smallcaps>"
msgstr ""
"Um local pequeno com abundância de Nióbio sólido.\n"
"\n"
"<smallcaps>Asteroides supercondutores oferecem ricos veios de nióbio para Duplicantes que podem suportar seus rios de magma "
"derretido.</smallcaps>"

#. STRINGS.WORLDS.NIOBIUMMOONLET.NAME
msgctxt "STRINGS.WORLDS.NIOBIUMMOONLET.NAME"
msgid "Superconductive Asteroid"
msgstr "Asteroide Supercondutor"

#. STRINGS.WORLDS.OASIS.DESCRIPTION
msgctxt "STRINGS.WORLDS.OASIS.DESCRIPTION"
msgid ""
"A desolate location with a cache of life-sustaining water trapped beneath the surface.\n"
"\n"
"<smallcaps>A wide underground desert will pose temperature threats and strain the resources of a colony on Oasisse. "
"However, surviving the challenge should present great industrial opportunities.</smallcaps>\n"
"\n"
msgstr ""
"Um local desolado com um depósito de água vital preso abaixo da superfície.\n"
"\n"
"<smallcaps>Um amplo deserto subterrâneo representará ameaças de temperatura e sobrecarregará os recursos de uma colônia em "
"Oasis. No entanto, sobreviver ao desafio deverá apresentar grandes oportunidades industriais.</smallcaps>\n"

#. STRINGS.WORLDS.OASIS.NAME
msgctxt "STRINGS.WORLDS.OASIS.NAME"
msgid "Oasisse"
msgstr "Oasis"

#. STRINGS.WORLDS.OCEANIA.DESCRIPTION
msgctxt "STRINGS.WORLDS.OCEANIA.DESCRIPTION"
msgid ""
"A location with vast quantities of undrinkable salt water.\n"
"\n"
"<smallcaps>Oceania is quite stable and resource rich, but the majority of the area is covered in a saltwater ocean. Careful "
"expansion and resource usage should lead to a successful colony.</smallcaps>\n"
"\n"
msgstr ""
"Um local com grandes quantidades de água salgada intragável.\n"
"\n"
"<smallcaps>A Oceania é bastante estável e rica em recursos, mas a maior parte da área é coberta por um oceano de água "
"salgada. A expansão cuidadosa e o uso de recursos devem levar a uma colônia bem-sucedida.</smallcaps>\n"

#. STRINGS.WORLDS.OCEANIA.NAME
msgctxt "STRINGS.WORLDS.OCEANIA.NAME"
msgid "Oceania"
msgstr "Oceania"

#. STRINGS.WORLDS.OILRICHWARPTARGET.DESCRIPTION
msgctxt "STRINGS.WORLDS.OILRICHWARPTARGET.DESCRIPTION"
msgid ""
"A rusty world with an oily core.\n"
"\n"
"<smallcaps>Duplicants must sift through a great deal of rust and ocean to reach the prize of this planetoid's oil.</"
"smallcaps>"
msgstr ""
"Um mundo enferrujado com um núcleo oleoso.\n"
"\n"
"<smallcaps>Duplicantes devem vasculhar uma grande quantidade de ferrugem e oceano para alcançar o prêmio do petróleo deste "
"planetóide.</smallcaps>"

#. STRINGS.WORLDS.OILRICHWARPTARGET.NAME
msgctxt "STRINGS.WORLDS.OILRICHWARPTARGET.NAME"
msgid "Rusty Oil Asteroid"
msgstr "Asteroide de Óleo Enferrujado"

#. STRINGS.WORLDS.OILYMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.OILYMOONLET.DESCRIPTION"
msgid ""
"A small location with an abundance of fossil fuels.\n"
"\n"
"<smallcaps>Viscosia Asteroids are filled with valuable crude oil, natural gas, and ethanol deposits at the expense of other "
"essential resources. Early expansion to other planetoids will be essential for survival.</smallcaps>"
msgstr ""
"Um local pequeno com abundância de combustíveis fósseis.\n"
"\n"
"<smallcaps>Os Asteroides Viscosia estão cheios de valiosos depósitos de petróleo bruto, gás natural e etanol, às custas de "
"outros recursos essenciais. A expansão inicial para outros planetoides será essencial para a sobrevivência.</smallcaps>"

#. STRINGS.WORLDS.OILYMOONLET.NAME
msgctxt "STRINGS.WORLDS.OILYMOONLET.NAME"
msgid "Viscosia Asteroid"
msgstr "Asteroide Viscosia"

#. STRINGS.WORLDS.PREHISTORICBASEGAME.DESCRIPTION
msgctxt "STRINGS.WORLDS.PREHISTORICBASEGAME.DESCRIPTION"
msgid ""
"An endangered location with abundant food resources.\n"
"\n"
"<smallcaps>Relica's biodiversity makes reliable food production more attainable for new colonies. Construction materials "
"and fuels are also ample. Surface defence must be prioritized to minimize damage from an incoming impactor asteroid.</"
"smallcaps>"
msgstr ""
"Um local em perigo com abundantes recursos alimentares.\n"
"\n"
"<smallcaps>A biodiversidade de Relica torna a produção confiável de alimentos mais acessível para novas colônias. Materiais "
"de construção e combustíveis também são abundantes. A defesa da superfície deve ser priorizada para minimizar os danos de "
"um asteroide impactante que se aproxima.</smallcaps>"

#. STRINGS.WORLDS.PREHISTORICBASEGAME.NAME
msgctxt "STRINGS.WORLDS.PREHISTORICBASEGAME.NAME"
msgid "Relica"
msgstr "Relica"

#. STRINGS.WORLDS.PREHISTORICCLASSIC.DESCRIPTION
msgctxt "STRINGS.WORLDS.PREHISTORICCLASSIC.DESCRIPTION"
msgid ""
"An endangered starting world with abundant food resources.\n"
"\n"
"<smallcaps>Relica's biodiversity makes reliable food production more attainable for new colonies. Construction materials "
"and fuels are also ample. Surface defence must be prioritized to minimize damage from an incoming impactor asteroid.</"
"smallcaps>"
msgstr ""
"Um mundo inicial em perigo com abundantes recursos alimentares.\n"
"\n"
"<smallcaps>A biodiversidade de Relica torna a produção confiável de alimentos mais acessível para novas colônias. Materiais "
"de construção e combustíveis também são abundantes. A defesa da superfície deve ser priorizada para minimizar os danos de "
"um asteroide impactante que se aproxima.</smallcaps>"

#. STRINGS.WORLDS.PREHISTORICCLASSIC.NAME
msgctxt "STRINGS.WORLDS.PREHISTORICCLASSIC.NAME"
msgid "Relica Asteroid"
msgstr "Asteroide Relica"

#. STRINGS.WORLDS.PREHISTORICMIXING.DESCRIPTION
msgctxt "STRINGS.WORLDS.PREHISTORICMIXING.DESCRIPTION"
msgid ""
"A fragment of a prehistoric starting world.\n"
"\n"
"<smallcaps>Its biodiversity makes reliable food production more attainable for new colonies. Construction materials and "
"fuels are also ample. </smallcaps>"
msgstr ""
"Um fragmento de um mundo inicial pré-histórico.\n"
"\n"
"<smallcaps>Sua biodiversidade torna a produção confiável de alimentos mais acessível para novas colônias. Materiais de "
"construção e combustíveis também são abundantes.</smallcaps>"

#. STRINGS.WORLDS.PREHISTORICMIXING.NAME
msgctxt "STRINGS.WORLDS.PREHISTORICMIXING.NAME"
msgid "Relica Fragment"
msgstr "Fragmento de Relica"

#. STRINGS.WORLDS.PREHISTORICSHATTERED.DESCRIPTION
msgctxt "STRINGS.WORLDS.PREHISTORICSHATTERED.DESCRIPTION"
msgid ""
"A geyser-rich location that will be struck by an impactor asteroid almost immediately.\n"
"\n"
"<smallcaps>Impact-related damage will trigger the eruption of this world's unusually high number of geysers. Colonies that "
"survive the volatile aftermath will reap the benefits of the abundant natural resources released into the environment.</"
"smallcaps>"
msgstr ""
"Um local rico em gêiseres que será atingido por um asteroide de impacto quase imediatamente.\n"
"\n"
"<smallcaps>Os danos relacionados ao impacto desencadearão a erupção do número extraordinariamente alto de gêiseres deste "
"mundo. As colônias que sobreviverem às consequências voláteis colherão os benefícios dos abundantes recursos naturais "
"liberados no ambiente.</smallcaps>"

#. STRINGS.WORLDS.PREHISTORICSHATTERED.NAME
msgctxt "STRINGS.WORLDS.PREHISTORICSHATTERED.NAME"
msgid "RelicAAAA<sup>AAAGHH</sup>"
msgstr "RelicAAAA<sup>AAAGHH</sup>"

#. STRINGS.WORLDS.PREHISTORICSPACEDOUT.DESCRIPTION
msgctxt "STRINGS.WORLDS.PREHISTORICSPACEDOUT.DESCRIPTION"
msgid ""
"A smaller endangered starting world with abundant food resources.\n"
"\n"
"<smallcaps>Relica's biodiversity makes reliable food production more attainable for new colonies. Construction materials "
"and fuels are also ample. Surface defence must be prioritized to minimize damage from an incoming impactor asteroid.</"
"smallcaps>"
msgstr ""
"Um mundo inicial menor em perigo, com abundantes recursos alimentares.\n"
"\n"
"<smallcaps>A biodiversidade de Relica torna a produção confiável de alimentos mais acessível para novas colônias. Materiais "
"de construção e combustíveis também são abundantes. A defesa da superfície deve ser priorizada para minimizar os danos de "
"um asteroide impactante que se aproxima.</smallcaps>"

#. STRINGS.WORLDS.PREHISTORICSPACEDOUT.NAME
msgctxt "STRINGS.WORLDS.PREHISTORICSPACEDOUT.NAME"
msgid "Relica Minor"
msgstr "Relica Menor"

#. STRINGS.WORLDS.REGOLITHMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.REGOLITHMOONLET.DESCRIPTION"
msgid ""
"A small, cold world with plenty of craters.\n"
"\n"
"<smallcaps>Regolith Asteroids have frequent meteor showers and are chock-full of Regolith, an incredibly useful filtration "
"material. </smallcaps>"
msgstr ""
"Um mundo pequeno e frio com muitas crateras.\n"
"\n"
"<smallcaps>Os Asteroides Regolitos têm chuvas de meteoros frequentes e estão repletos de Regolito, um material de filtração "
"incrivelmente útil.</smallcaps>"

#. STRINGS.WORLDS.REGOLITHMOONLET.NAME
msgctxt "STRINGS.WORLDS.REGOLITHMOONLET.NAME"
msgid "Regolith Asteroid"
msgstr "Asteroide Regolito"

#. STRINGS.WORLDS.SANDSTONE_DEFAULT.DESCRIPTION
msgctxt "STRINGS.WORLDS.SANDSTONE_DEFAULT.DESCRIPTION"
msgid ""
"A promising location with a balanced variety of resources.\n"
"\n"
"<smallcaps>Terra meets all the requirements for Duplicant life and holds no surprises. It's an ideal location for a first "
"attempt at establishing a colony.</smallcaps>\n"
"\n"
msgstr ""
"Um local promissor com uma variedade equilibrada de recursos.\n"
"\n"
"<smallcaps>Terra atende a todos os requisitos para a vida de Duplicantes e não guarda surpresas. É um local ideal para uma "
"primeira tentativa de estabelecer uma colônia.</smallcaps>\n"

#. STRINGS.WORLDS.SANDSTONE_DEFAULT.NAME
msgctxt "STRINGS.WORLDS.SANDSTONE_DEFAULT.NAME"
msgid "Terra"
msgstr "Terra"

#. STRINGS.WORLDS.SANDSTONE_FROZEN.DESCRIPTION
msgctxt "STRINGS.WORLDS.SANDSTONE_FROZEN.DESCRIPTION"
msgid ""
"A frigid location marked by inhospitably low temperatures throughout.\n"
"\n"
"<smallcaps>Rime's low temperatures will make finding water and establishing farms or ranches problematic. However, the wide "
"spectrum of minerals and cool environment could lead to thriving industry.</smallcaps>\n"
"\n"
msgstr ""
"Um local frígido marcado por temperaturas inóspitas por toda parte.\n"
"\n"
"<smallcaps>As baixas temperaturas do Asteroide Escarchado tornarão problemático encontrar água e estabelecer fazendas ou "
"estábulos. No entanto, o amplo espectro de minerais e o ambiente fresco podem levar a uma indústria próspera.</smallcaps>\n"
"\n"

#. STRINGS.WORLDS.SANDSTONE_FROZEN.NAME
msgctxt "STRINGS.WORLDS.SANDSTONE_FROZEN.NAME"
msgid "Rime"
msgstr "Escarchado"

#. STRINGS.WORLDS.STRANGE_ASTEROID_KF23.DESCRIPTION
msgctxt "STRINGS.WORLDS.STRANGE_ASTEROID_KF23.DESCRIPTION"
msgid ""
"A tilted world, at once strange and...strangely familiar. Its singular terrain is consistent across all universes.\n"
"\n"
"This resistance to the fluidity of temporal shifts has the cosmos buzzing, as individual colonies compare notes on "
"successes, failures and the bizarre redistribution of resources.\n"
"\n"
"<smallcaps>Released for Klei Fest 2023."
msgstr ""
"Um mundo inclinado, ao mesmo tempo estranho e... estranhamente familiar. Seu terreno singular é consistente em todos os "
"universos.\n"
"\n"
"Esta resistência à fluidez das mudanças temporais faz o cosmos vibrar, à medida que as colónias individuais comparam notas "
"sobre sucessos, fracassos e a bizarra redistribuição de recursos.\n"
"\n"
"<smallcaps>Lançado para o Klei Fest 2023."

#. STRINGS.WORLDS.STRANGE_ASTEROID_KF23.NAME
msgctxt "STRINGS.WORLDS.STRANGE_ASTEROID_KF23.NAME"
msgid "Skewed Asteroid"
msgstr "Asteroide Inclinado"

#. STRINGS.WORLDS.STRANGERICHSANDSTONE.DESCRIPTION
msgctxt "STRINGS.WORLDS.STRANGERICHSANDSTONE.DESCRIPTION"
msgid ""
"A petite rocky world with an oily core.\n"
"\n"
"<smallcaps>Though it looks deceptively nondescript from space, readings from this planet suggest a strong fuel source lurks "
"somewhere beneath the surface.</smallcaps>"
msgstr ""
"Um pequeno mundo rochoso com um núcleo oleoso.\n"
"\n"
"<smallcaps>Embora pareça enganosamente indefinido visto do espaço, as leituras deste planeta sugerem que uma forte fonte de "
"combustível se escondem em algum lugar abaixo da superfície.</smallcaps>"

#. STRINGS.WORLDS.STRANGERICHSANDSTONE.NAME
msgctxt "STRINGS.WORLDS.STRANGERICHSANDSTONE.NAME"
msgid "Rocky Asteroid"
msgstr "Asteroide Rochoso"

#. STRINGS.WORLDS.SULFURMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.SULFURMOONLET.DESCRIPTION"
msgid ""
"A smaller landmass with a distinct odor.\n"
"\n"
"<smallcaps>Brimstonia Asteroids contain an abundant supply of Sulfur.</smallcaps>"
msgstr ""
"Uma massa de terra menor com um odor distinto.\n"
"\n"
"<smallcaps>Os Asteroide Sulfúreo contêm um suprimento abundante de enxofre.</smallcaps>"

#. STRINGS.WORLDS.SULFURMOONLET.NAME
msgctxt "STRINGS.WORLDS.SULFURMOONLET.NAME"
msgid "Brimstonia Asteroid"
msgstr "Asteroide Sulfúreo"

