msgctxt "STRINGS.CODEX.A0_PROPFACILITYDISPLAY1.TITLE"
msgid "Printing Pod Promo"
msgstr "Promoção do Módulo Duplicador"

#. STRINGS.CODEX.A0_PROPFACILITYDISPLAY2.BODY.CONTAINER1
msgctxt "STRINGS.CODEX.A0_PROPFACILITYDISPLAY2.BODY.CONTAINER1"
msgid ""
"Bring your mining operations into the twenty-third century with new Gravitas personal excavators.\n"
"\n"
"Improved particle condensers reduce raw volume for more efficient product shipping - and that's good for your bottom line.\n"
"\n"
"Licensed for industrial use only, resale of Gravitas equipment may carry a fine of up to $200,000 under the Global "
"Restoration Act."
msgstr ""
"Leve suas operações de mineração para o século 23 com os novos escavadores pessoais da Gravitas.\n"
"\n"
"Condensadores de partículas aprimorados reduzem o volume bruto para um envio de produtos mais eficiente - e isso é bom para "
"o seu resultado final.\n"
"\n"
"Licenciado para uso industrial apenas, a revenda de equipamentos da Gravitas pode resultar em uma multa de até $200.000 sob "
"o Ato de Restauração Global."

