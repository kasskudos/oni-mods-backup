msgctxt "STRINGS.CREATURES.PLANT_MUTATIONS.MODERATELYTIGHT.NAME"
msgid "Specialized"
msgstr "Especializado"

#. STRINGS.CREATURES.PLANT_MUTATIONS.NONE.NAME
msgctxt "STRINGS.CREATURES.PLANT_MUTATIONS.NONE.NAME"
msgid "Original"
msgstr "Original"

#. STRINGS.CREATURES.PLANT_MUTATIONS.PLANT_NAME_FMT
msgctxt "STRINGS.CREATURES.PLANT_MUTATIONS.PLANT_NAME_FMT"
msgid "{PlantName} ({MutationList})"
msgstr "{PlantName} ({MutationList})"

#. STRINGS.CREATURES.PLANT_MUTATIONS.ROTTENHEAPS.DESCRIPTION
msgctxt "STRINGS.CREATURES.PLANT_MUTATIONS.ROTTENHEAPS.DESCRIPTION"
msgid "Plants with this mutation grow extremely quickly, though the produce they make is sometimes questionable."
msgstr "Plantas com esta mutação crescem extremamente rápido, embora os produtos que produzem sejam às vezes questionáveis."

#. STRINGS.CREATURES.PLANT_MUTATIONS.ROTTENHEAPS.NAME
msgctxt "STRINGS.CREATURES.PLANT_MUTATIONS.ROTTENHEAPS.NAME"
msgid "Exuberant"
msgstr "Exuberante"

#. STRINGS.CREATURES.PLANT_MUTATIONS.SLOWBURN.DESCRIPTION
msgctxt "STRINGS.CREATURES.PLANT_MUTATIONS.SLOWBURN.DESCRIPTION"
msgid "These plants grow almost as slow as their wild cousins, but also consume almost no fertilizer."
msgstr "Essas plantas crescem quase tão devagar quanto seus primos selvagens, mas também consomem quase nenhum fertilizante."

#. STRINGS.CREATURES.PLANT_MUTATIONS.SLOWBURN.NAME
msgctxt "STRINGS.CREATURES.PLANT_MUTATIONS.SLOWBURN.NAME"
msgid "Wildish"
msgstr "Selvagem"

#. STRINGS.CREATURES.PLANT_MUTATIONS.SUNNYSPEED.DESCRIPTION
msgctxt "STRINGS.CREATURES.PLANT_MUTATIONS.SUNNYSPEED.DESCRIPTION"
msgid "This mutation provides the plant with sun-collecting leaves, allowing faster growth."
msgstr "Esta mutação fornece à planta folhas coletoras de sol, permitindo um crescimento mais rápido."

#. STRINGS.CREATURES.PLANT_MUTATIONS.SUNNYSPEED.NAME
msgctxt "STRINGS.CREATURES.PLANT_MUTATIONS.SUNNYSPEED.NAME"
msgid "Leafy"
msgstr "Frondoso"

#. STRINGS.CREATURES.PLANT_MUTATIONS.UNIDENTIFIED
msgctxt "STRINGS.CREATURES.PLANT_MUTATIONS.UNIDENTIFIED"
msgid "Unidentified Subspecies"
msgstr "Subespécie Não Identificada"

#. STRINGS.CREATURES.PLANT_MUTATIONS.UNIDENTIFIED_DESC
msgctxt "STRINGS.CREATURES.PLANT_MUTATIONS.UNIDENTIFIED_DESC"
msgid ""
"This seed must be identified at the <link=\"GENETICANALYSISSTATION\">Botanical Analyzer</link> before it can be planted."
msgstr ""
"Esta semente deve ser identificada no <link=\"GENETICANALYSISSTATION\">Analisador Botânico</link> antes de ser plantada."

#. STRINGS.CREATURES.POOP.PLANT_POOP_STATION_WILD
msgctxt "STRINGS.CREATURES.POOP.PLANT_POOP_STATION_WILD"
msgid "Fertilized"
msgstr "Fertilizado"

#. STRINGS.CREATURES.SPECIES.ALGAE_STEGO.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ALGAE_STEGO.BABY.DESC"
msgid ""
"A slightly moist Blum Lumb baby.\n"
"\n"
"In time, it will grow into a stompy <link=\"ALGAESTEGO\">Blum Lumb</link>."
msgstr ""
"Um bebê Estegubim ligeiramente úmido.\n"
"\n"
"Com o tempo, ele crescerá e se tornará um <link=\"ALGAESTEGO\">Estegublum</link> pisoteador."

#. STRINGS.CREATURES.SPECIES.ALGAE_STEGO.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ALGAE_STEGO.BABY.NAME"
msgid "<link=\"ALGAESTEGO\">Blumblet</link>"
msgstr "<link=\"ALGAESTEGO\">Estegubim</link>"

#. STRINGS.CREATURES.SPECIES.ALGAE_STEGO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ALGAE_STEGO.DESC"
msgid ""
"Blum Lumbs are non-hostile critters that produce <link=\"ALGAE\">Algae</link>.\n"
"\n"
"When they stomp heavily near <link=\"PLANTS\">plants</link>, the commotion causes harvestable items to fall to the ground."
msgstr ""
"Estegubluns são criaturas não hostis que produzem <link=\"ALGAE\">Algas</link>.\n"
"\n"
"Quando pisoteiam com força perto de <link=\"PLANTS\">plantas</link>, a agitação faz com que itens colhíveis caiam no chão."

#. STRINGS.CREATURES.SPECIES.ALGAE_STEGO.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.ALGAE_STEGO.EGG_NAME"
msgid "<link=\"ALGAESTEGO\">Blum Lumb Egg</link>"
msgstr "<link=\"ALGAESTEGO\">Ovo de Estegublum</link>"

#. STRINGS.CREATURES.SPECIES.ALGAE_STEGO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ALGAE_STEGO.NAME"
msgid "<link=\"ALGAESTEGO\">Blum Lumb</link>"
msgstr "<link=\"ALGAESTEGO\">Estegublum</link>"

#. STRINGS.CREATURES.SPECIES.BASICFABRICMATERIALPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BASICFABRICMATERIALPLANT.DESC"
msgid ""
"Thimble Reeds produce indescribably soft <link=\"BASICFABRIC\">Reed Fiber</link> for <link=\"EQUIPMENT\">Clothing</link> "
"production."
msgstr ""
"Juncos produzem uma <link=\"BASICFABRIC\">Fibra de Junco</link> indescrivivelmente macia para a produção de "
"<link=\"EQUIPMENT\">Roupas</link>."

#. STRINGS.CREATURES.SPECIES.BASICFABRICMATERIALPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.BASICFABRICMATERIALPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"BASICFABRIC\">Reed Fiber</link>."
msgstr "Esta planta produz <link=\"BASICFABRIC\">Fibra de Junco</link>."

#. STRINGS.CREATURES.SPECIES.BASICFABRICMATERIALPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BASICFABRICMATERIALPLANT.NAME"
msgid "<link=\"BASICFABRICPLANT\">Thimble Reed</link>"
msgstr "<link=\"BASICFABRICPLANT\">Junco</link>"

#. STRINGS.CREATURES.SPECIES.BASICFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BASICFORAGEPLANTPLANTED.DESC"
msgid "Muckroots are incapable of propagating but can be harvested for a single <link=\"FOOD\">Food</link> serving."
msgstr "Tuberas são incapazes de se propagar, mas podem ser colhidas para uma única porção de <link=\"FOOD\">Alimento</link>."

#. STRINGS.CREATURES.SPECIES.BASICFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BASICFORAGEPLANTPLANTED.NAME"
msgid "<link=\"BASICFORAGEPLANTPLANTED\">Buried Muckroot</link>"
msgstr "<link=\"BASICFORAGEPLANTPLANTED\">Tubera Enterrada</link>"

#. STRINGS.CREATURES.SPECIES.BASICSINGLEHARVESTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BASICSINGLEHARVESTPLANT.DESC"
msgid ""
"Mealwoods produce <link=\"BASICPLANTFOOD\">Meal Lice</link>, an oddly wriggly grain that can be harvested for "
"<link=\"FOOD\">Food</link>."
msgstr ""
"Raquifloras produzem <link=\"BASICPLANTFOOD\">Raquigrao</link>, um grão estranhamente ondulado que pode ser colhido para "
"<link=\"FOOD\">Alimento</link>."

#. STRINGS.CREATURES.SPECIES.BASICSINGLEHARVESTPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.BASICSINGLEHARVESTPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"BASICPLANTFOOD\">Meal Lice</link>."
msgstr "Esta planta produz <link=\"BASICPLANTFOOD\">Raquigrao</link> comestível."

#. STRINGS.CREATURES.SPECIES.BASICSINGLEHARVESTPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BASICSINGLEHARVESTPLANT.NAME"
msgid "<link=\"BASICSINGLEHARVESTPLANT\">Mealwood</link>"
msgstr "<link=\"BASICSINGLEHARVESTPLANT\">Raquiflora</link>"

#. STRINGS.CREATURES.SPECIES.BEAN_PLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BEAN_PLANT.DESC"
msgid "Nosh Sprouts thrive in colder climates and produce edible <link=\"BEANPLANTSEED\">Nosh Beans</link>."
msgstr "A Brotossoja prospera em climas mais frios e produzem <link=\"BEAN\">Grãos de Brotossoja</link> comestíveis."

#. STRINGS.CREATURES.SPECIES.BEAN_PLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.BEAN_PLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"BEANPLANTSEED\">Nosh Beans</link>."
msgstr "Essa planta produz <link=\"BEANPLANTSEED\">Grão de Brotossoja</link>."

#. STRINGS.CREATURES.SPECIES.BEAN_PLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BEAN_PLANT.NAME"
msgid "<link=\"BEANPLANT\">Nosh Sprout</link>"
msgstr "<link=\"BEANPLANT\">Brotossoja</link>"

#. STRINGS.CREATURES.SPECIES.BEE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BEE.BABY.DESC"
msgid ""
"A harmless little Beetiny.\n"
"\n"
"In time, it will mature into a vicious adult <link=\"BEE\">Beeta</link>."
msgstr ""
"Uma pequena Abetinha inofensiva.\n"
"\n"
"Com o tempo, ela amadurecerá em uma <link=\"BEE\">Abeta</link> adulta e perigosa."

#. STRINGS.CREATURES.SPECIES.BEE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BEE.BABY.NAME"
msgid "<link=\"BEE\">Beetiny</link>"
msgstr "<link=\"BEE\">Abetinha</link>"

#. STRINGS.CREATURES.SPECIES.BEE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BEE.DESC"
msgid ""
"Beetas are hostile critters that thrive in <link=\"RADIATION\">Radioactive</link> environments.\n"
"\n"
"They commonly gather <link=\"URANIUMORE\">Uranium Ore</link> for their <link=\"BEEHIVE\">Beeta Hives</link> to produce "
"<link=\"ENRICHEDURANIUM\">Enriched Uranium</link>."
msgstr ""
"Abetas são criaturas hostis que prosperam em ambientes <link=\"RADIATION\">Radioativos</link>.\n"
"\n"
"Elas geralmente coletam <link=\"URANIUMORE\">Minério de Urânio</link> para suas <link=\"BEEHIVE\">Colmeias de Abeta</link> "
"produzirem <link=\"ENRICHEDURANIUM\">Urânio Enriquecido</link>."

#. STRINGS.CREATURES.SPECIES.BEE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BEE.NAME"
msgid "<link=\"BEE\">Beeta</link>"
msgstr "<link=\"BEE\">Abeta</link>"

#. STRINGS.CREATURES.SPECIES.BLUE_GRASS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BLUE_GRASS.DESC"
msgid ""
"Alveo Veras consume <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and <link=\"ICE\">Ice</link>, and form harvestable "
"<link=\"OXYROCK\">Oxylite</link> deposits."
msgstr ""
"Pulmoveras consomem <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link> e <link=\"ICE\">Gelo</link>, e formam depósitos "
"colhíveis de <link=\"OXYROCK\">Oxílito</link> deposits."

#. STRINGS.CREATURES.SPECIES.BLUE_GRASS.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.BLUE_GRASS.DOMESTICATEDDESC"
msgid "This plant produces <link=\"OXYROCK\">Oxylite</link>."
msgstr "Essa planta produz <link=\"OXYROCK\">Oxílito</link>."

#. STRINGS.CREATURES.SPECIES.BLUE_GRASS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BLUE_GRASS.NAME"
msgid "<link=\"BLUEGRASS\">Alveo Vera</link>"
msgstr "<link=\"BLUEGRASS\">Pulmovera</link>"

#. STRINGS.CREATURES.SPECIES.BULBLOOM.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BULBLOOM.DESC"
msgid "Bulblooms emit a bioluminescent <link=\"LIGHT\">Light</link> that enhances <link=\"DECOR\">Decor</link>."
msgstr "Bulbolumes emitem uma <link=\"LIGHT\">Luz</link> bioluminescente que aumenta a <link=\"DECOR\">Decor</link>."

#. STRINGS.CREATURES.SPECIES.BULBLOOM.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.BULBLOOM.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link> and produces <link=\"LIGHT\">Light</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decor</link> do ambiente e produz <link=\"LIGHT\">Luz</link>."

#. STRINGS.CREATURES.SPECIES.BULBLOOM.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.BULBLOOM.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "Bônus de Crescimento"

#. STRINGS.CREATURES.SPECIES.BULBLOOM.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BULBLOOM.NAME"
msgid "<link=\"BULBLOOM\">Bulbloom</link>"
msgstr "<link=\"BULBLOOM\">Bulbolume</link>"

#. STRINGS.CREATURES.SPECIES.BULBLOOM.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.BULBLOOM.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "Penalidade por Murchar"

#. STRINGS.CREATURES.SPECIES.BULBPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BULBPLANT.DESC"
msgid "Buddy Buds are leafy plants that have a positive effect on <link=\"MORALE\">Morale</link>, much like a friend."
msgstr ""
"Botões Camaradas são plantas frondosas que têm um efeito positivo no <link=\"MORALE\">Moral</link>, assim como um amigo."

#. STRINGS.CREATURES.SPECIES.BULBPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.BULBPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decor</link> do ambiente."

#. STRINGS.CREATURES.SPECIES.BULBPLANT.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.BULBPLANT.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "Bônus de Crescimento"

#. STRINGS.CREATURES.SPECIES.BULBPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BULBPLANT.NAME"
msgid "<link=\"BULBPLANT\">Buddy Bud</link>"
msgstr "<link=\"BULBPLANT\">Botão Camarada</link>"

#. STRINGS.CREATURES.SPECIES.BULBPLANT.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.BULBPLANT.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "Penalidade por Murchar"

#. STRINGS.CREATURES.SPECIES.BUTTERFLY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BUTTERFLY.DESC"
msgid ""
"Mimikas are airborne organisms that help nearby <link=\"PLANTS\">Plants</link> grow more quickly.\n"
"\n"
"When its leaves dry up, it will harden into <link=\"BUTTERFLYPLANTSEED\">Mimillet</link>."
msgstr ""
"Mímicas são organismos aéreos que ajudam <link=\"PLANTS\">Plantas</link> próximas a crescerem mais rapidamente.\n"
"\n"
"Quando suas folhas secam, ela endurece e se transforma em <link=\"BUTTERFLYPLANT\">Mimilheto</link>."

#. STRINGS.CREATURES.SPECIES.BUTTERFLY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BUTTERFLY.NAME"
msgid "<link=\"BUTTERFLY\">Mimika</link>"
msgstr "<link=\"BUTTERFLY\">Mímica</link>"

#. STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.DESC"
msgid ""
"Mimika Buds are self-harvesting plants that produce airborne <link=\"BUTTERFLY\">Mimikas</link>.\n"
"\n"
"<link=\"BUTTERFLY\">Mimikas</link> boost growth for nearby <link=\"PLANTS\">Plants</link> before hardening into "
"<link=\"BUTTERFLYPLANTSEED\">Mimillet</link>."
msgstr ""
"Botões de Mímica são plantas de auto-colheita que produzem <link=\"BUTTERFLY\">Mímicas</link>.\n"
"\n"
"<link=\"BUTTERFLY\">Mímicas</link> impulsionam o crescimento de <link=\"PLANTS\">Plantas</link> próximas antes de "
"endurecerem e se transformarem em <link=\"BUTTERFLYPLANT\">Mimilheto</link>."

#. STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"BUTTERFLY\">Mimikas</link>."
msgstr "Esta planta produz <link=\"BUTTERFLY\">Mímicas</link>."

#. STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.BUTTERFLYPLANT.NAME"
msgid "<link=\"BUTTERFLYPLANT\">Mimika Bud</link>"
msgstr "<link=\"BUTTERFLYPLANT\">Botão de Mímica</link>"

#. STRINGS.CREATURES.SPECIES.CACTUSPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CACTUSPLANT.DESC"
msgid ""
"Joyas are <link=\"DECOR\">Decorative</link> <link=\"PLANTS\">Plants</link> that are colloquially said to make gardeners "
"\"jump for joy\"."
msgstr ""
"Cactos são <link=\"DECOR\">Decorativas</link> <link=\"PLANTS\">Plantas</link> que, coloquialmente, dizem fazer os "
"jardineiros \"saltarem de alegria\"."

#. STRINGS.CREATURES.SPECIES.CACTUSPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.CACTUSPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decor</link> do ambiente."

#. STRINGS.CREATURES.SPECIES.CACTUSPLANT.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.CACTUSPLANT.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "Bônus de Crescimento"

#. STRINGS.CREATURES.SPECIES.CACTUSPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CACTUSPLANT.NAME"
msgid "<link=\"CACTUSPLANT\">Jumping Joya</link>"
msgstr "<link=\"CACTUSPLANT\">Cacto Saltitante</link>"

#. STRINGS.CREATURES.SPECIES.CACTUSPLANT.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.CACTUSPLANT.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "Penalidade por Murchar"

#. STRINGS.CREATURES.SPECIES.CARROTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CARROTPLANT.DESC"
msgid "Plume Squashes are sweet, nutrient-rich tubers that can be harvested for <link=\"FOOD\">Food</link>."
msgstr ""
"Abóboras Plumosas são tubérculos doces e ricos em nutrientes, que podem ser colhidos como <link=\"FOOD\">Alimento</link>."

#. STRINGS.CREATURES.SPECIES.CARROTPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.CARROTPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"CARROT\">Plume Squash</link>."
msgstr "Essa planta produz <link=\"CARROT\">Abóbora Plumosa</link> comestível."

#. STRINGS.CREATURES.SPECIES.CARROTPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CARROTPLANT.NAME"
msgid "<link=\"CARROTPLANT\">Plume Squash Plant</link>"
msgstr "<link=\"CARROTPLANT\">Abóbora Plumosa</link>"

#. STRINGS.CREATURES.SPECIES.CHAMELEON.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.BABY.DESC"
msgid ""
"A wide-eyed little Dartlet.\n"
"\n"
"Someday it will mature into a fully grown <link=\"CHAMELEON\">Dartle</link>."
msgstr ""
"Um pequeno Darteco de olhos arregalados.\n"
"\n"
"Algum dia ele irá se tornar um <link=\"CHAMELEON\">Darteco</link> adulto."

#. STRINGS.CREATURES.SPECIES.CHAMELEON.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.BABY.NAME"
msgid "<link=\"CHAMELEON\">Dartlet</link>"
msgstr "<link=\"CHAMELEON\">Dartequinho</link>"

#. STRINGS.CREATURES.SPECIES.CHAMELEON.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.DESC"
msgid ""
"Dartles are non-hostile critters who eat <link=\"DEWDRIP\">Dewdrips</link> and excrete <link=\"BLEACHSTONE\">Bleach Stone</"
"link> and <link=\"CHLORINEGAS\">Chlorine Gas</link>.\n"
"\n"
"They are preyed on by <link=\"RAPTOR\">Rhexes</link>."
msgstr ""
"Dartecos são criaturas não hostis que comem <link=\"DEWDRIP\">Gotas de Orvalho</link> e excretam "
"<link=\"BLEACHSTONE\">Lixívia</link> e <link=\"CHLORINEGAS\">Gás de Cloro</link>.\n"
"\n"
"Eles são predados pelos <link=\"RAPTOR\">Rexes</link>."

#. STRINGS.CREATURES.SPECIES.CHAMELEON.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.EGG_NAME"
msgid "<link=\"CHAMELEON\">Dartle Egg</link>"
msgstr "<link=\"CHAMELEON\">Ovo de Darteco</link>"

#. STRINGS.CREATURES.SPECIES.CHAMELEON.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CHAMELEON.NAME"
msgid "<link=\"CHAMELEON\">Dartle</link>"
msgstr "<link=\"CHAMELEON\">Darteco</link>"

#. STRINGS.CREATURES.SPECIES.CHLORINEGEYSER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CHLORINEGEYSER.DESC"
msgid "A highly pressurized geyser that periodically erupts with <link=\"CHLORINEGAS\">Chlorine Gas</link>."
msgstr "Um Gêiser altamente pressurizado que emite periodicamente <link=\"CHLORINEGAS\">Cloro</link>."

#. STRINGS.CREATURES.SPECIES.CHLORINEGEYSER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CHLORINEGEYSER.NAME"
msgid "<link=\"GEYSERGENERICCHLORINEGAS\">Chlorine Geyser</link>"
msgstr "<link=\"GEYSERGENERICCHLORINEGAS\">Gêiser de Cloro</link>"

#. STRINGS.CREATURES.SPECIES.CLAM.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CLAM.DESC"
msgid ""
"Clampums are aquatic bivalves that transform <link=\"SAND\">Sand</link> into <link=\"PEARL\">Pearl</link>.\n"
"\n"
"Due to their size, they can only be planted in a <link=\"WIDEFARMTILE\">Wide Hydroponic Farm</link>."
msgstr ""
"Bivalvos são organismos aquáticos que transformam <link=\"SAND\">Areia</link> em <link=\"PEARL\">Pérola</link>.\n"
"\n"
"Devido ao seu tamanho, só podem ser plantados em uma <link=\"WIDEFARMTILE\">Fazenda Hidropônica Larga</link>."

#. STRINGS.CREATURES.SPECIES.CLAM.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.CLAM.DOMESTICATEDDESC"
msgid "This organism produces <link=\"PEARL\">Pearl</link>."
msgstr "Este organismo produz <link=\"PEARL\">Pérola</link>."

#. STRINGS.CREATURES.SPECIES.CLAM.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CLAM.NAME"
msgid "<link=\"CLAM\">Clampum</link>"
msgstr "<link=\"CLAM\">Bivalvo</link>"

#. STRINGS.CREATURES.SPECIES.COLDBREATHER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.COLDBREATHER.DESC"
msgid ""
"Wheezeworts can be planted in <link=\"PLANTERBOX\">Planter Boxes</link>, <link=\"FARMTILE\">Farm Tiles</link> or "
"<link=\"HYDROPONICFARM\">Hydroponic Farms</link>, and absorb <link=\"HEAT\">Heat</link> by respiring through their porous "
"outer membranes."
msgstr ""
"Criofloras podem ser plantadas em <link=\"PLANTERBOX\">Jardineiras</link>, <link=\"FARMTILE\">Bloco de Horta</link> ou "
"<link=\"HYDROPONICFARM\">Horta Hidropônica</link> e absorvem <link=\"HEAT\">Calor</link>, respirando através de suas "
"membranas porosas."

#. STRINGS.CREATURES.SPECIES.COLDBREATHER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.COLDBREATHER.DOMESTICATEDDESC"
msgid "This plant absorbs <link=\"HEAT\">Heat</link>."
msgstr "Essa planta absorve <link=\"HEAT\">Calor</link>."

#. STRINGS.CREATURES.SPECIES.COLDBREATHER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.COLDBREATHER.NAME"
msgid "<link=\"COLDBREATHER\">Wheezewort</link>"
msgstr "<link=\"COLDBREATHER\">Crioflora</link>"

#. STRINGS.CREATURES.SPECIES.COLDBREATHERCLUSTER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.COLDBREATHERCLUSTER.DESC"
msgid ""
"Wheezeworts can be planted in <link=\"PLANTERBOX\">Planter Boxes</link>, <link=\"FARMTILE\">Farm Tiles</link> or "
"<link=\"HYDROPONICFARM\">Hydroponic Farms</link>, and absorb <link=\"HEAT\">Heat</link> by respiring through their porous "
"outer membranes."
msgstr ""
"Criofloras podem ser plantadas em <link=\"PLANTERBOX\">Jardineiras</link>, <link=\"FARMTILE\">Bloco de Horta</link> ou "
"<link=\"HYDROPONICFARM\">Horta Hidropônica</link>, absorvem <link=\"HEAT\">Calor</link> respirando através de suas "
"membranas porosas."

#. STRINGS.CREATURES.SPECIES.COLDBREATHERCLUSTER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.COLDBREATHERCLUSTER.DOMESTICATEDDESC"
msgid "This plant absorbs <link=\"HEAT\">Heat</link>."
msgstr "Essa planta absorve <link=\"HEAT\">Calor</link>."

#. STRINGS.CREATURES.SPECIES.COLDBREATHERCLUSTER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.COLDBREATHERCLUSTER.NAME"
msgid "<link=\"COLDBREATHERCLUSTER\">Wheezewort</link>"
msgstr "<link=\"COLDBREATHERCLUSTER\">Crioflora</link>"

#. STRINGS.CREATURES.SPECIES.COLDWHEAT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.COLDWHEAT.DESC"
msgid ""
"Sleet Wheat produces <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>, a chilly grain that can be processed into "
"<link=\"FOOD\">Food</link>."
msgstr ""
"Trigo Boreal produz <link=\"COLDWHEATSEED\">Grão de Trigo Boreal</link>, um grão gelado que pode ser processado em "
"<link=\"FOOD\">Alimentos</link>."

#. STRINGS.CREATURES.SPECIES.COLDWHEAT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.COLDWHEAT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>."
msgstr "Esta planta produz <link=\"COLDWHEATSEED\">Grão de Trigo Boreal</link> comestível."

#. STRINGS.CREATURES.SPECIES.COLDWHEAT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.COLDWHEAT.NAME"
msgid "<link=\"COLDWHEAT\">Sleet Wheat</link>"
msgstr "<link=\"COLDWHEAT\">Trigo Boreal</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.BABY.DESC"
msgid ""
"A snippy little Pokeshell Spawn.\n"
"\n"
"In time it will mature into a fully grown <link=\"CRAB\">Pokeshell</link>."
msgstr ""
"Um pequeno Caranguejinho Calcário irritadiço.\n"
"\n"
"Com o tempo, ela amadurecerá em um <link=\"CRAB\">Caranguejo Calcário</link> totalmente crescido."

#. STRINGS.CREATURES.SPECIES.CRAB.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.BABY.NAME"
msgid "<link=\"CRAB\">Pokeshell Spawn</link>"
msgstr "<link=\"CRAB\">Caranguejinho Calcário</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.DESC"
msgid ""
"Pokeshells are nonhostile critters unless their eggs are nearby.\n"
"\n"
"They eat <link=\"TOXICSAND\">Polluted Dirt</link> and <link=\"COMPOST\">Rot Piles</link>.\n"
"\n"
"The shells they leave behind after molting can be crushed into <link=\"LIME\">Lime</link>."
msgstr ""
"Caranguejos Calcários são criaturas não hostis, a menos que seus ovos estejam por perto.\n"
"\n"
"Eles comem <link=\"TOXICSAND\">Terra Poluída</link> e <link=\"COMPOST\">Pilhas Podres</link>.\n"
"\n"
"As carapaças que deixam para trás após a muda podem ser trituradas em <link=\"LIME\">Cal</link>."

#. STRINGS.CREATURES.SPECIES.CRAB.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.EGG_NAME"
msgid "<link=\"CRAB\">Pokeshell Roe</link>"
msgstr "<link=\"CRAB\">Ova Calcária</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.NAME"
msgid "<link=\"CRAB\">Pokeshell</link>"
msgstr "<link=\"CRAB\">Caranguejo Calcário</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.BABY.DESC"
msgid ""
"A picky little Sanishell Spawn.\n"
"\n"
"In time it will mature into a fully grown <link=\"CRABFRESHWATER\">Sanishell</link>."
msgstr ""
"Um Caranguejinho Saneador exigente.\n"
"\n"
"Com o tempo, ela amadurecerá em um <link=\"CRABFRESHWATER\">Caranguejo Saneador</link> totalmente crescido."

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.BABY.NAME"
msgid "<link=\"CRABFRESHWATER\">Sanishell Spawn</link>"
msgstr "<link=\"CRABFRESHWATER\">Caranguejinho Saneador</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.DESC"
msgid ""
"Sanishells are nonhostile critters unless their eggs are nearby.\n"
"\n"
"They thrive in <link=\"WATER\">Water</link> and eliminate <link=\"DISEASE\">Germs</link> from any liquid they inhabit.\n"
"\n"
"They eat <link=\"TOXICSAND\">Polluted Dirt</link>, <link=\"SLIMEMOLD\">Slime</link> and <link=\"COMPOST\">Rot Piles</link>."
msgstr ""
"Caranguejos Saneadores são criaturas não hostis, a menos que seus ovos estejam por perto.\n"
"\n"
"Eles prosperam em <link=\"WATER\">Água</link> e eliminam <link=\"DISEASE\">Germes</link> de qualquer líquido que habitam.\n"
"\n"
"Eles comem <link=\"TOXICSAND\">Terra Poluída</link>, <link=\"SLIMEMOLD\">Limo</link> e <link=\"COMPOST\">Pilha Podre</link>."

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.EGG_NAME"
msgid "<link=\"CRABFRESHWATER\">Sanishell Roe</link>"
msgstr "<link=\"CRABFRESHWATER\">Ova Saneadora</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_FRESH_WATER.NAME"
msgid "<link=\"CRABFRESHWATER\">Sanishell</link>"
msgstr "<link=\"CRABFRESHWATER\">Caranguejo Saneador</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.BABY.DESC"
msgid ""
"A knotty little Oakshell Spawn.\n"
"\n"
"In time it will mature into a fully grown <link=\"CRABWOOD\">Oakshell</link>."
msgstr ""
"Um pequeno Caranguejinho Lenhoso nodoso.\n"
"\n"
"Com o tempo, ele amadurecerá em um <link=\"CRABWOOD\">Caranguejo Lenhoso</link> totalmente crescido."

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.BABY.NAME"
msgid "<link=\"CRABWOOD\">Oakshell Spawn</link>"
msgstr "<link=\"CRABWOOD\">Caranguejinho Lenhoso</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.DESC"
msgid ""
"Oakshells are nonhostile critters unless their eggs are nearby.\n"
"\n"
"They eat <link=\"TOXICSAND\">Polluted Dirt</link>, <link=\"SLIMEMOLD\">Slime</link> and <link=\"COMPOST\">Rot Piles</"
"link>.\n"
"\n"
"The shells they leave behind after molting can be crushed into <link=\"WOOD\">Wood</link>.\n"
"\n"
"Oakshells thrive in <link=\"ETHANOL\">Ethanol</link>."
msgstr ""
"Caranguejos Lenhosos são criaturas não hostis a menos que suas ovas estejam por perto.\n"
"\n"
"Eles comem <link=\"TOXICSAND\">Terra Poluída</link>, <link=\"SLIMEMOLD\">Limo</link> e <link=\"COMPOST\">Pilha Podre</"
"link>.\n"
"\n"
"As cascas que eles deixam para trás após a muda podem ser esmagadas em <link=\"WOOD\">Madeira</link>.\n"
"\n"
"Caranguejos Lenhosos prosperam em <link=\"ETHANOL\">Etanol</link>."

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.EGG_NAME"
msgid "<link=\"CRABWOOD\">Oakshell Roe</link>"
msgstr "<link=\"CRABWOOD\">Ova Lenhosa</link>"

#. STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRAB.VARIANT_WOOD.NAME"
msgid "<link=\"CRABWOOD\">Oakshell</link>"
msgstr "<link=\"CRABWOOD\">Caranguejo Lenhoso</link>"

#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.DESC"
msgid ""
"Critter Traps are carnivorous plants that consume small-to-medium-sized critters and release <link=\"HYDROGEN\">Hydrogen "
"Gas</link> as waste."
msgstr ""
"Criaturas Armadilhas são plantas carnívoras que consomem criaturas de pequeno a médio porte e liberam "
"<link=\"HYDROGEN\">Hidrogênio</link> como resíduo."

#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.DOMESTICATEDDESC"
msgid "This plant eats small critters and produces <link=\"HYDROGEN\">Hydrogen Gas</link>."
msgstr "Essa planta devora pequenas criaturas e produz <link=\"HYDROGEN\">Hidrogênio</link>."

#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.HUNGRY
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.HUNGRY"
msgid "Hungry"
msgstr "Fome"

#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.NAME"
msgid "<link=\"CRITTERTRAPPLANT\">Saturn Critter Trap</link>"
msgstr "<link=\"CRITTERTRAPPLANT\">Armadilha de Criaturas Saturnina</link>"

#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.PLANT_HUNGER_REQUIREMENT
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.PLANT_HUNGER_REQUIREMENT"
msgid "Carnivorous Diet"
msgstr "Dieta Carnívora"

#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.VICTIM_IDENTIFIER
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.VICTIM_IDENTIFIER"
msgid "Land Critters"
msgstr "Criaturas Terrestres"

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.DESC
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.DESC"
msgid "Bliss Bursts release an explosion of <link=\"DECOR\">Decor</link> into otherwise dull environments."
msgstr "Explosões de Felicidade liberam uma explosão de <link=\"DECOR\">Decor</link> em ambientes tediosos."

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decor</link> do ambiente."

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "Bônus de Crescimento"

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.NAME
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.NAME"
msgid "<link=\"CYLINDRICA\">Bliss Burst</link>"
msgstr "<link=\"CYLINDRICA\">Explosão de Felicidade</link>"

#. STRINGS.CREATURES.SPECIES.CYLINDRICA.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.CYLINDRICA.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "Penalidade por Murchar"

#. STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DESC"
msgid "Dew Drippers produce <link=\"DEWDRIP\">Dewdrips</link> that can be crushed into <link=\"MILK\">Brackene</link>."
msgstr ""
"Orvalheiras produzem <link=\"DEWDRIP\">Gotas de Orvalho</link> que podem ser esmagadas em <link=\"MILK\">Braquil</link>."

#. STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"MILK\">Brackene</link>."
msgstr "Esta planta produz <link=\"MILK\">Braquil</link>."

#. STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.NAME"
msgid "<link=\"DEWDRIPPERPLANT\">Dew Dripper</link>"
msgstr "<link=\"DEWDRIPPERPLANT\">Orvalheira</link>"

#. STRINGS.CREATURES.SPECIES.DEWPALM.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWPALM.DESC"
msgid ""
"Gum Palms can be harvested for <link=\"PALMWOOD\">Gum Wood</link>, which can be processed into <link=\"LATEX\">Latex</link> "
"at the <link=\"MILKPRESS\">Plant Pulverizer</link>.\n"
"\n"
"Due to their size, they can only be planted in a <link=\"WIDEFARMTILE\">Wide Hydroponic Farm</link>."
msgstr ""
"Palmeiras Goma podem ser colhidas para obter <link=\"PALMWOOD\">Madeira Goma</link>, que pode ser processada em "
"<link=\"LATEX\">Látex</link> no <link=\"MILKPRESS\">Pulverizador de Plantas</link>.\n"
"\n"
"Devido ao seu tamanho, só podem ser plantadas em uma <link=\"WIDEFARMTILE\">Fazenda Hidropônica Larga</link>."

#. STRINGS.CREATURES.SPECIES.DEWPALM.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWPALM.DOMESTICATEDDESC"
msgid "This plant produces <link=\"PALMWOOD\">Gum Wood</link>."
msgstr "Esta planta produz <link=\"PALMWOOD\">Madeira Goma</link>."

#. STRINGS.CREATURES.SPECIES.DEWPALM.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DEWPALM.NAME"
msgid "<link=\"DEWPALM\">Gum Palm</link>"
msgstr "<link=\"DEWPALM\">Palmeira Goma</link>"

#. STRINGS.CREATURES.SPECIES.DIESELMOO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIESELMOO.DESC"
msgid ""
"Husky Moos are extraterrestrial critters that feed on <link=\"PLANTFIBER\">Plant Husk</link> and <link=\"GASGRASS\">Gas "
"Grass</link>, and excrete <link=\"CARBONDIOXIDE\">Carbon Dioxide</link>.\n"
"\n"
"When domesticated and fed, they can be milked for <link=\"REFINEDLIPID\">Biodiesel</link>."
msgstr ""
"Muus Cascudos são criaturas extraterrestres que se alimentam de <link=\"PLANTFIBER\">Casca Vegetal</link> e "
"<link=\"GASGRASS\">Grama Gasosa</link>, e excretam <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link>.\n"
"\n"
"Quando domesticados e alimentados, podem ser ordenhados para obter <link=\"REFINEDLIPID\">Biodiesel</link>."

#. STRINGS.CREATURES.SPECIES.DIESELMOO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIESELMOO.NAME"
msgid "<link=\"DIESELMOO\">Husky Moo</link>"
msgstr "<link=\"DIESELMOO\">Muu Cascudo</link>"

#. STRINGS.CREATURES.SPECIES.DINOFERN.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DINOFERN.DESC"
msgid ""
"Megafronds produce <link=\"FERNFOOD\">Megafrond Grain</link>, an ancient grain that can be processed into "
"<link=\"FOOD\">Food</link>."
msgstr ""
"Megafolhas produzem <link=\"FERNFOOD\">Grão de Megafolha</link>, um grão ancestral que pode ser processado em "
"<link=\"FOOD\">Comida</link>."

#. STRINGS.CREATURES.SPECIES.DINOFERN.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.DINOFERN.DOMESTICATEDDESC"
msgid "This plant produces <link=\"FERNFOOD\">Megafrond Grain</link>."
msgstr "Esta planta produz <link=\"FERNFOOD\">Grão de Megafolha</link>."

#. STRINGS.CREATURES.SPECIES.DINOFERN.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DINOFERN.NAME"
msgid "<link=\"DINOFERN\">Megafrond</link>"
msgstr "<link=\"DINOFERN\">Megafolha</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.DESC"
msgid ""
"A crawly little Sweetle Larva.\n"
"\n"
"In time, it will mature into an adult <link=\"DIVERGENTBEETLE\">Sweetle</link>."
msgstr ""
"Uma pequena e rastejante Larva de Doçouro.\n"
"\n"
"Com o tempo, ela amadurecerá em um <link=\"DIVERGENTBEETLE\">Doçouro</link> adulto."

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.NAME"
msgid "<link=\"DIVERGENTBEETLE\">Sweetle Larva</link>"
msgstr "<link=\"DIVERGENTBEETLE\">Larva de Doçouro</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.DESC"
msgid ""
"Sweetles are nonhostile critters that excrete large amounts of <link=\"SUCROSE\">Sucrose</link>.\n"
"\n"
"They are closely related to the <link=\"DIVERGENTWORM\">Grubgrub</link> and exhibit similar, albeit less effective farming "
"behaviors."
msgstr ""
"Os Doçouros são criaturas não hostis que excretam grandes quantidades de <link=\"SUCROSE\">Sacarose</link>.\n"
"Eles são parentes próximos dos <link=\"DIVERGENTWORM\">Hortiverme</link> e exibem comportamentos similares de cultivo, "
"embora menos eficazes."

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.EGG_NAME"
msgid "<link=\"DIVERGENTBEETLE\">Sweetle Egg</link>"
msgstr "<link=\"DIVERGENTBEETLE\">Ovo de Doçouro</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.NAME"
msgid "<link=\"DIVERGENTBEETLE\">Sweetle</link>"
msgstr "<link=\"DIVERGENTBEETLE\">Doçouro</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.DESC"
msgid ""
"A squirmy little Grubgrub Wormling.\n"
"\n"
"In time, it will mature into an adult <link=\"WORM\">Grubgrub</link> and drastically grow in size."
msgstr ""
"Um pequeno e contorcido Hortivermezinho.\n"
"\n"
"Com o tempo, ele amadurecerá em um <link=\"WORM\">Hortiverme</link> adulto e crescerá drasticamente de tamanho."

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.NAME"
msgid "<link=\"DIVERGENTWORM\">Grubgrub Wormling</link>"
msgstr "<link=\"DIVERGENTWORM\">Hortivermezinho</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.DESC"
msgid ""
"Grubgrubs form symbiotic relationships with plants, especially <link=\"WORMPLANT\">Grubfruit Plants</link>, and "
"instinctually tend to them.\n"
"\n"
"Grubgrubs are closely related to <link=\"DIVERGENTBEETLE\">Sweetles</link>."
msgstr ""
"Hortiverme formam relações simbióticas com plantas, especialmente <link=\"WORMPLANT\">Hortífruta</link>, e instintivamente "
"cuidam delas.\n"
"\n"
"Hortiverme são parentes próximos dos <link=\"DIVERGENTBEETLE\">Doçouros</link>."

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.EGG_NAME"
msgid "<link=\"DIVERGENTWORM\">Grubgrub Egg</link>"
msgstr "<link=\"DIVERGENTWORM\">Ovo de Hortiverme</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.NAME"
msgid "<link=\"DIVERGENTWORM\">Grubgrub</link>"
msgstr "<link=\"DIVERGENTWORM\">Hortiverme</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.BABY.DESC"
msgid ""
"A little, bug-eyed Drecklet.\n"
"\n"
"In time it will mature into a fully grown <link=\"DRECKO\">Drecko</link>."
msgstr ""
"Um pequeno Drecozinho de olhos esbugalhados.\n"
"\n"
"Com o tempo, ele amadurecerá e se tornará um <link=\"DRECKO\">Dreco</link> adulto."

#. STRINGS.CREATURES.SPECIES.DRECKO.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.BABY.NAME"
msgid "<link=\"DRECKO\">Drecklet</link>"
msgstr "<link=\"DRECKO\">Drecozinho</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.DESC"
msgid ""
"Dreckos are nonhostile critters that graze on <link=\"SPICEVINE\">Pincha Pepperplants</link>, <link=\"SWAMPLILY\">Balm "
"Lily</link> or <link=\"BASICSINGLEHARVESTPLANT\">Mealwood Plants</link>.\n"
"\n"
"Their backsides are covered in thick woolly fibers that only grow in <link=\"HYDROGEN\">Hydrogen</link> climates."
msgstr ""
"Drecos são criaturas não hostis que pastam em <link=\"SPICEVINE\">Pimenteiras Baga</link>, <link=\"SWAMPLILY\">Lírios "
"Balsâmicos</link> ou <link=\"BASICSINGLEHARVESTPLANT\">Raquifloras</link>.\n"
"\n"
"Suas costas são cobertas de fibras grossas e lanosas que só crescem em climas de <link=\"HYDROGEN\">Hidrogênio</link>."

#. STRINGS.CREATURES.SPECIES.DRECKO.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.EGG_NAME"
msgid "<link=\"DRECKO\">Drecko Egg</link>"
msgstr "<link=\"DRECKO\">Ovo de Dreco</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.NAME"
msgid "<link=\"DRECKO\">Drecko</link>"
msgstr "<link=\"DRECKO\">Dreco</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.DESC"
msgid ""
"A bug-eyed little Glossy Drecklet.\n"
"\n"
"In time it will mature into an adult Drecko morph, the <link=\"DRECKOPLASTIC\">Glossy Drecko</link>."
msgstr ""
"Um pequeno Drecozinho Lustroso de olhos esbugalhados.\n"
"\n"
"Com o tempo, ele amadurecerá em uma variante Dreco adulto, o <link=\"DRECKOPLASTIC\">Dreco Lustroso</link>."

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.NAME"
msgid "<link=\"DRECKOPLASTIC\">Glossy Drecklet</link>"
msgstr "<link=\"DRECKOPLASTIC\">Drecozinho Lustroso</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.DESC"
msgid ""
"Glossy Dreckos are nonhostile critters that graze on live <link=\"BASICSINGLEHARVESTPLANT\">Mealwood Plants</link> and "
"<link=\"PRICKLEFLOWER\">Bristle Blossoms</link>.\n"
"\n"
"Their backsides are covered in bioplastic scales that only grow in <link=\"HYDROGEN\">Hydrogen Gas</link> climates."
msgstr ""
"Drecos Lustrosos são criaturas não hostis que pastam em <link=\"BASICSINGLEHARVESTPLANT\">Raquifloras</link> vivas e "
"<link=\"PRICKLEFLOWER\">Florescarpas</link>.\n"
"\n"
"Suas costas são cobertas de escamas de bioplástico que só crescem em climas de <link=\"HYDROGEN\">Hidrogênio</link>."

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.EGG_NAME"
msgid "<link=\"DRECKOPLASTIC\">Glossy Drecko Egg</link>"
msgstr "<link=\"DRECKOPLASTIC\">Ovo de Dreco Lustroso</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.NAME"
msgid "<link=\"DRECKOPLASTIC\">Glossy Drecko</link>"
msgstr "<link=\"DRECKOPLASTIC\">Dreco Lustroso</link>"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.DESC"
msgid ""
"Sporechids have an eerily alluring appearance to mask the fact that they host particularly nasty strain of brain fungus."
msgstr ""
"Esporóforos têm uma aparência estranhamente atraente para mascarar o fato de que hospedam uma cepa particularmente "
"desagradável de fungo cerebral."

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.DOMESTICATEDDESC"
msgid ""
"This plant improves ambient <link=\"DECOR\">Decor</link> but produces high quantities of <link=\"ZOMBIESPORES\">Zombie "
"Spores</link>."
msgstr ""
"Esta planta melhora a <link=\"DECOR\">Decor</link> do ambiente, mas produz grandes quantidades de "
"<link=\"ZOMBIESPORES\">Esporos Zumbis</link>."

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "Bônus de Crescimento"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.NAME"
msgid "<link=\"EVILFLOWER\">Sporechid</link>"
msgstr "<link=\"EVILFLOWER\">Esporóforo</link>"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "Penalidade por Murchar"

#. STRINGS.CREATURES.SPECIES.FILAMENTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.FILAMENTPLANT.DESC"
msgid ""
"Petta Poufs are <link=\"DECOR\">Decorative</link> aquatic <link=\"PLANTS\">Plants</link>.\n"
"\n"
"The gentle touch of their blooms soothes passing Duplicants' nerves."
msgstr ""
"Pomponelas são <link=\"PLANTS\">Plantas</link> <link=\"DECOR\">Decorativas</link> aquáticas.\n"
"\n"
"O toque suave de suas flores acalma os nervos dos Duplicantes que passam por perto."

#. STRINGS.CREATURES.SPECIES.FILAMENTPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.FILAMENTPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decor</link> do ambiente."

#. STRINGS.CREATURES.SPECIES.FILAMENTPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.FILAMENTPLANT.NAME"
msgid "<link=\"FILAMENTPLANT\">Petta Pouf</link>"
msgstr "<link=\"FILAMENTPLANT\">Pomponela</link>"

#. STRINGS.CREATURES.SPECIES.FILTERPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.FILTERPLANT.DESC"
msgid "Hydrocacti act as natural <link=\"WATER\">Water</link> filters when given access to <link=\"SAND\">Sand</link>."
msgstr ""
"Hidrocactos atuam como filtros naturais de <link=\"WATER\">Água</link> quando têm acesso à <link=\"SAND\">Areia</link>."

#. STRINGS.CREATURES.SPECIES.FILTERPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.FILTERPLANT.DOMESTICATEDDESC"
msgid ""
"This plant uses <link=\"SAND\">Sand</link> to convert <link=\"DIRTYWATER\">Polluted Water</link> into "
"<link=\"WATER\">Water</link>."
msgstr ""
"Esta planta utiliza <link=\"SAND\">Areia</link> para converter <link=\"DIRTYWATER\">Água Poluída</link> em "
"<link=\"WATER\">Água</link> limpa."

#. STRINGS.CREATURES.SPECIES.FILTERPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.FILTERPLANT.NAME"
msgid "<link=\"FILTERPLANT\">Hydrocactus</link>"
msgstr "<link=\"FILTERPLANT\">Hidrocacto</link>"

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.DESC"
msgid ""
"Lura plants are carnivorous plants that trap flying critters, such as <link=\"MOSQUITO\">Gnits</link>.\n"
"\n"
"Their digestive processes produce harvestable <link=\"AMBER\">Amber</link>."
msgstr ""
"Plantas Lura são plantas carnívoras que capturam criaturas voadoras, como os <link=\"MOSQUITO\">Pernilonguitos</link>.\n"
"\n"
"Seus processos digestivos produzem <link=\"AMBER\">Âmbar</link> coletável."

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"NATURALRESIN\">Resin</link>."
msgstr "Esta planta produz <link=\"NATURALRESIN\">Resina</link>."

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.HUNGRY
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.HUNGRY"
msgid "Hungry"
msgstr "Fome"

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.NAME"
msgid "<link=\"FLYTRAPPLANT\">Lura Plant</link>"
msgstr "<link=\"FLYTRAPPLANT\">Planta Lura</link>"

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.PLANT_HUNGER_REQUIREMENT
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.PLANT_HUNGER_REQUIREMENT"
msgid "Carnivorous Diet"
msgstr "Dieta Carnívora"

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.VICTIM_IDENTIFIER
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.VICTIM_IDENTIFIER"
msgid "Airborne Critters"
msgstr "Criaturas Aéreas"

#. STRINGS.CREATURES.SPECIES.FORESTFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.FORESTFORAGEPLANTPLANTED.DESC"
msgid ""
"Hexalents are incapable of propagating but can be harvested for a single, calorie dense <link=\"FOOD\">Food</link> serving."
msgstr ""
"Hexalentes são incapazes de se propagar, mas podem ser colhidos para uma única porção de <link=\"FOOD\">Alimento</link> "
"altamente calórico."

#. STRINGS.CREATURES.SPECIES.FORESTFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.FORESTFORAGEPLANTPLANTED.NAME"
msgid "<link=\"FORESTFORAGEPLANTPLANTED\">Hexalent</link>"
msgstr "<link=\"FORESTFORAGEPLANTPLANTED\">Hexalente</link>"

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.DESC"
msgid ""
"Ring Rosebushes are <link=\"DECOR\">Decorative</link> <link=\"PLANTS\">Plants</link> that add a touch of whimsy wherever "
"they are planted."
msgstr ""
"Roseiras Anelares são <link=\"DECOR\">Decorativas</link> <link=\"PLANTS\">Plantas</link> que adicionam um toque de fantasia "
"onde quer que sejam plantadas."

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decor</link> do ambiente."

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "Bônus de Crescimento"

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.NAME"
msgid "<link=\"GARDENDECORPLANT\">Ring Rosebush</link>"
msgstr "<link=\"GARDENDECORPLANT\">Roseira Anelar</link>"

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "Penalidade por Murchar"

#. STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.DESC"
msgid ""
"Sweatcorn Stalks produce <link=\"GARDENFOODPLANTFOOD\">Sweatcorn</link>, a crisp vegetable that can be harvested for "
"<link=\"FOOD\">Food</link>."
msgstr ""
"Os Pés de Melimilho produzem <link=\"GARDENFOODPLANTFOOD\">Melimilho</link>, um vegetal crocante que pode ser colhido para "
"<link=\"FOOD\">Alimento</link>."

#. STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"GARDENFOODPLANTFOOD\">Sweatcorn</link>s."
msgstr "Esta planta produz <link=\"GARDENFOODPLANTFOOD\">Melimilhos</link> comestíveis."

#. STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.NAME"
msgid "<link=\"GARDENFOODPLANT\">Sweatcorn Stalk</link>"
msgstr "<link=\"GARDENFOODPLANT\">Pé de Melimilho</link>"

#. STRINGS.CREATURES.SPECIES.GARDENFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFORAGEPLANTPLANTED.DESC"
msgid "Snacti are incapable of propagating but can be harvested for a single <link=\"FOOD\">Food</link> serving."
msgstr ""
"Petiscáctos são incapazes de se propagar, mas podem ser colhidos para uma única porção de <link=\"FOOD\">Comida</link>."

#. STRINGS.CREATURES.SPECIES.GARDENFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFORAGEPLANTPLANTED.NAME"
msgid "<link=\"GARDENFORAGEPLANTPLANTED\">Snactus</link>"
msgstr "<link=\"GARDENFORAGEPLANTPLANTED\">Petiscácto</link>"

#. STRINGS.CREATURES.SPECIES.GASGRASS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GASGRASS.DESC"
msgid ""
"Gas Grass is an alien lifeform tentatively categorized as a \"plant.\"\n"
"\n"
"It can be harvested for <link=\"PLANTFIBER\">Plant Husk</link> or eaten as-is by <link=\"MOOSPECIES\">Moos</link>."
msgstr ""
"Grama Gasosa é uma forma de vida alienígena provisoriamente categorizada como uma \"planta\".\n"
"\n"
"Ela pode ser colhida para obter <link=\"PLANTFIBER\">Casca Vegetal</link> ou comida diretamente por "
"<link=\"MOOSPECIES\">Muus</link>."

#. STRINGS.CREATURES.SPECIES.GASGRASS.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.GASGRASS.DOMESTICATEDDESC"
msgid "An alien grass variety that is eaten by <link=\"MOO\">Gassy Moos</link>."
msgstr "Uma variedade de grama alienígena que é comida por <link=\"MOO\">Muus Gasosos</link>."

#. STRINGS.CREATURES.SPECIES.GASGRASS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GASGRASS.NAME"
msgid "<link=\"GASGRASS\">Gas Grass</link>"
msgstr "<link=\"GASGRASS\">Grama Gasosa</link>"

#. STRINGS.CREATURES.SPECIES.GEYSER.BIG_VOLCANO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.BIG_VOLCANO.DESC"
msgid "A massive volcano that periodically erupts with molten <link=\"MAGMA\">Magma</link>."
msgstr "Um vulcão grande que entra em erupção periodicamente liberando <link=\"MAGMA\">Magma</link> derretido."

