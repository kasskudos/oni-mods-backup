#. STRINGS.BUILDINGS.PREFABS.EGGINCUBATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGINCUBATOR.DESC"
msgid "Incubators can maintain the ideal internal conditions for several species of critter egg."
msgstr "Incubadoras mantêm as condições internas ideais para vários tipos de ovos de criaturas."

#. STRINGS.BUILDINGS.PREFABS.EGGINCUBATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGINCUBATOR.EFFECT"
msgid ""
"Incubates <link=\"CREATURES\">Critter</link> eggs until ready to hatch.\n"
"\n"
"Assigned Duplicants must possess the <link=\"RANCHING1\">Critter Ranching</link> skill."
msgstr ""
"Incuba ovos de <link=\"CREATURES\">Criaturas</link> até que estejam prontos para chocar.\n"
"\n"
"Duplicantes designados devem possuir a habilidade de <link=\"RANCHING1\">Criação de Criaturas</link>."

#. STRINGS.BUILDINGS.PREFABS.EGGINCUBATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGINCUBATOR.NAME"
msgid "<link=\"EGGINCUBATOR\">Incubator</link>"
msgstr "<link=\"EGGINCUBATOR\">Incubadora</link>"

#. STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.DESC"
msgid "Bionic Duplicants rely on a steady supply of power to function."
msgstr "Duplicantes Biônicos dependem de um fornecimento constante de energia para funcionar."

#. STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.EFFECT"
msgid "Converts empty <link=\"ELECTROBANK\">Eco Power Banks</link> into fully charged units ready for reuse."
msgstr ""
"Converte <link=\"ELECTROBANK\">Baterias Biônicas Eco</link> vazias em unidades totalmente carregadas prontas para "
"reutilização."

#. STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.NAME"
msgid "<link=\"ELECTROBANKCHARGER\">Power Bank Charger</link>"
msgstr "<link=\"ELECTROBANKCHARGER\">Carregador de Bateria Biônica</link>"

#. STRINGS.BUILDINGS.PREFABS.ELECTROLYZER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROLYZER.DESC"
msgid "Water goes in one end, life sustaining oxygen comes out the other."
msgstr "A água entra por um lado e o oxigênio que sustenta a vida sai pelo outro."

#. STRINGS.BUILDINGS.PREFABS.ELECTROLYZER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROLYZER.EFFECT"
msgid ""
"Converts <link=\"WATER\">Water</link> into <link=\"OXYGEN\">Oxygen</link> and <link=\"HYDROGEN\">Hydrogen Gas</link>.\n"
"\n"
"Becomes idle when the area reaches maximum pressure capacity."
msgstr ""
"Transforma <link=\"WATER\">Água</link> em <link=\"OXYGEN\">Oxigênio</link> e <link=\"HYDROGEN\">Hidrogênio</link>.\n"
"\n"
"Fica ociosa quando a área atinge a capacidade máxima de pressão."

#. STRINGS.BUILDINGS.PREFABS.ELECTROLYZER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROLYZER.NAME"
msgid "<link=\"ELECTROLYZER\">Electrolyzer</link>"
msgstr "<link=\"ELECTROLYZER\">Eletrolisador</link>"

#. STRINGS.BUILDINGS.PREFABS.ESCAPEPOD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ESCAPEPOD.DESC"
msgid "Delivers a Duplicant from a stranded rocket to the nearest Planetoid."
msgstr "Transporta um Duplicante de um foguete encalhado para o Planetoide mais próximo."

#. STRINGS.BUILDINGS.PREFABS.ESCAPEPOD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ESCAPEPOD.NAME"
msgid "<link=\"ESCAPEPOD\">Escape Pod</link>"
msgstr "<link=\"ESCAPEPOD\">Cápsula de Escape</link>"

#. STRINGS.BUILDINGS.PREFABS.ESPRESSOMACHINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ESPRESSOMACHINE.DESC"
msgid "A shot of espresso helps Duplicants relax after a long day."
msgstr "Uma dose de café espresso ajuda os Duplicantes a relaxarem após um longo dia."

#. STRINGS.BUILDINGS.PREFABS.ESPRESSOMACHINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ESPRESSOMACHINE.EFFECT"
msgid ""
"Provides refreshment for Duplicants on their breaks.\n"
"\n"
"Increases Duplicant <link=\"MORALE\">Morale</link>."
msgstr ""
"Fornece refresco aos Duplicantes em seus intervalos.\n"
"\n"
"Aumenta a <link=\"MORALE\">Moral</link> dos Duplicantes."

#. STRINGS.BUILDINGS.PREFABS.ESPRESSOMACHINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ESPRESSOMACHINE.NAME"
msgid "<link=\"ESPRESSOMACHINE\">Espresso Machine</link>"
msgstr "<link=\"ESPRESSOMACHINE\">Máquina de Expresso</link>"

#. STRINGS.BUILDINGS.PREFABS.ETHANOLDISTILLERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ETHANOLDISTILLERY.DESC"
msgid "Ethanol distillers convert <link=\"WOOD\">Wood</link> into burnable <link=\"ETHANOL\">Ethanol</link> fuel."
msgstr "Destiladores de Etanol converte <link=\"WOOD\">Madeira</link> em combustível de <link=\"ETHANOL\">Etanol</link>."

#. STRINGS.BUILDINGS.PREFABS.ETHANOLDISTILLERY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ETHANOLDISTILLERY.EFFECT"
msgid "Refines <link=\"WOOD\">Wood</link> into <link=\"ETHANOL\">Ethanol</link>."
msgstr "Refina <link=\"WOOD\">Madeira</link> em <link=\"ETHANOL\">Etanol</link>."

#. STRINGS.BUILDINGS.PREFABS.ETHANOLDISTILLERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ETHANOLDISTILLERY.NAME"
msgid "<link=\"ETHANOLDISTILLERY\">Ethanol Distiller</link>"
msgstr "<link=\"ETHANOLDISTILLERY\">Destilador de Etanol</link>"

#. STRINGS.BUILDINGS.PREFABS.EXOBASEHEADQUARTERS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXOBASEHEADQUARTERS.DESC"
msgid "A quick and easy substitute, though it'll never live up to the original."
msgstr "Um substituto rápido e fácil, apesar que nunca vai ser melhor que o original."

#. STRINGS.BUILDINGS.PREFABS.EXOBASEHEADQUARTERS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.EXOBASEHEADQUARTERS.EFFECT"
msgid ""
"A portable bioprinter that produces new Duplicants or care packages containing resources.\n"
"\n"
"Only one Printing Pod or Mini-Pod is permitted per Planetoid."
msgstr ""
"Uma impressora biológica portátil que produz novos Duplicantes ou pacotes de suprimentos contendo recursos.\n"
"\n"
"Apenas um Módulo Duplicador ou Mini-Módulo é permitida por Planetoide."

#. STRINGS.BUILDINGS.PREFABS.EXOBASEHEADQUARTERS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXOBASEHEADQUARTERS.NAME"
msgid "<link=\"EXOBASEHEADQUARTERS\">Mini-Pod</link>"
msgstr "<link=\"EXOBASEHEADQUARTERS\">Mini-duplicador</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.DESC"
msgid "Drywall can be used in conjunction with tiles to build airtight rooms on the surface."
msgstr "A Placa de Gesso pode ser usada em conjunto com blocos para construir salas herméticas na superfície."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.EFFECT"
msgid ""
"Prevents <link=\"ELEMENTSGAS\">Gas</link> and <link=\"ELEMENTSLIQUID\">Liquid</link> loss in space.\n"
"\n"
"Builds an insulating backwall behind buildings."
msgstr ""
"Evita a perda de <link=\"ELEMENTSGAS\">Gás</link> e <link=\"ELEMENTSLIQUID\">Líquido</link> no espaço.\n"
"\n"
"Constrói uma parede atrás das construções para isolar."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.AQUATICMOSAIC.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.AQUATICMOSAIC.DESC"
msgid "A multi-hued blue wallpaper."
msgstr "Um papel de parede azul em vários tons."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.AQUATICMOSAIC.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.AQUATICMOSAIC.NAME"
msgid "<link=\"EXTERIORWALL\">Aquatic Mosaic</link>"
msgstr "<link=\"EXTERIORWALL\">Mosaico Aquático</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BALM_LILY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BALM_LILY.DESC"
msgid "A mellow floral wallpaper."
msgstr "Um papel de parede floral suave."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BALM_LILY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BALM_LILY.NAME"
msgid "<link=\"EXTERIORWALL\">Balm Lily Print</link>"
msgstr "<link=\"EXTERIORWALL\">Estampa de Lírio Bálsamo</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_BLUE_COBALT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_BLUE_COBALT.DESC"
msgid "It doesn't cure the blues, so much as emphasize them."
msgstr "Não cura a tristeza, apenas a enfatiza."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_BLUE_COBALT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_BLUE_COBALT.NAME"
msgid "<link=\"EXTERIORWALL\">Solid Cobalt</link>"
msgstr "<link=\"EXTERIORWALL\">Cobalto Sólido</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_GREEN_KELLY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_GREEN_KELLY.DESC"
msgid "It's cheaper than having a garden."
msgstr "É mais barato do que ter um jardim."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_GREEN_KELLY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_GREEN_KELLY.NAME"
msgid "<link=\"EXTERIORWALL\">Spring Green</link>"
msgstr "<link=\"EXTERIORWALL\">Verde Primavera</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_GREY_CHARCOAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_GREY_CHARCOAL.DESC"
msgid "An elevated take on \"gray\"."
msgstr "Uma versão elevada do \"cinza\"."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_GREY_CHARCOAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_GREY_CHARCOAL.NAME"
msgid "<link=\"EXTERIORWALL\">Solid Charcoal</link>"
msgstr "<link=\"EXTERIORWALL\">Carvão Sólido</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_ORANGE_SATSUMA.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_ORANGE_SATSUMA.DESC"
msgid "Less fruit-forward, but just as fresh."
msgstr "Menos frutado, mas igualmente fresco."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_ORANGE_SATSUMA.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_ORANGE_SATSUMA.NAME"
msgid "<link=\"EXTERIORWALL\">Solid Satsuma</link>"
