#. STRINGS.CREATURES.STATS.BECKONING.NAME
msgctxt "STRINGS.CREATURES.STATS.BECKONING.NAME"
msgid "Accu-moo-lation"
msgstr "Acuu-muu-lação"

#. STRINGS.CREATURES.STATS.BECKONING.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.BECKONING.TOOLTIP"
msgid ""
"At 100% <style=\"KKeyword\">Accu-moo-lation</style>, this critter will call a friend to join them on this asteroid\n"
"\n"
"Once the newcomer has landed, <style=\"KKeyword\">Accu-moo-lation</style> is rolled back to 0%"
msgstr ""
"Com a <style=\"KKeyword\">Acu-mu-lação</style> em 100%, esta criatura chamará um amigo para se juntar a ela neste "
"asteroide\n"
"\n"
"Depois que o recém-chegado aterrissar, a <style=\"KKeyword\">Acu-mu-lação</style> é revertida para 0%"

#. STRINGS.CREATURES.STATS.CRITTERTEMPERATURE.NAME
msgctxt "STRINGS.CREATURES.STATS.CRITTERTEMPERATURE.NAME"
msgid "Body Temperature"
msgstr "Temperatura Corporal"

#. STRINGS.CREATURES.STATS.CRITTERTEMPERATURE.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.CRITTERTEMPERATURE.TOOLTIP"
msgid ""
"This critter's comfortable <style=\"KKeyword\">Body Temperature</style> range is between <b>{0}</b> and <b>{1}</b>\n"
"\n"
"Its livable <style=\"KKeyword\">External Temperature</style> range is between <b>{2}</b> and <b>{3}</b>"
msgstr ""
"A faixa de <style=\"KKeyword\">Temperatura Corporal</style> confortável desta criatura está entre <b>{0}</b> e <b>{1}</b>\n"
"\n"
"Sua faixa de <style=\"KKeyword\">Temperatura Externa</style> viável está entre <b>{2}</b> e <b>{3}</b>"

#. STRINGS.CREATURES.STATS.DOMESTICATION.NAME
msgctxt "STRINGS.CREATURES.STATS.DOMESTICATION.NAME"
msgid "Domestication"
msgstr "Domesticação"

#. STRINGS.CREATURES.STATS.DOMESTICATION.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.DOMESTICATION.TOOLTIP"
msgid ""
"Fully <style=\"KKeyword\">Tame</style> critters produce more materials than wild ones, and may even provide psychological "
"benefits to my colony\n"
"\n"
"This critter is <b>{0}</b> domesticated"
msgstr ""
"Criaturas totalmente <style=\"KKeyword\">domesticadas</style> produzem mais materiais do que as selvagens e podem até "
"proporcionar benefícios psicológicos para minha colônia\n"
"\n"
"Esta criatura está <b>{0}</b> domesticada"

