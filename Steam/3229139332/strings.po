msgctxt "STRINGS.EQUIPMENT.PREFABS.RUBBERBOOTS.WORN_DESC"
msgid ""
"A worn out pair of <link=\"RUBBERBOOTS\">Rubber Boots</link>.\n"
"Boots can be repaired at a <link=\"CRAFTINGTABLE\">Crafting Station</link>."
msgstr ""
"Um par de <link=\"RUBBERBOOTS\">Botas de Borracha</link> desgastado.\n"
"As botas podem ser consertadas em uma <link=\"CRAFTINGTABLE\">Mesa de Montagem</link>."

#. STRINGS.EQUIPMENT.PREFABS.RUBBERBOOTS.WORN_NAME
