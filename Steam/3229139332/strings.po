#. STRINGS.MISC.TAGS.BUILDABLERAW
msgctxt "STRINGS.MISC.TAGS.BUILDABLERAW"
msgid "<link=\"BUILDABLERAW\">Raw Mineral</link>"
msgstr "<link=\"BUILDABLERAW\">Mineral Bruto</link>"

#. STRINGS.MISC.TAGS.BUILDABLERAW_DESC
msgctxt "STRINGS.MISC.TAGS.BUILDABLERAW_DESC"
msgid ""
"Raw minerals are the unrefined forms of organic solids. Almost all raw minerals can be processed in the "
"<link=\"ROCKCRUSHER\">Rock Crusher</link>, although a handful require the use of the "
"<link=\"SUPERMATERIALREFINERY\">Molecular Forge</link>."
msgstr ""
"Minerais brutos são as formas não refinadas de sólidos orgânicos. Quase todos os minerais brutos podem ser processados no "
"<link=\"ROCKCRUSHER\">Triturador de Rochas</link>, embora alguns exijam o uso da <link=\"SUPERMATERIALREFINERY\">Forja "
"Molecular</link>."

#. STRINGS.MISC.TAGS.BUILDING
