#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK.DESC"
msgid ""
"A rechargeable <link=\"ELECTROBANK\">Power Bank</link>.\n"
"\n"
"It can power buildings via <link=\"LARGEELECTROBANKDISCHARGER\">Large Dischargers</link> or "
"<link=\"SMALLELECTROBANKDISCHARGER\">Compact Dischargers</link>.\n"
"\n"
"Duplicants can produce new <link=\"ELECTROBANK\">Eco Power Banks</link> at the <link=\"ADVANCEDCRAFTINGTABLE\">Soldering "
"Station</link>.\n"
"\n"
"Must be kept dry."
msgstr ""
"Uma <link=\"ELECTROBANK\">Bateria Biônica</link> recarregável.\n"
"\n"
"Ela pode abastecer estruturas via <link=\"LARGEELECTROBANKDISCHARGER\">Descargadores Grandes</link> ou "
"<link=\"SMALLELECTROBANKDISCHARGER\">Descargadores Compactos</link>.\n"
"\n"
"Duplicantes podem produzir novas <link=\"ELECTROBANK\">Baterias Biônicas Eco</link> na "
"<link=\"ADVANCEDCRAFTINGTABLE\">Estação de Soldagem</link>.\n"
"\n"
"Deve ser mantido seco."

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK.NAME"
msgid "<link=\"ELECTROBANK\">Eco Power Bank</link>"
msgstr "<link=\"ELECTROBANK\">Bateria Biônica Eco</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_EMPTY.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_EMPTY.DESC"
msgid ""
"A depleted <link=\"ELECTROBANK\">Power Bank</link>.\n"
"\n"
"It must be recharged at a <link=\"ELECTROBANKCHARGER\">Power Bank Charger</link> before it can be reused."
msgstr ""
"Uma <link=\"ELECTROBANK\">Bateria Biônica</link> descarregada.\n"
"\n"
"Ela deve ser recarregada em um <link=\"ELECTROBANKCHARGER\">Carregador de Bateria Biônica</link> antes de ser reutilizada."

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_EMPTY.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_EMPTY.NAME"
msgid "<link=\"ELECTROBANK\">Empty Eco Power Bank</link>"
msgstr "<link=\"ELECTROBANK\">Bateria Biônica Eco Vazia</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_GARBAGE.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_GARBAGE.DESC"
msgid ""
"A <link=\"ELECTROBANK\">Power Bank</link> that has reached the end of its lifetime.\n"
"\n"
"It can be salvaged for <link=\"KATAIRITE\">Abyssalite</link> at the <link=\"ROCKCRUSHER\">Rock Crusher</link>."
msgstr ""
"Uma <link=\"ELECTROBANK\">Bateria Biônica</link> que chegou ao fim de sua vida útil.\n"
"\n"
"Pode ser reciclada para obter <link=\"KATAIRITE\">Abissalito</link> no <link=\"ROCKCRUSHER\">Triturador de Rocha</link>."

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_GARBAGE.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_GARBAGE.NAME"
msgid "<link=\"ELECTROBANK\">Power Bank Scrap</link>"
msgstr "<link=\"ELECTROBANK\">Bateria Biônica Desgastada</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_METAL_ORE.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_METAL_ORE.DESC"
msgid ""
"A disposable <link=\"ELECTROBANK\">Power Bank</link> made with <link=\"METAL\">Metal Ore</link>.\n"
"\n"
"It can power buildings via <link=\"LARGEELECTROBANKDISCHARGER\">Large Dischargers</link> or "
"<link=\"SMALLELECTROBANKDISCHARGER\">Compact Dischargers</link>.\n"
"\n"
"Duplicants can produce new <link=\"ELECTROBANK\">Metal Power Banks</link> at the <link=\"CRAFTINGTABLE\">Crafting Station</"
"link>.\n"
"\n"
"Must be kept dry."
msgstr ""
"Uma <link=\"ELECTROBANK\">Bateria Biônica</link> descartável feita com <link=\"METAL\">Minério de Metal</link>.\n"
"\n"
"Pode abastecer estruturas usando <link=\"LARGEELECTROBANKDISCHARGER\">Descargadores Grandes</link> ou "
"<link=\"SMALLELECTROBANKDISCHARGER\">Descargadores Compactos</link>.\n"
"\n"
"Duplicantes podem produzir novas <link=\"ELECTROBANK\">Baterias Biônicas de Metal</link> na <link=\"CRAFTINGTABLE\">Mesa de "
"Montagem</link>.\n"
"\n"
"Deve ser mantido seco."

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_METAL_ORE.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_METAL_ORE.NAME"
msgid "<link=\"ELECTROBANKMETALORE\">Metal Power Bank</link>"
msgstr "<link=\"ELECTROBANKMETALORE\">Bateria Biônica de Metal</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_SELFCHARGING.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_SELFCHARGING.DESC"
msgid ""
"A self-charging <link=\"ELECTROBANK\">Power Bank</link> made with <link=\"ENRICHEDURANIUM\">Enriched Uranium</link>.\n"
"\n"
"It can power buildings via <link=\"LARGEELECTROBANKDISCHARGER\">Large Dischargers</link> or "
"<link=\"SMALLELECTROBANKDISCHARGER\">Compact Dischargers</link>.\n"
"\n"
"Its low <link=\"POWER\">wattage</link> and high <link=\"RADIATION\">Radioactivity</link> make it unsuitable for Bionic "
"Duplicant use."
msgstr ""
"Uma <link=\"ELECTROBANK\">Bateria Biônica</link> autocarregável feita com <link=\"ENRICHEDURANIUM\">Urânio Enriquecido</"
"link>.\n"
"\n"
"Pode abastecer estruturas usando <link=\"LARGEELECTROBANKDISCHARGER\">Descargadores Grandes</link> ou "
"<link=\"SMALLELECTROBANKDISCHARGER\">Descargadores Compactos</link>.\n"
"\n"
"Seu baixo <link=\"POWER\">potência</link> e alta <link=\"RADIATION\">Radioatividade</link> a tornam inadequada para uso por "
"Duplicantes Biônicos."

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ELECTROBANK_SELFCHARGING.NAME
