#. STRINGS.BUILDINGS.PREFABS.DOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DOOR.DESC"
msgid "Door controls can be used to prevent Duplicants from entering restricted areas."
msgstr "Os controles das portas podem ser usados para impedir que Duplicantes entrem em áreas restritas."

#. STRINGS.BUILDINGS.PREFABS.DOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DOOR.EFFECT"
msgid ""
"Encloses areas without blocking <link=\"ELEMENTSLIQUID\">Liquid</link> or <link=\"ELEMENTSGAS\">Gas</link> flow.\n"
"\n"
"Wild <link=\"CREATURES\">Critters</link> cannot pass through doors."
msgstr ""
"Fecha áreas sem bloquear o <link=\"ELEMENTSLIQUID\">Líquido</link> ou <link=\"ELEMENTSGAS\">Gás</link>.\n"
"\n"
"<link=\"CREATURES\">Criaturas</link> selvagens não podem passar pelas portas."

