msgctxt "STRINGS.CODEX.A1_MAILROOMETIQUETTE.BODY.CONTAINER1"
msgid ""
"<smallcaps><b>Reminder: Mailroom Etiquette</b>\n"
"From: <b>Admin</b> <alpha=#AA><admin@gravitas.nova></color>\n"
"To: <b>All</b></smallcaps>\n"
"------------------\n"
"\n"
"<indent=5%>Please do not have live bees delivered to the office mail room. Requests and orders for experimental test "
"subjects may be processed through admin.\n"
"\n"
"<i>Please request all test subjects through admin.</i>\n"
"\n"
"Thank-you.\n"
"\n"
"-Admin\n"
"The Gravitas Facility</indent>"
msgstr ""
"<smallcaps><b>Lembrete: Etiqueta da Sala de Correio</b>\n"
"De: <b>Administração</b> <alpha=#AA><admin@gravitas.nova>\n"
"Para: <b>Todos</b></smallcaps>\n"
"------------------\n"
"\n"
"<indent=5%>Por favor, não entregue abelhas vivas na sala de correio do escritório. Solicitações e pedidos de cobaias "
"experimentais podem ser processados pela administração.\n"
"\n"
"<i>Solicite todas as cobaias pela administração.</i>\n"
"\n"
"Obrigado.\n"
"\n"
"-Administração\n"
"O Instituto Gravitas</indent>"

