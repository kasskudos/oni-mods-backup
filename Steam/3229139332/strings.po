#. STRINGS.BUILDINGS.PREFABS.MINERALDEOXIDIZER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MINERALDEOXIDIZER.DESC"
msgid "Oxygen diffusers are inefficient, but output enough oxygen to keep a colony breathing."
msgstr "Os difusores de oxigênio são ineficientes, mas produzem oxigênio suficiente para manter a respiração da colônia."

#. STRINGS.BUILDINGS.PREFABS.MINERALDEOXIDIZER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MINERALDEOXIDIZER.EFFECT"
msgid ""
"Converts large amounts of <link=\"ALGAE\">Algae</link> into <link=\"OXYGEN\">Oxygen</link>.\n"
"\n"
"Becomes idle when the area reaches maximum pressure capacity."
msgstr ""
"Converte grandes quantidades de <link=\"ALGAE\">Algas</link> em <link=\"OXYGEN\">Oxigênio</link>.\n"
"\n"
"Fica ocioso quando a área atinge a capacidade máxima de pressão."

#. STRINGS.BUILDINGS.PREFABS.MINERALDEOXIDIZER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MINERALDEOXIDIZER.NAME"
msgid "<link=\"MINERALDEOXIDIZER\">Oxygen Diffuser</link>"
msgstr "<link=\"MINERALDEOXIDADOR\">Difusor de Oxigênio</link>"

#. STRINGS.BUILDINGS.PREFABS.MINIFRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MINIFRIDGE.DESC"
msgid "It's very small."
msgstr "É bem pequena."

#. STRINGS.BUILDINGS.PREFABS.MINIFRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MINIFRIDGE.EFFECT"
msgid "Stores <link=\"FOOD\">Food</link> at an ideal <link=\"HEAT\">Temperature</link> to prevent spoilage."
msgstr "Armazena <link=\"FOOD\">Alimentos</link> em uma <link=\"HEAT\">Temperatura</link> ideal para evitar a deterioração."

#. STRINGS.BUILDINGS.PREFABS.MINIFRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MINIFRIDGE.NAME"
msgid "<link=\"MINIFRIDGE\">Mini Fridge</link>"
