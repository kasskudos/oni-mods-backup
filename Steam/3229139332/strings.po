#. STRINGS.ELEMENTS.HARDPOLYPROPYLENE.DESC
msgctxt "STRINGS.ELEMENTS.HARDPOLYPROPYLENE.DESC"
msgid ""
"<link=\"HARDPOLYPROPYLENE\">Plastium</link> is an advanced thermoplastic polymer made from "
"<link=\"TEMPCONDUCTORSOLID\">Thermium</link>, <link=\"POLYPROPYLENE\">Plastic</link> and <link=\"MILKFAT\">Brackwax</"
"link>.\n"
"\n"
"It is highly heat-resistant and suitable for use in space buildings."
msgstr ""
"<link=\"HARDPOLYPROPYLENE\">Plástio</link> é um polímero termoplástico avançado feito de "
"<link=\"TEMPCONDUCTORSOLID\">Térmio</link>, <link=\"POLYPROPYLENE\">Plástico</link> e <link=\"MILKFAT \">Braquilcera</"
"link>.\n"
"\n"
"É altamente resistente ao calor e adequado para uso em construções espaciais."

#. STRINGS.ELEMENTS.HARDPOLYPROPYLENE.NAME
msgctxt "STRINGS.ELEMENTS.HARDPOLYPROPYLENE.NAME"
msgid "<link=\"HARDPOLYPROPYLENE\">Plastium</link>"
msgstr "<link=\"HARDPOLYPROPYLENE\">Plástio</link>"

#. STRINGS.ELEMENTS.HELIUM.DESC
msgctxt "STRINGS.ELEMENTS.HELIUM.DESC"
msgid "(He) Helium is an atomically lightweight, chemical <link=\"ELEMENTSGAS\">Gas</link>."
msgstr "(He) Hélio é um <link=\"ELEMENTSGAS\">Gás</link> químico, atomicamente leve."

#. STRINGS.ELEMENTS.HELIUM.NAME
msgctxt "STRINGS.ELEMENTS.HELIUM.NAME"
msgid "<link=\"HELIUM\">Helium</link>"
msgstr "<link=\"HELIUM\">Hélio</link>"

#. STRINGS.ELEMENTS.HYDROGEN.DESC
msgctxt "STRINGS.ELEMENTS.HYDROGEN.DESC"
msgid ""
"(H) Hydrogen Gas is the universe's most common and atomically light element in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr ""
"(H) Hidrogênio é o elemento mais comum e atomicamente leve do universo em um estado <link=\"ELEMENTSGAS\">Gasoso</link>."

#. STRINGS.ELEMENTS.HYDROGEN.NAME
msgctxt "STRINGS.ELEMENTS.HYDROGEN.NAME"
msgid "<link=\"HYDROGEN\">Hydrogen Gas</link>"
msgstr "<link=\"HYDROGEN\">Hidrogênio</link>"

#. STRINGS.ELEMENTS.ICE.DESC
msgctxt "STRINGS.ELEMENTS.ICE.DESC"
msgid "(H<sub>2</sub>O) Ice is clean water frozen into a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(H<sub>2</sub>O) Gelo é água limpa congelada em um estado <link=\"ELEMENTSSOLID\">Sólido</link>."

#. STRINGS.ELEMENTS.ICE.NAME
msgctxt "STRINGS.ELEMENTS.ICE.NAME"
msgid "<link=\"ICE\">Ice</link>"
msgstr "<link=\"ICE\">Gelo</link>"

#. STRINGS.ELEMENTS.IGNEOUSROCK.DESC
msgctxt "STRINGS.ELEMENTS.IGNEOUSROCK.DESC"
msgid ""
"Igneous Rock is a composite of solidified volcanic rock.\n"
"\n"
"It is useful as a <b>Construction Material</b>."
msgstr ""
"Rocha Ígnea é um composto de rocha vulcânica solidificada.\n"
"\n"
"É útil como <b>Material de Construção</b>."

#. STRINGS.ELEMENTS.IGNEOUSROCK.NAME
msgctxt "STRINGS.ELEMENTS.IGNEOUSROCK.NAME"
msgid "<link=\"IGNEOUSROCK\">Igneous Rock</link>"
msgstr "<link=\"IGNEOUSROCK\">Rocha Ígnea</link>"

#. STRINGS.ELEMENTS.INK.DESC
msgctxt "STRINGS.ELEMENTS.INK.DESC"
msgid ""
"Squid Ink is a heavily pigmented organic <link=\"ELEMENTSLIQUID\">Liquid</link> composed of <link=\"MUCUS\">Mucin</link>, "
"melanin, and <link=\"REFINEDCARBON\">Refined Carbon</link>.\n"
"\n"
"It possesses useful <link=\"RADIATION\">Radiation</link> absorption properties."
msgstr ""
"Tinta de Lula é um <link=\"ELEMENTSLIQUID\">Líquido</link> orgânico fortemente pigmentado composto de mucina, melanina e "
"<link=\"REFINEDCARBON\">Carbono Refinado</link>.\n"
"\n"
"Possui propriedades úteis de absorção de <link=\"RADIATION\">Radiação</link>."

#. STRINGS.ELEMENTS.INK.NAME
msgctxt "STRINGS.ELEMENTS.INK.NAME"
msgid "<link=\"INK\">Squid Ink</link>"
msgstr "<link=\"INK\">Tinta de Lula</link>"

#. STRINGS.ELEMENTS.IRIDIUM.DESC
msgctxt "STRINGS.ELEMENTS.IRIDIUM.DESC"
msgid ""
"(Ir) Iridium is a firm and highly conductive <link=\"METAL\">Metal</link> that can withstand extreme  <link=\"HEAT\">Heat</"
"link>."
msgstr ""
"(Ir) Irídio é um <link=\"METAL\">Metal</link> firme e altamente condutivo que pode suportar <link=\"HEAT\">Calor</link> "
"extremo."

#. STRINGS.ELEMENTS.IRIDIUM.NAME
msgctxt "STRINGS.ELEMENTS.IRIDIUM.NAME"
msgid "<link=\"IRIDIUM\">Iridium</link>"
msgstr "<link=\"IRIDIUM\">Irídio</link>"

#. STRINGS.ELEMENTS.IRIDIUMGAS.DESC
msgctxt "STRINGS.ELEMENTS.IRIDIUMGAS.DESC"
msgid ""
"(Ir) Iridium Gas is a highly conductive <link=\"METAL\">Metal</link> heated into a  <link=\"ELEMENTSGAS\">Gas</link> state."
msgstr ""
"(Ir) Irídio é um <link=\"METAL\">Metal</link> altamente condutor aquecido a um estado <link=\"ELEMENTSGAS\">Gasoso</link>."

#. STRINGS.ELEMENTS.IRIDIUMGAS.NAME
msgctxt "STRINGS.ELEMENTS.IRIDIUMGAS.NAME"
msgid "<link=\"IRIDIUMGAS\">Iridium Gas</link>"
msgstr "<link=\"IRIDIUMGAS\">Irídio</link>"

#. STRINGS.ELEMENTS.IRON.DESC
msgctxt "STRINGS.ELEMENTS.IRON.DESC"
msgid "(Fe) Iron is a common industrial <link=\"REFINEDMETAL\">Metal</link>."
msgstr "(Fe) Ferro é um <link=\"REFINEDMETAL\">Metal</link> industrial comum."

#. STRINGS.ELEMENTS.IRON.NAME
msgctxt "STRINGS.ELEMENTS.IRON.NAME"
msgid "<link=\"IRON\">Iron</link>"
msgstr "<link=\"IRON\">Ferro</link>"

#. STRINGS.ELEMENTS.IRONGAS.DESC
msgctxt "STRINGS.ELEMENTS.IRONGAS.DESC"
msgid "(Fe) Iron Gas is a common industrial <link=\"METAL\">Metal</link>, heated into a <link=\"ELEMENTSGAS\">Gas</link>."
msgstr "(FE) Ferro é um <link=\"METAL\">Metal</link> industrial comum, aquecido em um <link=\"ELEMENTSGAS\">Gás</link>."

#. STRINGS.ELEMENTS.IRONGAS.NAME
msgctxt "STRINGS.ELEMENTS.IRONGAS.NAME"
msgid "<link=\"IRONGAS\">Iron Gas</link>"
msgstr "<link=\"IRONGAS\">Ferro</link>"

#. STRINGS.ELEMENTS.IRONORE.DESC
msgctxt "STRINGS.ELEMENTS.IRONORE.DESC"
msgid ""
"(Fe) Iron Ore is a soft <link=\"METAL\">Metal</link>.\n"
"\n"
"It is suitable for building <link=\"POWER\">Power</link> systems."
msgstr ""
"(Fe) Minério de Ferro é um <link=\"METAL\">Metal</link> macio.\n"
"\n"
"É adequado para construir sistemas de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.IRONORE.NAME
msgctxt "STRINGS.ELEMENTS.IRONORE.NAME"
msgid "<link=\"IRONORE\">Iron Ore</link>"
msgstr "<link=\"IRONORE\">Minério de Ferro</link>"

#. STRINGS.ELEMENTS.ISORESIN.DESC
msgctxt "STRINGS.ELEMENTS.ISORESIN.DESC"
msgid ""
"Isosap is a crystallized sap composed of long-chain polymers.\n"
"\n"
"It is used in the production of rare, high grade materials."
msgstr ""
"Isolátex é uma seiva cristalizada composta por polímeros de cadeia longa.\n"
"\n"
"É usado na produção de materiais raros e de alta qualidade."

#. STRINGS.ELEMENTS.ISORESIN.NAME
msgctxt "STRINGS.ELEMENTS.ISORESIN.NAME"
msgid "<link=\"ISORESIN\">Isosap</link>"
msgstr "<link=\"ISORESIN\">Isoresina</link>"

#. STRINGS.ELEMENTS.KATAIRITE.DESC
msgctxt "STRINGS.ELEMENTS.KATAIRITE.DESC"
msgid "(Ab) Abyssalite is a resilient, crystalline element."
msgstr "(Ab) Abissalito é um elemento cristalino e resiliente."

#. STRINGS.ELEMENTS.KATAIRITE.NAME
msgctxt "STRINGS.ELEMENTS.KATAIRITE.NAME"
msgid "<link=\"KATAIRITE\">Abyssalite</link>"
msgstr "<link=\"KATAIRITE\">Abissalito</link>"

#. STRINGS.ELEMENTS.LATEX.DESC
msgctxt "STRINGS.ELEMENTS.LATEX.DESC"
msgid ""
"Latex is a naturally derived colloidal dispersion of polymer particles in <link=\"ELEMENTSLIQUID\">Liquid</link>.\n"
"\n"
"It can be used to produce <link=\"RUBBER\">Rubber</link>."
msgstr ""
"Látex é uma dispersão coloidal natural de partículas de polímero em <link=\"ELEMENTSLIQUID\">Líquido</link>.\n"
"\n"
"Pode ser usado para produzir <link=\"RUBBER\">Borracha</link>."

#. STRINGS.ELEMENTS.LATEX.NAME
msgctxt "STRINGS.ELEMENTS.LATEX.NAME"
msgid "<link=\"LATEX\">Latex</link>"
msgstr "<link=\"LATEX\">Látex</link>"

#. STRINGS.ELEMENTS.LEAD.DESC
msgctxt "STRINGS.ELEMENTS.LEAD.DESC"
msgid ""
"(Pb) Lead is a soft yet extremely dense <link=\"REFINEDMETAL\">Refined Metal</link>.\n"
"\n"
"It has a low Overheat Temperature and is suitable for building <link=\"POWER\">Power</link> systems."
msgstr ""
"(Pb) Chumbo é <link=\"REFINEDMETAL\">Metal Refinado</link> macio porém extremamente denso.\n"
"\n"
"Ele tem uma baixa Temperatura de Sobreaquecimento e é indicado na construção de circuitos de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.LEAD.NAME
msgctxt "STRINGS.ELEMENTS.LEAD.NAME"
msgid "<link=\"LEAD\">Lead</link>"
msgstr "<link=\"LEAD\">Chumbo</link>"

#. STRINGS.ELEMENTS.LEADGAS.DESC
msgctxt "STRINGS.ELEMENTS.LEADGAS.DESC"
msgid ""
"(Pb) Lead Gas is a soft yet extremely dense <link=\"REFINEDMETAL\">Refined Metal</link> heated into a "
"<link=\"ELEMENTSGAS\">Gaseous</link>."
msgstr ""
"(Pb) Chumbo é um <link=\"REFINEDMETAL\">Metal Refinado</link> macio, mas extremamente denso, aquecido a um estado "
"<link=\"ELEMENTSGAS\">Gasoso</link>."

#. STRINGS.ELEMENTS.LEADGAS.NAME
msgctxt "STRINGS.ELEMENTS.LEADGAS.NAME"
msgid "<link=\"LEADGAS\">Lead Gas</link>"
msgstr "<link=\"LEADGAS\">Chumbo</link>"

#. STRINGS.ELEMENTS.LIME.DESC
msgctxt "STRINGS.ELEMENTS.LIME.DESC"
msgid ""
"(CaCO<sub>3</sub>) Lime is a mineral commonly found in <link=\"CREATURES\">Critter</link> egg shells.\n"
"\n"
"It is useful as a <b>Construction Material</b>."
msgstr ""
"(CaCO<sub>3</sub>) Cal é um mineral comumente encontrado em cascas de ovos de <link=\"CREATURES\">Criaturas</link>.\n"
"\n"
"É útil como um <b>Material de Construção</b>."

#. STRINGS.ELEMENTS.LIME.NAME
msgctxt "STRINGS.ELEMENTS.LIME.NAME"
msgid "<link=\"LIME\">Lime</link>"
msgstr "<link=\"LIME\">Cal</link>"

#. STRINGS.ELEMENTS.LIQUIDCARBONDIOXIDE.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDCARBONDIOXIDE.DESC"
msgid ""
"(CO<sub>2</sub>) Carbon Dioxide is an unbreathable chemical compound.\n"
"\n"
"This selection is currently in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr ""
"(CO<sub>2</sub>) Dióxido de Carbono é um composto químico não respirável.\n"
"\n"
"Esta seleção está atualmente em um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.LIQUIDCARBONDIOXIDE.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDCARBONDIOXIDE.NAME"
msgid "<link=\"LIQUIDCARBONDIOXIDE\">Liquid Carbon Dioxide</link>"
msgstr "<link=\"LIQUIDCARBONDIOXIDE\">Dióxido de Carbono</link>"

#. STRINGS.ELEMENTS.LIQUIDGUNK.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDGUNK.DESC"
msgid ""
"Gunk is the built-up grime and grit produced by Duplicants' bionic mechanisms.\n"
"\n"
"It is unpleasantly viscous."
msgstr ""
"Graxa Biônica é a sujeira e os detritos acumulados pelos mecanismos biônicos dos Duplicantes.\n"
"\n"
"É desagradavelmente viscoso."

#. STRINGS.ELEMENTS.LIQUIDGUNK.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDGUNK.NAME"
msgid "<link=\"LIQUIDGUNK\">Gunk</link>"
msgstr "<link=\"LIQUIDGUNK\">Graxa Biônica</link>"

#. STRINGS.ELEMENTS.LIQUIDHELIUM.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDHELIUM.DESC"
msgid "(He) Helium is an atomically lightweight chemical element cooled into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(He) Hélio é um elemento químico atomicamente leve resfriado para um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.LIQUIDHELIUM.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDHELIUM.NAME"
msgid "<link=\"LIQUIDHELIUM\">Helium</link>"
msgstr "<link=\"LIQUIDHELIUM\">Hélio</link>"

#. STRINGS.ELEMENTS.LIQUIDHYDROGEN.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDHYDROGEN.DESC"
msgid ""
"(H) Hydrogen in its <link=\"ELEMENTSLIQUID\">Liquid</link> state.\n"
"\n"
"It freezes most substances that come into contact with it."
msgstr ""
"(H) Hidrogênio em seu estado <link=\"ELEMENTSLIQUID\">Líquido</link>.\n"
"\n"
"Congela a maioria das substâncias que entram em contato com ele."

#. STRINGS.ELEMENTS.LIQUIDHYDROGEN.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDHYDROGEN.NAME"
msgid "<link=\"LIQUIDHYDROGEN\">Liquid Hydrogen</link>"
msgstr "<link=\"LIQUIDHYDROGEN\">Hidrogênio Líquido</link>"

#. STRINGS.ELEMENTS.LIQUIDMETHANE.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDMETHANE.DESC"
msgid ""
"(CH<sub>4</sub>) Methane is an alkane.\n"
"\n"
"This selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr ""
"(CH<sub>4</sub>) Metano é um alcano.\n"
"\n"
"Esta seleção está em um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.LIQUIDMETHANE.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDMETHANE.NAME"
msgid "<link=\"LIQUIDMETHANE\">Liquid Methane</link>"
msgstr "<link=\"LIQUIDMETHANE\">Metano Líquido</link>"

#. STRINGS.ELEMENTS.LIQUIDOXYGEN.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDOXYGEN.DESC"
msgid ""
"(O<sub>2</sub>) Oxygen is a breathable chemical.\n"
"\n"
"This selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr ""
"(O<sub>2</sub>) Oxigênio é um produto químico respirável.\n"
"\n"
"Esta seleção está em um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.LIQUIDOXYGEN.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDOXYGEN.NAME"
msgid "<link=\"LIQUIDOXYGEN\">Liquid Oxygen</link>"
msgstr "<link=\"LIQUIDOXYGEN\">Oxigênio Líquido</link>"

#. STRINGS.ELEMENTS.LIQUIDPHOSPHORUS.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDPHOSPHORUS.DESC"
msgid ""
"(P) Phosphorus is a chemical element.\n"
"\n"
"This selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr ""
"(P) Fósforo é um elemento químico.\n"
"\n"
"Esta seleção está em um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.LIQUIDPHOSPHORUS.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDPHOSPHORUS.NAME"
msgid "<link=\"LIQUIDPHOSPHORUS\">Liquid Phosphorus</link>"
msgstr "<link=\"LIQUIDPHOSPHORUS\">Fósforo Líquido</link>"

#. STRINGS.ELEMENTS.LIQUIDPROPANE.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDPROPANE.DESC"
msgid ""
"(C<sub>3</sub>H<sub>8</sub>) Propane is an alkane.\n"
"\n"
"This selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state.\n"
"\n"
"It is useful in <link=\"POWER\">Power</link> production."
msgstr ""
"(C<sub>3</sub>H<sub>8</sub>) Propano é um alcano.\n"
"\n"
"Esta seleção está em um estado <link=\"ELEMENTSLIQUID\">Líquido</link>.\n"
"\n"
"É útil na produção de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.LIQUIDPROPANE.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDPROPANE.NAME"
msgid "<link=\"LIQUIDPROPANE\">Liquid Propane</link>"
msgstr "<link=\"LIQUIDPROPANE\">Propano Líquido</link>"

#. STRINGS.ELEMENTS.LIQUIDSULFUR.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDSULFUR.DESC"
msgid ""
"(S) Sulfur is a common chemical element and byproduct of <link=\"METHANE\">Natural Gas</link> production.\n"
"\n"
"This selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr ""
"(S) Enxofre é um elemento químico comum e subproduto da produção de <link=\"METHANE\">Gás Natural</link>.\n"
"\n"
"Esta seleção está em um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.LIQUIDSULFUR.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDSULFUR.NAME"
msgid "<link=\"LIQUIDSULFUR\">Liquid Sulfur</link>"
msgstr "<link=\"LIQUIDSULFUR\">Enxofre Líquido</link>"

#. STRINGS.ELEMENTS.MAFICROCK.DESC
msgctxt "STRINGS.ELEMENTS.MAFICROCK.DESC"
msgid ""
"Mafic Rock is a variation of <link=\"IGNEOUSROCK\">Igneous Rock</link> that is rich in <link=\"IRON\">Iron</link>.\n"
"\n"
"It is useful as a <b>Construction Material</b>."
msgstr ""
"Rocha Máfica é uma variação de <link=\"IGNEOUSROCK\">Rocha gnea</link> que é rica em <link=\"IRON\">Ferro</link>.\n"
"\n"
"É útil como <b>Material de Construção</b>."

#. STRINGS.ELEMENTS.MAFICROCK.NAME
msgctxt "STRINGS.ELEMENTS.MAFICROCK.NAME"
msgid "<link=\"MAFICROCK\">Mafic Rock</link>"
msgstr "<link=\"MAFICROCK\">Rocha Máfica</link>"

#. STRINGS.ELEMENTS.MAGMA.DESC
msgctxt "STRINGS.ELEMENTS.MAGMA.DESC"
msgid ""
"Magma is a composite of <link=\"IGNEOUSROCK\">Igneous Rock</link> heated into a molten, <link=\"ELEMENTSLIQUID\">Liquid</"
"link> state."
msgstr ""
"Magma é um composto de <link=\"IGNEOUSROCK\">Rocha Ígnea</link> aquecido até o estado <link=\"ELEMENTSLIQUID\">Líquido</"
"link>."

#. STRINGS.ELEMENTS.MAGMA.NAME
msgctxt "STRINGS.ELEMENTS.MAGMA.NAME"
msgid "<link=\"MAGMA\">Magma</link>"
msgstr "<link=\"MAGMA\">Magma</link>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.DECOR
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.DECOR"
msgid "<link=\"DECOR\">Decor</link>: {0}"
msgstr "<link=\"DECOR\">Decor</link>: {0}"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.EFFECTS_HEADER
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.EFFECTS_HEADER"
msgid "<b>Resource Effects:</b>"
msgstr "<b>Efeitos do Material:</b>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.EXCELLENT_RADIATION_SHIELD
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.EXCELLENT_RADIATION_SHIELD"
msgid "<link=\"RADIATION\">Excellent Radiation Shield</link>"
msgstr "<link=\"RADIATION\">Excelente Escudo de Radiação</link>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.HIGH_SPECIFIC_HEAT_CAPACITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.HIGH_SPECIFIC_HEAT_CAPACITY"
msgid "<link=\"HEAT\">Slow Heating</link>"
msgstr "<link=\"HEAT\">Aquecimento Lento</link>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.HIGH_THERMAL_CONDUCTIVITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.HIGH_THERMAL_CONDUCTIVITY"
msgid "<link=\"HEAT\">High Thermal Conductivity</link>"
msgstr "<link=\"HEAT\">Alta Condutividade Térmica</link>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.LOW_SPECIFIC_HEAT_CAPACITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.LOW_SPECIFIC_HEAT_CAPACITY"
msgid "<link=\"HEAT\">Thermally Reactive</link>"
msgstr "<link=\"HEAT\">Termorreativo</link>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.LOW_THERMAL_CONDUCTIVITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.LOW_THERMAL_CONDUCTIVITY"
msgid "<link=\"HEAT\">Insulator</link>"
msgstr "<link=\"HEAT\">Isolante</link>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.OVERHEATTEMPERATURE
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.OVERHEATTEMPERATURE"
msgid "<link=\"HEAT\">Overheat Temperature</link>: {0}"
msgstr "<link=\"HEAT\">Temperatura de Superaquecimento</link>: {0}"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.DECOR
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.DECOR"
msgid "This material will add <b>{0}</b> to the finished building's <style=\"KKeyword\">Decor</style>"
msgstr "Este material adicionará <b>{0}</b> à <style=\"KKeyword\">Decor</style> desta estrutura construída"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.EFFECTS_HEADER
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.EFFECTS_HEADER"
msgid "Buildings constructed from this material will have these properties"
msgstr "Estruturas construídas com este material terão estas propriedades"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.EXCELLENT_RADIATION_SHIELD
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.EXCELLENT_RADIATION_SHIELD"
msgid ""
"<style=\"KKeyword\">Excellent Radiation Shield</style> radiation has a hard time passing through materials with a high "
"<style=\"KKeyword\">Radiation Absorption Factor</style> value. \n"
"\n"
"Radiation Absorption Factor: {1}"
msgstr ""
"<style=\"KKeyword\">Escudo de Radiação Excelente</style> a radiação tem dificuldade em passar por materiais com um alto "
"valor de <style=\"KKeyword\">Fator de Absorção de Radiação</style>.\n"
"\n"
"Fator de Absorção de Radiação: {1}"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.HIGH_SPECIFIC_HEAT_CAPACITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.HIGH_SPECIFIC_HEAT_CAPACITY"
msgid ""
"<style=\"KKeyword\">Slow Heating</style> materials require a large amount of energy to raise in "
"<style=\"KKeyword\">Temperature</style>, and therefore heat and cool slowly\n"
"\n"
"Specific Heat Capacity: {1} DTU to raise 1g by 1K"
msgstr ""
"Materiais de <style=\"KKeyword\">Aquecimento Lento</style> requerem uma grande quantidade de energia para aumentar a "
"<style=\"KKeyword\">Temperatura</style> e, portanto, aquecem e esfriam lentamente.\n"
"\n"
"Capacidade de Calor Específico: {1} DTU para aumentar 1g em 1K"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.HIGH_THERMAL_CONDUCTIVITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.HIGH_THERMAL_CONDUCTIVITY"
msgid ""
"This material disperses <style=\"KKeyword\">Heat</style> because energy transfers quickly through materials with high "
"<style=\"KKeyword\">Thermal Conductivity</style>\n"
"\n"
"Between two objects, the rate of <style=\"KKeyword\">Heat</style> transfer will be determined by the object with the "
"<i>lowest</i> <style=\"KKeyword\">Thermal Conductivity</style>\n"
"\n"
"Thermal Conductivity: {1} W per degree K difference (Oxygen: 0.024 W)"
msgstr ""
"Este material dissipa <style=\"KKeyword\">Calor</style> porque a energia se transfere rapidamente através de materiais com "
"alta <style=\"KKeyword\">Condutividade Térmica</style>.\n"
"\n"
"Entre dois objetos, a taxa de transferência de <style=\"KKeyword\">Calor</style> será determinada pelo objeto com a "
"<i>menor</i> <style=\"KKeyword\">Condutividade Térmica</style>.\n"
"\n"
"Condutividade Térmica: {1} W por grau K de diferença (Oxigênio: 0,024 W)"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.LOW_SPECIFIC_HEAT_CAPACITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.LOW_SPECIFIC_HEAT_CAPACITY"
msgid ""
"<style=\"KKeyword\">Thermally Reactive</style> materials require little energy to raise in <style=\"KKeyword\">Temperature</"
"style>, and therefore heat and cool quickly\n"
"\n"
"Specific Heat Capacity: {1} DTU to raise 1g by 1K"
msgstr ""
"Materiais <style=\"KKeyword\">Termicamente Reativos</style> requerem pouca energia para aumentar a "
"<style=\"KKeyword\">Temperatura</style> e, portanto, aquecem e esfriam rapidamente.\n"
"\n"
"Capacidade de Calor Específico: {1} DTU para aumentar 1g em 1K"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.LOW_THERMAL_CONDUCTIVITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.LOW_THERMAL_CONDUCTIVITY"
msgid ""
"This material retains <style=\"KKeyword\">Heat</style> because energy transfers slowly through materials with low "
"<style=\"KKeyword\">Thermal Conductivity</style>\n"
"\n"
"Between two objects, the rate of <style=\"KKeyword\">Heat</style> transfer will be determined by the object with the "
"<i>lowest</i> <style=\"KKeyword\">Thermal Conductivity</style>\n"
"\n"
"Thermal Conductivity: {1} W per degree K difference (Oxygen: 0.024 W)"
msgstr ""
"Este material retém <style=\"KKeyword\">Calor</style> porque a energia se transfere lentamente através de materiais com "
"baixa <style=\"KKeyword\">Condutividade Térmica</style>.\n"
"\n"
"Entre dois objetos, a taxa de transferência de <style=\"KKeyword\">Calor</style> será determinada pelo objeto com a "
"<i>menor</i> <style=\"KKeyword\">Condutividade Térmica</style>.\n"
"\n"
"Condutividade Térmica: {1} W por grau K de diferença (Oxigênio: 0,024 W)"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.OVERHEATTEMPERATURE
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.OVERHEATTEMPERATURE"
msgid "This material will add <b>{0}</b> to the finished building's <style=\"KKeyword\">Overheat Temperature</style>"
msgstr ""
"Este material adicionará <b>{0}</b> à <style=\"KKeyword\">Temperatura de Superaquecimento</style> do estrutura concluído"

#. STRINGS.ELEMENTS.MERCURY.DESC
msgctxt "STRINGS.ELEMENTS.MERCURY.DESC"
msgid "(Hg) Mercury is a metallic <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr "(Hg) Mercúrio  é um <link=\"ELEMENTSLIQUID\">Líquido</link> metálico."

#. STRINGS.ELEMENTS.MERCURY.NAME
msgctxt "STRINGS.ELEMENTS.MERCURY.NAME"
msgid "<link=\"MERCURY\">Mercury</link>"
msgstr "<link=\"MERCURY\">Mercúrio</link>"

#. STRINGS.ELEMENTS.MERCURYGAS.DESC
msgctxt "STRINGS.ELEMENTS.MERCURYGAS.DESC"
msgid "(Hg) Mercury Gas is a <link=\"REFINEDMETAL\">Metal</link> heated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr ""
"(Hg) Gás de Mercúrio é um <link=\"REFINEDMETAL\">Metal</link> refinado aquecido a um estado <link=\"ELEMENTSGAS\">Gasoso</"
"link>."

#. STRINGS.ELEMENTS.MERCURYGAS.NAME
msgctxt "STRINGS.ELEMENTS.MERCURYGAS.NAME"
msgid "<link=\"MERCURYGAS\">Mercury Gas</link>"
msgstr "<link=\"MERCURYGAS\">Mercúrio</link>"

#. STRINGS.ELEMENTS.METHANE.DESC
msgctxt "STRINGS.ELEMENTS.METHANE.DESC"
msgid ""
"Natural Gas is a mixture of various alkanes in a <link=\"ELEMENTSGAS\">Gaseous</link> state.\n"
"\n"
"It is useful in <link=\"POWER\">Power</link> production."
msgstr ""
"O Gás Natural é uma mistura de vários alcanos em estado <link=\"ELEMENTSGAS\">Gasoso</link>.\n"
"\n"
"É útil na produção de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.METHANE.NAME
msgctxt "STRINGS.ELEMENTS.METHANE.NAME"
msgid "<link=\"METHANE\">Natural Gas</link>"
msgstr "<link=\"METHANE\">Gás Natural</link>"

#. STRINGS.ELEMENTS.MILK.DESC
msgctxt "STRINGS.ELEMENTS.MILK.DESC"
msgid ""
"Brackene is a sodium-rich <link=\"ELEMENTSLIQUID\">Liquid</link>.\n"
"\n"
"It is useful in <link=\"RANCHING\">Ranching</link>."
msgstr ""
"Braquil é um <link=\"ELEMENTSLIQUID\">Líquido</link> rico em sódio.\n"
"\n"
"É útil na <link=\"RANCHING\">Pecuária</link>."

#. STRINGS.ELEMENTS.MILK.NAME
msgctxt "STRINGS.ELEMENTS.MILK.NAME"
msgid "<link=\"MILK\">Brackene</link>"
msgstr "<link=\"MILK\">Braquil</link>"

#. STRINGS.ELEMENTS.MILKFAT.DESC
msgctxt "STRINGS.ELEMENTS.MILKFAT.DESC"
msgid "Brackwax is a <link=\"ELEMENTSSOLID\">Solid</link> byproduct of <link=\"MILK\">Brackene</link>."
msgstr "Braquilcera é um subproduto <link=\"ELEMENTSSOLID\">Sólido</link> do <link=\"MILK\">Braquil</link>."

#. STRINGS.ELEMENTS.MILKFAT.NAME
msgctxt "STRINGS.ELEMENTS.MILKFAT.NAME"
msgid "<link=\"MILKFAT\">Brackwax</link>"
msgstr "<link=\"MILKFAT\">Braquilcera</link>"

#. STRINGS.ELEMENTS.MILKICE.DESC
msgctxt "STRINGS.ELEMENTS.MILKICE.DESC"
msgid "Frozen Brackene is <link=\"MILK\">Brackene</link> frozen into a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "Braquil Congelado é <link=\"MILK\">Braquil</link> congelado em um estado <link=\"ELEMENTSSOLID\">Sólido</link>."

#. STRINGS.ELEMENTS.MILKICE.NAME
msgctxt "STRINGS.ELEMENTS.MILKICE.NAME"
msgid "<link=\"MILKICE\">Frozen Brackene</link>"
msgstr "<link=\"MILKICE\">Braquil Congelado</link>"

#. STRINGS.ELEMENTS.MOLTENALUMINUM.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENALUMINUM.DESC"
msgid ""
"(Al) Molten Aluminum is a low density <link=\"REFINEDMETAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</"
"link> state."
msgstr ""
"(Al) Alumínio Fundido é um <link=\"REFINEDMETAL\">Metal</link> de baixa densidade aquecido a um estado "
"<link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENALUMINUM.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENALUMINUM.NAME"
msgid "<link=\"MOLTENALUMINUM\">Molten Aluminum</link>"
msgstr "<link=\"MOLTENALUMINUM\">Alumínio Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENCARBON.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENCARBON.DESC"
msgid "(C) Liquid Carbon is an abundant, versatile element heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(C) Carbono Líquido é um elemento abundante e versátil aquecido a um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENCARBON.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENCARBON.NAME"
msgid "<link=\"MOLTENCARBON\">Liquid Carbon</link>"
msgstr "<link=\"MOLTENCARBON\">Carbono Líquido</link>"

#. STRINGS.ELEMENTS.MOLTENCOBALT.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENCOBALT.DESC"
msgid ""
"(Co) Molten Cobalt is a <link=\"REFINEDMETAL\">Refined Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> "
"state."
msgstr ""
"(Co) Cobalto Fundido é um <link=\"REFINEDMETAL\">Metal Refinado</link> aquecido a um estado "
"<link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENCOBALT.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENCOBALT.NAME"
msgid "<link=\"MOLTENCOBALT\">Molten Cobalt</link>"
msgstr "<link=\"MOLTENCOBALT\">Cobalto Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENCOPPER.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENCOPPER.DESC"
msgid ""
"(Cu) Molten Copper is a conductive <link=\"METAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr ""
"(Cu) Cobre Fundido é um <link=\"METAL\">Metal</link> condutor aquecido a um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENCOPPER.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENCOPPER.NAME"
msgid "<link=\"MOLTENCOPPER\">Molten Copper</link>"
msgstr "<link=\"MOLTENCOPPER\">Cobre Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENGLASS.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENGLASS.DESC"
msgid "Molten Glass is a composite of granular rock, heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Vidro Fundido é um composto de rocha granular, aquecido a um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENGLASS.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENGLASS.NAME"
msgid "<link=\"MOLTENGLASS\">Molten Glass</link>"
msgstr "<link=\"MOLTENGLASS\">Vidro Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENGOLD.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENGOLD.DESC"
msgid ""
"(Au) Gold, a conductive precious <link=\"REFINEDMETAL\">Metal</link>, heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> "
"state."
msgstr ""
"(Au) Ouro, um <link=\"REFINEDMETAL\">Metal</link> precioso condutor, aquecido a um estado <link=\"ELEMENTSLIQUID\">Líquido</"
"link>."

#. STRINGS.ELEMENTS.MOLTENGOLD.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENGOLD.NAME"
msgid "<link=\"MOLTENGOLD\">Molten Gold</link>"
msgstr "<link=\"MOLTENGOLD\">Ouro Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENIRIDIUM.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENIRIDIUM.DESC"
msgid ""
"(Ir) Molten Iridium is a highly conductive <link=\"METAL\">Metal</link> heated to a <link=\"ELEMENTSLIQUID\">Liquid</link> "
"state."
msgstr ""
"(Ir) Irídio Fundido é um <link=\"METAL\">Metal</link> altamente condutor aquecido a um estado "
"<link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENIRIDIUM.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENIRIDIUM.NAME"
msgid "<link=\"MOLTENIRIDIUM\">Molten Iridium</link>"
msgstr "<link=\"MOLTENIRIDIUM\">Irídio Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENIRON.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENIRON.DESC"
msgid ""
"(Fe) Molten Iron is a common industrial <link=\"METAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> "
"state."
msgstr ""
"(Fe) Ferro Fundido é um <link=\"METAL\">Metal</link> industrial comum aquecido a um estado "
"<link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENIRON.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENIRON.NAME"
msgid "<link=\"MOLTENIRON\">Molten Iron</link>"
msgstr "<link=\"MOLTENIRON\">Ferro Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENLEAD.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENLEAD.DESC"
msgid ""
"(Pb) Lead is an extremely dense <link=\"REFINEDMETAL\">Refined Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</"
"link> state."
msgstr ""
"(Pb) Chumbo é um <link=\"REFINEDMETAL\">Metal Refinado</link> extremamente denso aquecido a um estado "
"<link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENLEAD.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENLEAD.NAME"
msgid "<link=\"MOLTENLEAD\">Molten Lead</link>"
msgstr "<link=\"MOLTENLEAD\">Chumbo Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENNICKEL.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENNICKEL.DESC"
msgid ""
"(Ni) Molten Nickel is a conductive <link=\"METAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr ""
"(Ni) Níquel Fundido é um <link=\"METAL\">Metal</link> condutor aquecido a um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENNICKEL.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENNICKEL.NAME"
msgid "<link=\"MOLTENNICKEL\">Molten Nickel</link>"
msgstr "<link=\"MOLTENNICKEL\">Níquel Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENNIOBIUM.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENNIOBIUM.DESC"
msgid "(Nb) Molten Niobium is a rare metal heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Nb) Nióbio Fundido é um metal raro aquecido a um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENNIOBIUM.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENNIOBIUM.NAME"
msgid "<link=\"MOLTENNIOBIUM\">Molten Niobium</link>"
msgstr "<link=\"MOLTENNIOBIUM\">Nióbio Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENSALT.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENSALT.DESC"
msgid ""
"(NaCl) Molten Salt is an edible chemical compound that has been heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr ""
"(NaCl) Sal Fundido é um composto químico comestível que foi aquecido a um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENSALT.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENSALT.NAME"
msgid "<link=\"MOLTENSALT\">Molten Salt</link>"
msgstr "<link=\"MOLTENSALT\">Sal Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENSTEEL.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENSTEEL.DESC"
msgid ""
"Molten Steel is a <link=\"METAL\">Metal</link> alloy of iron and carbon, heated into a hazardous "
"<link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr ""
"Aço Fundido é uma liga de <link=\"METAL\">Metal</link> de ferro e carbono, aquecida a um estado "
"<link=\"ELEMENTSLIQUID\">Líquido</link> perigoso."

#. STRINGS.ELEMENTS.MOLTENSTEEL.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENSTEEL.NAME"
msgid "<link=\"MOLTENSTEEL\">Molten Steel</link>"
msgstr "<link=\"MOLTENSTEEL\">Aço Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENSUCROSE.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENSUCROSE.DESC"
msgid ""
"(C<sub>12</sub>H<sub>22</sub>O<sub>11</sub>) Liquid Sucrose is the raw form of sugar, heated into a "
"<link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr ""
"(C<sub>12</sub>H<sub>22</sub>O<sub>11</sub>) Sacarose é a forma bruta do açúcar, aquecida a um estado "
"<link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENSUCROSE.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENSUCROSE.NAME"
msgid "<link=\"MOLTENSUCROSE\">Liquid Sucrose</link>"
msgstr "<link=\"MOLTENSUCROSE\">Sacarose Líquida</link>"

#. STRINGS.ELEMENTS.MOLTENSYNGAS.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENSYNGAS.DESC"
msgid ""
"Molten Synthesis Gas is an artificial, unbreathable <link=\"ELEMENTSLIQUID\">Liquid</link>.\n"
"\n"
"It can be converted into an efficient fuel."
msgstr ""
"O Gás de Síntese Fundido é um <link=\"ELEMENTSLIQUID\">Líquido</link> artificial, não respirável.\n"
"\n"
"Pode ser convertido em um combustível eficiente."

#. STRINGS.ELEMENTS.MOLTENSYNGAS.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENSYNGAS.NAME"
msgid "<link=\"SYNGAS\">Molten Synthesis Gas</link>"
msgstr "<link=\"SYNGAS\">Gás de Síntese Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENTUNGSTEN.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENTUNGSTEN.DESC"
msgid ""
"(W) Molten Tungsten is a crystalline <link=\"REFINEDMETAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</"
"link> state."
msgstr ""
"(W) Tungstênio Fundido é um <link=\"REFINEDMETAL\">Metal</link> cristalino, aquecido até o estado "
"<link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENTUNGSTEN.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENTUNGSTEN.NAME"
msgid "<link=\"MOLTENTUNGSTEN\">Molten Tungsten</link>"
msgstr "<link=\"MOLTENTUNGSTEN\">Tungstênio Fundido</link>"

#. STRINGS.ELEMENTS.MOLTENTUNGSTENDISELENIDE.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENTUNGSTENDISELENIDE.DESC"
msgid ""
"(WSe<sub>2</sub>) Tungsten Diselenide is an inorganic <link=\"METAL\">Metal</link> compound heated into a "
"<link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr ""
"(WSe<sub>2</sub>) Diseleneto de Tungstênio é um composto de <link=\"METAL\">Metal</link> inorgânico aquecido a um estado "
"<link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENTUNGSTENDISELENIDE.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENTUNGSTENDISELENIDE.NAME"
msgid "<link=\"MOLTENTUNGSTENDISELENIDE\">Tungsten Diselenide</link>"
msgstr "<link=\"MOLTENTUNGSTENDISELENIDE\">Disseleneto de Tungstênio</link>"

#. STRINGS.ELEMENTS.MOLTENURANIUM.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENURANIUM.DESC"
msgid ""
"(U) Liquid Uranium is a highly <link=\"RADIATION\">Radioactive</link> substance, heated into a hazardous "
"<link=\"ELEMENTSLIQUID\">Liquid</link> state.\n"
"\n"
"It is a byproduct of <link=\"ENRICHEDURANIUM\">Enriched Uranium</link>."
msgstr ""
"(U) Urânio é uma substância altamente <link=\"RADIATION\">Radioativa</link>, aquecida a um estado "
"<link=\"ELEMENTSLIQUID\">Líquido</link> perigoso.\n"
"\n"
"É um subproduto do <link=\"ENRICHEDURANIUM\">Urânio Enriquecido</link>."

#. STRINGS.ELEMENTS.MOLTENURANIUM.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENURANIUM.NAME"
msgid "<link=\"MOLTENURANIUM\">Liquid Uranium</link>"
msgstr "<link=\"MOLTENURANIUM\">Urânio</link>"

#. STRINGS.ELEMENTS.MOLTENZINC.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENZINC.DESC"
msgid "Molten Zinc is <link=\"ZINC\">Zinc</link> heated into <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Zinco Fundido é <link=\"ZINC\">Zinco</link> aquecido a um estado <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.ELEMENTS.MOLTENZINC.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENZINC.NAME"
msgid "<link=\"MOLTENZINC\">Molten Zinc</link>"
msgstr "<link=\"MOLTENZINC\">Zinco Fundido</link>"

#. STRINGS.ELEMENTS.MUCUS.DESC
msgctxt "STRINGS.ELEMENTS.MUCUS.DESC"
msgid ""
"Mucin is an extremely viscous <link=\"ELEMENTSLIQUID\">Liquid</link> gel composed of natural enzymes and polysaccharides.\n"
"\n"
"Its unusually thick consistency can result in formations atypical of most liquids."
msgstr ""
"A Mucina é um gel de <link=\"ELEMENTSLIQUID\">Líquido</link> extremamente viscoso composto por enzimas naturais e "
"polissacarídeos.\n"
"\n"
"Sua consistência inusualmente espessa pode resultar em formações atípicas da maioria dos líquidos."

#. STRINGS.ELEMENTS.MUCUS.NAME
msgctxt "STRINGS.ELEMENTS.MUCUS.NAME"
msgid "<link=\"MUCUS\">Mucin</link>"
msgstr "<link=\"MUCUS\">Mucina</link>"

#. STRINGS.ELEMENTS.MUD.DESC
msgctxt "STRINGS.ELEMENTS.MUD.DESC"
msgid ""
"A mixture of <link=\"DIRT\">Dirt</link> and <link=\"WATER\">Water</link>.\n"
"\n"
"Can be separated into its base elements using a <link=\"SLUDGEPRESS\">Sludge Press</link>."
msgstr ""
"Uma mistura de <link=\"DIRT\">Terra</link> e <link=\"WATER\">Água</link>.\n"
"\n"
"Pode ser separada em seus elementos básicos usando uma <link=\"SLUDGEPRESS\">Imprensa de Lodo</link>."

#. STRINGS.ELEMENTS.MUD.NAME
msgctxt "STRINGS.ELEMENTS.MUD.NAME"
msgid "<link=\"MUD\">Mud</link>"
msgstr "<link=\"MUD\">Lama</link>"

#. STRINGS.ELEMENTS.MURKYBRINE.DESC
msgctxt "STRINGS.ELEMENTS.MURKYBRINE.DESC"
msgid ""
"Polluted Brine is a murky, concentrated solution of <link=\"SALT\">Salt</link> dissolved in <link=\"DIRTYWATER\">Polluted "
"Water</link>.\n"
"\n"
"It can be used in desalination processes, separating out usable salt."
msgstr ""
"Salmoura Poluída é uma solução turva e concentrada de <link=\"SALT\">Sal</link> dissolvida em <link=\"DIRTYWATER\">Água "
"Poluída</link>.\n"
"\n"
"Pode ser usada em processos de dessalinização, separando o sal utilizável."

#. STRINGS.ELEMENTS.MURKYBRINE.NAME
msgctxt "STRINGS.ELEMENTS.MURKYBRINE.NAME"
msgid "<link=\"MURKYBRINE\">Polluted Brine</link>"
msgstr "<link=\"MURKYBRINE\">Salmoura Poluída</link>"

#. STRINGS.ELEMENTS.MURKYBRINEICE.DESC
msgctxt "STRINGS.ELEMENTS.MURKYBRINEICE.DESC"
msgid ""
"Polluted Brine Ice is a murky, concentrated solution of <link=\"SALT\">Salt</link> dissolved in "
"<link=\"DIRTYWATER\">Polluted Water</link> and frozen into a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr ""
"Salmoura Poluída Congelada é uma solução turva e concentrada de <link=\"SALT\">Sal</link> dissolvida em "
"<link=\"DIRTYWATER\">Água Poluída</link> e congelada em um estado <link=\"ELEMENTSSOLID\">Sólido</link>."

#. STRINGS.ELEMENTS.MURKYBRINEICE.NAME
msgctxt "STRINGS.ELEMENTS.MURKYBRINEICE.NAME"
msgid "<link=\"MURKYBRINEICE\">Polluted Brine Ice</link>"
msgstr "<link=\"MURKYBRINEICE\">Salmoura Poluída Congelada</link>"

#. STRINGS.ELEMENTS.NAPHTHA.DESC
msgctxt "STRINGS.ELEMENTS.NAPHTHA.DESC"
msgid "Naphtha a distilled hydrocarbon mixture produced from the burning of <link=\"POLYPROPYLENE\">Plastic</link>."
msgstr ""
"Nafta é uma mistura de hidrocarbonetos destilados produzida a partir da queima de <link=\"POLYPROPYLENE\">Plástico</link>."

#. STRINGS.ELEMENTS.NAPHTHA.NAME
msgctxt "STRINGS.ELEMENTS.NAPHTHA.NAME"
msgid "<link=\"NAPHTHA\">Liquid Naphtha</link>"
msgstr "<link=\"NAPHTHA\">Nafta</link>"

#. STRINGS.ELEMENTS.NATURALRESIN.DESC
msgctxt "STRINGS.ELEMENTS.NATURALRESIN.DESC"
msgid ""
"Resin is a viscous organic <link=\"ELEMENTSLIQUID\">Liquid</link>.\n"
"\n"
"It can be treated to become <link=\"POLYPROPYLENE\">Plastic</link> in the <link=\"POLYMERIZER\">Polymer Press</link>."
msgstr ""
"Resina é um <link=\"ELEMENTSLIQUID\">Líquido</link> orgânico viscoso.\n"
"\n"
"Pode ser tratada para se tornar <link=\"POLYPROPYLENE\">Plástico</link> na <link=\"POLYMERIZER\">Prensa Polimérica</link>."

#. STRINGS.ELEMENTS.NATURALRESIN.NAME
msgctxt "STRINGS.ELEMENTS.NATURALRESIN.NAME"
msgid "<link=\"NATURALRESIN\">Resin</link>"
msgstr "<link=\"NATURALRESIN\">Resina</link>"

#. STRINGS.ELEMENTS.NATURALSOLIDRESIN.DESC
msgctxt "STRINGS.ELEMENTS.NATURALSOLIDRESIN.DESC"
msgid ""
"Resin that has been cooled to a <link=\"ELEMENTSSOLID\">Solid</link> state.\n"
"\n"
"It can be treated to become <link=\"POLYPROPYLENE\">Plastic</link> in the <link=\"POLYMERIZER\">Polymer Press</link>."
msgstr ""
"Resina que foi resfriada até o estado <link=\"ELEMENTSSOLID\">Sólido</link>.\n"
"\n"
"Pode ser tratada para se tornar <link=\"POLYPROPYLENE\">Plástico</link> na <link=\"POLYMERIZER\">Prensa Polimérica</link>."

#. STRINGS.ELEMENTS.NATURALSOLIDRESIN.NAME
msgctxt "STRINGS.ELEMENTS.NATURALSOLIDRESIN.NAME"
msgid "<link=\"NATURALSOLIDRESIN\">Solid Resin</link>"
msgstr "<link=\"NATURALSOLIDRESIN\">Resina Sólida</link>"

#. STRINGS.ELEMENTS.NICKEL.DESC
msgctxt "STRINGS.ELEMENTS.NICKEL.DESC"
msgid ""
"(Ni) Nickel is a conductive <link=\"METAL\">Metal</link>.\n"
"\n"
"It is suitable for building <link=\"POWER\">Power</link> systems."
msgstr ""
"(Ni) Níquel é um <link=\"METAL\">Metal</link> condutor.\n"
"\n"
"É adequado para construir sistemas de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.NICKEL.NAME
msgctxt "STRINGS.ELEMENTS.NICKEL.NAME"
msgid "<link=\"NICKEL\">Nickel</link>"
msgstr "<link=\"NICKEL\">Níquel</link>"

#. STRINGS.ELEMENTS.NICKELGAS.DESC
msgctxt "STRINGS.ELEMENTS.NICKELGAS.DESC"
msgid "(Ni) Nickel Gas is a conductive <link=\"METAL\">Metal</link> heated into a <link=\"ELEMENTSGAS\">Gas</link> state."
msgstr "(Ni) Níquel é um <link=\"METAL\">Metal</link> condutivo aquecido até o estado <link=\"ELEMENTSGAS\">Gasoso</link>."

#. STRINGS.ELEMENTS.NICKELGAS.NAME
msgctxt "STRINGS.ELEMENTS.NICKELGAS.NAME"
msgid "<link=\"NICKELGAS\">Nickel Gas</link>"
msgstr "<link=\"NICKELGAS\">Níquel</link>"

#. STRINGS.ELEMENTS.NICKELORE.DESC
msgctxt "STRINGS.ELEMENTS.NICKELORE.DESC"
msgid ""
"(Ni) Nickel Ore is a conductive <link=\"METAL\">Metal</link>.\n"
"\n"
"It can be refined into <link=\"NICKEL\">Nickel</link> and is suitable for building <link=\"POWER\">Power</link> systems."
msgstr ""
"(Ni) Minério de Níquel é um <link=\"METAL\">Metal</link> condutivo.\n"
"\n"
"Pode ser refinado em <link=\"NICKEL\">Níquel</link> e é adequado para construir sistemas de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.NICKELORE.NAME
msgctxt "STRINGS.ELEMENTS.NICKELORE.NAME"
msgid "<link=\"NICKELORE\">Nickel Ore</link>"
msgstr "<link=\"NICKELORE\">Minério de Níquel</link>"

#. STRINGS.ELEMENTS.NIOBIUM.DESC
msgctxt "STRINGS.ELEMENTS.NIOBIUM.DESC"
msgid ""
"(Nb) Niobium is a rare metal with many practical applications in metallurgy and superconductor <link=\"RESEARCH\">Research</"
"link>."
msgstr ""
"(Nb) Nióbio é um metal raro com muitas aplicações práticas em metalurgia e <link=\"RESEARCH\">Pesquisa</link> de "
"supercondutores."

#. STRINGS.ELEMENTS.NIOBIUM.NAME
msgctxt "STRINGS.ELEMENTS.NIOBIUM.NAME"
msgid "<link=\"NIOBIUM\">Niobium</link>"
msgstr "<link=\"NIOBIUM\">Nióbio</link>"

#. STRINGS.ELEMENTS.NIOBIUMGAS.DESC
msgctxt "STRINGS.ELEMENTS.NIOBIUMGAS.DESC"
msgid ""
"(Nb) Niobium Gas is a rare metal.\n"
"\n"
"This selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr ""
"(Nb) Nióbio é um metal raro.\n"
"\n"
"Esta seleção está em um estado <link=\"ELEMENTSGAS\">Gasoso</link>."

#. STRINGS.ELEMENTS.NIOBIUMGAS.NAME
msgctxt "STRINGS.ELEMENTS.NIOBIUMGAS.NAME"
msgid "<link=\"NIOBIUMGAS\">Niobium Gas</link>"
msgstr "<link=\"NIOBIUMGAS\">Nióbio</link>"

#. STRINGS.ELEMENTS.NUCLEARWASTE.DESC
msgctxt "STRINGS.ELEMENTS.NUCLEARWASTE.DESC"
msgid ""
"Highly toxic liquid full of <link=\"RADIATION\">Radioactive Contaminants</link> which emit <link=\"RADIATION\">Radiation</"
"link> that can be absorbed by <link=\"HIGHENERGYPARTICLESPAWNER\">Radbolt Generators</link>."
msgstr ""
"Líquido altamente tóxico feito de <link=\"RADIATION\">Contaminantes Radioativos</link> que emitem "
"<link=\"RADIATION\">Radiação</link> que pode ser absorvida por <link=\"HIGHENERGYPARTICLESPAWNER\">Geradores de Radioraios</"
"link>."

#. STRINGS.ELEMENTS.NUCLEARWASTE.NAME
msgctxt "STRINGS.ELEMENTS.NUCLEARWASTE.NAME"
msgid "<link=\"NUCLEARWASTE\">Liquid Nuclear Waste</link>"
msgstr "<link=\"NUCLEARWASTE\">Lixo Radioativo Líquido</link>"

#. STRINGS.ELEMENTS.OBSIDIAN.DESC
msgctxt "STRINGS.ELEMENTS.OBSIDIAN.DESC"
msgid "Obsidian is a brittle composite of volcanic <link=\"GLASS\">Glass</link>."
msgstr "Obsidiana é um composto frágil de <link=\"GLASS\">Vidro</link> vulcânico."

#. STRINGS.ELEMENTS.OBSIDIAN.NAME
msgctxt "STRINGS.ELEMENTS.OBSIDIAN.NAME"
msgid "<link=\"OBSIDIAN\">Obsidian</link>"
msgstr "<link=\"OBSIDIAN\">Obsidiana</link>"

#. STRINGS.ELEMENTS.OXYGEN.DESC
msgctxt "STRINGS.ELEMENTS.OXYGEN.DESC"
msgid ""
"(O<sub>2</sub>) Oxygen is an atomically lightweight and breathable <link=\"ELEMENTSGAS\">Gas</link>, necessary for "
"sustaining life.\n"
"\n"
"It tends to rise above other gases."
msgstr ""
"(O<sub>2</sub>) Oxigênio é um <link=\"ELEMENTSGAS\">Gás</link> atomicamente leve e respirável, necessário para sustentar a "
"vida.\n"
"\n"
"Ele tende a se elevar acima de outros gases."

#. STRINGS.ELEMENTS.OXYGEN.NAME
msgctxt "STRINGS.ELEMENTS.OXYGEN.NAME"
msgid "<link=\"OXYGEN\">Oxygen</link>"
msgstr "<link=\"OXYGEN\">Oxigênio</link>"

#. STRINGS.ELEMENTS.OXYROCK.DESC
msgctxt "STRINGS.ELEMENTS.OXYROCK.DESC"
msgid ""
"(Ir<sub>3</sub>O<sub>2</sub>) Oxylite is a chemical compound that slowly emits breathable <link=\"OXYGEN\">Oxygen</link>.\n"
"\n"
"Excavating <link=\"OXYROCK\">Oxylite</link> increases its emission rate, but depletes the ore more rapidly."
msgstr ""
"(Ir<sub>3</sub>O<sub>2</sub>) Oxilito é um composto químico que emite lentamente <link=\"OXYGEN\">Oxigênio</link> "
"respirável.\n"
"\n"
"Escavar <link=\"OXYROCK\">Oxilito</link> aumenta sua taxa de emissão, mas esgota o minério mais rapidamente."

#. STRINGS.ELEMENTS.OXYROCK.NAME
msgctxt "STRINGS.ELEMENTS.OXYROCK.NAME"
msgid "<link=\"OXYROCK\">Oxylite</link>"
msgstr "<link=\"OXYROCK\">Oxilito</link>"

#. STRINGS.ELEMENTS.PALMWOOD.DESC
msgctxt "STRINGS.ELEMENTS.PALMWOOD.DESC"
msgid ""
"Gum Wood can be processed at the <link=\"MILKPRESS\">Plant Pulverizer</link> to yield <link=\"LATEX\">Latex</link>, which "
"is essential for <link=\"RUBBER\">Rubber</link> production.\n"
"\n"
"It can also be used for <link=\"HEAT\">Heat</link> and <link=\"POWER\">Power</link>, or as a <b>Construction Material</b>."
msgstr ""
"A Madeira Goma pode ser processada no <link=\"MILKPRESS\">Pulverizador de Plantas</link> para produzir "
"<link=\"LATEX\">Látex</link>, que é essencial para a produção de <link=\"RUBBER\">Borracha</link>.\n"
"\n"
"Também pode ser usada para <link=\"HEAT\">Calor</link> e <link=\"POWER\">Energia</link>, ou como <b>Material de Construção</"
"b>."

#. STRINGS.ELEMENTS.PALMWOOD.NAME
msgctxt "STRINGS.ELEMENTS.PALMWOOD.NAME"
msgid "<link=\"PALMWOOD\">Gum Wood</link>"
msgstr "<link=\"PALMWOOD\">Madeira Goma</link>"

#. STRINGS.ELEMENTS.PEARL.DESC
msgctxt "STRINGS.ELEMENTS.PEARL.DESC"
msgid ""
"A perfectly smooth gem.\n"
"\n"
"It can be eaten by <link=\"SEAHORSESPECIES\">Seaquines</link> or used as an attractive <b>Construction Material</b>."
msgstr ""
"Uma gema perfeitamente lisa.\n"
"\n"
"Pode ser comida por <link=\"SEAHORSESPECIES\">Marvalos</link> ou usada como um <b>Material de Construção</b> atraente."

#. STRINGS.ELEMENTS.PEARL.NAME
msgctxt "STRINGS.ELEMENTS.PEARL.NAME"
msgid "<link=\"PEARL\">Pearl</link>"
msgstr "<link=\"PEARL\">Pérola</link>"

#. STRINGS.ELEMENTS.PEAT.DESC
msgctxt "STRINGS.ELEMENTS.PEAT.DESC"
msgid ""
"Peat is a densely packed material made up of partially decomposed organic matter.\n"
"\n"
"It is a combustible fuel, useful in <link=\"POWER\">Power</link> production."
msgstr ""
"Turfa é um material densamente compactado feito de matéria orgânica parcialmente decomposta.\n"
"\n"
"É um combustível combustível, útil na produção de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.PEAT.NAME
msgctxt "STRINGS.ELEMENTS.PEAT.NAME"
msgid "<link=\"PEAT\">Peat</link>"
msgstr "<link=\"PEAT\">Turfa</link>"

#. STRINGS.ELEMENTS.PETROLEUM.DESC
msgctxt "STRINGS.ELEMENTS.PETROLEUM.DESC"
msgid ""
"Petroleum is a <link=\"POWER\">Power</link> source refined from <link=\"CRUDEOIL\">Crude Oil</link>.\n"
"\n"
"It is also an essential ingredient in the production of <link=\"POLYPROPYLENE\">Plastic</link>."
msgstr ""
"O Petróleo é uma fonte de <link=\"POWER\">Energia</link> refinada a partir do <link=\"CRUDEOIL\">Petróleo Bruto</link>.\n"
"\n"
"Ele também é um ingrediente essencial na produção de <link=\"POLYPROPYLENE\">Plástico</link>."

#. STRINGS.ELEMENTS.PETROLEUM.NAME
msgctxt "STRINGS.ELEMENTS.PETROLEUM.NAME"
msgid "<link=\"PETROLEUM\">Petroleum</link>"
msgstr "<link=\"PETROLEUM\">Petróleo</link>"

#. STRINGS.ELEMENTS.PETROLEUM.NAME_TWO
msgctxt "STRINGS.ELEMENTS.PETROLEUM.NAME_TWO"
msgid "<link=\"PETROLEUM\">Petroleum</link>"
msgstr "<link=\"PETROLEUM\">Petróleo</link>"

#. STRINGS.ELEMENTS.PHOSPHATENODULES.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHATENODULES.DESC"
msgid "(PO<sup>3-</sup><sub>4</sub>) Nodules of sedimentary rock containing high concentrations of phosphate."
msgstr "(PO<sup>3-</sup><sub>4</sub>) Nódulos de rocha sedimentar contendo altas concentrações de fosfato."

#. STRINGS.ELEMENTS.PHOSPHATENODULES.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHATENODULES.NAME"
msgid "<link=\"PHOSPHATENODULES\">Phosphate Nodules</link>"
msgstr "<link=\"PHOSPHATENODULES\">Nódulos de Fosfato</link>"

#. STRINGS.ELEMENTS.PHOSPHORITE.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHORITE.DESC"
msgid "Phosphorite is a composite of sedimentary rock, saturated with phosphate."
msgstr "A fosforita é um composto de rocha sedimentar, saturado de fosfato."

#. STRINGS.ELEMENTS.PHOSPHORITE.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHORITE.NAME"
msgid "<link=\"PHOSPHORITE\">Phosphorite</link>"
msgstr "<link=\"FOSFORITE\">Fosforita</link>"

#. STRINGS.ELEMENTS.PHOSPHORUS.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHORUS.DESC"
msgid "(P) Refined Phosphorus is a chemical element in its <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(P) Fósforo Refinado é um elemento químico em seu estado <link=\"ELEMENTSSOLID\">Sólido</link>."

#. STRINGS.ELEMENTS.PHOSPHORUS.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHORUS.NAME"
msgid "<link=\"PHOSPHORUS\">Refined Phosphorus</link>"
msgstr "<link=\"PHOSPHORUS\">Fósforo Refinado</link>"

#. STRINGS.ELEMENTS.PHOSPHORUSGAS.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHORUSGAS.DESC"
msgid ""
"(P) Phosphorus Gas is the <link=\"ELEMENTSGAS\">Gaseous</link> state of <link=\"PHOSPHORUS\">Refined Phosphorus</link>."
msgstr "(P) Fósforo é o estado <link=\"ELEMENTSGAS\">Gasoso</link> do <link=\"PHOSPHORUS\">Fósforo Refinado</link>."

#. STRINGS.ELEMENTS.PHOSPHORUSGAS.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHORUSGAS.NAME"
msgid "<link=\"PHOSPHORUSGAS\">Phosphorus Gas</link>"
msgstr "<link=\"PHOSPHORUSGAS\">Fósforo</link>"

#. STRINGS.ELEMENTS.PHYTOOIL.DESC
msgctxt "STRINGS.ELEMENTS.PHYTOOIL.DESC"
msgid ""
"Phyto Oil is a thick, slippery <link=\"ELEMENTSLIQUID\">Liquid</link> extracted from pureed <link=\"SLIME\">Slime</link>."
msgstr ""
"Óleo Fito é um <link=\"ELEMENTSLIQUID\">Líquido</link> espesso e viscoso extraído do <link=\"SLIME\">Limo</link> processado."

#. STRINGS.ELEMENTS.PHYTOOIL.NAME
msgctxt "STRINGS.ELEMENTS.PHYTOOIL.NAME"
msgid "<link=\"PHYTOOIL\">Phyto Oil</link>"
msgstr "<link=\"PHYTOOIL\">Óleo Fito</link>"

#. STRINGS.ELEMENTS.POLYPROPYLENE.BUILD_DESC
msgctxt "STRINGS.ELEMENTS.POLYPROPYLENE.BUILD_DESC"
msgid "Buildings made of this <link=\"POLYPROPYLENE\">Plastic</link> have antiseptic properties"
msgstr "Estruturas feitas deste <link=\"POLYPROPYLENE\">Plástico</link> têm propriedades antissépticas"

#. STRINGS.ELEMENTS.POLYPROPYLENE.DESC
msgctxt "STRINGS.ELEMENTS.POLYPROPYLENE.DESC"
msgid ""
"(C<sub>3</sub>H<sub>6</sub>)<sub>n</sub> <link=\"POLYPROPYLENE\">Plastic</link> is a thermoplastic polymer.\n"
"\n"
"It is useful for constructing a variety of advanced buildings and equipment."
msgstr ""
"(C<sub>3</sub>H<sub>6</sub>)<sub>n</sub> <link=\"POLYPROPYLENE\">Plástico</link> é um polímero termoplástico.\n"
"\n"
"É útil para construir uma variedade de estruturas e equipamentos avançados."

#. STRINGS.ELEMENTS.POLYPROPYLENE.NAME
msgctxt "STRINGS.ELEMENTS.POLYPROPYLENE.NAME"
msgid "<link=\"POLYPROPYLENE\">Plastic</link>"
msgstr "<link=\"POLYPROPYLENE\">Plástico</link>"

#. STRINGS.ELEMENTS.PONDSCUM.DESC
msgctxt "STRINGS.ELEMENTS.PONDSCUM.DESC"
msgid ""
"Pondscum is a soft, naturally occurring composite of biological nutrients.\n"
"\n"
"It may be processed into <link=\"FERTILIZER\">Fertilizer</link> and aids in the growth of certain <link=\"PLANTS\">Plants</"
"link>."
msgstr ""
"Lodo de Lagoa é um composto macio e natural de nutrientes biológicos.\n"
"\n"
"Pode ser processado em <link=\"FERTILIZER\">Fertilizante</link> e auxilia no crescimento de certas "
"<link=\"PLANTS\">Plantas</link>."

#. STRINGS.ELEMENTS.PONDSCUM.NAME
msgctxt "STRINGS.ELEMENTS.PONDSCUM.NAME"
msgid "<link=\"PONDSCUM\">Pondscum</link>"
msgstr "<link=\"PONDSCUM\">Lodo de Lagoa</link>"

#. STRINGS.ELEMENTS.PROPANE.DESC
msgctxt "STRINGS.ELEMENTS.PROPANE.DESC"
msgid ""
"(C<sub>3</sub>H<sub>8</sub>) Propane Gas is a natural alkane.\n"
"\n"
"This selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state.\n"
"\n"
"It is useful in <link=\"POWER\">Power</link> production."
msgstr ""
"(C<sub>3</sub>H<sub>8</sub>) Gás Propano é um alcano natural.\n"
"\n"
"Esta seleção está em um estado <link=\"ELEMENTSGAS\">Gasoso</link>.\n"
"\n"
"É útil na produção de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.PROPANE.NAME
msgctxt "STRINGS.ELEMENTS.PROPANE.NAME"
msgid "<link=\"PROPANE\">Propane Gas</link>"
msgstr "<link=\"PROPANE\">Gás Propano</link>"

#. STRINGS.ELEMENTS.RADIATIONPROPERTIES
msgctxt "STRINGS.ELEMENTS.RADIATIONPROPERTIES"
msgid ""
"Radiation Absorption Factor: {0}\n"
"Radiation Emission/1000kg: {1}"
msgstr ""
"Fator de Absorção de Radiação: {0}\n"
"Emissão de Radiação/1000kg: {1}"

#. STRINGS.ELEMENTS.RADIUM.DESC
msgctxt "STRINGS.ELEMENTS.RADIUM.DESC"
msgid ""
"(Ra) Radium is a <link=\"LIGHT\">Light</link> emitting radioactive substance.\n"
"\n"
"It is useful as a <link=\"POWER\">Power</link> source."
msgstr ""
"(Ra) Rádio é uma substância radioativa emissora de <link=\"LIGHT\">Luz</link>.\n"
"\n"
"É útil como fonte de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.RADIUM.NAME
msgctxt "STRINGS.ELEMENTS.RADIUM.NAME"
msgid "<link=\"RADIUM\">Radium</link>"
msgstr "<link=\"RADIUM\">Rádio</link>"

#. STRINGS.ELEMENTS.REFINEDCARBON.DESC
msgctxt "STRINGS.ELEMENTS.REFINEDCARBON.DESC"
msgid "(C) Refined carbon is solid element purified from raw <link=\"CARBON\">Coal</link>."
msgstr "(C) Carbono refinado é um elemento sólido purificado a partir de <link=\"CARBON\">Carvão</link> bruto."

#. STRINGS.ELEMENTS.REFINEDCARBON.NAME
msgctxt "STRINGS.ELEMENTS.REFINEDCARBON.NAME"
msgid "<link=\"REFINEDCARBON\">Refined Carbon</link>"
msgstr "<link=\"REFINEDCARBON\">Carbono Refinado</link>"

#. STRINGS.ELEMENTS.REFINEDLIPID.DESC
msgctxt "STRINGS.ELEMENTS.REFINEDLIPID.DESC"
msgid ""
"Biodiesel is a <link=\"ELEMENTSLIQUID\">Liquid</link> composed of highly processed fatty acids derived from purified "
"natural oils.\n"
"\n"
"Its <link=\"COMBUSTIBLELIQUID\">combustibility</link> makes it useful for <link=\"POWER\">Power</link> production."
msgstr ""
"Biodiesel é um <link=\"ELEMENTSLIQUID\">Líquido</link> composto por ácidos graxos altamente processados derivados de óleos "
"naturais purificados.\n"
"\n"
"Sua <link=\"COMBUSTIBLELIQUID\">combustibilidade</link> a torna útil para a produção de <link=\"POWER\">Energia</link>."

#. STRINGS.ELEMENTS.REFINEDLIPID.NAME
msgctxt "STRINGS.ELEMENTS.REFINEDLIPID.NAME"
msgid "<link=\"REFINEDLIPID\">Biodiesel</link>"
msgstr "<link=\"REFINEDLIPID\">Biodiesel</link>"

#. STRINGS.ELEMENTS.REGOLITH.DESC
msgctxt "STRINGS.ELEMENTS.REGOLITH.DESC"
msgid ""
"Regolith is a sandy substance composed of the various particles that collect atop terrestrial objects.\n"
"\n"
"It is useful as a <link=\"FILTER\">Filtration Medium</link>."
msgstr ""
"Regolito é uma substância arenosa composta por várias partículas que se acumulam sobre objetos terrestres.\n"
"\n"
"É útil como <link=\"FILTER\">Meio de Filtragem</link>."

#. STRINGS.ELEMENTS.REGOLITH.NAME
msgctxt "STRINGS.ELEMENTS.REGOLITH.NAME"
msgid "<link=\"REGOLITH\">Regolith</link>"
msgstr "<link=\"REGOLITH\">Regolito</link>"

#. STRINGS.ELEMENTS.RESIN.DESC
msgctxt "STRINGS.ELEMENTS.RESIN.DESC"
msgid ""
"Sticky goo harvested from a grumpy tree.\n"
"\n"
"It can be polymerized into <link=\"ISORESIN\">Isosap</link> by boiling away its excess moisture."
msgstr ""
"Goma pegajosa colhida de uma árvore ranzinza.\n"
"\n"
"Pode ser polimerizada em <link=\"ISORESIN\">Isoresina</link> fervendo sua umidade em excesso."

#. STRINGS.ELEMENTS.RESIN.NAME
msgctxt "STRINGS.ELEMENTS.RESIN.NAME"
msgid "<link=\"RESIN\">Sap</link>"
msgstr "<link=\"RESIN\">Seiva</link>"

#. STRINGS.ELEMENTS.ROCKGAS.DESC
msgctxt "STRINGS.ELEMENTS.ROCKGAS.DESC"
msgid "Rock Gas is rock that has been superheated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "Rocha Gasosa é rocha que foi superaquecida em um estado <link=\"ELEMENTSGAS\">Gasoso</link>."

#. STRINGS.ELEMENTS.ROCKGAS.NAME
msgctxt "STRINGS.ELEMENTS.ROCKGAS.NAME"
msgid "<link=\"ROCKGAS\">Rock Gas</link>"
msgstr "<link=\"ROCKGAS\">Rocha Gasosa</link>"

#. STRINGS.ELEMENTS.RUBBER.DESC
msgctxt "STRINGS.ELEMENTS.RUBBER.DESC"
msgid ""
"Rubber is a viscoelastic <link=\"ELEMENTSSOLID\">Solid</link> made from vulcanized <link=\"LATEX\">Latex</link>.\n"
"\n"
"It can be used to make <link=\"BUILDINGGASKET\">Gaskets</link>."
msgstr ""
"Borracha é um <link=\"ELEMENTSSOLID\">Sólido</link> viscoelástico feito a partir de <link=\"LATEX\">Látex</link> "
"vulcanizado.\n"
"\n"
"Pode ser usado para fabricar <link=\"BUILDINGGASKET\">Juntas</link>."

#. STRINGS.ELEMENTS.RUBBER.NAME
msgctxt "STRINGS.ELEMENTS.RUBBER.NAME"
msgid "<link=\"RUBBER\">Rubber</link>"
msgstr "<link=\"RUBBER\">Borracha</link>"

#. STRINGS.ELEMENTS.RUST.DESC
msgctxt "STRINGS.ELEMENTS.RUST.DESC"
msgid ""
"Rust is an iron oxide that forms from the breakdown of <link=\"IRON\">Iron</link>.\n"
"\n"
"It is useful in some <link=\"OXYGEN\">Oxygen</link> production processes."
msgstr ""
"A ferrugem é um óxido de ferro que se forma a partir da decomposição do <link=\"IRON\">Ferro</link>.\n"
"\n"
"É útil em alguns processos de produção de <link=\"OXYGEN\">Oxigênio</link>."

#. STRINGS.ELEMENTS.RUST.NAME
msgctxt "STRINGS.ELEMENTS.RUST.NAME"
msgid "<link=\"RUST\">Rust</link>"
msgstr "<link=\"RUST\">Ferrugem</link>"

#. STRINGS.ELEMENTS.SALT.DESC
msgctxt "STRINGS.ELEMENTS.SALT.DESC"
msgid ""
"(NaCl) Salt, also known as sodium chloride, is an edible chemical compound.\n"
"\n"
"When refined, it can be eaten with meals to increase Duplicant <link=\"MORALE\">Morale</link>."
msgstr ""
"(NaCl) O sal, também conhecido como cloreto de sódio, é um composto químico comestível.\n"
"\n"
"Quando refinado, pode ser consumido com as refeições para aumentar a <link=\"MORALE\">Moral</link> dos Duplicantes."

#. STRINGS.ELEMENTS.SALT.NAME
msgctxt "STRINGS.ELEMENTS.SALT.NAME"
msgid "<link=\"SALT\">Salt</link>"
msgstr "<link=\"SALT\">Sal</link>"

#. STRINGS.ELEMENTS.SALTGAS.DESC
msgctxt "STRINGS.ELEMENTS.SALTGAS.DESC"
msgid ""
"(NaCl) Salt Gas is an edible chemical compound that has been superheated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr ""
"(NaCl) Gás Salgado é um composto químico comestível que foi superaquecido em um estado <link=\"ELEMENTSGAS\">Gasoso</link>."

#. STRINGS.ELEMENTS.SALTGAS.NAME
msgctxt "STRINGS.ELEMENTS.SALTGAS.NAME"
msgid "<link=\"SALTGAS\">Salt Gas</link>"
msgstr "<link=\"SALTGAS\">Gás Salgado</link>"

#. STRINGS.ELEMENTS.SALTWATER.DESC
msgctxt "STRINGS.ELEMENTS.SALTWATER.DESC"
msgid ""
"Salt Water is a natural, lightly concentrated solution of <link=\"SALT\">Salt</link> dissolved in <link=\"WATER\">Water</"
"link>.\n"
"\n"
"It can be used in desalination processes, separating out usable salt."
msgstr ""
"Água Salgada é uma solução natural, levemente concentrada de <link=\"SALT\">Sal</link> dissolvido em <link=\"WATER\">Água</"
"link>.\n"
"\n"
"Pode ser usada em processos de dessalinização, separando o sal utilizável."

#. STRINGS.ELEMENTS.SALTWATER.NAME
msgctxt "STRINGS.ELEMENTS.SALTWATER.NAME"
msgid "<link=\"SALTWATER\">Salt Water</link>"
msgstr "<link=\"SALTWATER\">Água Salgada</link>"

#. STRINGS.ELEMENTS.SAND.DESC
msgctxt "STRINGS.ELEMENTS.SAND.DESC"
msgid ""
"Sand is a composite of granular rock.\n"
"\n"
"It is useful as a <link=\"FILTER\">Filtration Medium</link>."
msgstr ""
"Areia é um composto de rochas sedimentares.\n"
"\n"
"É útil como um <link=\"FILTER\">Meio de Filtração</link>."

#. STRINGS.ELEMENTS.SAND.NAME
msgctxt "STRINGS.ELEMENTS.SAND.NAME"
msgid "<link=\"SAND\">Sand</link>"
msgstr "<link=\"SAND\">Areia</link>"

#. STRINGS.ELEMENTS.SANDCEMENT.DESC
msgctxt "STRINGS.ELEMENTS.SANDCEMENT.DESC"
msgid ""
msgstr ""

#. STRINGS.ELEMENTS.SANDCEMENT.NAME
msgctxt "STRINGS.ELEMENTS.SANDCEMENT.NAME"
msgid "<link=\"SANDCEMENT\">Sand Cement</link>"
msgstr "<link=\"SANDCEMENT\">Cimento de Areia</link>"

#. STRINGS.ELEMENTS.SANDSTONE.DESC
msgctxt "STRINGS.ELEMENTS.SANDSTONE.DESC"
msgid ""
"Sandstone is a composite of relatively soft sedimentary rock.\n"
"\n"
"It is useful as a <b>Construction Material</b>."
msgstr ""
"Arenito é um composto de rocha sedimentar relativamente macia.\n"
"\n"
"É útil como um <b>Material de Construção</b>."

#. STRINGS.ELEMENTS.SANDSTONE.NAME
msgctxt "STRINGS.ELEMENTS.SANDSTONE.NAME"
msgid "<link=\"SANDSTONE\">Sandstone</link>"
msgstr "<link=\"SANDSTONE\">Arenito</link>"

#. STRINGS.ELEMENTS.SEDIMENTARYROCK.DESC
msgctxt "STRINGS.ELEMENTS.SEDIMENTARYROCK.DESC"
msgid ""
"Sedimentary Rock is a hardened composite of sediment layers.\n"
"\n"
"It is useful as a <b>Construction Material</b>."
msgstr ""
"Rocha Sedimentar é um composto endurecido de camadas de sedimento.\n"
"\n"
"É útil como um <b>Material de Construção</b>."

#. STRINGS.ELEMENTS.SEDIMENTARYROCK.NAME
msgctxt "STRINGS.ELEMENTS.SEDIMENTARYROCK.NAME"
msgid "<link=\"SEDIMENTARYROCK\">Sedimentary Rock</link>"
msgstr "<link=\"SEDIMENTARYROCK\">Rocha Sedimentar</link>"

#. STRINGS.ELEMENTS.SHALE.DESC
msgctxt "STRINGS.ELEMENTS.SHALE.DESC"
msgid ""
"Shale is a brittle composite of sediment layers.\n"
"\n"
"It is useful as a <b>Construction Material</b>."
msgstr ""
"Xisto é um compósito frágil de camadas de sedimento.\n"
"\n"
"É útil como <b>Material de Construção</b>."

#. STRINGS.ELEMENTS.SHALE.NAME
msgctxt "STRINGS.ELEMENTS.SHALE.NAME"
msgid "<link=\"SHALE\">Shale</link>"
msgstr "<link=\"SHALE\">Xisto</link>"

#. STRINGS.ELEMENTS.SILTSTONE.DESC
msgctxt "STRINGS.ELEMENTS.SILTSTONE.DESC"
msgid ""
"Siltstone is a chalky mudrock made primarily of compressed silt.\n"
"\n"
"It is useful as a <b>Construction Material</b>."
msgstr ""
"Siltito é uma rocha argilosa calcária feita principalmente de lama comprimida.\n"
"\n"
"É útil como <b>Material de Construção</b>."

#. STRINGS.ELEMENTS.SILTSTONE.NAME
msgctxt "STRINGS.ELEMENTS.SILTSTONE.NAME"
msgid "<link=\"SILTSTONE\">Siltstone</link>"
msgstr "<link=\"SILTSTONE\">Siltito</link>"

#. STRINGS.ELEMENTS.SLABS.DESC
msgctxt "STRINGS.ELEMENTS.SLABS.DESC"
msgid "Slabs are a refined mineral building block used for assembling advanced buildings."
msgstr "Lajes são um bloco de construção mineral refinado usado para montar estruturas avançadas."

#. STRINGS.ELEMENTS.SLABS.NAME
