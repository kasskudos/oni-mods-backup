msgstr "Parede"

#. STRINGS.BUILDINGS.PREFABS.PROPHUMANCHESTERFIELDCHAIR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPHUMANCHESTERFIELDCHAIR.DESC"
msgid "A luxurious chair where future generations can comfortably sit and dream of home."
msgstr "Uma cadeira luxuosa onde as futuras gerações podem se sentar confortavelmente e sonhar com o lar."

#. STRINGS.BUILDINGS.PREFABS.PROPHUMANCHESTERFIELDCHAIR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPHUMANCHESTERFIELDCHAIR.NAME"
msgid "Showroom Chair"
msgstr "Cadeira de Mostruário"

#. STRINGS.BUILDINGS.PREFABS.PROPHUMANCHESTERFIELDSOFA.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPHUMANCHESTERFIELDSOFA.DESC"
msgid "A luxurious couch where potential residents can comfortably nap and dream of home."
msgstr "Um sofá luxuoso onde potenciais residentes podem confortavelmente cochilar e sonhar com o lar."

#. STRINGS.BUILDINGS.PREFABS.PROPHUMANCHESTERFIELDSOFA.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPHUMANCHESTERFIELDSOFA.NAME"
msgid "Showroom Couch"
msgstr "Sofá de Mostruário"

#. STRINGS.BUILDINGS.PREFABS.PROPHUMANMURPHYBED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPHUMANMURPHYBED.DESC"
msgid ""
"A bed that folds into the wall, for small live/work spaces.\n"
"\n"
"This is the display model."
msgstr ""
"Uma cama que se dobra na parede, para pequenos espaços de convivência/trabalho.\n"
"\n"
"Este é o modelo de exposição."

#. STRINGS.BUILDINGS.PREFABS.PROPHUMANMURPHYBED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPHUMANMURPHYBED.NAME"
msgid "Murphy Bed"
msgstr "Cama Dobrável"

#. STRINGS.BUILDINGS.PREFABS.PROPLADDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPLADDER.DESC"
msgid "A hard plastic ladder."
msgstr "Uma escada de plástico rígido."

#. STRINGS.BUILDINGS.PREFABS.PROPLADDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPLADDER.NAME"
msgid "Ladder"
msgstr "Escada"

#. STRINGS.BUILDINGS.PREFABS.PROPLIGHT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPLIGHT.DESC"
msgid "An elegant ceiling lamp, slightly worse for wear."
msgstr "Uma luminária de teto elegante, um pouco desgastada."

#. STRINGS.BUILDINGS.PREFABS.PROPLIGHT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPLIGHT.NAME"
msgid "Light Fixture"
msgstr "Luminária"

#. STRINGS.BUILDINGS.PREFABS.PROPRECEPTIONDESK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPRECEPTIONDESK.DESC"
msgid ""
"A full coffee cup and a note abandoned mid sentence sit behind the desk.\n"
"\n"
"It gives me an eerie feeling, as if the receptionist has stepped out and will return any moment."
msgstr ""
"Uma xícara de café cheia e um bilhete abandonado no meio da frase estão atrás da mesa.\n"
"\n"
"Isso me dá uma sensação estranha, como se a recepcionista tivesse saído e fosse voltar a qualquer momento."

#. STRINGS.BUILDINGS.PREFABS.PROPRECEPTIONDESK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPRECEPTIONDESK.NAME"
msgid "Reception Desk"
msgstr "Recepção"

#. STRINGS.BUILDINGS.PREFABS.PROPSKELETON.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSKELETON.DESC"
msgid ""
"A detailed anatomical model.\n"
"\n"
"It appears to be made of resin."
msgstr ""
"Um modelo anatômico detalhado.\n"
"\n"
"Parece ser feito de resina."

#. STRINGS.BUILDINGS.PREFABS.PROPSKELETON.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSKELETON.NAME"
msgid "Model Skeleton"
msgstr "Esqueleto de Modelo"

#. STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE1.DESC"
msgid "All that remains of a once peacefully orbiting satellite."
msgstr "Tudo o que resta de um satélite que já orbitou pacificamente."

#. STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE1.NAME"
msgid "Crashed Satellite"
msgstr "Satélite Caído"

#. STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE2.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE2.DESC"
msgid "All that remains of a once peacefully orbiting satellite."
msgstr "Tudo o que resta de um satélite que já orbitou pacificamente."

#. STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE2.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE2.NAME"
msgid "Wrecked Satellite"
msgstr "Satélite Destruído"

#. STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE3.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE3.DESC"
msgid "All that remains of a once peacefully orbiting satellite."
msgstr "Tudo o que resta de um satélite que já orbitou pacificamente."

#. STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE3.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPSURFACESATELLITE3.NAME"
msgid "Crushed Satellite"
msgstr "Satélite Esmagado"

#. STRINGS.BUILDINGS.PREFABS.PROPTABLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPTABLE.DESC"
msgid "A table and some chairs."
msgstr "Uma mesa e algumas cadeiras."

#. STRINGS.BUILDINGS.PREFABS.PROPTABLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPTABLE.NAME"
msgid "Table"
msgstr "Mesa"

#. STRINGS.BUILDINGS.PREFABS.PROPTALLPLANT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPTALLPLANT.DESC"
msgid "Looking closely, it appears to be fake."
msgstr "Olhando de perto, parece ser falso."

#. STRINGS.BUILDINGS.PREFABS.PROPTALLPLANT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPTALLPLANT.NAME"
msgid "Potted Plant"
msgstr "Vaso de Planta"

#. STRINGS.BUILDINGS.PREFABS.RADIATIONLIGHT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RADIATIONLIGHT.DESC"
msgid "Duplicants can become sick if exposed to radiation without protection."
msgstr "Os Duplicantes podem adoecer se expostos à radiação sem proteção."

#. STRINGS.BUILDINGS.PREFABS.RADIATIONLIGHT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RADIATIONLIGHT.EFFECT"
msgid ""
"Emits <link=\"RADIATION\">Radiation</link> when <link=\"POWER\">Powered</link> that can be collected by a "
"<link=\"HIGHENERGYPARTICLESPAWNER\">Radbolt Generator</link>."
msgstr ""
"Emite <link=\"RADIATION\">Radiação</link> quando <link=\"POWER\">Energizado</link> que pode ser coletada por um "
"<link=\"HIGHENERGYPARTICLESPAWNER\">Gerador de Radioraios</link>."

#. STRINGS.BUILDINGS.PREFABS.RADIATIONLIGHT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RADIATIONLIGHT.NAME"
msgid "<link=\"RADIATIONLIGHT\">Radiation Lamp</link>"
msgstr "<link=\"RADIATIONLIGHT\">Lâmpada Radioativa</link>"

#. STRINGS.BUILDINGS.PREFABS.RAILGUN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RAILGUN.DESC"
msgid "It's tempting to climb inside but trust me... don't."
msgstr "É tentador entrar, mas acredite em mim... não faça isso."

#. STRINGS.BUILDINGS.PREFABS.RAILGUN.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RAILGUN.EFFECT"
msgid ""
"Launches <link=\"RAILGUNPAYLOAD\">Interplanetary Payloads</link> between Planetoids.\n"
"\n"
"Payloads can contain <link=\"ELEMENTSSOLID\">Solid</link>, <link=\"ELEMENTSLIQUID\">Liquid</link>, or "
"<link=\"ELEMENTSGAS\">Gas</link> materials.\n"
"\n"
"Cannot transport Duplicants."
msgstr ""
"Lança <link=\"RAILGUNPAYLOAD\">Cargas Interplanetárias</link> entre Planetoides.\n"
"\n"
"As cargas podem conter materiais <link=\"ELEMENTSSOLID\">Sólidos</link>, <link=\"ELEMENTSLIQUID\">Líquidos</link> ou "
"<link=\"ELEMENTSGAS\">Gasosos</link>.\n"
"\n"
"Não pode transportar Duplicantes."

#. STRINGS.BUILDINGS.PREFABS.RAILGUN.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.RAILGUN.LOGIC_PORT"
msgid "Launch Toggle"
msgstr "Alternar Lançamento"

#. STRINGS.BUILDINGS.PREFABS.RAILGUN.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.RAILGUN.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Enable payload launching."
msgstr "<b><style=\"logic_off\">Sinal Verde</style></b>: Habilita o envio de pacotes."

#. STRINGS.BUILDINGS.PREFABS.RAILGUN.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.RAILGUN.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Disable payload launching."
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Desabilita o envio de pacotes."

#. STRINGS.BUILDINGS.PREFABS.RAILGUN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RAILGUN.NAME"
msgid "<link=\"RAILGUN\">Interplanetary Launcher</link>"
msgstr "<link=\"RAILGUN\">Lançador Interplanetário</link>"

#. STRINGS.BUILDINGS.PREFABS.RAILGUN.SIDESCREEN_HEP_REQUIRED
msgctxt "STRINGS.BUILDINGS.PREFABS.RAILGUN.SIDESCREEN_HEP_REQUIRED"
msgid "Launch cost: {current} / {required} radbolts"
msgstr "Custo de lançamento: {current} / {required} radioraios"

#. STRINGS.BUILDINGS.PREFABS.RAILGUNPAYLOADOPENER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RAILGUNPAYLOADOPENER.DESC"
msgid "Payload openers can be hooked up to conveyors, plumbing and ventilation for improved sorting."
msgstr "Abridores de carga podem ser conectados a esteiras, encanamentos e ventilação para uma melhor separação."

#. STRINGS.BUILDINGS.PREFABS.RAILGUNPAYLOADOPENER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RAILGUNPAYLOADOPENER.EFFECT"
msgid ""
"Unpacks <link=\"RAILGUNPAYLOAD\">Interplanetary Payloads</link> delivered by Duplicants.\n"
"\n"
"Automatically separates <link=\"ELEMENTSSOLID\">Solid</link>, <link=\"ELEMENTSLIQUID\">Liquid</link>, and "
"<link=\"ELEMENTSGAS\">Gas</link> materials and distributes them to the appropriate systems."
msgstr ""
"Desempacota <link=\"RAILGUNPAYLOAD\">Cargas Interplanetárias</link> entregues pelos Duplicantes.\n"
"\n"
"Separa automaticamente materiais <link=\"ELEMENTSSOLID\">Sólidos</link>, <link=\"ELEMENTSLIQUID\">Líquidos</link> e "
"<link=\"ELEMENTSGAS\">Gasosos</link> e os distribui para os sistemas apropriados."

#. STRINGS.BUILDINGS.PREFABS.RAILGUNPAYLOADOPENER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RAILGUNPAYLOADOPENER.NAME"
msgid "<link=\"RAILGUNPAYLOADOPENER\">Payload Opener</link>"
msgstr "<link=\"RAILGUNPAYLOADOPENER\">Abridor de Carga</link>"

#. STRINGS.BUILDINGS.PREFABS.RANCHSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RANCHSTATION.DESC"
msgid "A groomed critter is a happy, healthy, productive critter."
msgstr "Uma criatura bem cuidada é uma criatura feliz, saudável e produtiva."

#. STRINGS.BUILDINGS.PREFABS.RANCHSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RANCHSTATION.EFFECT"
msgid ""
"Allows the assigned <link=\"RANCHER\">Rancher</link> to care for and gradually tame <link=\"CREATURES\">Critters</link>.\n"
"\n"
"Assigned Duplicants must possess the <link=\"RANCHING1\">Critter Ranching</link> skill."
msgstr ""
"Permite que o <link=\"RANCHER\">Criador</link> designado cuide e domestique gradualmente as <link=\"CREATURES\">Criaturas</"
"link>.\n"
"\n"
"Duplicantes designados devem possuir a habilidade <link=\"RANCHING1\">Criação de Criaturas</link>."

#. STRINGS.BUILDINGS.PREFABS.RANCHSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RANCHSTATION.NAME"
msgid "<link=\"RANCHSTATION\">Grooming Station</link>"
msgstr "<link=\"RANCHSTATION\">Estação de Cuidados</link>"

#. STRINGS.BUILDINGS.PREFABS.RATIONBOX.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RATIONBOX.DESC"
msgid "Ration boxes keep food safe from hungry critters, but don't slow food spoilage."
msgstr "Caixas de Ração mantêm a comida segura de criaturas famintas, mas não retardam a deterioração dos alimentos."

#. STRINGS.BUILDINGS.PREFABS.RATIONBOX.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RATIONBOX.EFFECT"
msgid ""
"Stores a small amount of <link=\"FOOD\">Food</link>.\n"
"\n"
"Food must be delivered to boxes by Duplicants."
msgstr ""
"Armazena uma pequena quantidade de <link=\"FOOD\">Comida</link>.\n"
"\n"
"A comida deve ser entregue às caixas pelos Duplicantes."

#. STRINGS.BUILDINGS.PREFABS.RATIONBOX.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RATIONBOX.NAME"
msgid "<link=\"RATIONBOX\">Ration Box</link>"
msgstr "<link=\"RATIONBOX\">Caixa de Ração</link>"

#. STRINGS.BUILDINGS.PREFABS.REEFGENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.REEFGENERATOR.DESC"
msgid "Enables a colony to run on clean energy."
msgstr "Permite que uma colônia funcione com energia limpa."

#. STRINGS.BUILDINGS.PREFABS.REEFGENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.REEFGENERATOR.EFFECT"
msgid ""
"Converts the kinetic energy from a <link=\"SMALLREEFGEYSER\">Tidal Spring</link> below it into electrical "
"<link=\"POWER\">Power</link>."
msgstr ""
"Converte a energia cinética de uma <link=\"SMALLREEFGEYSER\">Fonte de Marés</link> abaixo dele em <link=\"POWER\">Energia</"
"link> elétrica."

#. STRINGS.BUILDINGS.PREFABS.REEFGENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.REEFGENERATOR.NAME"
msgid "<link=\"REEFGENERATOR\">Tidal Turbine</link>"
msgstr "<link=\"REEFGENERATOR\">Turbina Maremotriz</link>"

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.DESC"
msgid "Food spoilage can be slowed by ambient conditions as well as by refrigerators."
msgstr "A deterioração dos alimentos pode ser retardada pelas condições ambientais, assim como por refrigeradores."

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.EFFECT"
msgid "Stores <link=\"FOOD\">Food</link> at an ideal <link=\"HEAT\">Temperature</link> to prevent spoilage."
msgstr "Armazena <link=\"FOOD\">Alimentos</link> em uma <link=\"HEAT\">Temperatura</link> ideal para evitar a deterioração."

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.BLUE_BABYTEARS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.BLUE_BABYTEARS.DESC"
msgid "For food so cold, it brings a tear to the eye."
msgstr "Comida tão gelada que faz os olhos lacrimejarem."

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.BLUE_BABYTEARS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.BLUE_BABYTEARS.NAME"
msgid "<link=\"REFRIGERATOR\">Weepy Blue Refrigerator</link>"
msgstr "<link=\"REFRIGERATOR\">Refrigerador Azul Lacrimoso</link>"

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.DEFAULT_REFRIGERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.DEFAULT_REFRIGERATOR.DESC"
msgid "Food spoilage can be slowed by ambient conditions as well as by refrigerators."
msgstr "A deterioração dos alimentos pode ser retardada pelas condições ambientais, assim como por refrigeradores."

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.DEFAULT_REFRIGERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.DEFAULT_REFRIGERATOR.NAME"
msgid "<link=\"REFRIGERATOR\">Refrigerator</link>"
msgstr "<link=\"REFRIGERATOR\">Geladeira</link>"

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.GREEN_MUSH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.GREEN_MUSH.DESC"
msgid "Honestly, this hue is particularly chilling."
msgstr "Sinceramente, esse tom é particularmente gelado."

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.GREEN_MUSH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.GREEN_MUSH.NAME"
msgid "<link=\"REFRIGERATOR\">Mush Green Refrigerator</link>"
msgstr "<link=\"REFRIGERATOR\">Geladeira Verde Fúngica</link>"

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.PURPLE_BRAINFAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.PURPLE_BRAINFAT.DESC"
msgid "This fridge makes color-coordination a (cold) snap."
msgstr "Esta geladeira torna a coordenação de cores um estalo (gelado)."

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.PURPLE_BRAINFAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.PURPLE_BRAINFAT.NAME"
msgid "<link=\"REFRIGERATOR\">Faint Purple Refrigerator</link>"
msgstr "<link=\"REFRIGERATOR\">Geladeira Roxo Suave</link>"

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.RED_ROSE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.RED_ROSE.DESC"
msgid "Inspired by the Duplicant poem, \"Pretty in Puce.\""
msgstr "Inspirado no poema dos Duplicantes, \"Bela em Púrpura.\""

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.RED_ROSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.RED_ROSE.NAME"
msgid "<link=\"REFRIGERATOR\">Puce Pink Refrigerator</link>"
msgstr "<link=\"REFRIGERATOR\">Geladeira Rosa Púrpura</link>"

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.STRIPES_RED_WHITE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.STRIPES_RED_WHITE.DESC"
msgid "Bold on the outside, cold on the inside!"
msgstr "Ousada por fora, gelada por dentro!"

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.STRIPES_RED_WHITE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.STRIPES_RED_WHITE.NAME"
msgid "<link=\"REFRIGERATOR\">Bold Stripe Refrigerator</link>"
msgstr "<link=\"REFRIGERATOR\">Geladeira Listrada Ousada</link>"

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.YELLOW_TARTAR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.YELLOW_TARTAR.DESC"
msgid "Some Duplicants call it \"sunny\" yellow, but only because they've never seen the sun."
msgstr "Alguns Duplicantes a chamam de amarelo \"solar\", mas só porque nunca viram o sol."

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.YELLOW_TARTAR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.FACADES.YELLOW_TARTAR.NAME"
msgid "<link=\"REFRIGERATOR\">Ick Yellow Refrigerator</link>"
msgstr "<link=\"REFRIGERATOR\">Geladeira Amarelo Enojento</link>"

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.LOGIC_PORT"
msgid "Full/Not Full"
msgstr "Cheia/Vazia"

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when full"
msgstr "Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando cheio"

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</b></style>"

#. STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.REFRIGERATOR.NAME"
msgid "<link=\"REFRIGERATOR\">Refrigerator</link>"
msgstr "<link=\"REFRIGERATOR\">Geladeira</link>"

#. STRINGS.BUILDINGS.PREFABS.REMOTEWORKERDOCK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.REMOTEWORKERDOCK.DESC"
msgid "It's a Duplicant's duplicate's dock."
msgstr "Uma estação para o duplicado do Duplicante."

#. STRINGS.BUILDINGS.PREFABS.REMOTEWORKERDOCK.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.REMOTEWORKERDOCK.EFFECT"
msgid ""
"<link=\"REMOTEWORKERDOCK\">Remote Worker Docks</link> deploy automatons that operate machinery based on instructions "
"received from a connected <link=\"REMOTEWORKTERMINAL\">Remote Controller</link>.\n"
"\n"
"Must be placed within range of its target building."
msgstr ""
"<link=\"REMOTEWORKERDOCK\">Estações de Trabalhador Remoto</link> implantam autômatos que operam máquinas com base em "
"instruções recebidas de um <link=\"REMOTEWORKTERMINAL\">Controlador Remoto</link> conectado.\n"
"\n"
"Deve ser colocado dentro do alcance da estrutura alvo."

#. STRINGS.BUILDINGS.PREFABS.REMOTEWORKERDOCK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.REMOTEWORKERDOCK.NAME"
msgid "<link=\"REMOTEWORKERDOCK\">Remote Worker Dock</link>"
msgstr "<link=\"REMOTEWORKERDOCK\">Estação de Trabalhador Remoto</link>"

#. STRINGS.BUILDINGS.PREFABS.REMOTEWORKERDOCK.NAME_FMT
msgctxt "STRINGS.BUILDINGS.PREFABS.REMOTEWORKERDOCK.NAME_FMT"
msgid "Dock {ID}"
msgstr "Estação {ID}"

#. STRINGS.BUILDINGS.PREFABS.REMOTEWORKTERMINAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.REMOTEWORKTERMINAL.DESC"
msgid "Remote controllers cut down on colony commute times."
msgstr "Controladores remotos reduzem o tempo de deslocamento na colônia."

#. STRINGS.BUILDINGS.PREFABS.REMOTEWORKTERMINAL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.REMOTEWORKTERMINAL.EFFECT"
msgid "Enables Duplicants to operate machinery remotely via a connected <link=\"REMOTEWORKERDOCK\">Remote Worker Dock</link>."
msgstr ""
"Permite que Duplicantes operem máquinas remotamente por meio de uma <link=\"REMOTEWORKERDOCK\">Estação de Trabalhadores "
"Remotos</link> conectada."

#. STRINGS.BUILDINGS.PREFABS.REMOTEWORKTERMINAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.REMOTEWORKTERMINAL.NAME"
msgid "<link=\"REMOTEWORKTERMINAL\">Remote Controller</link>"
msgstr "<link=\"REMOTEWORKTERMINAL\">Controlador Remoto</link>"

#. STRINGS.BUILDINGS.PREFABS.RESEARCHCENTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RESEARCHCENTER.DESC"
msgid "Research stations are necessary for unlocking all research tiers."
msgstr "Estações de pesquisa são necessárias para desbloquear todos os níveis de pesquisa."

#. STRINGS.BUILDINGS.PREFABS.RESEARCHCENTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RESEARCHCENTER.EFFECT"
msgid ""
"Conducts <link=\"RESEARCH\">Novice Research</link> to unlock new technologies.\n"
"\n"
"Consumes <link=\"DIRT\">Dirt</link>."
msgstr ""
"Realiza <link=\"RESEARCH\">Pesquisa Iniciante</link> para desbloquear novas tecnologias.\n"
"\n"
"Consome <link=\"DIRT\">Terra</link>."

#. STRINGS.BUILDINGS.PREFABS.RESEARCHCENTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RESEARCHCENTER.NAME"
msgid "<link=\"RESEARCHCENTER\">Research Station</link>"
msgstr "<link=\"RESEARCHCENTER\">Estação de Pesquisa</link>"

#. STRINGS.BUILDINGS.PREFABS.RESEARCHCLUSTERMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RESEARCHCLUSTERMODULE.DESC"
msgid "Increases the amount of research data obtained en route to a destination."
msgstr "Aumenta a quantidade de dados de pesquisa obtidos durante o trajeto até um destino."

#. STRINGS.BUILDINGS.PREFABS.RESEARCHCLUSTERMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RESEARCHCLUSTERMODULE.EFFECT"
msgid ""
"Collects free-floating <link=\"DATABANK\">Data Banks</link> found in its flight path.\n"
"\n"
msgstr ""
"Coleta <link=\"DATABANK\">Bancos de Dados</link> flutuantes encontrados em seu caminho de voo.\n"
"\n"

#. STRINGS.BUILDINGS.PREFABS.RESEARCHCLUSTERMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RESEARCHCLUSTERMODULE.NAME"
msgid "<link=\"RESEARCHCLUSTERMODULE\">Research Module</link>"
msgstr "<link=\"RESEARCHCLUSTERMODULE\">Módulo de Pesquisa</link>"

#. STRINGS.BUILDINGS.PREFABS.RESEARCHMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RESEARCHMODULE.DESC"
msgid "Data banks can be used at virtual planetariums to produce additional research."
msgstr "Bancos de dados podem ser usados em planetários virtuais para produzir pesquisa adicional."

#. STRINGS.BUILDINGS.PREFABS.RESEARCHMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RESEARCHMODULE.EFFECT"
msgid ""
"Completes one <link=\"RESEARCH\">Research Task</link> per space mission.\n"
"\n"
"Produces a small Data Bank regardless of mission destination.\n"
"\n"
"Generated <link=\"RESEARCH\">Research Points</link> become available upon the rocket's return."
msgstr ""
"Conclui uma <link=\"RESEARCH\">Tarefa de Pesquisa</link> por missão espacial.\n"
"\n"
"Produz um pequeno Banco de Dados independentemente do destino da missão.\n"
"\n"
"Os <link=\"RESEARCH\">Pontos de Pesquisa</link> gerados ficam disponíveis quando o foguete retorna."

#. STRINGS.BUILDINGS.PREFABS.RESEARCHMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RESEARCHMODULE.NAME"
msgid "<link=\"RESEARCHMODULE\">Research Module</link>"
msgstr "<link=\"RESEARCHMODULE\">Módulo de Pesquisa</link>"

#. STRINGS.BUILDINGS.PREFABS.RESETSKILLSSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RESETSKILLSSTATION.DESC"
msgid "Erase skills from a Duplicant's mind, returning them to their default abilities."
msgstr "Apaga as habilidades da mente de um Duplicante, retornando-o às suas habilidades padrão."

#. STRINGS.BUILDINGS.PREFABS.RESETSKILLSSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RESETSKILLSSTATION.EFFECT"
msgid ""
"Refunds a Duplicant's Skill Points for reassignment.\n"
"\n"
"Duplicants will lose all assigned skills in the process."
msgstr ""
"Reembolsa os Pontos de Habilidade de um Duplicante para realocação.\n"
"\n"
"Duplicantes perderão todas as habilidades atribuídas no processo."

#. STRINGS.BUILDINGS.PREFABS.RESETSKILLSSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RESETSKILLSSTATION.NAME"
msgid "<link=\"RESETSKILLSSTATION\">Skill Scrubber</link>"
msgstr "<link=\"RESETSKILLSSTATION\">Reconfigurador de Habilidades</link>"

#. STRINGS.BUILDINGS.PREFABS.REUSABLETRAP.INPUT_LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.REUSABLETRAP.INPUT_LOGIC_PORT"
msgid "Trap Setter"
msgstr "Ativador de Armadilha"

#. STRINGS.BUILDINGS.PREFABS.REUSABLETRAP.INPUT_LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.REUSABLETRAP.INPUT_LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Set trap"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Armar armadilha"

#. STRINGS.BUILDINGS.PREFABS.REUSABLETRAP.INPUT_LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.REUSABLETRAP.INPUT_LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Disarm and empty trap"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Desarmar e esvaziar armadilha"

#. STRINGS.BUILDINGS.PREFABS.REUSABLETRAP.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.REUSABLETRAP.LOGIC_PORT"
msgid "Trap Occupied"
msgstr "Armadilha Ocupada"

#. STRINGS.BUILDINGS.PREFABS.REUSABLETRAP.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.REUSABLETRAP.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when a critter has been trapped"
msgstr "Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando uma criatura for capturada"

#. STRINGS.BUILDINGS.PREFABS.REUSABLETRAP.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.REUSABLETRAP.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</b></style>"

#. STRINGS.BUILDINGS.PREFABS.ROBOPILOTCOMMANDMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROBOPILOTCOMMANDMODULE.DESC"
msgid "Robo-pilot modules do not require a Duplicant astronaut."
msgstr "Os módulos de robo-piloto não requerem um duplicante astronauta."

#. STRINGS.BUILDINGS.PREFABS.ROBOPILOTCOMMANDMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROBOPILOTCOMMANDMODULE.EFFECT"
msgid ""
"Enables rockets to travel swiftly and safely without a <link=\"COMMANDMODULE\">Command Capsule</link>.\n"
"\n"
"A Robo-Pilot Capsule must be the last module installed at the top of a rocket."
msgstr ""
"Permite que foguetes viagem de forma rápida e segura sem uma <link=\"COMMANDMODULE\">Cápsula de Comando</link>.\n"
"\n"
"Uma Cápsula de Robo-Piloto deve ser o último módulo instalado no topo de um foguete."

#. STRINGS.BUILDINGS.PREFABS.ROBOPILOTCOMMANDMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROBOPILOTCOMMANDMODULE.NAME"
msgid "<link=\"ROBOPILOTCOMMANDMODULE\">Robo-Pilot Capsule</link>"
msgstr "<link=\"ROBOPILOTCOMMANDMODULE\">Cápsula de Robo-Piloto</link>"

#. STRINGS.BUILDINGS.PREFABS.ROBOPILOTMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROBOPILOTMODULE.DESC"
msgid "Robo-pilot modules do not require a Duplicant astronaut."
msgstr "Os módulos de robo-piloto não requerem um duplicante astronauta."

#. STRINGS.BUILDINGS.PREFABS.ROBOPILOTMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROBOPILOTMODULE.EFFECT"
msgid ""
"Enables rockets to travel swfitly without a <link=\"ROCKETCONTROLSTATION\">Rocket Control Station</link>.\n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"Permite que foguetes viagem rapidamente sem uma <link=\"ROCKETCONTROLSTATION\">Estação de Controle de Foguetes</link>.\n"
"\n"
"Deve ser construído através da <link=\"LAUNCHPAD\">Plataforma de Lançamento</link>."

#. STRINGS.BUILDINGS.PREFABS.ROBOPILOTMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROBOPILOTMODULE.NAME"
msgid "<link=\"ROBOPILOTMODULE\">Robo-Pilot Module</link>"
msgstr "<link=\"ROBOPILOTMODULE\">Módulo de Robô-Piloto</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.DESC"
msgid "Rock Crushers loosen nuggets from raw ore and can process many different resources."
msgstr "Esmagadores de rochas soltam pepitas de minério bruto e podem processar muitos recursos diferentes."

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.EFFECT"
msgid ""
"Inefficiently produces refined materials from raw resources.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Produz materiais refinados de forma ineficiente a partir de recursos brutos.\n"
"\n"
"Duplicantes não fabricarão itens a menos que as receitas estejam na fila."

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.BALLOON.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.BALLOON.DESC"
msgid "Wherever there's raw ore, there's a rock crusher lurking nearby."
msgstr "Onde existir um minério bruto, há um Esmagador de Rochas próximo."

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.BALLOON.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.BALLOON.NAME"
msgid "<link=\"ROCKCRUSHER\">Pop-A-Rocks-E</link>"
msgstr "<link=\"ROCKCRUSHER\">Estoura-Pedras</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.CHOMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.CHOMP.DESC"
msgid "Buffs rough ore into smooth little nuggets."
msgstr "Poli o minério bruto até transformá-lo em pequenas pepitas lisas."

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.CHOMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.CHOMP.NAME"
msgid "<link=\"ROCKCRUSHER\">Mani Rock Crusher</link>"
msgstr "<link=\"ROCKCRUSHER\">Quebra-Pedras</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.DEFAULT_ROCKCRUSHER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.DEFAULT_ROCKCRUSHER.DESC"
msgid "Rock Crushers loosen nuggets from raw ore and can process many different resources."
msgstr "Esmagadores de rochas soltam pepitas de minério bruto e podem processar muitos recursos diferentes."

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.DEFAULT_ROCKCRUSHER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.DEFAULT_ROCKCRUSHER.NAME"
msgid "<link=\"ROCKCRUSHER\">Rock Crusher</link>"
msgstr "<link=\"ROCKCRUSHER\">Esmagador de Rochas</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.GEARS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.GEARS.DESC"
msgid "Uncrushed ore really grinds its gears."
msgstr "Minério bruto não esmagado realmente irrita."

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.GEARS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.GEARS.NAME"
msgid "<link=\"ROCKCRUSHER\">Super-Mech Rock Crusher</link>"
msgstr "<link=\"ROCKCRUSHER\">Esmagador de Rochas Super-Mec</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.HANDS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.HANDS.DESC"
msgid "Smashy smashy!"
msgstr "Esmaga esmaga!"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.HANDS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.HANDS.NAME"
msgid "<link=\"ROCKCRUSHER\">Punchy Rock Crusher</link>"
msgstr "<link=\"ROCKCRUSHER\">Esmagador de Rochas Soquinho</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.ROUNDSTAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.ROUNDSTAMP.DESC"
msgid "Inspired by the traditional mortar and pestle."
msgstr "Inspirado pelo tradicional pilão e almofariz."

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.ROUNDSTAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.ROUNDSTAMP.NAME"
msgid "<link=\"ROCKCRUSHER\">Smooth Rock Crusher</link>"
msgstr "<link=\"ROCKCRUSHER\">Esmagador de Rochas Lisinho</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.SPIKEBEDS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.SPIKEBEDS.DESC"
msgid "Mashes rocks into oblivion."
msgstr "Esmaga rochas no esquecimento."

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.SPIKEBEDS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.SPIKEBEDS.NAME"
msgid "<link=\"ROCKCRUSHER\">Spiked Rock Crusher</link>"
msgstr "<link=\"ROCKCRUSHER\">Esmagador de Rochas Espinhudo</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.TEETH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.TEETH.DESC"
msgid "Not designed to handle overcooked food waste."
msgstr "Não foi projetado para lidar com resíduos de alimentos cozidos demais."

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.TEETH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.FACADES.TEETH.NAME"
msgid "<link=\"ROCKCRUSHER\">Toothy Rock Crusher</link>"
msgstr "<link=\"ROCKCRUSHER\">Esmagador de Rochas Dentinho</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.LIME_FROM_LIMESTONE_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.LIME_FROM_LIMESTONE_RECIPE_DESCRIPTION"
msgid "Crushes {0} into {1} and a small amount of pure {2}"
msgstr "Esmaga {0} em {1} e uma pequena quantidade de {2} puro"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.LIME_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.LIME_RECIPE_DESCRIPTION"
msgid "Crushes {1} into {0}"
msgstr "Esmaga {1} em {0}"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.METAL_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.METAL_RECIPE_DESCRIPTION"
msgid "Crushes {1} into <link=\"SAND\">Sand</link> and pure {0}"
msgstr "Esmaga {1} em <link=\"SAND\">Areia</link> e {0} puro"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.NAME"
msgid "<link=\"ROCKCRUSHER\">Rock Crusher</link>"
msgstr "<link=\"ROCKCRUSHER\">Esmagador de Rochas</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.RECIPE_DESCRIPTION"
msgid "Crushes {0} into {1}"
msgstr "Esmaga {0} em {1}"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.RECIPE_DESCRIPTION_TWO_OUTPUT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.RECIPE_DESCRIPTION_TWO_OUTPUT"
msgid "Crushes {0} into {1} and {2}"
msgstr "Esmaga {0} em {1} e {2}"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.RESIN_FROM_AMBER_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.RESIN_FROM_AMBER_RECIPE_DESCRIPTION"
msgid "Crushes {0} into {1} and {2}, and a small amount of {3}"
msgstr "Esmaga {0} em {1} e {2}, e uma pequena quantidade de {3}"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.SAND_FROM_RAW_MINERAL_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.SAND_FROM_RAW_MINERAL_DESCRIPTION"
msgid "Crushes <link=\"BUILDABLERAW\">Raw Minerals</link> into <link=\"SAND\">Sand</link>"
msgstr "Esmaga <link=\"BUILDABLERAW\">Minerais Brutos</link> em <link=\"SAND\">Areia</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.SAND_FROM_RAW_MINERAL_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKCRUSHER.SAND_FROM_RAW_MINERAL_NAME"
msgid "<link=\"BUILDABLERAW\">Raw Mineral</link> to <link=\"SAND\">Sand</link>"
msgstr "<link=\"BUILDABLERAW\">Mineral Bruto</link> para <link=\"SAND\">Areia</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETCOMMANDCONSOLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCOMMANDCONSOLE.DESC"
msgid "Looks kinda fun."
msgstr "Parece meio divertido."

#. STRINGS.BUILDINGS.PREFABS.ROCKETCOMMANDCONSOLE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCOMMANDCONSOLE.EFFECT"
msgid ""
"Allows a Duplicant to pilot a rocket.\n"
"\n"
"Cargo rockets must possess a Rocket Cockpit in order to function."
msgstr ""
"Permite que um Duplicante pilote um foguete.\n"
"\n"
"Foguete de carga deve possuir uma Cabine de Comando para funcionar."

#. STRINGS.BUILDINGS.PREFABS.ROCKETCOMMANDCONSOLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCOMMANDCONSOLE.NAME"
msgid "<link=\"ROCKETCOMMANDCONSOLE\">Rocket Cockpit</link>"
msgstr "<link=\"ROCKETCOMMANDCONSOLE\">Cockpit de Foguete</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.DESC"
msgid "Someone needs to be around to jiggle the controls when the screensaver comes on."
msgstr "Alguém precisa estar por perto para mexer nos controles quando o protetor de tela for ativado."

#. STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.EFFECT"
msgid ""
"Allows Duplicants to use pilot-operated rockets and control access to interior buildings.\n"
"\n"
"Assigned Duplicants must have the <link=\"ROCKETPILOTING1\">Rocket Piloting</link> skill."
msgstr ""
"Permite que os Duplicantes usem foguetes operados por piloto e controlem o acesso às estruturas internas.\n"
"\n"
"Os Duplicantes designados devem ter a habilidade <link=\"ROCKETPILOTING1\">Pilotagem de Foguetes</link>."

#. STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.LOGIC_PORT"
msgid "Restrict Building Usage"
msgstr "Restringir Uso da Estrutura"

#. STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Restrict access to interior buildings"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Restringe o acesso às estruturas internas"

#. STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Unrestrict access to interior buildings"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Libera o acesso às estruturas internas"

#. STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETCONTROLSTATION.NAME"
msgid "<link=\"ROCKETCONTROLSTATION\">Rocket Control Station</link>"
msgstr "<link=\"ROCKETCONTROLSTATION\">Estação de Controle de Foguetes</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPETILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPETILE.DESC"
msgid "Keeps the space out."
msgstr "Mantém o espaço fora."

#. STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPETILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPETILE.EFFECT"
msgid "The walls of a rocket."
msgstr "As paredes de um foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPETILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPETILE.NAME"
msgid "<link=\"ROCKETENVELOPETILE\">Rocket</link>"
msgstr "<link=\"ROCKETENVELOPETILE\">Foguete</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPEWINDOWTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPEWINDOWTILE.DESC"
msgid "I can see my asteroid from here!"
msgstr "Posso ver meu asteróide daqui!"

#. STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPEWINDOWTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPEWINDOWTILE.EFFECT"
msgid "The window of a rocket."
msgstr "A janela de um foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPEWINDOWTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETENVELOPEWINDOWTILE.NAME"
msgid "<link=\"ROCKETENVELOPEWINDOWTILE\">Rocket Window</link>"
msgstr "<link=\"ROCKETENVELOPEWINDOWTILE\">Janela de Foguete</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUT.DESC"
msgid "It's basically central-vac."
msgstr "É basicamente um aspirador central."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUT.EFFECT"
msgid ""
"Allows <link=\"ELEMENTSGAS\">Gases</link> to be pumped into rocket storage via <link=\"GASCONDUIT\">Pipes</link>.\n"
"\n"
"Sends gas to the first Rocket Module with available space.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"Permite que <link=\"ELEMENTSGAS\">Gases</link> sejam bombeados para o armazenamento do foguete através de "
"<link=\"GASCONDUIT\">Tubos</link>.\n"
"\n"
"Envia gás para o primeiro Módulo de Foguete com espaço disponível.\n"
"\n"
"Deve ser construído no interior de um Módulo de Foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUT.NAME"
msgid "<link=\"ROCKETINTERIORGASINPUT\">Gas Intake Fitting</link>"
msgstr "<link=\"ROCKETINTERIORGASINPUT\">Conector de Entrada de Gás</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUTPORT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUTPORT.DESC"
msgid "A direct attachment leading to the output port on the exterior of the rocket."
msgstr "Uma conexão direta que leva à porta de saída no exterior do foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUTPORT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUTPORT.EFFECT"
msgid ""
"Allows a direct conduit connection out of the <link=\"HABITATMODULEMEDIUM\">Spacefarer Module</link> of the rocket.\n"
"Can be used to vent <link=\"ELEMENTSGAS\">Gasses</link> to space during flight."
msgstr ""
"Permite uma conexão direta de duto para fora do <link=\"HABITATMODULEMEDIUM\">Módulo de Viagem Espacial</link> do foguete.\n"
"Pode ser usado para liberar <link=\"ELEMENTSGAS\">Gases</link> no espaço durante o voo."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUTPORT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASINPUTPORT.NAME"
msgid "<link=\"ROCKETINTERIORGASINPUTPORT\">Gas Spacefarer Input Port</link>"
msgstr "<link=\"ROCKETINTERIORGASINPUTPORT\">Porta de Entrada de Gás Espacial</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUT.DESC"
msgid "Refreshing breezes, on-demand."
msgstr "Brisas refrescantes sob demanda."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUT.EFFECT"
msgid ""
"Allows <link=\"ELEMENTSGAS\">Gases</link> to be drawn from rocket storage via <link=\"GASCONDUIT\">Pipes</link>.\n"
"\n"
"Draws gas from the first Rocket Module with the requested material.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"Permite que <link=\"ELEMENTSGAS\">Gases</link> sejam extraídos do armazenamento do foguete através de "
"<link=\"GASCONDUIT\">Tubulações</link>.\n"
"\n"
"Extrai gás do primeiro Módulo do Foguete que contenha o material solicitado.\n"
"\n"
"Deve ser construído no interior de um Módulo do Foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUT.NAME"
msgid "<link=\"ROCKETINTERIORGASOUTPUT\">Gas Output Fitting</link>"
msgstr "<link=\"ROCKETINTERIORGASOUTPUT\">Conector de Saída de Gás</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUTPORT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUTPORT.DESC"
msgid "A direct attachment to the input port on the exterior of a rocket."
msgstr "Uma conexão direta à porta de entrada no exterior de um foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUTPORT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUTPORT.EFFECT"
msgid "Allows a direct conduit connection into the <link=\"HABITATMODULEMEDIUM\">Spacefarer Module</link> of a rocket."
msgstr ""
"Permite uma conexão direta de duto para dentro do <link=\"HABITATMODULEMEDIUM\">Módulo de Viagem Espacial</link> de um "
"foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUTPORT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORGASOUTPUTPORT.NAME"
msgid "<link=\"ROCKETINTERIORGASOUTPUTPORT\">Gas Spacefarer Output Port</link>"
msgstr "<link=\"ROCKETINTERIORGASOUTPUTPORT\">Porta de Saída de Gás Espacial</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUT.DESC"
msgid "Begone, foul waters!"
msgstr "Fora, águas impuras!"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUT.EFFECT"
msgid ""
"Allows <link=\"ELEMENTSLIQUID\">Liquids</link> to be pumped into rocket storage via <link=\"LIQUIDCONDUIT\">Pipes</link>.\n"
"\n"
"Sends liquid to the first Rocket Module with available space.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"Permite que <link=\"ELEMENTSLIQUID\">Líquidos</link> sejam bombeados para o armazenamento do foguete através de "
"<link=\"LIQUIDCONDUIT\">Tubulações</link>.\n"
"\n"
"Envia líquido para o primeiro Módulo do Foguete com espaço disponível.\n"
"\n"
"Deve ser construído no interior de um Módulo do Foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUT.NAME"
msgid "<link=\"ROCKETINTERIORLIQUIDINPUT\">Liquid Intake Fitting</link>"
msgstr "<link=\"ROCKETINTERIORLIQUIDINPUT\">Conector de Entrada de Líquido</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUTPORT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUTPORT.DESC"
msgid "A direct attachment to the output port on the exterior of a rocket."
msgstr "Uma conexão direta com a porta de saída no exterior de um foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUTPORT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUTPORT.EFFECT"
msgid ""
"Allows a direct conduit connection out of the <link=\"HABITATMODULEMEDIUM\">Spacefarer Module</link> of a rocket.\n"
"Can be used to vent <link=\"ELEMENTSLIQUID\">Liquids</link> to space during flight."
msgstr ""
"Permite uma conexão direta de tubulação para fora do <link=\"HABITATMODULEMEDIUM\">Módulo Espacial</link> de um foguete.\n"
"Pode ser usado para expelir <link=\"ELEMENTSLIQUID\">Líquidos</link> para o espaço durante o voo."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUTPORT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDINPUTPORT.NAME"
msgid "<link=\"ROCKETINTERIORLIQUIDINPUTPORT\">Liquid Spacefarer Input Port</link>"
msgstr "<link=\"ROCKETINTERIORLIQUIDINPUTPORT\">Porta de Entrada de Líquido Espacial</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUT.DESC"
msgid "Now if only we had some water balloons..."
msgstr "Agora, se ao menos tivéssemos alguns balões de água..."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUT.EFFECT"
msgid ""
"Allows <link=\"ELEMENTSLIQUID\">Liquids</link> to be drawn from rocket storage via <link=\"LIQUIDCONDUIT\">Pipes</link>.\n"
"\n"
"Draws liquid from the first Rocket Module with the requested material.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"Permite que <link=\"ELEMENTSLIQUID\">Líquidos</link> sejam extraídos do armazenamento do foguete através de "
"<link=\"LIQUIDCONDUIT\">Tubos</link>.\n"
"\n"
"Extrai líquido do primeiro Módulo do Foguete que contenha o material solicitado.\n"
"\n"
"Deve ser construído no interior de um Módulo do Foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUT.NAME"
msgid "<link=\"ROCKETINTERIORLIQUIDOUTPUT\">Liquid Output Fitting</link>"
msgstr "<link=\"ROCKETINTERIORLIQUIDOUTPUT\">Conexão de Saída de Líquido</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUTPORT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUTPORT.DESC"
msgid "A direct attachment to the input port on the exterior of a rocket."
msgstr "Uma conexão direta à porta de entrada no exterior de um foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUTPORT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUTPORT.EFFECT"
msgid "Allows a direct conduit connection into the <link=\"HABITATMODULEMEDIUM\">Spacefarer Module</link> of a rocket."
msgstr ""
"Permite uma conexão direta de duto com o <link=\"HABITATMODULEMEDIUM\">Módulo de Viagem Espacial</link> de um foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUTPORT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORLIQUIDOUTPUTPORT.NAME"
msgid "<link=\"ROCKETINTERIORLIQUIDOUTPUTPORT\">Liquid Spacefarer Output Port</link>"
msgstr "<link=\"ROCKETINTERIORLIQUIDOUTPUTPORT\">Porta de Saída de Líquido do Módulo de Viagem Espacial</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORPOWERPLUG.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORPOWERPLUG.DESC"
msgid "Outlets conveniently power buildings inside a cockpit using their rocket's power stores."
msgstr "Tomadas alimentam convenientemente as estruturas dentro de um cockpit usando as reservas de energia do foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORPOWERPLUG.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORPOWERPLUG.EFFECT"
msgid ""
"Provides <link=\"POWER\">Power</link> to connected buildings.\n"
"\n"
"Pulls power from <link=\"BATTERYMODULE\">Battery Modules</link> and Rocket Engines.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"Fornece <link=\"POWER\">Energia</link> para as estruturas conectadas.\n"
"\n"
"Puxa energia dos <link=\"BATTERYMODULE\">Módulos de Bateria</link> e Motores de Foguete.\n"
"\n"
"Deve ser construído no interior de um Módulo de Foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORPOWERPLUG.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORPOWERPLUG.NAME"
msgid "<link=\"ROCKETINTERIORPOWERPLUG\">Power Outlet Fitting</link>"
msgstr "<link=\"ROCKETINTERIORPOWERPLUG\">Tomada de Energia</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDINPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDINPUT.DESC"
msgid "Why organize your shelves when you can just shove everything in here?"
msgstr "Por que organizar suas prateleiras se você pode simplesmente jogar tudo aqui dentro?"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDINPUT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDINPUT.EFFECT"
msgid ""
"Allows <link=\"ELEMENTSSOLID\">Solid Materials</link> to be moved into rocket storage via <link=\"SOLIDCONDUIT\">Conveyor "
"Rails</link>.\n"
"\n"
"Sends solid material to the first Rocket Module with available space.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"Permite que <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> sejam transferidos para o armazenamento do foguete via "
"<link=\"SOLIDCONDUIT\">Trilhos Transportadores</link>.\n"
"\n"
"Envia material sólido para o primeiro Módulo de Foguete com espaço disponível.\n"
"\n"
"Deve ser construído no interior de um Módulo de Foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDINPUT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDINPUT.NAME"
msgid "<link=\"ROCKETINTERIORSOLIDINPUT\">Conveyor Receptacle Fitting</link>"
msgstr "<link=\"ROCKETINTERIORSOLIDINPUT\">Adaptador de Receptáculo Transportador</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDOUTPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDOUTPUT.DESC"
msgid "For accessing your stored luggage mid-flight."
msgstr "Para acessar sua bagagem armazenada durante o voo."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDOUTPUT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDOUTPUT.EFFECT"
msgid ""
"Allows <link=\"ELEMENTSSOLID\">Solid Materials</link> to be moved out of rocket storage via <link=\"SOLIDCONDUIT\">Conveyor "
"Rails</link>.\n"
"\n"
"Draws solid material from the first Rocket Module with the requested material.\n"
"\n"
"Must be built within the interior of a Rocket Module."
msgstr ""
"Permite que <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> sejam removidos do armazenamento do foguete via "
"<link=\"SOLIDCONDUIT\">Trilhos Transportadores</link>.\n"
"\n"
"Puxa material sólido do primeiro Módulo de Foguete que contenha o material solicitado.\n"
"\n"
"Deve ser construído no interior de um Módulo de Foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDOUTPUT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETINTERIORSOLIDOUTPUT.NAME"
msgid "<link=\"ROCKETINTERIORSOLIDOUTPUT\">Conveyor Loader Fitting</link>"
msgstr "<link=\"ROCKETINTERIORSOLIDOUTPUT\">Adaptador de Carregador Transportador</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETPOD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETPOD.DESC"
msgid "The Duplicant inside is equal parts nervous and excited."
msgstr "O Duplicante dentro está igualmente nervoso e empolgado."

#. STRINGS.BUILDINGS.PREFABS.ROCKETPOD.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETPOD.EFFECT"
msgid ""
"Contains a Duplicant deployed from orbit by a <link=\"PIONEERMODULE\">Trailblazer Module</link>.\n"
"\n"
"Pod will disintegrate on arrival."
msgstr ""
"Contém um Duplicante lançado da órbita por um <link=\"PIONEERMODULE\">Módulo Pioneiro</link>.\n"
"\n"
"A cápsula se desintegrará na chegada."

#. STRINGS.BUILDINGS.PREFABS.ROCKETPOD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETPOD.NAME"
msgid "<link=\"ROCKETPOD\">Trailblazer Deploy Pod</link>"
msgstr "<link=\"ROCKETPOD\">Cápsula de Desembarque Pioneira</link>"

#. STRINGS.BUILDINGS.PREFABS.ROCKETWALLTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETWALLTILE.DESC"
msgid "Keeps the space out."
msgstr "Mantém o espaço do lado de fora."

#. STRINGS.BUILDINGS.PREFABS.ROCKETWALLTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETWALLTILE.EFFECT"
msgid "The walls of a rocket."
msgstr "As paredes de um foguete."

#. STRINGS.BUILDINGS.PREFABS.ROCKETWALLTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROCKETWALLTILE.NAME"
msgid "<link=\"ROCKETENVELOPETILE\">Rocket Wall</link>"
msgstr "<link=\"ROCKETENVELOPETILE\">Parede de Foguete</link>"

#. STRINGS.BUILDINGS.PREFABS.ROLESTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ROLESTATION.DESC"
msgid "A skills board can teach special skills to Duplicants they can't learn on their own."
msgstr "Um quadro de habilidades pode ensinar habilidades especiais aos Duplicantes que eles não podem aprender sozinhos."

#. STRINGS.BUILDINGS.PREFABS.ROLESTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ROLESTATION.EFFECT"
msgid "Allows Duplicants to spend Skill Points to learn new <link=\"JOBS\">Skills</link>."
msgstr "Permite que os Duplicantes gastem Pontos de Habilidade para aprender novas <link=\"JOBS\">Habilidades</link>."

#. STRINGS.BUILDINGS.PREFABS.ROLESTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ROLESTATION.NAME"
msgid "<link=\"ROLESTATION\">Skills Board</link>"
msgstr "<link=\"ROLESTATION\">Quadro de Habilidades</link>"

#. STRINGS.BUILDINGS.PREFABS.RUBBERMAKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RUBBERMAKER.DESC"
msgid "Making rubber is the first step to crafting gaskets that keep liquids where they ought to be."
msgstr "Fazer borracha é o primeiro passo para criar juntas que mantêm os líquidos onde devem estar."

#. STRINGS.BUILDINGS.PREFABS.RUBBERMAKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RUBBERMAKER.EFFECT"
msgid ""
"Converts <link=\"LATEX\">Latex</link> into <link=\"RUBBER\">Rubber</link>.\n"
"\n"
"Latex must be delivered via <link=\"LIQUIDPIPING\">Liquid Pipes</link>."
msgstr ""
"Converte <link=\"LATEX\">Látex</link> em <link=\"RUBBER\">Borracha</link>.\n"
"\n"
"O Látex deve ser entregue via Canos."

#. STRINGS.BUILDINGS.PREFABS.RUBBERMAKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RUBBERMAKER.NAME"
msgid "<link=\"RUBBERMAKER\">Vulcanizer</link>"
msgstr "<link=\"RUBBERMAKER\">Vulcanizador</link>"

#. STRINGS.BUILDINGS.PREFABS.RUBBERTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RUBBERTILE.DESC"
msgid "Rubber tiles are designed to resist damage from liquid pressure."
msgstr "Blocos de borracha são projetados para resistir a danos de pressão de líquidos."

#. STRINGS.BUILDINGS.PREFABS.RUBBERTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RUBBERTILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Provides an anti-slip work surface and effective <link=\"HEAT\">Insulation</link>."
msgstr ""
"Usado para construir paredes e pisos de quartos.\n"
"\n"
"Fornece uma superfície de trabalho antiderrapante e <link=\"HEAT\">Isolamento</link> eficaz."

#. STRINGS.BUILDINGS.PREFABS.RUBBERTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RUBBERTILE.NAME"
msgid "<link=\"RUBBERTILE\">Rubber Tile</link>"
msgstr "<link=\"RUBBERTILE\">Bloco de Borracha</link>"

#. STRINGS.BUILDINGS.PREFABS.RUSTDEOXIDIZER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.RUSTDEOXIDIZER.DESC"
msgid "Rust and salt goes in, oxygen comes out."
msgstr "A ferrugem e o sal entram, o oxigênio sai."

#. STRINGS.BUILDINGS.PREFABS.RUSTDEOXIDIZER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.RUSTDEOXIDIZER.EFFECT"
msgid ""
"Converts <link=\"RUST\">Rust</link> into <link=\"OXYGEN\">Oxygen</link> and <link=\"CHLORINE\">Chlorine Gas</link>.\n"
"\n"
"Becomes idle when the area reaches maximum pressure capacity."
msgstr ""
"Converte <link=\"RUST\">Ferrugem</link> em <link=\"OXYGEN\">Oxigênio</link> e <link=\"CHLORINE\">Gás de Cloro</link>.\n"
"\n"
"Torna-se inativo quando a área atinge a capacidade máxima de pressão."

#. STRINGS.BUILDINGS.PREFABS.RUSTDEOXIDIZER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.RUSTDEOXIDIZER.NAME"
msgid "<link=\"RUSTDEOXIDIZER\">Rust Deoxidizer</link>"
msgstr "<link=\"RUSTDEOXIDIZER\">Desoxidizador de Ferrugem</link>"

#. STRINGS.BUILDINGS.PREFABS.SAUNA.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SAUNA.DESC"
msgid "A steamy sauna soothes away all the aches and pains."
msgstr "Uma sauna quente alivia todas as dores e tensões."

#. STRINGS.BUILDINGS.PREFABS.SAUNA.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SAUNA.EFFECT"
msgid ""
"Uses <link=\"STEAM\">Steam</link> to create a relaxing atmosphere.\n"
"\n"
"Increases Duplicant <link=\"MORALE\">Morale</link> and provides a lingering sense of warmth."
msgstr ""
"Utiliza <link=\"STEAM\">Vapor</link> para criar uma atmosfera relaxante.\n"
"\n"
"Aumenta o <link=\"MORALE\">Ânimo</link> dos Duplicantes e proporciona uma sensação duradoura de calor."

#. STRINGS.BUILDINGS.PREFABS.SAUNA.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SAUNA.NAME"
msgid "<link=\"SAUNA\">Sauna</link>"
msgstr "<link=\"SAUNA\">Sauna</link>"

#. STRINGS.BUILDINGS.PREFABS.SCANNERMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SCANNERMODULE.DESC"
msgid "Allows Duplicants to boldly go where other Duplicants haven't been yet."
msgstr "Permite que os Duplicantes avancem com coragem para onde nenhum outro Duplicante foi antes."

#. STRINGS.BUILDINGS.PREFABS.SCANNERMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SCANNERMODULE.EFFECT"
msgid ""
"Automatically analyzes adjacent space while on a voyage. \n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"Analisa automaticamente o espaço adjacente durante uma viagem. \n"
"\n"
"Deve ser construído através da <link=\"LAUNCHPAD\">Plataforma de Foguetes</link>."

#. STRINGS.BUILDINGS.PREFABS.SCANNERMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SCANNERMODULE.NAME"
msgid "<link=\"SCANNERMODULE\">Cartographic Module</link>"
msgstr "<link=\"SCANNERMODULE\">Módulo Cartográfico</link>"

#. STRINGS.BUILDINGS.PREFABS.SCOUTLANDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SCOUTLANDER.DESC"
msgid "Lands <link=\"SCOUT\">Rover</link> on a Planetoid when <link=\"SCOUTMODULE\">Rover's Module</link> is in orbit."
msgstr ""
"Pousa o <link=\"SCOUT\">Rover</link> em um Planetoide quando o <link=\"SCOUTMODULE\">Módulo do Rover</link> está em órbita."

#. STRINGS.BUILDINGS.PREFABS.SCOUTLANDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SCOUTLANDER.NAME"
msgid "<link=\"SCOUTMODULE\">Rover's Lander</link>"
msgstr "<link=\"SCOUTMODULE\">Módulo de Pouso do Rover</link>"

#. STRINGS.BUILDINGS.PREFABS.SCOUTMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SCOUTMODULE.DESC"
msgid "Rover can conduct explorations of planetoids that don't have rocket platforms built."
msgstr "O Rover pode realizar explorações de planetoides que não possuem plataformas de foguetes construídas."

#. STRINGS.BUILDINGS.PREFABS.SCOUTMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SCOUTMODULE.EFFECT"
msgid ""
"Deploys one <link=\"SCOUT\">Rover Bot</link> for remote Planetoid exploration.\n"
"\n"
"Deployment is available while in a Starmap hex adjacent to a Planetoid. \n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"Implanta um <link=\"SCOUT\">Robô Rover</link> para exploração remota de Planetas.\n"
"\n"
"A implantação está disponível enquanto estiver em um hexágono do Mapa Estelar adjacente a um Planeta.\n"
"\n"
"Deve ser construído através da <link=\"LAUNCHPAD\">Plataforma de Lançamento de Foguetes</link>."

#. STRINGS.BUILDINGS.PREFABS.SCOUTMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SCOUTMODULE.NAME"
msgid "<link=\"SCOUTMODULE\">Rover's Module</link>"
msgstr "<link=\"SCOUTMODULE\">Módulo do Rover</link>"

#. STRINGS.BUILDINGS.PREFABS.SCOUTROCKETPOD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SCOUTROCKETPOD.DESC"
msgid "Good luck out there, boy!"
msgstr "Boa sorte lá fora, garoto!"

#. STRINGS.BUILDINGS.PREFABS.SCOUTROCKETPOD.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SCOUTROCKETPOD.EFFECT"
msgid ""
"Contains a <link=\"SCOUT\">Rover</link> deployed from an orbiting <link=\"SCOUTMODULE\">Rover's Module</link>.\n"
"\n"
"Pod will disintegrate on arrival."
msgstr ""
"Contém um <link=\"SCOUT\">Rover</link> lançado de um <link=\"SCOUTMODULE\">Módulo do Rover</link> em órbita.\n"
"\n"
