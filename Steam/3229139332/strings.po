#. STRINGS.MISC.TAGS.REMOTEOPERABLE_DESC
msgctxt "STRINGS.MISC.TAGS.REMOTEOPERABLE_DESC"
msgid ""
"These buildings can be operated from a distance by a <link=\"REMOTEWORKTERMINAL\">Remote Controller</link> so long as they "
"are built within range of a <link=\"REMOTEWORKERDOCK\">Remote Worker Dock</link>."
msgstr ""
"Essas estruturas podem ser operados remotamente por um <link=\"REMOTEWORKTERMINAL\">Controlador Remoto</link> desde que "
"sejam construídos dentro do alcance de uma <link=\"REMOTEWORKERDOCK\">Estação de Trabalhador Remoto</link>."

