#. STRINGS.EQUIPMENT.PREFABS.LEAD_SUIT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.LEAD_SUIT.DESC"
msgid "Because exposure to radiation doesn't grant Duplicants superpowers."
msgstr "Porque a exposição à radiação não dá superpoderes aos Duplicantes."

#. STRINGS.EQUIPMENT.PREFABS.LEAD_SUIT.EFFECT
msgctxt "STRINGS.EQUIPMENT.PREFABS.LEAD_SUIT.EFFECT"
msgid ""
"Supplies Duplicants with <link=\"OXYGEN\">Oxygen</link> and protection in areas with <link=\"RADIATION\">Radiation</link>.\n"
"\n"
"Must be refilled with <link=\"OXYGEN\">Oxygen</link> at a <link=\"LEADSUITLOCKER\">Lead Suit Dock</link> when depleted."
msgstr ""
"Fornece <link=\"OXYGEN\">Oxigênio</link> e proteção aos Duplicantes em áreas com <link=\"RADIATION\">Radiação</link>.\n"
"\n"
"Deve ser reabastecido com <link=\"OXYGEN\">Oxigênio</link> em um <link=\"LEADSUITLOCKER\">Estação de Traje de Chumbo</link> "
"quando esgotado."

