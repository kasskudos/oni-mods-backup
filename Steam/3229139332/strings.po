msgstr "Primeiro Encontro"

#. STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.BEGIN_POPUP.DESCRIPTION
msgctxt "STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.BEGIN_POPUP.DESCRIPTION"
msgid ""
"I've discovered an experiment designed to analyze the evolutionary dynamics of critter mutation.\n"
"\n"
"Once it has gathered enough data, it could prove extremely useful for genetic manipulation."
msgstr ""
"Descobri um experimento projetado para analisar a dinâmica evolutiva da mutação de criaturas.\n"
"\n"
"Depois que reunir dados suficientes, pode ser extremamente útil para manipulação genética."

#. STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.BEGIN_POPUP.NAME
msgctxt "STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.BEGIN_POPUP.NAME"
msgid "Story Trait: Critter Flux-O-Matic"
msgstr "Traço da História: Fluxomático de Criaturas"

#. STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.DESCRIPTION
msgctxt "STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.DESCRIPTION"
msgid ""
"Explore a revolutionary genetic manipulation device designed for critters.\n"
"\n"
"Whether or not it was ever used on non-critter subjects is unclear. Its DNA database has been wiped clean."
msgstr ""
"Explore um dispositivo revolucionário de manipulação genética projetado para criaturas.\n"
"\n"
"Não está claro se ele já foi usado em indivíduos que não sejam criaturas. Seu banco de dados de DNA foi completamente "
"apagado."

#. STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.DESCRIPTION_SHORT
msgctxt "STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.DESCRIPTION_SHORT"
msgid "Explore a revolutionary genetic manipulation device designed for critters."
msgstr "Explore um dispositivo de manipulação genética revolucionário projetado para criaturas."

#. STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.END_POPUP.BUTTON
msgctxt "STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.END_POPUP.BUTTON"
msgid "Unlock Gene Manipulation Mode"
msgstr "Desbloquear Modo de Manipulação Genética"

#. STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.END_POPUP.CODEX_NAME
msgctxt "STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.END_POPUP.CODEX_NAME"
msgid "Challenge Completed"
msgstr "Desafio Completo"

#. STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.END_POPUP.DESCRIPTION
msgctxt "STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.END_POPUP.DESCRIPTION"
msgid ""
"Success! Sufficient samples collected.\n"
"\n"
"I can now trigger genetic deviations in base morphs by sending them through the scanner.\n"
"\n"
"Existing variants can also be scanned, but their genetic makeup is too unstable to tolerate further manipulation."
msgstr ""
"Sucesso! Amostras suficientes coletadas.\n"
"\n"
"Agora posso desencadear desvios genéticos em morfos de base enviando-os através do scanner.\n"
"\n"
"Variantes existentes também podem ser digitalizadas, mas sua composição genética é muito instável para tolerar mais "
"manipulação."

#. STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.END_POPUP.NAME
msgctxt "STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.END_POPUP.NAME"
msgid "Story Trait Complete: Critter Flux-O-Matic"
msgstr "Traço de História Concluída: Fluxomático de Criaturas"

#. STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.NAME
