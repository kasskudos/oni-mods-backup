msgstr "Penalidade por Murchar"

#. STRINGS.CREATURES.SPECIES.JUNGLEGASPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.JUNGLEGASPLANT.DESC"
msgid ""
"A large, chlorine-dwelling <link=\"PLANTS\">Plant</link> that can be grown in farm buildings.\n"
"\n"
"Palmeras grow inedible buds that emit unbreathable hydrogen gas."
msgstr ""
"Uma grande <link=\"PLANTS\">Planta</link> que vive em cloro e pode ser cultivada em estruturas agrícolas.\n"
"\n"
"Palmeiras cultivam brotos não comestíveis que emitem gás hidrogênio irrespirável."

#. STRINGS.CREATURES.SPECIES.JUNGLEGASPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.JUNGLEGASPLANT.DOMESTICATEDDESC"
msgid ""
"A large, chlorine-dwelling <link=\"PLANTS\">Plant</link> that grows inedible buds which emit unbreathable hydrogen gas."
msgstr ""
"Uma grande <link=\"PLANTS\">Planta</link> que vive em cloro e cultiva brotos não comestíveis que emitem gás hidrogênio "
"irrespirável."

#. STRINGS.CREATURES.SPECIES.JUNGLEGASPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.JUNGLEGASPLANT.NAME"
msgid "<link=\"JUNGLEGASPLANT\">Palmera Tree</link>"
msgstr "<link=\"JUNGLEGASPLANT\">Palmeira</link>"

#. STRINGS.CREATURES.SPECIES.KELPPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.KELPPLANT.DESC"
msgid ""
"Seakombs consume <link=\"TOXICSAND\">Polluted Dirt</link>.\n"
"\n"
"Their leaves can be processed to extract <link=\"PHYTOOIL\">Phyto Oil</link>."
msgstr ""
"Pentálgas consomem <link=\"TOXICSAND\">Terra Poluída</link>.\n"
"\n"
"Suas folhas podem ser processadas para extrair <link=\"PHYTOOIL\">Óleo Fito</link>."

#. STRINGS.CREATURES.SPECIES.KELPPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.KELPPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"KELP\">Seakomb Leaf</link>."
msgstr "Esta planta produz <link=\"KELP\">Folha de Pentálga</link>."

#. STRINGS.CREATURES.SPECIES.KELPPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.KELPPLANT.NAME"
msgid "<link=\"KELPPLANT\">Seakomb</link>"
msgstr "<link=\"KELPPLANT\">Pentálga</link>"

#. STRINGS.CREATURES.SPECIES.LEAFYPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.LEAFYPLANT.DESC"
msgid ""
"Mirth Leaves sport a calm green hue known for alleviating <link=\"STRESS\">Stress</link> and improving "
"<link=\"MORALE\">Morale</link>."
msgstr ""
"Folhas Felizes exibem um tom de verde calmo, conhecido por aliviar o <link=\"STRESS\">Estresse</link> e melhorar o "
"<link=\"MORALE\">Moral</link>."

#. STRINGS.CREATURES.SPECIES.LEAFYPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.LEAFYPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decor</link> do ambiente."

