#. STRINGS.BUILDINGS.PREFABS.CARGOBAY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CARGOBAY.DESC"
msgid "Duplicants will fill cargo bays with any resources they find during space missions."
msgstr ""
"Os Duplicantes preencherão os compartimentos de carga com todos os recursos que encontrarem durante as missões espaciais."

#. STRINGS.BUILDINGS.PREFABS.CARGOBAY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CARGOBAY.EFFECT"
msgid ""
"Allows Duplicants to store any <link=\"ELEMENTSSOLID\">Solid Materials</link> found during space missions.\n"
"\n"
"Stored resources become available to the colony upon the rocket's return."
msgstr ""
"Permite que os Duplicantes armazenem quaisquer <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> encontrados durante missões "
"espaciais.\n"
"\n"
"Os recursos armazenados ficam disponíveis para a colônia após o retorno do foguete."

#. STRINGS.BUILDINGS.PREFABS.CARGOBAY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CARGOBAY.NAME"
msgid "<link=\"CARGOBAY\">Cargo Bay</link>"
msgstr "<link=\"CARGOBAY\">Compartimento de Carga</link>"

#. STRINGS.BUILDINGS.PREFABS.CARGOBAYCLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CARGOBAYCLUSTER.DESC"
msgid "Holds more than a regular cargo bay."
msgstr "Comporta mais do que um compartimento de carga normal."

#. STRINGS.BUILDINGS.PREFABS.CARGOBAYCLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CARGOBAYCLUSTER.EFFECT"
msgid ""
"Allows Duplicants to store most of the <link=\"ELEMENTSSOLID\">Solid Materials</link> found during space missions.\n"
"\n"
"Stored resources become available to the colony upon the rocket's return. \n"
"\n"
"Must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr ""
"Permite que os Duplicantes armazenem a maioria dos <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> encontrados durante "
"missões espaciais.\n"
"\n"
"Os recursos armazenados ficam disponíveis para a colônia após o retorno do foguete.\n"
"\n"
"Deve ser construído através da <link=\"LAUNCHPAD\">Plataforma de Foguete</link>."

#. STRINGS.BUILDINGS.PREFABS.CARGOBAYCLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CARGOBAYCLUSTER.NAME"
msgid "<link=\"CARGOBAYCLUSTER\">Large Cargo Bay</link>"
msgstr "<link=\"CARGOBAYCLUSTER\">Módulo de Carga Grande</link>"

#. STRINGS.BUILDINGS.PREFABS.CARPETTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CARPETTILE.DESC"
msgid "Soft on little Duplicant toesies."
msgstr "Suave aos dedos dos pés do Duplicante."

#. STRINGS.BUILDINGS.PREFABS.CARPETTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CARPETTILE.EFFECT"
msgid ""
"Used to build the walls and floors of rooms.\n"
"\n"
"Increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>."
msgstr ""
"Usado para construir paredes e pisos de quartos.\n"
"\n"
"Aumenta a <link=\"DECOR\">Decor</link>, contribuindo para a <link=\"MORALE\">Moral</link>."

#. STRINGS.BUILDINGS.PREFABS.CARPETTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CARPETTILE.NAME"
msgid "<link=\"CARPETTILE\">Carpeted Tile</link>"
msgstr "<link=\"CARPETTILE\">Bloco de Carpete</link>"

#. STRINGS.BUILDINGS.PREFABS.CEILINGFOSSILSCULPTURE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGFOSSILSCULPTURE.DESC"
msgid "Duplicants who have learned art skills can produce more decorative ceiling sculptures."
msgstr "Duplicantes que adquiriram habilidades artísticas podem produzir esculturas de teto mais decorativas."

#. STRINGS.BUILDINGS.PREFABS.CEILINGFOSSILSCULPTURE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGFOSSILSCULPTURE.EFFECT"
msgid ""
"Majorly increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>.\n"
"\n"
"Must be sculpted by a Duplicant."
msgstr ""
"Aumenta significativamente a <link=\"DECOR\">Decor</link>, contribuindo para a <link=\"MORALE\">Moral</link>.\n"
"\n"
"Precisa ser esculpido por um Duplicante."

#. STRINGS.BUILDINGS.PREFABS.CEILINGFOSSILSCULPTURE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGFOSSILSCULPTURE.NAME"
msgid "<link=\"CEILINGFOSSILSCULPTURE\">Hanging Fossil Block</link>"
msgstr "<link=\"CEILINGFOSSILSCULPTURE\">Bloco de Fóssil Pendente</link>"

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.DESC"
msgid "Light reduces Duplicant stress and is required to grow certain plants."
msgstr "A luz reduz o estresse dos Duplicantes e é necessária para o crescimento de certas plantas."

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.EFFECT"
msgid ""
"Provides <link=\"LIGHT\">Light</link> when <link=\"POWER\">Powered</link>.\n"
"\n"
"Increases Duplicant workspeed within light radius."
msgstr ""
"Fornece <link=\"LIGHT\">Luz</link> quando <link=\"POWER\">Energizado</link>.\n"
"\n"
"Aumenta a velocidade de trabalho do Duplicante dentro do raio de luz."

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.BLOSSOM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.BLOSSOM.DESC"
msgid "For Duplicants who can't keep real plants alive."
msgstr "Para Duplicantes que não conseguem manter plantas reais vivas."

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.BLOSSOM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.BLOSSOM.NAME"
msgid "<link=\"CEILINGLIGHT\">Blossom Ceiling Light</link>"
msgstr "<link=\"CEILINGLIGHT\">Luz de Teto Florescarpa</link>"

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.DEFAULT_CEILINGLIGHT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.DEFAULT_CEILINGLIGHT.DESC"
msgid "It does not go on the floor."
msgstr "Não vai para o chão."

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.DEFAULT_CEILINGLIGHT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.DEFAULT_CEILINGLIGHT.NAME"
msgid "<link=\"CEILINGLIGHT\">Ceiling Light</link>"
msgstr "<link=\"CEILINGLIGHT\">Luz de teto</link>"

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.FAUXPIPE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.FAUXPIPE.DESC"
msgid "The height of plumbing-inspired interior design."
msgstr "O auge do design de interiores inspirado no encanamento."

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.FAUXPIPE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.FAUXPIPE.NAME"
msgid "<link=\"CEILINGLIGHT\">Faux Pipe Ceiling Light</link>"
msgstr "<link=\"CEILINGLIGHT\">Luminária de Teto Tubo Falso</link>"

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.LABFLASK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.LABFLASK.DESC"
msgid "For best results, do not fill with liquids."
msgstr "Para melhores resultados, não encha com líquidos."

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.LABFLASK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.LABFLASK.NAME"
msgid "<link=\"CEILINGLIGHT\">Lab Flask Ceiling Light</link>"
msgstr "<link=\"CEILINGLIGHT\">Luz de Teto Frasco de Laboratório</link>"

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.MINING.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.MINING.DESC"
msgid "The protective cage makes it the safest choice for underground parties."
msgstr "A gaiola de proteção a torna a escolha mais segura para festas subterrâneas."

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.MINING.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.MINING.NAME"
msgid "<link=\"CEILINGLIGHT\">Mining Ceiling Light</link>"
msgstr "<link=\"CEILINGLIGHT\">Luz de Teto de Mineração</link>"

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.POLKADOT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.POLKADOT.DESC"
msgid "A fun lampshade for fun spaces."
msgstr "Um abajur divertido para espaços divertidos."

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.POLKADOT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.POLKADOT.NAME"
msgid "<link=\"CEILINGLIGHT\">Polka Dot Ceiling Light</link>"
msgstr "<link=\"CEILINGLIGHT\">Luminária de Teto Poá</link>"

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.RUBIKS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.RUBIKS.DESC"
msgid "The initials E.R. are sewn into the lampshade."
msgstr "As iniciais E.R. estão costuradas no abajur."

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.RUBIKS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.FACADES.RUBIKS.NAME"
msgid "<link=\"CEILINGLIGHT\">Puzzle Cube Ceiling Light</link>"
msgstr "<link=\"CEILINGLIGHT\">Luminária de Teto Cubo Mágico</link>"

#. STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CEILINGLIGHT.NAME"
msgid "<link=\"CEILINGLIGHT\">Ceiling Light</link>"
msgstr "<link=\"CEILINGLIGHT\">Luz de teto</link>"

#. STRINGS.BUILDINGS.PREFABS.CHECKPOINT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CHECKPOINT.DESC"
msgid "Checkpoints can be connected to automated sensors to determine when it's safe to enter."
msgstr "Pontos de Controle podem ser automatizados para determinar quando for seguro entrar."

#. STRINGS.BUILDINGS.PREFABS.CHECKPOINT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CHECKPOINT.EFFECT"
msgid ""
"Allows Duplicants to pass when receiving a <b><style=\"logic_on\">Green Signal</style></b>.\n"
"\n"
"Prevents Duplicants from passing when receiving a <b><style=\"logic_off\">Red Signal</style></b>."
msgstr ""
"Permite que os Duplicantes passem ao receber um <b><style=\"logic_on\">Sinal Verde</style></b>.\n"
"\n"
"Impede que os Duplicantes passem ao receber um <b><style=\"logic_off\">Sinal Vermelho</style></b>."

#. STRINGS.BUILDINGS.PREFABS.CHECKPOINT.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.CHECKPOINT.LOGIC_PORT"
msgid "Duplicant Stop/Go"
msgstr "Duplicante Parar/Avançar"

#. STRINGS.BUILDINGS.PREFABS.CHECKPOINT.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.CHECKPOINT.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Allow Duplicant passage"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Permite a passagem dos Duplicantes"

#. STRINGS.BUILDINGS.PREFABS.CHECKPOINT.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.CHECKPOINT.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Prevent Duplicant passage"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Impede a passagem dos Duplicantes"

#. STRINGS.BUILDINGS.PREFABS.CHECKPOINT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CHECKPOINT.NAME"
msgid "<link=\"CHECKPOINT\">Duplicant Checkpoint</link>"
msgstr "<link=\"CHECKPOINT\">Pontos de Controle de Duplicantes</link>"

#. STRINGS.BUILDINGS.PREFABS.CHEMICALREFINERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CHEMICALREFINERY.DESC"
msgid "It's like a blender, but better."
msgstr "É como um liquidificador, mas melhor."

#. STRINGS.BUILDINGS.PREFABS.CHEMICALREFINERY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CHEMICALREFINERY.EFFECT"
msgid ""
"Combines <link=\"ELEMENTSLIQUID\">Liquids</link> and other inputs into fluid compounds.\n"
"\n"
"Duplicants will not fabricate emulsions unless recipes are queued."
msgstr ""
"Combina <link=\"ELEMENTSLIQUID\">Líquidos</link> e outras entradas em compostos fluidos.\n"
"\n"
"Duplicantes não fabricarão emulsões a menos que receitas estejam na fila."

#. STRINGS.BUILDINGS.PREFABS.CHEMICALREFINERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CHEMICALREFINERY.NAME"
msgid "<link=\"CHEMICALREFINERY\">Emulsifier</link>"
msgstr "<link=\"CHEMICALREFINERY\">Emulsificador</link>"

#. STRINGS.BUILDINGS.PREFABS.CHEMICALREFINERY.REFINEDLIPID_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.CHEMICALREFINERY.REFINEDLIPID_RECIPE_DESCRIPTION"
msgid "Biodiesel is a <link=\"COMBUSTIBLELIQUID\">Combustible Liquid</link> used in <link=\"POWER\">Power</link> production."
msgstr "Biodiesel é um <link=\"ELEMENTSLIQUID\">Líquido</link> usado na produção de <link=\"POWER\">Energia</link>."

#. STRINGS.BUILDINGS.PREFABS.CHEMICALREFINERY.SALTWATER_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.CHEMICALREFINERY.SALTWATER_RECIPE_DESCRIPTION"
msgid "Salt Water is a <link=\"ELEMENTSLIQUID\">Liquid</link> with insulating and radiation-absorbing properties."
msgstr "Água Salgada é um <link=\"ELEMENTSLIQUID\">Líquido</link> com propriedades isolantes e absorventes de radiação."

#. STRINGS.BUILDINGS.PREFABS.CHLORINATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CHLORINATOR.DESC"
msgid "Bleach stone is useful for sanitation and geotuning."
msgstr "Lixívia é útil para saneamento e geo-ajuste."

#. STRINGS.BUILDINGS.PREFABS.CHLORINATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CHLORINATOR.EFFECT"
msgid "Uses <link=\"SALT\">Salt</link> and <link=\"GOLD\">Gold</link> to produce <link=\"BLEACHSTONE\">Bleach Stone</link>."
msgstr "Usa <link=\"SALT\">Sal</link> e <link=\"GOLD\">Ouro</link> para produzir <link=\"BLEACHSTONE\">Lixívia</link>."

#. STRINGS.BUILDINGS.PREFABS.CHLORINATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CHLORINATOR.NAME"
msgid "<link=\"CHLORINATOR\">Bleach Stone Hopper</link>"
msgstr "<link=\"CHLORINATOR\">Funil de Lixívia</link>"

#. STRINGS.BUILDINGS.PREFABS.CLOTHINGALTERATIONSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CLOTHINGALTERATIONSTATION.DESC"
msgid "Allows skilled Duplicants to add extra personal pizzazz to their wardrobe."
msgstr "Permite que Duplicantes habilidosos adicionem um toque extra de estilo ao seu guarda-roupa."

#. STRINGS.BUILDINGS.PREFABS.CLOTHINGALTERATIONSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CLOTHINGALTERATIONSTATION.EFFECT"
msgid ""
"Upgrades <link=\"FUNKYVEST\">Snazzy Suits</link> into <link=\"CUSTOMCLOTHING\">Primo Garb</link>.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Melhora <link=\"FUNKYVEST\">Roupas Elegantes</link> em <link=\"CUSTOMCLOTHING\">Roupas de Grife</link>.\n"
"\n"
"Os Duplicantes não fabricarão itens a menos que receitas sejam enfileiradas."

#. STRINGS.BUILDINGS.PREFABS.CLOTHINGALTERATIONSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CLOTHINGALTERATIONSTATION.NAME"
msgid "<link=\"CLOTHINGALTERATIONSTATION\">Clothing Refashionator</link>"
msgstr "<link=\"CLOTHINGALTERATIONSTATION\">Remodelador de Roupas</link>"

#. STRINGS.BUILDINGS.PREFABS.CLOTHINGFABRICATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CLOTHINGFABRICATOR.DESC"
msgid "A textile loom can be used to spin Reed Fiber into wearable Duplicant clothing."
msgstr "Uma Fábrica Têxtil pode ser usada para fiar Fibra de Junco e transformá-la em roupas para Duplicantes."

#. STRINGS.BUILDINGS.PREFABS.CLOTHINGFABRICATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CLOTHINGFABRICATOR.EFFECT"
msgid ""
"Tailors Duplicant <link=\"EQUIPMENT\">Clothing</link> items.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Fabrica itens de <link=\"EQUIPMENT\">Roupa</link> para Duplicantes.\n"
"\n"
"Duplicantes não fabricarão itens a menos que as receitas estejam na fila."

#. STRINGS.BUILDINGS.PREFABS.CLOTHINGFABRICATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CLOTHINGFABRICATOR.NAME"
msgid "<link=\"CLOTHINGFABRICATOR\">Textile Loom</link>"
msgstr "<link=\"CLOTHINGFABRICATOR\">Fábrica Têxtil</link>"

#. STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.DESC"
msgid ""
msgstr "Permite que um Duplicante pilote foguetes. Designa um Duplicante como Piloto de Foguete."

#. STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.EFFECT"
msgid ""
msgstr "Designa um Duplicante como Piloto de Foguete"

#. STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.LOGIC_PORT_LAUNCH
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.LOGIC_PORT_LAUNCH"
msgid "Launch Rocket"
msgstr "Lançar Foguete"

#. STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.LOGIC_PORT_LAUNCH_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.LOGIC_PORT_LAUNCH_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Launch rocket"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Lançar foguete"

#. STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.LOGIC_PORT_LAUNCH_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.LOGIC_PORT_LAUNCH_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Awaits launch command"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Aguardando comando de lançamento"

#. STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.LOGIC_PORT_READY
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.LOGIC_PORT_READY"
msgid "Rocket Checklist"
msgstr "Lista de Verificação de Foguete"

#. STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.LOGIC_PORT_READY_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.LOGIC_PORT_READY_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when its rocket launch checklist is complete"
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</b></style> quando a lista de checagem de lançamento do foguete estiver completa"

#. STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.LOGIC_PORT_READY_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.LOGIC_PORT_READY_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</b></style>"

#. STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERCOMMANDMODULE.NAME"
msgid "<link=\"CLUSTERCOMMANDMODULE\">Command Capsule</link>"
msgstr "<link=\"CLUSTERCOMMANDMODULE\">Cápsula de Comando</link>"

#. STRINGS.BUILDINGS.PREFABS.CLUSTERCRAFTINTERIORDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERCRAFTINTERIORDOOR.DESC"
msgid "A hatch for getting in and out of the rocket."
msgstr "Uma escotilha para entrar e sair do foguete."

#. STRINGS.BUILDINGS.PREFABS.CLUSTERCRAFTINTERIORDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERCRAFTINTERIORDOOR.EFFECT"
msgid "Warning: Do not open mid-flight."
msgstr "Aviso: Não abra no meio do voo."

#. STRINGS.BUILDINGS.PREFABS.CLUSTERCRAFTINTERIORDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERCRAFTINTERIORDOOR.NAME"
msgid "<link=\"CLUSTERCRAFTINTERIORDOOR\">Interior Hatch</link>"
msgstr "<link=\"CLUSTERCRAFTINTERIORDOOR\">Escotilha Interna</link>"

#. STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPE.DESC"
msgid "Telescopes are necessary for studying space, allowing rocket travel to other worlds."
msgstr "Os telescópios são necessários para estudar o espaço, permitindo viagens de foguetes para outros mundos."

#. STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPE.EFFECT"
msgid ""
"Reveals visitable Planetoids in space, producing <link=\"DATABANK\">Data Banks</link> in the process.\n"
"\n"
"Assigned Duplicants must possess the <link=\"ASTRONOMY\">Astronomy</link> skill.\n"
"\n"
"Building must be exposed to space to function."
msgstr ""
"Revela planetoides visitáveis ​​no espaço.\n"
"\n"
"Os Duplicantes designados devem possuir a habilidade <link=\"ASTRONOMY\">Astronomia</link>.\n"
"\n"
"A construção deve estar exposta ao espaço para funcionar."

#. STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPE.NAME"
msgid "<link=\"CLUSTERTELESCOPE\">Telescope</link>"
msgstr "<link=\"CLUSTERTELESCOPE\">Telescópio</link>"

#. STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPE.REQUIREMENT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPE.REQUIREMENT_TOOLTIP"
msgid "A steady {0} supply is required to sustain working Duplicants."
msgstr "Um suprimento constante de {0} é necessário para sustentar Duplicantes trabalhando."

#. STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPEENCLOSED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPEENCLOSED.DESC"
msgid "It's easier to focus on work when shielded from the vacuum of space."
msgstr "É mais fácil focar no trabalho quando protegido do vácuo do espaço."

#. STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPEENCLOSED.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPEENCLOSED.EFFECT"
msgid ""
"Reveals visitable Planetoids in space and produces <link=\"DATABANK\">Data Banks</link>... in comfort!\n"
"\n"
"Assigned Duplicants must possess the <link=\"ASTRONOMY\">Astronomy</link> skill.\n"
"\n"
"Excellent sunburn protection (100%), partial <link=\"RADIATION\">Radiation</link> protection (50%) .\n"
"\n"
"Building must be exposed to space to function."
msgstr ""
"Revela Planetoides visitáveis no espaço... com conforto!\n"
"\n"
"Duplicantes designados devem possuir a habilidade de <link=\"ASTRONOMY\">Astronomia</link>.\n"
"\n"
"Excelente proteção contra queimaduras solares (100%), proteção parcial contra <link=\"RADIATION\">Radiação</link> (50%).\n"
"\n"
"A estrutura deve estar exposta ao espaço para funcionar."

#. STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPEENCLOSED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPEENCLOSED.NAME"
msgid "<link=\"CLUSTERTELESCOPEENCLOSED\">Enclosed Telescope</link>"
msgstr "<link=\"CLUSTERTELESCOPEENCLOSED\">Telescópio Fechado</link>"

#. STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPEENCLOSED.REQUIREMENT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.CLUSTERTELESCOPEENCLOSED.REQUIREMENT_TOOLTIP"
msgid "A steady {0} supply is required to sustain working Duplicants."
msgstr "Um suprimento constante de {0} é necessário para sustentar Duplicantes em trabalho."

#. STRINGS.BUILDINGS.PREFABS.CO2ENGINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CO2ENGINE.DESC"
msgid "Rockets can be used to send Duplicants into space and retrieve rare resources."
msgstr "Foguetes podem ser usados ​​para enviar Duplicantes ao espaço e recuperar recursos raros."

#. STRINGS.BUILDINGS.PREFABS.CO2ENGINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CO2ENGINE.EFFECT"
msgid ""
"Uses pressurized <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> to propel rockets for short range space exploration.\n"
"\n"
"Carbon Dioxide Engines are relatively fast engine for their size but with limited height restrictions.\n"
"\n"
"Engine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n"
"\n"
"Once the engine has been built, more rocket modules can be added."
msgstr ""
"Usa <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link> pressurizado para propulsar foguetes em explorações espaciais de "
"curto alcance.\n"
"\n"
"Motores de Dióxido de Carbono são motores relativamente rápidos para seu tamanho, mas com restrições de altura limitadas.\n"
"\n"
"O motor deve ser construído através da <link=\"LAUNCHPAD\">Plataforma de Foguete</link>.\n"
"\n"
"Uma vez que o motor tenha sido construído, mais módulos de foguete podem ser adicionados."

#. STRINGS.BUILDINGS.PREFABS.CO2ENGINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CO2ENGINE.NAME"
msgid "<link=\"CO2ENGINE\">Carbon Dioxide Engine</link>"
msgstr "<link=\"CO2ENGINE\">Motor de Dióxido de Carbono</link>"

#. STRINGS.BUILDINGS.PREFABS.CO2SCRUBBER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CO2SCRUBBER.DESC"
msgid "Skimmers remove large amounts of carbon dioxide, but produce no breathable air."
msgstr "Os Removedores de Carbono removem grandes quantidades de dióxido de carbono, mas não produzem ar respirável."

#. STRINGS.BUILDINGS.PREFABS.CO2SCRUBBER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CO2SCRUBBER.EFFECT"
msgid "Uses <link=\"WATER\">Water</link> to filter <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> from the air."
msgstr "Usa <link=\"WATER\">Água</link> para filtrar <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link> do ar."

#. STRINGS.BUILDINGS.PREFABS.CO2SCRUBBER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CO2SCRUBBER.NAME"
msgid "<link=\"CO2SCRUBBER\">Carbon Skimmer</link>"
msgstr "<link=\"CO2SCRUBBER\">Removedor de Carbono</link>"

#. STRINGS.BUILDINGS.PREFABS.COMETDETECTOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.COMETDETECTOR.DESC"
msgid "Networks of many scanners will scan more efficiently than one on its own."
msgstr "Redes de muitos scanners farão a varredura com mais eficiência do que um scanner sozinho."

#. STRINGS.BUILDINGS.PREFABS.COMETDETECTOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.COMETDETECTOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> to its automation circuit when it detects incoming objects from "
"space.\n"
"\n"
"Can be configured to detect incoming meteor showers or returning space rockets."
msgstr ""
"Envia um <b><style=\"logic_on\">Sinal Verde</style></b> para seu circuito de automação quando detecta objetos vindos do "
"espaço.\n"
"\n"
"Pode ser configurado para detectar chuvas de meteoros ou foguetes espaciais retornando."

#. STRINGS.BUILDINGS.PREFABS.COMETDETECTOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.COMETDETECTOR.NAME"
msgid "<link=\"COMETDETECTOR\">Space Scanner</link>"
msgstr "<link=\"COMETDETECTOR\">Scanner Espacial</link>"

#. STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.DESC"
msgid "At least one astronaut must be assigned to the command module to pilot a rocket."
msgstr "Pelo menos um astronauta deve ser designado para o módulo de comando para pilotar um foguete."

#. STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.EFFECT"
msgid ""
"Contains passenger seating for Duplicant <link=\"ASTRONAUTING1\">Astronauts</link>.\n"
"\n"
"A Command Capsule must be the last module installed at the top of a rocket."
msgstr ""
"Contém assentos para passageiros para Duplicantes <link=\"ASTRONAUTING1\">Astronautas</link>.\n"
"\n"
"Uma Cápsula de Comando deve ser o último módulo instalado no topo de um foguete."

#. STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.LOGIC_PORT_LAUNCH
msgctxt "STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.LOGIC_PORT_LAUNCH"
msgid "Launch Rocket"
msgstr "Lançar Foguete"

#. STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.LOGIC_PORT_LAUNCH_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.LOGIC_PORT_LAUNCH_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Launch rocket"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Lança o foguete"

#. STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.LOGIC_PORT_LAUNCH_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.LOGIC_PORT_LAUNCH_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Awaits launch command"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Aguarda para lançar o foguete"

#. STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.LOGIC_PORT_READY
msgctxt "STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.LOGIC_PORT_READY"
msgid "Rocket Checklist"
msgstr "Lista de Verificação de Foguete"

#. STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.LOGIC_PORT_READY_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.LOGIC_PORT_READY_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when its rocket launch checklist is complete"
msgstr "Envia um <b><style=\"logic_on\">Sinal Verde</style></b> quando a lista de verificação do foguete estiver completa"

#. STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.LOGIC_PORT_READY_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.LOGIC_PORT_READY_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Senão, envia um <b><style=\"logic_off\">Sinal Vermelho</b></style>"

#. STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.COMMANDMODULE.NAME"
msgid "<link=\"COMMANDMODULE\">Command Capsule</link>"
msgstr "<link=\"COMMANDMODULE\">Cápsula de Comando</link>"

#. STRINGS.BUILDINGS.PREFABS.COMPOST.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.COMPOST.DESC"
msgid "Composts safely deal with biological waste, producing fresh dirt."
msgstr "Composteiras lidam com resíduos biológicos de forma segura, produzindo terra fresca."

#. STRINGS.BUILDINGS.PREFABS.COMPOST.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.COMPOST.EFFECT"
msgid ""
"Reduces <link=\"TOXICSAND\">Polluted Dirt</link>, rotting <link=\"FOOD\">Foods</link>, and discarded organics down into "
"<link=\"DIRT\">Dirt</link>."
msgstr ""
"Reduz <link=\"TOXICSAND\">Terra Poluída</link>, <link=\"FOOD\">Alimentos</link> apodrecidos e orgânicos descartados em "
"<link=\"DIRT\">Terra</link>."

#. STRINGS.BUILDINGS.PREFABS.COMPOST.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.COMPOST.NAME"
msgid "<link=\"COMPOST\">Compost</link>"
msgstr "<link=\"COMPOST\">Composteira</link>"

#. STRINGS.BUILDINGS.PREFABS.CONDUIT.STATUS_ITEM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CONDUIT.STATUS_ITEM.NAME"
msgid "Marked for Emptying"
msgstr "Marcado Para Esvaziamento"

#. STRINGS.BUILDINGS.PREFABS.CONDUIT.STATUS_ITEM.TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.CONDUIT.STATUS_ITEM.TOOLTIP"
msgid "Awaiting a <link=\"PLUMBER\">Plumber</link> to clear this pipe"
msgstr "Aguardando um <link=\"PLUMBER\">Encanador</link> para esvaziar este cano"

#. STRINGS.BUILDINGS.PREFABS.CONTACTCONDUCTIVEPIPEBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CONTACTCONDUCTIVEPIPEBRIDGE.DESC"
msgid "It can transfer heat effectively even if no liquid is passing through."
msgstr "Pode transferir calor de forma eficaz, mesmo que nenhum líquido esteja passando por ele."

#. STRINGS.BUILDINGS.PREFABS.CONTACTCONDUCTIVEPIPEBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CONTACTCONDUCTIVEPIPEBRIDGE.EFFECT"
msgid ""
"Carries <link=\"ELEMENTSLIQUID\">Liquid</link>, allowing extreme <link=\"HEAT\">Temperature</link> exchange with "
"overlapping buildings.\n"
"\n"
"Can function in a vacuum.\n"
"\n"
"Can be run through wall and floor tiles."
msgstr ""
"Transporta <link=\"ELEMENTSLIQUID\">Líquido</link>, permitindo uma troca extrema de <link=\"HEAT\">Temperatura</link> com "
"estruturas sobrepostas.\n"
"\n"
"Pode funcionar em um vácuo.\n"
"\n"
"Pode ser construido através de paredes e pisos."

#. STRINGS.BUILDINGS.PREFABS.CONTACTCONDUCTIVEPIPEBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CONTACTCONDUCTIVEPIPEBRIDGE.NAME"
msgid "<link=\"CONTACTCONDUCTIVEPIPEBRIDGE\">Conduction Panel</link>"
msgstr "<link=\"CONTACTCONDUCTIVEPIPEBRIDGE\">Painel de Condução</link>"

#. STRINGS.BUILDINGS.PREFABS.COOKINGSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.COOKINGSTATION.DESC"
msgid "Proper cooking eliminates foodborne disease and produces tasty, stress-relieving meals."
msgstr ""
"O cozimento adequado elimina doenças transmitidas por alimentos e produz refeições saborosas e que aliviam o estresse."

#. STRINGS.BUILDINGS.PREFABS.COOKINGSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.COOKINGSTATION.EFFECT"
msgid ""
"Cooks a wide variety of improved <link=\"FOOD\">Foods</link>.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Cozinha uma grande variedade de <link=\"FOOD\">Alimentos</link> melhorados.\n"
"\n"
"Duplicantes não fabricarão itens a menos que as receitas estejam na fila."

#. STRINGS.BUILDINGS.PREFABS.COOKINGSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.COOKINGSTATION.NAME"
msgid "<link=\"COOKINGSTATION\">Electric Grill</link>"
msgstr "<link=\"COOKINGSTATION\">Churrasqueira Elétrica</link>"

#. STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.DESC"
msgid "Corner trim is a purely decorative addition for ceiling corners."
msgstr "A Moldura de canto é uma adição puramente decorativa aos cantos do teto."

#. STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.EFFECT"
msgid ""
"Used to decorate the ceiling corners of rooms.\n"
"\n"
"Increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>."
msgstr ""
"Utilizado para decorar os cantos do teto dos quartos.\n"
"\n"
"Aumenta a <link=\"DECOR\">Decor</link>, contribuindo para a <link=\"MORALE\">Moral</link>."

#. STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.FACADES.DEFAULT_CORNERMOULDING.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.FACADES.DEFAULT_CORNERMOULDING.DESC"
msgid "It really dresses up a ceiling corner."
msgstr "Realmente enfeita um canto do teto."

#. STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.FACADES.DEFAULT_CORNERMOULDING.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.FACADES.DEFAULT_CORNERMOULDING.NAME"
msgid "<link=\"CORNERMOULDING\">Corner Trim</link>"
msgstr "<link=\"CORNERMOULDING\">Moldura de canto</link>"

#. STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.FACADES.SHINEORNAMENTS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.FACADES.SHINEORNAMENTS.DESC"
msgid "Why deck the halls, when you could <i>festoon</i> them?"
msgstr "Por que enfeitar os corredores quando você pode <i>enfeitá-los</i>?"

#. STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.FACADES.SHINEORNAMENTS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.FACADES.SHINEORNAMENTS.NAME"
msgid "<link=\"CORNERMOULDING\">Fancy Bug Corner Garland</link>"
msgstr "<link=\"CORNERMOULDING\">Guirlanda de Canto de Vagalumes Chiques</link>"

#. STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CORNERMOULDING.NAME"
msgid "<link=\"CORNERMOULDING\">Corner Trim</link>"
msgstr "<link=\"CORNERMOULDING\">Moldura de canto</link>"

#. STRINGS.BUILDINGS.PREFABS.COSMICRESEARCHCENTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.COSMICRESEARCHCENTER.DESC"
msgid "Planetariums allow the simulated exploration of locations discovered with a telescope."
msgstr "Planetários permitem a exploração simulada de locais descobertos com um telescópio."

#. STRINGS.BUILDINGS.PREFABS.COSMICRESEARCHCENTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.COSMICRESEARCHCENTER.EFFECT"
msgid ""
"Conducts <link=\"RESEARCH\">Interstellar Research</link> to unlock new technologies.\n"
"\n"
"Consumes data from <link=\"RESEARCHMODULE\">Research Modules</link>.\n"
"\n"
"Assigned Duplicants must possess the <link=\"ASTRONOMY\">Astronomy</link> skill."
msgstr ""
"Realiza <link=\"RESEARCH\">Pesquisa Interestelar</link> para desbloquear novas tecnologias.\n"
"\n"
"Consome dados do <link=\"RESEARCHMODULE\">Módulo de Pesquisa</link>.\n"
"\n"
"Os Duplicantes atribuídos devem possuir a habilidade <link=\"ASTRONOMY\">Astronomia</link>."

#. STRINGS.BUILDINGS.PREFABS.COSMICRESEARCHCENTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.COSMICRESEARCHCENTER.NAME"
msgid "<link=\"COSMICRESEARCHCENTER\">Virtual Planetarium</link>"
msgstr "<link=\"COSMICRESEARCHCENTER\">Planetário Virtual</link>"

#. STRINGS.BUILDINGS.PREFABS.CRAFTINGTABLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CRAFTINGTABLE.DESC"
msgid "Crafting stations allow Duplicants to make oxygen masks to wear in low breathability areas."
msgstr ""
"As Mesas de Montagem permitem que os Duplicantes façam máscaras de oxigênio para usar em áreas de baixa respirabilidade."

#. STRINGS.BUILDINGS.PREFABS.CRAFTINGTABLE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CRAFTINGTABLE.EFFECT"
msgid ""
"Produces items and equipment for Duplicant use.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Produz itens e equipamentos para uso dos Duplicantes\n"
"\n"
"Duplicantes não fabricarão itens a menos que as receitas estejam na fila."

#. STRINGS.BUILDINGS.PREFABS.CRAFTINGTABLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CRAFTINGTABLE.NAME"
msgid "<link=\"CRAFTINGTABLE\">Crafting Station</link>"
msgstr "<link=\"CRAFTINGTABLE\">Mesa de Montagem</link>"

#. STRINGS.BUILDINGS.PREFABS.CRAFTINGTABLE.RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.CRAFTINGTABLE.RECIPE_DESCRIPTION"
msgid "Converts {0} to {1}"
msgstr "Converte {0} para {1}"

#. STRINGS.BUILDINGS.PREFABS.CREATUREAIRTRAP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREAIRTRAP.DESC"
msgid "It needs to be armed prior to use."
msgstr "Precisa ser armada antes de ser usada."

#. STRINGS.BUILDINGS.PREFABS.CREATUREAIRTRAP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREAIRTRAP.EFFECT"
msgid ""
"Attracts and captures airborne <link=\"CREATURES\">Critters</link>.\n"
"\n"
"Only Duplicants with the <link=\"RANCHING1\">Critter Ranching I</link> skill can arm this trap. It's reusable!"
msgstr ""
"Atrai e captura <link=\"CREATURES\">Criaturas</link> voadoras.\n"
"\n"
"Apenas Duplicantes com a habilidade <link=\"RANCHING1\">Criação de Criaturas I</link> podem armar esta armadilha. É "
"reutilizável!"

#. STRINGS.BUILDINGS.PREFABS.CREATUREAIRTRAP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREAIRTRAP.NAME"
msgid "<link=\"CREATUREAIRTRAP\">Airborne Critter Trap</link>"
msgstr "<link=\"CREATUREAIRTRAP\">Armadilha para Criaturas Aéreas</link>"

#. STRINGS.BUILDINGS.PREFABS.CREATUREDELIVERYPOINT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREDELIVERYPOINT.DESC"
msgid "Duplicants automatically bring captured critters to these relocation points for release."
msgstr "Duplicantes trazem automaticamente as criaturas capturadas para esses pontos de entrega."

#. STRINGS.BUILDINGS.PREFABS.CREATUREDELIVERYPOINT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREDELIVERYPOINT.EFFECT"
msgid ""
"Releases trapped <link=\"CREATURES\">Critters</link> back into the world.\n"
"\n"
"Can be used multiple times."
msgstr ""
"Libera <link=\"CREATURES\">Criaturas</link> capturadas de volta ao mundo.\n"
"\n"
"Pode ser usada várias vezes."

#. STRINGS.BUILDINGS.PREFABS.CREATUREDELIVERYPOINT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREDELIVERYPOINT.NAME"
msgid "<link=\"CREATUREDELIVERYPOINT\">Critter Drop-Off</link>"
msgstr "<link=\"CREATUREDELIVERYPOINT\">Ponto de Entrega de Criaturas</link>"

#. STRINGS.BUILDINGS.PREFABS.CREATUREFEEDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREFEEDER.DESC"
msgid "Wild critters who use feeders get accustomed to the cushiness of domesticated life."
msgstr "Criaturas selvagens que usam comedouros se acostumam ao conforto da vida domesticada."

#. STRINGS.BUILDINGS.PREFABS.CREATUREFEEDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREFEEDER.EFFECT"
msgid "Automatically dispenses food for hungry <link=\"CREATURES\">Critters</link>."
msgstr "Dispensa comida automaticamente para <link=\"CREATURES\">Criaturas</link> com fome."

#. STRINGS.BUILDINGS.PREFABS.CREATUREFEEDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREFEEDER.NAME"
msgid "<link=\"CREATUREFEEDER\">Critter Feeder</link>"
msgstr "<link=\"CREATUREFEEDER\">Alimentador de Criaturas</link>"

#. STRINGS.BUILDINGS.PREFABS.CREATUREGROUNDTRAP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREGROUNDTRAP.DESC"
msgid "It's designed for land critters, but flopping fish sometimes find their way in too."
msgstr "Foi projetada para Criaturas terrestres, mas às vezes, peixes saltitantes encontram um jeito de usar."

#. STRINGS.BUILDINGS.PREFABS.CREATUREGROUNDTRAP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREGROUNDTRAP.EFFECT"
msgid ""
"Captures a living <link=\"CREATURES\">Critter</link> for transport.\n"
"\n"
"Only Duplicants with the <link=\"RANCHING1\">Critter Ranching I</link> skill can arm this trap. It's reusable!"
msgstr ""
"Captura um <link=\"CREATURES\">Critter</link> vivo para transporte.\n"
"\n"
"Apenas Duplicantes com a habilidade <link=\"RANCHING1\">Pecuária I</link> podem armar esta armadilha. É reutilizável!"

#. STRINGS.BUILDINGS.PREFABS.CREATUREGROUNDTRAP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATUREGROUNDTRAP.NAME"
msgid "<link=\"CREATUREGROUNDTRAP\">Critter Trap</link>"
msgstr "<link=\"CREATUREGROUNDTRAP\">Armadilha de Criaturas</link>"

#. STRINGS.BUILDINGS.PREFABS.CREATURETRAP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATURETRAP.DESC"
msgid "Critter traps cannot catch swimming or flying critters."
msgstr "As armadilhas para criaturas não podem capturar criaturas nadadoras ou voadoras."

#. STRINGS.BUILDINGS.PREFABS.CREATURETRAP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATURETRAP.EFFECT"
msgid ""
"Captures a living <link=\"CREATURES\">Critter</link> for transport.\n"
"\n"
"Single use."
msgstr ""
"Captura uma <link=\"CREATURES\">Criatura</link> viva para transporte.\n"
"\n"
"Uso único."

#. STRINGS.BUILDINGS.PREFABS.CREATURETRAP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CREATURETRAP.NAME"
msgid "<link=\"CREATURETRAP\">Critter Trap</link>"
msgstr "<link=\"CREATURETRAP\">Armadilha para Criaturas</link>"

#. STRINGS.BUILDINGS.PREFABS.CRITTERCONDO.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERCONDO.DESC"
msgid "It's nice to have nice things."
msgstr "É bom ter coisas boas."

#. STRINGS.BUILDINGS.PREFABS.CRITTERCONDO.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERCONDO.EFFECT"
msgid "Provides a comfortable lounge area that boosts domesticated <link=\"CREATURES\">Critters'</link> happiness."
msgstr "Fornece uma área de descanso confortável que aumenta a felicidade das <link=\"CREATURES\">Criaturas</link>."

#. STRINGS.BUILDINGS.PREFABS.CRITTERCONDO.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERCONDO.NAME"
msgid "<link=\"CRITTERCONDO\">Critter Condo</link>"
msgstr "<link=\"CRITTERCONDO\">Ninho Artificial</link>"

#. STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.DESC"
msgid "Duplicants automatically bring captured critters to these relocation points for release."
msgstr "Duplicantes trazem automaticamente as criaturas capturadas para esses pontos de entrega."

#. STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.EFFECT"
msgid ""
"Releases trapped <link=\"CREATURES\">Critters</link> back into the world.\n"
"\n"
"Monitoring and drop-off are limited to the specified species."
msgstr ""
"Libera <link=\"CREATURES\">Criaturas</link> capturadas de volta ao mundo.\n"
"\n"
"O monitoramento e a entrega são limitados às espécies especificadas."

#. STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.LOGIC_INPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.LOGIC_INPUT.DESC"
msgid "Enable/Disable"
msgstr "Habilitar/Desabilitar"

#. STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.LOGIC_INPUT.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.LOGIC_INPUT.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Enable critter drop-off"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Ativa o Ponto de Entrega de Criaturas"

#. STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.LOGIC_INPUT.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.LOGIC_INPUT.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Disable critter drop-off"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Desativa o Ponto de Entrega de Criaturas"

#. STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERDROPOFF.NAME"
msgid "<link=\"CRITTERDROPOFF\">Critter Drop-Off</link>"
msgstr "<link=\"CRITTERDROPOFF\">Ponto de Entrega de Criaturas</link>"

#. STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.DESC"
msgid "Duplicants will automatically wrangle excess critters."
msgstr "Os duplicantes irão capturar automaticamente as criaturas em excesso."

#. STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.EFFECT"
msgid ""
"Ensures the prompt relocation of <link=\"CREATURES\">Critters</link> that exceed the maximum amount set.\n"
"\n"
"Monitoring and pick-up are limited to the specified species."
msgstr ""
"Garante a rápida realocação de <link=\"CREATURES\">Criaturas</link> que excedam a quantidade máxima estabelecida.\n"
"\n"
"O monitoramento e a coleta são limitados às espécies especificadas."

#. STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.LOGIC_INPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.LOGIC_INPUT.DESC"
msgid "Enable/Disable"
msgstr "Habilitar/Desabilitar"

#. STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.LOGIC_INPUT.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.LOGIC_INPUT.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Wrangle excess critters"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Laça as criaturas excedentes"

#. STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.LOGIC_INPUT.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.LOGIC_INPUT.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Ignore excess critters"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Ignora as criaturas excedentes"

#. STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CRITTERPICKUP.NAME"
msgid "<link=\"CRITTERPICKUP\">Critter Pick-Up</link>"
msgstr "<link=\"CRITTERPICKUP\">Ponto de Coleta de Criaturas</link>"

#. STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.DESC"
msgid "Ceiling trim is a purely decorative addition to one's overhead area."
msgstr "Molduras de teto são uma adição puramente decorativa à área em cima da cabeça."

#. STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.EFFECT"
msgid ""
"Used to decorate the ceilings of rooms.\n"
"\n"
"Increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>."
msgstr ""
"Usado para decorar o teto dos quartos.\n"
"\n"
"Aumenta a <link=\"DECOR\">Decor</link>, contribuindo para a <link=\"MORALE\">Moral</link>."

#. STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.FACADES.DEFAULT_CROWNMOULDING.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.FACADES.DEFAULT_CROWNMOULDING.DESC"
msgid "Ceiling trim is a purely decorative addition to one's overhead area."
msgstr "Molduras de teto são uma adição puramente decorativa à área em cima da cabeça."

#. STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.FACADES.DEFAULT_CROWNMOULDING.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.FACADES.DEFAULT_CROWNMOULDING.NAME"
msgid "<link=\"CROWNMOULDING\">Ceiling Trim</link>"
msgstr "<link=\"CROWNMOULDING\">Moldura de Teto</link>"

#. STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.FACADES.SHINEORNAMENTS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.FACADES.SHINEORNAMENTS.DESC"
msgid "Someone spent their entire weekend gluing ribbons to paper Shine Bug cut-outs, and it shows."
msgstr "Alguém passou todo o seu fim de semana colando fitas em recortes de papel de Vagalumes, e isso é evidente."

#. STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.FACADES.SHINEORNAMENTS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.FACADES.SHINEORNAMENTS.NAME"
msgid "<link=\"CROWNMOULDING\">Fancy Bug Ceiling Garland</link>"
msgstr "<link=\"CROWNMOULDING\">Guirlanda de Teto de Vagalumes Chiques</link>"

#. STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CROWNMOULDING.NAME"
msgid "<link=\"CROWNMOULDING\">Ceiling Trim</link>"
msgstr "<link=\"CROWNMOULDING\">Moldura de teto</link>"

#. STRINGS.BUILDINGS.PREFABS.CRYOTANK.DEFROSTBUTTON
msgctxt "STRINGS.BUILDINGS.PREFABS.CRYOTANK.DEFROSTBUTTON"
msgid "Defrost Friend"
msgstr "Descongelar Amigo"

#. STRINGS.BUILDINGS.PREFABS.CRYOTANK.DEFROSTBUTTONTOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.CRYOTANK.DEFROSTBUTTONTOOLTIP"
msgid "A new pal is just an icebreaker away"
msgstr "Um novo amigo está a apenas um quebra-gelo de distância"

#. STRINGS.BUILDINGS.PREFABS.CRYOTANK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.CRYOTANK.DESC"
msgid ""
"The tank appears impossibly old, but smells crisp and brand new.\n"
"\n"
"A silhouette just barely visible through the frost of the glass."
msgstr ""
"O tanque parece impossivelmente velho, mas cheira a novo em folha.\n"
"\n"
"Mal se vê a silhueta através do vidro congelado."

#. STRINGS.BUILDINGS.PREFABS.CRYOTANK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.CRYOTANK.NAME"
msgid "<link=\"CRYOTANK\">Cryotank 3000</link>"
msgstr "<link=\"CRYOTANK\">Criotanque 3000</link>"

#. STRINGS.BUILDINGS.PREFABS.DATAMINER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DATAMINER.DESC"
msgid "Data banks can also be used to program robo-pilot rocket modules."
msgstr "Bancos de Dados também podem ser utilizados para programar módulos de Robô-Piloto."

#. STRINGS.BUILDINGS.PREFABS.DATAMINER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DATAMINER.EFFECT"
msgid ""
"Mass-produces <link=\"DATABANK\">Data Banks</link> that can be processed into <link=\"RESEARCHDLC1\">Data Analysis "
"Research</link> points.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Produz em massa <link=\"DATABANK\">Data Banks</link> que podem ser processados em pontos de <link=\"RESEARCHDLC1\">Análise "
"de Dados</link>.\n"
"\n"
"Duplicantes não fabricarão itens a menos que as receitas sejam enfileiradas."

#. STRINGS.BUILDINGS.PREFABS.DATAMINER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DATAMINER.NAME"
msgid "<link=\"DATAMINER\">Data Miner</link>"
msgstr "<link=\"DATAMINER\">Mineradora de Dados</link>"

#. STRINGS.BUILDINGS.PREFABS.DATAMINER.RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.DATAMINER.RECIPE_DESCRIPTION"
msgid "Turns {0} into {1}."
msgstr "Transforma {0} em {1}."

#. STRINGS.BUILDINGS.PREFABS.DECONTAMINATIONSHOWER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DECONTAMINATIONSHOWER.DESC"
msgid "Don't forget to decontaminate behind your ears."
msgstr "Não se esqueça de descontaminar atrás das orelhas."

#. STRINGS.BUILDINGS.PREFABS.DECONTAMINATIONSHOWER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DECONTAMINATIONSHOWER.EFFECT"
msgid ""
"Uses <link=\"WATER\">Water</link> to remove <link=\"DISEASE\">Germs</link> and <link=\"RADIATION\">Radiation</link>.\n"
"\n"
"Decontaminates both Duplicants and their <link=\"EQUIPMENT\">Clothing</link>."
msgstr ""
"Usa <link=\"WATER\">Água</link> para remover <link=\"DISEASE\">Germes</link> e <link=\"RADIATION\">Radiação</link>.\n"
"\n"
"Descontamina os Duplicantes e seus <link=\"EQUIPMENT\">Trajes</link>."

#. STRINGS.BUILDINGS.PREFABS.DECONTAMINATIONSHOWER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DECONTAMINATIONSHOWER.NAME"
msgid "<link=\"DECONTAMINATIONSHOWER\">Decontamination Shower</link>"
msgstr "<link=\"DECONTAMINATIONSHOWER\">Chuveiro de Descontaminação</link>"

#. STRINGS.BUILDINGS.PREFABS.DEEPFRYER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DEEPFRYER.DESC"
msgid "Everything tastes better when it's deep-fried."
msgstr "Tudo fica mais saboroso quando frito."

#. STRINGS.BUILDINGS.PREFABS.DEEPFRYER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DEEPFRYER.EFFECT"
msgid ""
"Uses <link=\"TALLOW\">Tallow</link> to cook a wide variety of improved <link=\"FOOD\">Foods</link>.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued."
msgstr ""
"Usa <link=\"TALLOW\">Banha</link> para cozinhar uma ampla variedade de <link=\"FOOD\">Alimentos</link> melhorados.\n"
"\n"
"Duplicantes não fabricarão itens a menos que as receitas estejam na fila."

#. STRINGS.BUILDINGS.PREFABS.DEEPFRYER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DEEPFRYER.NAME"
msgid "<link=\"DEEPFRYER\">Deep Fryer</link>"
msgstr "<link=\"DEEPFRYER\">Fritadeira</link>"

#. STRINGS.BUILDINGS.PREFABS.DEEPFRYER.STATUSITEMS.OUTSIDE_KITCHEN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DEEPFRYER.STATUSITEMS.OUTSIDE_KITCHEN.NAME"
msgid "Outside of Kitchen"
msgstr "Fora de uma Cozinha"

#. STRINGS.BUILDINGS.PREFABS.DEEPFRYER.STATUSITEMS.OUTSIDE_KITCHEN.TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.DEEPFRYER.STATUSITEMS.OUTSIDE_KITCHEN.TOOLTIP"
msgid "This building must be in a Kitchen before it can be used"
msgstr "Esta construção deve estar em uma Cozinha antes de poder ser usada"

#. STRINGS.BUILDINGS.PREFABS.DESALINATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DESALINATOR.DESC"
msgid "Salt can be refined into table salt for a mealtime morale boost."
msgstr "O sal pode ser refinado em sal de cozinha para aumentar a moral na hora das refeições."

#. STRINGS.BUILDINGS.PREFABS.DESALINATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DESALINATOR.EFFECT"
msgid ""
"Removes <link=\"SALT\">Salt</link> from <link=\"BRINE\">Brine</link> or <link=\"SALTWATER\">Salt Water</link>, producing "
"<link=\"WATER\">Water</link>."
msgstr ""
"Remove <link=\"SALT\">Sal</link> de <link=\"BRINE\">Salmoura</link> ou <link=\"SALTWATER\">Água Salgada</link>, produzindo "
"<link=\"WATER\">Água</link>."

#. STRINGS.BUILDINGS.PREFABS.DESALINATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DESALINATOR.NAME"
msgid "<link=\"DESALINATOR\">Desalinator</link>"
msgstr "<link=\"DESALINATOR\">Dessalinizador</link>"

#. STRINGS.BUILDINGS.PREFABS.DEVGENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVGENERATOR.DESC"
msgid "Runs on coffee."
msgstr "Funciona com café."

#. STRINGS.BUILDINGS.PREFABS.DEVGENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVGENERATOR.EFFECT"
msgid "Generates testing power for late nights."
msgstr "Gera poder de teste para madrugadas."

#. STRINGS.BUILDINGS.PREFABS.DEVGENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVGENERATOR.NAME"
msgid "Dev Generator"
msgstr "Gerador de Devs"

#. STRINGS.BUILDINGS.PREFABS.DEVHEATER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVHEATER.DESC"
msgid "Did someone touch the thermostat?"
msgstr "Alguém encostou no termostato?"

#. STRINGS.BUILDINGS.PREFABS.DEVHEATER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVHEATER.EFFECT"
msgid "Generates on-demand heat for testing toastiness."
msgstr "Gera calor sob demanda para testar a tostagem."

#. STRINGS.BUILDINGS.PREFABS.DEVHEATER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVHEATER.NAME"
msgid "Dev Heater"
msgstr "Aquecedor Dev"

#. STRINGS.BUILDINGS.PREFABS.DEVHEPSPAWNER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVHEPSPAWNER.DESC"
msgid "Radbolts are necessary for producing Materials Science research."
msgstr "Radioraios são necessários para a produção de Pesquisa Científica da Matéria."

#. STRINGS.BUILDINGS.PREFABS.DEVHEPSPAWNER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVHEPSPAWNER.EFFECT"
msgid "Generates Radbolts."
msgstr "Gera Radioraios."

#. STRINGS.BUILDINGS.PREFABS.DEVHEPSPAWNER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVHEPSPAWNER.LOGIC_PORT"
msgid "Do not emit Radbolts"
msgstr "Não emite Radioraios"

#. STRINGS.BUILDINGS.PREFABS.DEVHEPSPAWNER.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVHEPSPAWNER.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Emit Radbolts"
msgstr "<b><style=\"logic_on\">Sinal Verde</style></b>: Emite Radioraios"

#. STRINGS.BUILDINGS.PREFABS.DEVHEPSPAWNER.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVHEPSPAWNER.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Do not emit Radbolts"
msgstr "<b><style=\"logic_off\">Sinal Vermelho</style></b>: Não emite Radioraios"

#. STRINGS.BUILDINGS.PREFABS.DEVHEPSPAWNER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVHEPSPAWNER.NAME"
msgid "Dev Radbolt Generator"
msgstr "Gerador Dev de Radioraios"

#. STRINGS.BUILDINGS.PREFABS.DEVLIFESUPPORT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVLIFESUPPORT.DESC"
msgid "Keeps Duplicants cozy and breathing."
msgstr "Mantém os Duplicantes aconchegantes e respirando."

#. STRINGS.BUILDINGS.PREFABS.DEVLIFESUPPORT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVLIFESUPPORT.EFFECT"
msgid "Generates warm, oxygen-rich air."
msgstr "Gera ar quente e rico em oxigênio."

#. STRINGS.BUILDINGS.PREFABS.DEVLIFESUPPORT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVLIFESUPPORT.NAME"
msgid "Dev Life Support"
msgstr "Suporte de vida do Desenvolvedor"

#. STRINGS.BUILDINGS.PREFABS.DEVLIGHTGENERATOR.BRIGHTNESS_LABEL
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVLIGHTGENERATOR.BRIGHTNESS_LABEL"
msgid "Brightness"
msgstr "Luminosidade"

#. STRINGS.BUILDINGS.PREFABS.DEVLIGHTGENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVLIGHTGENERATOR.DESC"
msgid "Brightens up a dev's darkest hours."
msgstr "Ilumina as horas mais sombrias de um desenvolvedor."

#. STRINGS.BUILDINGS.PREFABS.DEVLIGHTGENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVLIGHTGENERATOR.EFFECT"
msgid "Generates dimmable light on demand."
msgstr "Gera luz regulável sob demanda."

#. STRINGS.BUILDINGS.PREFABS.DEVLIGHTGENERATOR.FALLOFF_LABEL
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVLIGHTGENERATOR.FALLOFF_LABEL"
msgid "Falloff Rate"
msgstr "Taxa de Queda"

#. STRINGS.BUILDINGS.PREFABS.DEVLIGHTGENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVLIGHTGENERATOR.NAME"
msgid "Dev Light Source"
msgstr "Fonte de Luz do Desenvolvedor"

#. STRINGS.BUILDINGS.PREFABS.DEVLIGHTGENERATOR.RANGE_LABEL
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVLIGHTGENERATOR.RANGE_LABEL"
msgid "Range"
msgstr "Alcance"

#. STRINGS.BUILDINGS.PREFABS.DEVPUMPGAS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVPUMPGAS.DESC"
msgid "Piping a pump's output to a building's intake will send gas to that building."
msgstr "Conectar a saída de uma bomba à entrada de uma estrutura enviará gás para essa estrutura."

#. STRINGS.BUILDINGS.PREFABS.DEVPUMPGAS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVPUMPGAS.EFFECT"
msgid ""
"Draws in <link=\"ELEMENTSGAS\">Gas</link> and runs it through <link=\"GASPIPING\">Pipes</link>.\n"
"\n"
"Must be immersed in <link=\"ELEMENTSGAS\">Gas</link>."
msgstr ""
"Absorve <link=\"ELEMENTSGAS\">Gás</link> e o transporta através de <link=\"GASPIPING\">Tubos</link>.\n"
"\n"
"Deve estar imerso em <link=\"ELEMENTSGAS\">Gás</link>."

#. STRINGS.BUILDINGS.PREFABS.DEVPUMPGAS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVPUMPGAS.NAME"
msgid "Dev Pump Gas"
msgstr "Bomba de Gás Dev"

#. STRINGS.BUILDINGS.PREFABS.DEVPUMPLIQUID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVPUMPLIQUID.DESC"
msgid "Piping a pump's output to a building's intake will send liquid to that building."
msgstr "Conectar a saída de uma bomba à entrada de uma estrutura enviará líquido para essa estrutura."

#. STRINGS.BUILDINGS.PREFABS.DEVPUMPLIQUID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVPUMPLIQUID.EFFECT"
msgid ""
"Draws in <link=\"ELEMENTSLIQUID\">Liquid</link> and runs it through <link=\"LIQUIDPIPING\">Pipes</link>.\n"
"\n"
"Must be submerged in <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr ""
"Absorve <link=\"ELEMENTSLIQUID\">Líquido</link> e o transporta através de <link=\"LIQUIDPIPING\">Tubos</link>.\n"
"\n"
"Deve estar imerso em <link=\"ELEMENTSLIQUID\">Líquido</link>."

#. STRINGS.BUILDINGS.PREFABS.DEVPUMPLIQUID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVPUMPLIQUID.NAME"
msgid "Dev Pump Liquid"
msgstr "Bomba de Líquido Dev"

#. STRINGS.BUILDINGS.PREFABS.DEVPUMPSOLID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVPUMPSOLID.DESC"
msgid "Piping a pump's output to a building's intake will send solids to that building."
msgstr "Conectar a saída de uma bomba à entrada de uma estrutura enviará sólidos para essa estrutura."

#. STRINGS.BUILDINGS.PREFABS.DEVPUMPSOLID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVPUMPSOLID.EFFECT"
msgid ""
"Generates chosen <link=\"ELEMENTSSOLID\">Solid Materials</link> and runs it through <link=\"SOLIDCONDUIT\">Conveyor Rail</"
"link>"
msgstr ""
"Gera os <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> escolhidos e os transporta através do "
"<link=\"SOLIDCONDUIT\">Trilho Transportador</link>"

#. STRINGS.BUILDINGS.PREFABS.DEVPUMPSOLID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVPUMPSOLID.NAME"
msgid "Dev Pump Solid"
msgstr "Bomba de Sólidos Dev"

#. STRINGS.BUILDINGS.PREFABS.DEVRADIATIONGENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVRADIATIONGENERATOR.DESC"
msgid "That's some <i>strong</i> coffee."
msgstr "Isso é um café <i>forte</i>."

#. STRINGS.BUILDINGS.PREFABS.DEVRADIATIONGENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVRADIATIONGENERATOR.EFFECT"
msgid "Generates on-demand radiation to keep things clear. <i>Nu-</i>clear."
msgstr "Gera radiação sob demanda para manter as coisas claras. <i>Nuclear</i>."

#. STRINGS.BUILDINGS.PREFABS.DEVRADIATIONGENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DEVRADIATIONGENERATOR.NAME"
msgid "Dev Radiation Emitter"
msgstr "Emissor de Radiação de Desenvolvimento"

#. STRINGS.BUILDINGS.PREFABS.DIAMONDPRESS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DIAMONDPRESS.DESC"
msgid "Crushes refined carbon into diamond."
msgstr "Tritura Carbono Refinado em Diamante."

#. STRINGS.BUILDINGS.PREFABS.DIAMONDPRESS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DIAMONDPRESS.EFFECT"
msgid ""
"Uses <link=\"POWER\">Power</link> and <link=\"RADIATION\">Radbolts</link> to crush <link=\"REFINEDCARBON\">Refined Carbon</"
"link> into <link=\"DIAMOND\">Diamond</link>.\n"
"\n"
"Duplicants will not fabricate items unless recipes are queued and <link=\"REFINEDCARBON\">Refined Carbon</link> has been "
"discovered."
msgstr ""
"Usa <link=\"POWER\">Energia</link> e <link=\"RADIATION\">Radioraios</link> para transformar <link=\"REFINEDCARBON\">Carbono "
"Refinado</link> em <link=\"DIAMOND\">Diamante</link>.\n"
"\n"
"Duplicantes não fabricarão itens a menos que as receitas estejam na fila e que <link=\"REFINEDCARBON\">Carbono Refinado</"
"link> tenha sido descoberto."

#. STRINGS.BUILDINGS.PREFABS.DIAMONDPRESS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DIAMONDPRESS.NAME"
msgid "<link=\"DIAMONDPRESS\">Diamond Press</link>"
msgstr "<link=\"DIAMONDPRESS\">Prensa de Diamantes</link>"

#. STRINGS.BUILDINGS.PREFABS.DIAMONDPRESS.REFINED_CARBON_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.DIAMONDPRESS.REFINED_CARBON_RECIPE_DESCRIPTION"
msgid "Converts {1} to {0}"
msgstr "Converte {1} em {0}"

#. STRINGS.BUILDINGS.PREFABS.DININGTABLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DININGTABLE.DESC"
msgid "Duplicants prefer to dine at a table, rather than eat off the floor."
msgstr "Os duplicantes preferem jantar à mesa, em vez de comer no chão."

#. STRINGS.BUILDINGS.PREFABS.DININGTABLE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DININGTABLE.EFFECT"
msgid ""
"Gives one Duplicant a place to eat.\n"
"\n"
"Duplicants will automatically eat at their assigned table when hungry."
msgstr ""
"Dá a um Duplicante um lugar para comer.\n"
"\n"
"Os Duplicantes comerão automaticamente na mesa designada quando estiverem com fome."

#. STRINGS.BUILDINGS.PREFABS.DININGTABLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DININGTABLE.NAME"
msgid "<link=\"DININGTABLE\">Mess Table</link>"
msgstr "<link=\"DININGTABLE\">Mesa de Jantar</link>"

#. STRINGS.BUILDINGS.PREFABS.DIRECTIONALWORLDPUMPLIQUID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DIRECTIONALWORLDPUMPLIQUID.DESC"
msgid "Channels move more volume than pumps and require no power, but need sufficient pressure to function."
msgstr ""
"Os canais movem mais volume que as bombas e não precisam de energia, mas precisam de pressão suficiente para funcionar."

#. STRINGS.BUILDINGS.PREFABS.DIRECTIONALWORLDPUMPLIQUID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DIRECTIONALWORLDPUMPLIQUID.EFFECT"
msgid ""
"Directionally moves large volumes of <link=\"ELEMENTSLIQUID\">LIQUID</link> through a channel.\n"
"\n"
"Can be used as floor tile and rotated before construction."
msgstr ""
"Move direcionalmente grandes volumes de <link=\"ELEMENTSLIQUID\">LÍQUIDO</link> através de um canal.\n"
"\n"
"Pode ser usado como azulejo de piso e girado antes da construção."

#. STRINGS.BUILDINGS.PREFABS.DIRECTIONALWORLDPUMPLIQUID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DIRECTIONALWORLDPUMPLIQUID.NAME"
msgid "<link=\"DIRECTIONALWORLDPUMPLIQUID\">Liquid Channel</link>"
msgstr "<link=\"DIRECTIONALWORLDPUMPLIQUID\">Canal de Líquido</link>"

#. STRINGS.BUILDINGS.PREFABS.DISTILLATIONCOLUMN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DISTILLATIONCOLUMN.DESC"
msgid "Gets hot and steamy."
msgstr "Fica quente e fumegante."

#. STRINGS.BUILDINGS.PREFABS.DISTILLATIONCOLUMN.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DISTILLATIONCOLUMN.EFFECT"
msgid ""
"Separates any <link=\"DIRTYWATER\">Contaminated Water</link> piped through it into <link=\"STEAM\">Steam</link> and "
"<link=\"TOXICSAND\">Polluted Dirt</link>."
msgstr ""
"Separa <link=\"DIRTYWATER\">Água Contaminada</link> transportada através dele em <link=\"STEAM\">Vapor</link> e "
"<link=\"TOXICSAND\">Terra Poluída</link>."

#. STRINGS.BUILDINGS.PREFABS.DISTILLATIONCOLUMN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.DISTILLATIONCOLUMN.NAME"
msgid "<link=\"DISTILLATIONCOLUMN\">Distillation Column</link>"
msgstr "<link=\"DISTILLATIONCOLUMN\">Coluna de Destilação</link>"

#. STRINGS.BUILDINGS.PREFABS.DLC1COSMICRESEARCHCENTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.DLC1COSMICRESEARCHCENTER.DESC"
msgid ""
"Planetariums allow the simulated exploration of locations recorded in <link=\"ORBITALRESEARCHDATABANK\">Data Banks</link>."
msgstr ""
"Planetários permitem a exploração simulada de locais registrados em <link=\"ORBITALRESEARCHDATABANK\">Bancos de Dados</"
"link>."

#. STRINGS.BUILDINGS.PREFABS.DLC1COSMICRESEARCHCENTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.DLC1COSMICRESEARCHCENTER.EFFECT"
msgid ""
"Conducts <link=\"RESEARCH\">Data Analysis Research</link> to unlock new technologies.\n"
"\n"
"Consumes <link=\"ORBITALRESEARCHDATABANK\">Data Banks</link> generated by exploration."
msgstr ""
"Realiza <link=\"RESEARCH\">Pesquisa de Análise de Dados</link> para desbloquear novas tecnologias.\n"
"\n"
"Consome <link=\"ORBITALRESEARCHDATABANK\">Bancos de Dados</link> gerados pela exploração."

