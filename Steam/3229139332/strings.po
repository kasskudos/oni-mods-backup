msgstr "Fornece isolamento em regiões com <style=\"heat\">Temperaturas</style> extremas."

#. STRINGS.EQUIPMENT.PREFABS.TEMPERATURE_SUIT.WORN_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.TEMPERATURE_SUIT.WORN_DESC"
