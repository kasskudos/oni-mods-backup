msgstr "<link=\"SLIPPERY\">Escorregadio</link>"

#. STRINGS.MISC.TAGS.SLIPPERY_DESC
msgctxt "STRINGS.MISC.TAGS.SLIPPERY_DESC"
msgid ""
"Some <link=\"ELEMENTSLIQUID\">liquids</link> and <link=\"ELEMENTSSOLID\">solids</link> have a remarkably low coefficient of "
"friction. These present a safety hazard if left on the ground, as Duplicants may slip and fall when traveling across them."
msgstr ""
"Alguns <link=\"ELEMENTSLIQUID\">líquidos</link> e <link=\"ELEMENTSSOLID\">sólidos</link> possuem um coeficiente de atrito "
"notavelmente baixo. Eles apresentam um risco de segurança se deixados no chão, pois os Duplicantes podem escorregar e cair "
"ao atravessá-los."

