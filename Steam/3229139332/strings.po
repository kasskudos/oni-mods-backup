msgstr "Uma <link=\"PLANTS\">Planta</link> subterrânea reativa à temperatura."

#. STRINGS.CREATURES.SPECIES.HEATBULB.NAME
msgctxt "STRINGS.CREATURES.SPECIES.HEATBULB.NAME"
