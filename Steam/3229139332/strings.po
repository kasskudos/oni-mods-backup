#. STRINGS.MISC.TAGS.LUBRICATINGOIL
msgctxt "STRINGS.MISC.TAGS.LUBRICATINGOIL"
msgid "<link=\"LUBRICATINGOIL\">Gear Oil</link>"
msgstr "<link=\"LUBRICATINGOIL\">Lubrificante de Engrenagens</link>"

#. STRINGS.MISC.TAGS.LUBRICATINGOIL_DESC
msgctxt "STRINGS.MISC.TAGS.LUBRICATINGOIL_DESC"
msgid ""
"Gear oils are lubricating fluids useful in the maintenance of complex machinery, protecting gear systems from damage and "
"minimizing friction between moving parts to support optimal performance."
msgstr ""
"Os Lubrificante de Engrenagens são fluidos lubrificantes utilizados na manutenção de maquinários complexos, protegendo os "
"sistemas de engrenagens contra danos e minimizando o atrito entre as peças móveis para garantir um desempenho ideal."

