msgctxt "STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.NAME"
msgid "<link=\"QUICHE\">Dried Mushroom Quiche</link>"
msgstr "<link=\"QUICHE\">Quiche Desidratado de Cogumelo</link>"

#. STRINGS.ITEMS.FOOD.QUICHE.DESC
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.DESC"
msgid ""
"<link=\"COOKEDEGG\">Omelette</link>, <link=\"FRIEDMUSHROOM\">Fried Mushroom</link> and <link=\"LETTUCE\">Lettuce</link> "
"piled onto a yummy crust.\n"
"\n"
"Somehow, it's both soggy <i>and</i> crispy."
msgstr ""
"<link=\"COOKEDEGG\">Omelete</link>, <link=\"FRIEDMUSHROOM\">Cogumelo Frito</link> e <link=\"LETTUCE\">Alface</link> "
"empilhados em uma deliciosa crosta.\n"
"De alguma forma, é ao mesmo tempo encharcado <i>e</i> crocante."

#. STRINGS.ITEMS.FOOD.QUICHE.NAME
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.NAME"
msgid "<link=\"QUICHE\">Mushroom Quiche</link>"
msgstr "<link=\"QUICHE\">Quiche de Cogumelo</link>"

#. STRINGS.ITEMS.FOOD.QUICHE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.RECIPEDESC"
msgid ""
"<link=\"COOKEDEGG\">Omelette</link>, <link=\"FRIEDMUSHROOM\">Fried Mushroom</link> and <link=\"LETTUCE\">Lettuce</link> "
"piled onto a yummy crust."
msgstr ""
"<link=\"COOKEDEGG\">Omelete</link>, <link=\"FRIEDMUSHROOM\">Cogumelo Frito</link> e <link=\"LETTUCE\">Alface</link> "
"empilhados em uma deliciosa crosta."

