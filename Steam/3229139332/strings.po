msgstr "{friend} está descongelado!"

#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CRYOFRIEND.DESCRIPTION
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CRYOFRIEND.DESCRIPTION"
msgid ""
"{dupe} has made an amazing discovery! A barely working <link=\"CRYOTANK\">Cryotank 3000</link> has been uncovered "
"containing a {friend} inside in a frozen state.\n"
"\n"
"{dupe} was successful in thawing {friend} and this encounter has filled both Duplicants with a sense of hope, something "
"they will desperately need to keep their <link=\"MORALE\">Morale</link> up when facing the dangers ahead."
msgstr ""
"{dupe} fez uma descoberta incrível! Um <link=\"CRYOTANK\">Criotanque 3000</link> que mal funciona foi descoberto contendo "
"um(a) {friend} dentro, em estado congelado.\n"
"\n"
"{dupe} conseguiu descongelar {friend} e esse encontro encheu ambos os Duplicantes com um senso de esperança, algo que eles "
"precisarão desesperadamente para manter o <link=\"MORALE\">Moral</link> em alta ao enfrentar os perigos que estão por vir."

#. STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CRYOFRIEND.NAME
msgctxt "STRINGS.GAMEPLAY_EVENTS.EVENT_TYPES.CRYOFRIEND.NAME"
msgid "New Event: A Frozen Friend"
msgstr "Novo Evento: Um Amigo Congelado"

