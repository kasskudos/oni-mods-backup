#. STRINGS.CODEX.DUPLICANT.BODY.CONTAINER1
msgctxt "STRINGS.CODEX.DUPLICANT.BODY.CONTAINER1"
msgid ""
"Duplicants are printed at the <link=\"HEADQUARTERS\">Printing Pod</link>, emerging fully formed and clothed in standard-"
"issue uniforms. Unique outfits can be found in the Supply Closet.\n"
msgstr ""
"Os Duplicantes são impressos na <link=\"HEADQUARTERS\">Módulo Duplicador</link>, emergindo totalmente formados e vestidos "
"com uniformes padrão. Trajes exclusivos podem ser encontrados no Armário de Suprimentos.\n"
"\n"

