msgctxt "STRINGS.CREATURES.STATS.FERTILITY.NAME"
msgid "Reproduction"
msgstr "Reprodução"

#. STRINGS.CREATURES.STATS.FERTILITY.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.FERTILITY.TOOLTIP"
msgid ""
"At 100% <style=\"KKeyword\">Reproduction</style>, critters will reach the end of their reproduction cycle and lay a new "
"<style=\"KKeyword\">Egg</style>\n"
"\n"
"After an <style=\"KKeyword\">Egg</style> is laid, <style=\"KKeyword\">Reproduction</style> is rolled back to 0%"
msgstr ""
"Com 100% de <style=\"KKeyword\">Reprodução</style>, as criaturas chegarão ao final do seu ciclo de reprodução e botarão um "
"novo <style=\"KKeyword\">Ovo</style>\n"
"\n"
"Depois que um <style=\"KKeyword\">Ovo</style> é posto, a <style=\"KKeyword\">Reprodução</style> é revertida para 0%"

