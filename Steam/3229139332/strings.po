msgstr "<link=\"PLASTIC\">Plásticos</link>"

#. STRINGS.MISC.TAGS.PLASTIC_DESC
msgctxt "STRINGS.MISC.TAGS.PLASTIC_DESC"
msgid ""
"Plastics are synthetic <link=\"ELEMENTSSOLID\">Solids</link> that are pliable and minimize the transfer of "
"<link=\"HEAT\">Heat</link>. They typically have a low melting point, although more advanced plastics have been developed to "
"circumvent this issue."
msgstr ""
"Plásticos são <link=\"ELEMENTSSOLID\">Sólidos</link> sintéticos que são flexíveis e minimizam a transferência de "
"<link=\"HEAT\">Calor</link>. Geralmente possuem um ponto de fusão baixo, embora plásticos mais avançados tenham sido "
"desenvolvidos para contornar esse problema."

#. STRINGS.MISC.TAGS.PLASTIFIABLELIQUID
msgctxt "STRINGS.MISC.TAGS.PLASTIFIABLELIQUID"
msgid "<link=\"PLASTIFIABLELIQUID\">Plastic Monomer</link>"
msgstr "<link=\"PLASTIFIABLELIQUID\">Monômero Plástico</link>"

#. STRINGS.MISC.TAGS.PLASTIFIABLELIQUID_DESC
msgctxt "STRINGS.MISC.TAGS.PLASTIFIABLELIQUID_DESC"
msgid ""
"Plastic monomers are organic compounds that can be processed into <link=\"PLASTIC\">Plastics</link> that have valuable "
"applications as advanced building materials.\n"
"\n"
"Plastics derived from these monomers can also be used as packaging materials for <link=\"FOOD\">Food</link> preservation."
msgstr ""
"Monômeros plásticos são compostos orgânicos que podem ser processados em <link=\"PLASTIC\">Plásticos</link> os quais têm "
"aplicações valiosas como materiais de construção avançados.\n"
"\n"
"Plásticos derivados desses monômeros também podem ser utilizados como materiais de embalagem para a preservação de "
"<link=\"FOOD\">Comida</link>."

