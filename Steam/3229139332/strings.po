#. STRINGS.EQUIPMENT.PREFABS.HOLIDAY_2023_CRATE.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.HOLIDAY_2023_CRATE.DESC"
msgid ""
"An unaddressed package has been discovered near the Printing Pod. It exudes seasonal cheer, and trace amounts of Neutronium "
"have been detected."
msgstr ""
"Um pacote não endereçado foi descoberto perto do Módulo Duplicador. Ele exala alegria sazonal e foram detectados vestígios "
"de Neutrônio."

#. STRINGS.EQUIPMENT.PREFABS.HOLIDAY_2023_CRATE.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.HOLIDAY_2023_CRATE.NAME"
