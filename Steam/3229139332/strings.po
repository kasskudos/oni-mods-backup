#. STRINGS.CREATURES.SPECIES.METHANEGEYSER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.METHANEGEYSER.DESC"
msgid "A highly pressurized geyser that periodically erupts with <link=\"METHANE\">Natural Gas</link>."
msgstr "Um gêiser altamente pressurizado que emite periodicamente <link=\"METHANE\">Gás Natural</link>."

#. STRINGS.CREATURES.SPECIES.METHANEGEYSER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.METHANEGEYSER.NAME"
msgid "<link=\"GEYSERGENERICMETHANE\">Natural Gas Geyser</link>"
msgstr "<link=\"GEYSERGENERICMETHANE\">Fumarola de Gás Natural</link>"

#. STRINGS.CREATURES.SPECIES.MOLE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.BABY.DESC"
msgid ""
"A snuggly little pup.\n"
"\n"
"One day it will grow into an adult <link=\"MOLE\">Shove Vole</link>."
msgstr ""
"Um bebezinho fofinho.\n"
"\n"
"Um dia, ela vai virar um <link=\"MOLE\">Arganaz Toupeira</link> adulto."

#. STRINGS.CREATURES.SPECIES.MOLE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.BABY.NAME"
msgid "<link=\"MOLE\">Vole Pup</link>"
msgstr "<link=\"MOLE\">Arganazinho Topeira</link>"

#. STRINGS.CREATURES.SPECIES.MOLE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.DESC"
msgid ""
"Shove Voles are burrowing critters that eat the <link=\"REGOLITH\">Regolith</link> collected on terrestrial surfaces.\n"
"\n"
"They cannot burrow through <link=\"REFINEDMETAL\">Refined Metals</link>."
msgstr ""
"Arganaz Toupeira são criaturas escavadoras que comem o <link=\"REGOLITH\">Regolito</link> coletado em superfícies "
"terrestres.\n"
"\n"
"Eles não conseguem escavar <link=\"REFINEDMETAL\">Metais Refinados</link>."

#. STRINGS.CREATURES.SPECIES.MOLE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.EGG_NAME"
msgid "<link=\"MOLE\">Shove Vole Egg</link>"
msgstr "<link=\"MOLE\">Ovo de Arganazinho Topeira</link>"

#. STRINGS.CREATURES.SPECIES.MOLE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.NAME"
msgid "<link=\"MOLE\">Shove Vole</link>"
msgstr "<link=\"MOLE\">Arganaz Toupeira</link>"

#. STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.BABY.DESC"
msgid ""
"A tender little Delecta Vole pup.\n"
"\n"
"One day it will grow into an adult Shove Vole morph, the <link=\"MOLEDELICACY\">Delecta Vole</link>."
msgstr ""
"Um Arganazinho Tônico fofinho.\n"
"\n"
"Um dia, ela crescerá e se transformará em uma raça adulta de Arganaz, o <link=\"MOLEDELICACY\">Arganaz Tônico</link>."

#. STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.BABY.NAME"
msgid "<link=\"MOLEDELICACY\">Delecta Vole Pup</link>"
msgstr "<link=\"MOLEDELICACY\">Ovo de Arganazinho Tônico</link>"

#. STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.DESC"
msgid ""
"Delecta Voles are burrowing critters whose bodies sprout shearable <link=\"GINGERCONFIG\">Tonic Root</link> when "
"<link=\"REGOLITH\">Regolith</link> is ingested at preferred temperatures.\n"
"\n"
"They cannot burrow through <link=\"REFINEDMETAL\">Refined Metals</link>."
msgstr ""
"Arganazes Tônicos são criaturas escavadoras cujos corpos brotam <link=\"GINGERCONFIG\">Raiz Tônica</link> tosquiável quando "
"<link=\"REGOLITH\">Regolito</link> é ingerido em temperaturas ideais.\n"
"\n"
"Eles não conseguem escavar <link=\"REFINEDMETAL\">Metais Refinados</link>."

#. STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.EGG_NAME"
msgid "<link=\"MOLEDELICACY\">Delecta Vole Egg</link>"
msgstr "<link=\"MOLEDELICACY\">Ovo de Arganazinho Tônico</link>"

#. STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOLE.VARIANT_DELICACY.NAME"
msgid "<link=\"MOLEDELICACY\">Delecta Vole</link>"
msgstr "<link=\"MOLEDELICACY\">Arganaz Tônico</link>"

#. STRINGS.CREATURES.SPECIES.MOO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOO.DESC"
msgid ""
"Moos are extraterrestrial critters that feed on <link=\"GASGRASS\">Gas Grass</link> and excrete <link=\"METHANE\">Natural "
"Gas</link>.\n"
"\n"
"When domesticated and fed, they can be milked for <link=\"MILK\">Brackene</link>."
msgstr ""
"Os Muus são criaturas extraterrestres que se alimentam de <link=\"GASGRASS\">Grama Gasosa</link> e excretam "
"<link=\"METHANE\">Gás Natural</link>.\n"
"\n"
"Quando domesticados e alimentados, eles podem ser ordenhados para obter <link=\"MILK\">Braquil</link>."

#. STRINGS.CREATURES.SPECIES.MOO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOO.NAME"
msgid "<link=\"MOO\">Gassy Moo</link>"
msgstr "<link=\"MOO\">Muu Gasoso</link>"

#. STRINGS.CREATURES.SPECIES.MOSQUITO.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOSQUITO.BABY.DESC"
msgid ""
"A wiggly little Gnit Larva.\n"
"\n"
"In time, it will mature into an irritating <link=\"MOSQUITO\">Gnit</link>."
msgstr ""
"Uma pequena Larva de Pernilonguito inquieta.\n"
"\n"
"Com o tempo, ela amadurecerá e se tornará um irritante <link=\"MOSQUITO\">Pernilonguito</link>."

#. STRINGS.CREATURES.SPECIES.MOSQUITO.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOSQUITO.BABY.NAME"
msgid "<link=\"MOSQUITO\">Gnit Larva</link>"
msgstr "<link=\"MOSQUITO\">Larva de Pernilonguito</link>"

#. STRINGS.CREATURES.SPECIES.MOSQUITO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MOSQUITO.DESC"
msgid ""
"Gnits are hostile airborne critters primarily bred as food for the carnivorous <link=\"FLYTRAPPLANT\">Lura Plants</link> to "
"produce <link=\"AMBER\">Amber</link>.\n"
"\n"
"Their offspring must be exposed to <link=\"ELEMENTSLIQUID\">Liquid</link> in order to survive."
msgstr ""
"Pernilonguitos são criaturas aéreas hostis criadas principalmente como alimento para as carnívoras "
"<link=\"FLYTRAPPLANT\">Plantas Lura</link> produzirem <link=\"AMBER\">Âmbar</link>.\n"
"\n"
"Sua prole precisa ser exposta a <link=\"ELEMENTSLIQUID\">Líquido</link> para sobreviver."

#. STRINGS.CREATURES.SPECIES.MOSQUITO.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOSQUITO.EGG_NAME"
msgid "<link=\"MOSQUITO\">Gnit Egg</link>"
msgstr "<link=\"MOSQUITO\">Ovo de Pernilonguito</link>"

#. STRINGS.CREATURES.SPECIES.MOSQUITO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MOSQUITO.NAME"
msgid "<link=\"MOSQUITO\">Gnit</link>"
msgstr "<link=\"MOSQUITO\">Pernilonguito</link>"

#. STRINGS.CREATURES.SPECIES.MUSHROOMPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MUSHROOMPLANT.DESC"
msgid ""
"Dusk Caps produce <link=\"MUSHROOM\">Mushrooms</link>, fungal growths that can be harvested for <link=\"FOOD\">Food</link>."
msgstr ""
"Chapéus Fungicos produzem <link=\"MUSHROOM\">Cogumelos</link>, crescimentos fúngicos que podem ser colhidos para "
"<link=\"FOOD\">Comida</link>."

#. STRINGS.CREATURES.SPECIES.MUSHROOMPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.MUSHROOMPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"MUSHROOM\">Mushrooms</link>."
msgstr "Esta planta produz <link=\"MUSHROOM\">Cogumelos</link> comestíveis."

#. STRINGS.CREATURES.SPECIES.MUSHROOMPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MUSHROOMPLANT.NAME"
msgid "<link=\"MUSHROOMPLANT\">Dusk Cap</link>"
msgstr "<link=\"MUSHROOMPLANT\">Chapéu Fungico</link>"

#. STRINGS.CREATURES.SPECIES.MUSSELSPROUT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MUSSELSPROUT.DESC"
msgid ""
"Mussel Sprouts are incapable of propagating but can be harvested for a single low quality <link=\"FOOD\">Food</link> "
"serving."
msgstr ""
"Brotos Mexilhão são incapazes de se propagar, mas podem ser colhidas para uma única porção de <link=\"FOOD\">Alimento</"
"link> de baixa qualidade."

#. STRINGS.CREATURES.SPECIES.MUSSELSPROUT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MUSSELSPROUT.NAME"
msgid "<link=\"MUSSELSPROUT\">Mussel Sprout</link>"
msgstr "<link=\"MUSSELSPROUT\">Broto Mexilhão</link>"

#. STRINGS.CREATURES.SPECIES.MYSTERYEGG.DESC
msgctxt "STRINGS.CREATURES.SPECIES.MYSTERYEGG.DESC"
msgid "What's growing inside? Something nice? Something mean?"
msgstr "O que está crescendo aí dentro? Algo bom? Algo ruim?"

#. STRINGS.CREATURES.SPECIES.MYSTERYEGG.NAME
msgctxt "STRINGS.CREATURES.SPECIES.MYSTERYEGG.NAME"
msgid "<link=\"MYSTERYEGG\">Mysterious Egg</link>"
msgstr "<link=\"MYSTERYEGG\">Ovo Misterioso</link>"

#. STRINGS.CREATURES.SPECIES.OIL_WELL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OIL_WELL.DESC"
msgid ""
"Oil Reservoirs are rock formations with <link=\"CRUDEOIL\">Crude Oil</link> deposits beneath their surface.\n"
"\n"
"Oil can be extracted from a reservoir with sufficient pressure."
msgstr ""
"Reservatórios de Petróleo são formações rochosas com depósitos de <link=\"CRUDEOIL\">Petróleo Bruto</link> abaixo de sua "
"superfície.\n"
"\n"
"O petróleo pode ser extraído de um reservatório com pressão suficiente."

#. STRINGS.CREATURES.SPECIES.OIL_WELL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OIL_WELL.NAME"
msgid "<link=\"OILWELL\">Oil Reservoir</link>"
msgstr "<link=\"OILWELL\">Reservatório de Petróleo</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.BABY.DESC"
msgid ""
"A goopy little Slickster Larva.\n"
"\n"
"One day it will grow into an adult <link=\"OILFLOATER\">Slickster</link>."
msgstr ""
"Uma pequena Larva Viscosa gosmenta.\n"
"\n"
"Um dia ela se tornará um <link=\"OILFLOATER\">Viscoso</link> adulto."

#. STRINGS.CREATURES.SPECIES.OILFLOATER.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.BABY.NAME"
msgid "<link=\"OILFLOATER\">Slickster Larva</link>"
msgstr "<link=\"OILFLOATER\">Larva Viscosa</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.DESC"
msgid ""
"Slicksters are slimy critters that consume <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and exude <link=\"CRUDEOIL\">Crude "
"Oil</link>."
msgstr ""
"Viscosos são criaturas viscosas que consomem <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link> e exalam "
"<link=\"CRUDEOIL\">Petróleo Bruto</link>."

#. STRINGS.CREATURES.SPECIES.OILFLOATER.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.EGG_NAME"
msgid "<link=\"OILFLOATER\">Slickster Egg</link>"
msgstr "<link=\"OILFLOATER\">Ovo Viscoso</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.NAME"
msgid "<link=\"OILFLOATER\">Slickster</link>"
msgstr "<link=\"OILFLOATER\">Viscoso</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.BABY.DESC"
msgid ""
"A snuggly little Longhair Larva.\n"
"\n"
"One day it will grow into an adult Slickster morph, the <link=\"OILFLOATERDECOR\">Longhair Slickster</link>."
msgstr ""
"Uma pequena Larva Lanosa aconchegante.\n"
"\n"
"Um dia ela se tornará um morfo Viscoso adulto, o <link=\"OILFLOATERDECOR\">Viscoso Lanoso</link>."

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.BABY.NAME"
msgid "<link=\"OILFLOATERDECOR\">Longhair Larva</link>"
msgstr "<link=\"OILFLOATERDECOR\">Larva Lanosa</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.DESC"
msgid ""
"Longhair Slicksters are friendly critters that consume <link=\"OXYGEN\">Oxygen</link> and thrive in close contact with "
"Duplicant companions.\n"
"\n"
"Longhairs have extremely beautiful and luxurious coats."
msgstr ""
"Viscosos Lanosos são criaturas amigáveis que consomem <link=\"OXYGEN\">Oxigênio</link> e prosperam em contato próximo com "
"companheiros Duplicantes.\n"
"\n"
"Viscosos Lanosos têm pelagens extremamente bonitas e luxuosas."

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.EGG_NAME"
msgid "<link=\"OILFLOATERDECOR\">Longhair Slickster Egg</link>"
msgstr "<link=\"OILFLOATERDECOR\">Ovo Lanoso</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_DECOR.NAME"
msgid "<link=\"OILFLOATERDECOR\">Longhair Slickster</link>"
msgstr "<link=\"OILFLOATERDECOR\">Viscoso Lanoso</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.BABY.DESC"
msgid ""
"A goopy little Molten Larva.\n"
"\n"
"One day it will grow into an adult Slickster morph, the <link=\"OILFLOATERHIGHTEMP\">Molten Slickster</link>."
msgstr ""
"Uma pequena Larva Fundida gosmenta.\n"
"\n"
"Um dia ela se tornará um morfo Viscoso adulto, o <link=\"OILFLOATERHIGHTEMP\">Viscoso Fundido</link>."

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.BABY.NAME"
msgid "<link=\"OILFLOATERHIGHTEMP\">Molten Larva</link>"
msgstr "<link=\"OILFLOATERHIGHTEMP\">Larva Fundida</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.DESC"
msgid ""
"Molten Slicksters are slimy critters that consume <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and exude "
"<link=\"PETROLEUM\">Petroleum</link>."
msgstr ""
"Viscosos Fundidos são criaturas viscosas que consomem <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link> e exalam "
"<link=\"PETROLEUM\">Petróleo</link>."

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.EGG_NAME"
msgid "<link=\"OILFLOATERHIGHTEMP\">Molten Slickster Egg</link>"
msgstr "<link=\"OILFLOATERHIGHTEMP\">Ovo Fundido</link>"

#. STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILFLOATER.VARIANT_HIGHTEMP.NAME"
msgid "<link=\"OILFLOATERHIGHTEMP\">Molten Slickster</link>"
msgstr "<link=\"OILFLOATERHIGHTEMP\">Viscoso Fundido</link>"

#. STRINGS.CREATURES.SPECIES.OILSPOUT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OILSPOUT.DESC"
msgid "A rocky vent that spouts <link=\"CRUDEOIL\">Crude Oil</link>."
msgstr "Uma abertura rochosa que jorra <link=\"CRUDEOIL\">Petróleo Bruto</link>."

#. STRINGS.CREATURES.SPECIES.OILSPOUT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OILSPOUT.NAME"
msgid "<link=\"OILSPOUT\">Oil Spout</link>"
msgstr "<link=\"OILSPOUT\">Bica de Petróleo</link>"

#. STRINGS.CREATURES.SPECIES.OXYCORAL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OXYCORAL.DESC"
msgid ""
"Flue Corals are aquatic organisms that use <link=\"LIGHT\">Light</link> to produce <link=\"OXYGEN\">Oxygen</link>.\n"
"\n"
"Due to their size, they can only be planted in a <link=\"WIDEFARMTILE\">Wide Hydroponic Farm</link>."
msgstr ""
"Corais Chaminé são organismos aquáticos que usam <link=\"LIGHT\">Luz</link> para produzir <link=\"OXYGEN\">Oxigênio</"
"link>.\n"
"\n"
"Devido ao seu tamanho, só podem ser plantados em uma <link=\"WIDEFARMTILE\">Fazenda Hidropônica Larga</link>."

#. STRINGS.CREATURES.SPECIES.OXYCORAL.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.OXYCORAL.DOMESTICATEDDESC"
msgid "This plant produces <link=\"OXYGEN\">Oxygen</link>."
msgstr "Esta planta produz <link=\"OXYGEN\">Oxigênio</link>."

#. STRINGS.CREATURES.SPECIES.OXYCORAL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OXYCORAL.NAME"
msgid "<link=\"OXYCORAL\">Flue Coral</link>"
msgstr "<link=\"OXYCORAL\">Coral Chaminé</link>"

#. STRINGS.CREATURES.SPECIES.OXYFERN.DESC
msgctxt "STRINGS.CREATURES.SPECIES.OXYFERN.DESC"
msgid "Oxyferns absorb <link=\"CARBONDIOXIDE\">Carbon Dioxide Gas</link> and exude breathable <link=\"OXYGEN\">Oxygen</link>."
msgstr ""
"Oximambaias absorvem <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link> e exalam <link=\"OXYGEN\">Oxigênio</link> respirável."

#. STRINGS.CREATURES.SPECIES.OXYFERN.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.OXYFERN.DOMESTICATEDDESC"
msgid "This plant converts <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> into <link=\"OXYGEN\">Oxygen</link>."
msgstr "Essa planta converte <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link> em <link=\"OXYGEN\">Oxigênio</link>."

#. STRINGS.CREATURES.SPECIES.OXYFERN.NAME
msgctxt "STRINGS.CREATURES.SPECIES.OXYFERN.NAME"
msgid "<link=\"OXYFERN\">Oxyfern</link>"
msgstr "<link=\"OXYFERN\">Oximambaia</link>"

#. STRINGS.CREATURES.SPECIES.PACU.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACU.BABY.DESC"
msgid ""
"A wriggly little Pacu Fry.\n"
"\n"
"In time, it will mature into an adult <link=\"PACU\">Pacu</link>."
msgstr ""
"Um pacuzinho cheio de vida\n"
"\n"
"Com o tempo, vai crescer e virar um <link=\"PACU\">Pacu</link> adulto."

#. STRINGS.CREATURES.SPECIES.PACU.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.BABY.NAME"
msgid "<link=\"PACU\">Pacu Fry</link>"
msgstr "<link=\"PACU\">Pacuzinho</link>"

#. STRINGS.CREATURES.SPECIES.PACU.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACU.DESC"
msgid ""
"Pacus are aquatic creatures that can live in any liquid, such as <link=\"WATER\">Water</link> or "
"<link=\"DIRTYWATER\">Polluted Water</link>.\n"
"\n"
"Every organism in the known universe finds the Pacu extremely delicious."
msgstr ""
"Pacus são criaturas aquáticas que podem viver em qualquer líquido, como a <link=\"WATER\">Água</link> ou "
"<link=\"DIRTYWATER\">Água Poluída</link>.\n"
"\n"
"Todo organismo no universo conhecido considera o pacu extremamente delicioso."

#. STRINGS.CREATURES.SPECIES.PACU.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.EGG_NAME"
msgid "<link=\"PACU\">Pacu Egg</link>"
msgstr "<link=\"PACUEGG\">Ova de Pacu</link>"

#. STRINGS.CREATURES.SPECIES.PACU.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.NAME"
msgid "<link=\"PACU\">Pacu</link>"
msgstr "<link=\"PACU\">Pacu</link>"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.BABY.DESC"
msgid ""
"A wriggly little Gulp Fry.\n"
"\n"
"In time, it will mature into an adult <link=\"PACUCLEANER\">Gulp Fish</link>."
msgstr ""
"Um pequeno Pacuzinho Tragão agitado.\n"
"\n"
"Com o tempo, ele crescerá e se tornará um <link=\"PACUCLEANER\">Pacu Tragão</link> adulto."

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.BABY.NAME"
msgid "<link=\"PACUCLEANER\">Gulp Fry</link>"
msgstr "<link=\"PACUCLEANER\">Pacuzinho Tragão</link>"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.DESC"
msgid ""
"Gulp Fishes are aquatic critters who inhabit cold liquid pools.\n"
"\n"
"Their gills filter <link=\"DIRTYWATER\">Polluted Water</link> into <link=\"WATER\">Water</link>."
msgstr ""
"Peixes Tragões são criaturas aquáticas que habitam poços de líquido frio.\n"
"\n"
"Suas brânquias filtram <link=\"DIRTYWATER\">Água Poluída</link> em <link=\"WATER\">Água</link>."

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.EGG_NAME"
msgid "<link=\"PACUCLEANER\">Gulp Fish Egg</link>"
msgstr "<link=\"PACUCLEANER\">Ova de Pacu Tragão</link>"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_CLEANER.NAME"
msgid "<link=\"PACUCLEANER\">Gulp Fish</link>"
msgstr "<link=\"PACUCLEANER\">Pacu Tragão</link>"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.BABY.DESC"
msgid ""
"A wriggly little Tropical Fry.\n"
"\n"
"In time it will mature into an adult Pacu morph, the <link=\"PACUTROPICAL\">Tropical Pacu</link>."
msgstr ""
"Um Pacuzinho Tropical cheio de vida.\n"
"\n"
"Com o tempo, vai crescer e virar um <link=\"PACUTROPICAL\">Pacu Tropical</link> adulto, da raça dos Pacus."

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.BABY.NAME"
msgid "<link=\"PACUTROPICAL\">Tropical Fry</link>"
msgstr "<link=\"PACUTROPICAL\">Pacuzinho Tropical</link>"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.DESC"
msgid ""
"Tropical Pacus are aquatic critters who inhabit warm liquid pools.\n"
"\n"
"Their vibrant colors provide a significant <link=\"DECOR\">Decor</link> boost to their environment."
msgstr ""
"Pacus Tropicais são criaturas aquáticas que habitam tanques de líquido quente.\n"
"\n"
"Suas cores vibrantes fornecem um impulso significativo de <link=\"DECOR\">Decor</link> ao seu ambiente."

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.EGG_NAME"
msgid "<link=\"PACUTROPICAL\">Tropical Pacu Egg</link>"
msgstr "<link=\"PACUTROPICAL\">Ova de Pacu Tropical</link>"

#. STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACU.VARIANT_TROPICAL.NAME"
msgid "<link=\"PACUTROPICAL\">Tropical Pacu</link>"
msgstr "<link=\"PACUTROPICAL\">Pacu Tropical</link>"

#. STRINGS.CREATURES.SPECIES.PACUEGG.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PACUEGG.DESC"
msgid ""
"A tiny Pacu is nestled inside.\n"
"\n"
"It is not yet ready for the world."
msgstr ""
"Um pequeno Pacu está aconchegado dentro.\n"
"\n"
"Ele ainda não está pronto para o mundo."

#. STRINGS.CREATURES.SPECIES.PACUEGG.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PACUEGG.NAME"
msgid "<link=\"PACUEGG\">Pacu Egg</link>"
msgstr "<link=\"PACUEGG\">Ovo de Pacu</link>"

#. STRINGS.CREATURES.SPECIES.PARROTFISH.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PARROTFISH.BABY.DESC"
msgid ""
"A wriggly little Beakon Fry.\n"
"\n"
"In time, it will mature into an adult <link=\"PARROTFISH\">Beakon</link>."
msgstr ""
"Um pequeno filhote de Bicolume cheio de vida.\n"
"\n"
"Com o tempo, vai crescer e virar um <link=\"PARROTFISH\">Bicolume</link> adulto."

#. STRINGS.CREATURES.SPECIES.PARROTFISH.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PARROTFISH.BABY.NAME"
msgid "<link=\"PARROTFISH\">Beakon Fry</link>"
msgstr "<link=\"PARROTFISH\">Filhote de Bicolume</link>"

#. STRINGS.CREATURES.SPECIES.PARROTFISH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PARROTFISH.DESC"
msgid ""
"Beakons are aquatic critters who feast on <link=\"PHOSPHORITE\">Phosphorite</link> and <link=\"PLANKTONCORAL\">Starnacle</"
"link>, and excrete <link=\"LIME\">Lime</link>.\n"
"\n"
"They produce <link=\"LIGHT\">Light</link> when <link=\"CREATURES::GUIDE::MOOD\">Happy</link>, and enjoy consuming "
"<link=\"OXYGEN\">Oxygen</link>."
msgstr ""
"Bicolumes são criaturas aquáticas que se alimentam de <link=\"PHOSPHORITE\">Fosforita</link> e "
"<link=\"PLANKTONCORAL\">Estrelas-do-mar</link>, e excretam <link=\"LIME\">Cal</link>.\n"
"\n"
"Elas produzem <link=\"LIGHT\">Luz</link> quando <link=\"CREATURES::GUIDE::MOOD\">Felizes</link>, e gostam de consumir "
"<link=\"OXYGEN\">Oxigênio</link>."

#. STRINGS.CREATURES.SPECIES.PARROTFISH.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PARROTFISH.EGG_NAME"
msgid "<link=\"PARROTFISH\">Beakon Egg</link>"
msgstr "<link=\"PARROTFISH\">Ovo de Bicolume</link>"

#. STRINGS.CREATURES.SPECIES.PARROTFISH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PARROTFISH.NAME"
msgid "<link=\"PARROTFISH\">Beakon</link>"
msgstr "<link=\"PARROTFISH\">Bicolume</link>"

#. STRINGS.CREATURES.SPECIES.PINKROCK.CODEX
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCK.CODEX"
msgid "Lumen quartz is a naturally occurring object found in the <link=\"BIOMECARROTQUARRY\">Cool Pool</link> biome."
msgstr "O Quartzo Luminoso é um objeto natural encontrado no <link=\"BIOMECARROTQUARRY\">Bioma Glacial</link>."

#. STRINGS.CREATURES.SPECIES.PINKROCK.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCK.DESC"
msgid ""
"Lumen quartz emits a soft glowing <link=\"LIGHT\">Light</link> that makes everything look and feel a little rosier.\n"
"\n"
"It's even brighter and more beautiful once it's been carved."
msgstr ""
"O Quartzo Luminoso emite uma <link=\"LIGHT\">Luz</link> suave que faz tudo parecer e se sentir um pouco mais cor-de-rosa.\n"
"\n"
"Ele fica ainda mais brilhante e bonito quando esculpido."

#. STRINGS.CREATURES.SPECIES.PINKROCK.EFFECT
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCK.EFFECT"
msgid ""
msgstr ""

#. STRINGS.CREATURES.SPECIES.PINKROCK.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCK.NAME"
msgid "<link=\"PINKROCK\">Lumen Quartz</link>"
msgstr "<link=\"PINKROCK\">Quartzo Luminoso</link>"

#. STRINGS.CREATURES.SPECIES.PINKROCKCARVED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCKCARVED.DESC"
msgid ""
"A Duplicant has carved this Lumen quartz in a way that really maximizes its <link=\"DECOR\">Decor</link> value and "
"<link=\"LIGHT\">brightness</link>."
msgstr ""
"Um Duplicante esculpiu este Quartzo Luminoso de uma forma que realmente maximiza seu valor <link=\"DECOR\">Decorativo</"
"link> e <link=\"LIGHT\">brilho</link>."

#. STRINGS.CREATURES.SPECIES.PINKROCKCARVED.EFFECT
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCKCARVED.EFFECT"
msgid ""
msgstr ""

#. STRINGS.CREATURES.SPECIES.PINKROCKCARVED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PINKROCKCARVED.NAME"
msgid "<link=\"PINKROCK\">Carved Lumen Quartz</link>"
msgstr "<link=\"PINKROCK\">Quartzo Luminoso Esculpido</link>"

#. STRINGS.CREATURES.SPECIES.PLANKTONCORAL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PLANKTONCORAL.DESC"
msgid ""
"Starnacles are aquatic organisms that consume <link=\"COQUINA\">Coquina</link>.\n"
"\n"
" Its <link=\"PHOSPHORITE\">Phosphorite</link> build-up can be consumed by <link=\"PARROTFISH\">Beakons</link> or harvested "
"by Duplicants."
msgstr ""
"Estrelacas são organismos aquáticos que consomem <link=\"COQUINA\">Coquina</link>.\n"
"\n"
" Seu acúmulo de <link=\"PHOSPHORITE\">Fosforita</link> pode ser consumido por <link=\"PARROTFISH\">Bicolumes</link> ou "
"coletado por Duplicantes."

#. STRINGS.CREATURES.SPECIES.PLANKTONCORAL.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.PLANKTONCORAL.DOMESTICATEDDESC"
msgid "This coral produces <link=\"PHOSPHORITE\">Phosphorite</link>."
msgstr "Este coral produz <link=\"PHOSPHORITE\">Fosforita</link>."

#. STRINGS.CREATURES.SPECIES.PLANKTONCORAL.LIQUID_CONSUMPTION
msgctxt "STRINGS.CREATURES.SPECIES.PLANKTONCORAL.LIQUID_CONSUMPTION"
msgid "Filtering {ElementTypes}: {FlowRate}"
msgstr "Filtrando {ElementTypes}: {FlowRate}"

#. STRINGS.CREATURES.SPECIES.PLANKTONCORAL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PLANKTONCORAL.NAME"
msgid "<link=\"PLANKTONCORAL\">Starnacle</link>"
msgstr "<link=\"PLANKTONCORAL\">Estrelaca</link>"

#. STRINGS.CREATURES.SPECIES.PREHISTORICPACU.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PREHISTORICPACU.BABY.DESC"
msgid ""
"A grumpy little Jawbo fry.\n"
"\n"
"In time, it will grow into a toothy <link=\"PREHISTORICPACU\">Jawbo</link>."
msgstr ""
"Uma larva mal-humorada de Maxilossauro.\n"
"\n"
"Com o tempo, ela crescerá e se tornará um <link=\"PREHISTORICPACU\">Maxilossauro</link> dentuço."

#. STRINGS.CREATURES.SPECIES.PREHISTORICPACU.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PREHISTORICPACU.BABY.NAME"
msgid "<link=\"PREHISTORICPACU\">Jawbo Fry</link>"
msgstr "<link=\"PREHISTORICPACU\">Maxilevino</link>"

#. STRINGS.CREATURES.SPECIES.PREHISTORICPACU.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PREHISTORICPACU.DESC"
msgid ""
"Jawbos are carnivorous aquatic critters that feed on <link=\"PACU\">Pacus</link> and produce <link=\"RUST\">Rust</link>.\n"
"\n"
"They pose no danger to Duplicants."
msgstr ""
"Os Maxilossauros são Criaturas aquáticas carnívoras que se alimentam de <link=\"PACU\">Pacus</link> e produzem "
"<link=\"RUST\">Ferrugem</link>.\n"
"\n"
"Eles não representam perigo para os Duplicantes."

#. STRINGS.CREATURES.SPECIES.PREHISTORICPACU.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PREHISTORICPACU.EGG_NAME"
msgid "<link=\"PREHISTORICPACU\">Jawbo Egg</link>"
msgstr "<link=\"PREHISTORICPACU\">Ovo de Maxilossauro</link>"

#. STRINGS.CREATURES.SPECIES.PREHISTORICPACU.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PREHISTORICPACU.NAME"
msgid "<link=\"PREHISTORICPACU\">Jawbo</link>"
msgstr "<link=\"PREHISTORICPACU\">Maxilossauro</link>"

#. STRINGS.CREATURES.SPECIES.PRICKLEFLOWER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEFLOWER.DESC"
msgid "Bristle Blossoms produce <link=\"PRICKLEFRUIT\">Bristle Berry</link>, a prickly edible bud."
msgstr "Florescarpas produzem <link=\"PRICKLEFRUIT\">Fruto Escarpado</link>, um broto comestível espinhoso."

#. STRINGS.CREATURES.SPECIES.PRICKLEFLOWER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEFLOWER.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"PRICKLEFRUIT\">Bristle Berries</link>."
msgstr "Esta planta produz <link=\"PRICKLEFRUIT\">Frutos Escarpados</link> comestíveis."

#. STRINGS.CREATURES.SPECIES.PRICKLEFLOWER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEFLOWER.NAME"
msgid "<link=\"PRICKLEFLOWER\">Bristle Blossom</link>"
msgstr "<link=\"PRICKLEFLOWER\">Florescarpa</link>"

#. STRINGS.CREATURES.SPECIES.PRICKLEGRASS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEGRASS.DESC"
msgid "Bluff Briars exude pheromones causing critters to view them as especially beautiful."
msgstr "Arbustos Espinhosos exalam feromônios que fazem com que as criaturas os vejam como especialmente bonitos."

#. STRINGS.CREATURES.SPECIES.PRICKLEGRASS.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEGRASS.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Esta planta melhora a <link=\"DECOR\">Decor</link> do ambiente."

#. STRINGS.CREATURES.SPECIES.PRICKLEGRASS.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEGRASS.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "Bônus de Crescimento"

#. STRINGS.CREATURES.SPECIES.PRICKLEGRASS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEGRASS.NAME"
msgid "<link=\"PRICKLEGRASS\">Bluff Briar</link>"
msgstr "<link=\"PRICKLEGRASS\">Arbusto Espinhoso</link>"

#. STRINGS.CREATURES.SPECIES.PRICKLEGRASS.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.PRICKLEGRASS.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "Penalidade por Murchar"

#. STRINGS.CREATURES.SPECIES.PROPANESPOUT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PROPANESPOUT.DESC"
msgid "A rocky vent that spouts <link=\"PROPANE\">Propane Gas</link>."
msgstr "Uma abertura rochosa que jorra <link=\"PROPANE\">Gás Propano</link>."

#. STRINGS.CREATURES.SPECIES.PROPANESPOUT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PROPANESPOUT.NAME"
msgid "<link=\"GEYSERS\">Propane Spout</link>"
msgstr "<link=\"GEYSERS\">Bica de Propano</link>"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.BABY.DESC"
msgid ""
"A precious little Blowter Fry.\n"
"\n"
"In time, it will mature into an adult <link=\"PUFFERFISH\">Blowter</link>."
msgstr ""
"Um precioso filhote de Oxiacu cheio de vida.\n"
"\n"
"Com o tempo, vai crescer e virar um <link=\"PUFFERFISH\">Oxiacu</link> adulto."

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.BABY.NAME"
msgid "<link=\"SQUID\">Blowter Fry</link>"
msgstr "<link=\"SQUID\">Filhote de Oxiacu</link>"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.DESC"
msgid ""
"Blowters are aquatic critters who produce <link=\"OXYGEN\">Oxygen</link> after eating leaves from "
"<link=\"SEALETTUCE\">Waterweed</link> plants."
msgstr ""
"Oxiacus são criaturas aquáticas que produzem <link=\"OXYGEN\">Oxigênio</link> após comer folhas de plantas "
"<link=\"SEALETTUCE\">Alface Aquática</link>."

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.EGG_NAME"
msgid "<link=\"PUFFERFISH\">Blowter Egg</link>"
msgstr "<link=\"PUFFERFISH\">Ovo de Oxiacu</link>"

#. STRINGS.CREATURES.SPECIES.PUFFERFISH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFFERFISH.NAME"
msgid "<link=\"PUFFERFISH\">Blowter</link>"
msgstr "<link=\"PUFFERFISH\">Oxiacu</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.BABY.DESC"
msgid ""
"A gassy little Puftlet.\n"
"\n"
"In time it will grow into an adult <link=\"PUFT\">Puft</link>."
msgstr ""
"Um pequeno Pufinho gasoso.\n"
"\n"
"Com o tempo, ele se tornará um <link=\"PUFT\">Pufão</link> adulto."

#. STRINGS.CREATURES.SPECIES.PUFT.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.BABY.NAME"
msgid "<link=\"PUFT\">Puftlet</link>"
msgstr "<link=\"PUFT\">Pufinho</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.DESC"
msgid "Pufts are non-aggressive critters that excrete lumps of <link=\"SLIMEMOLD\">Slime</link> with each breath."
msgstr "Pufões são criaturas não agressivas que excretam pedaços de <link=\"SLIMEMOLD\">Limo</link> a cada respiração."

#. STRINGS.CREATURES.SPECIES.PUFT.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.EGG_NAME"
msgid "<link=\"PUFT\">Puft Egg</link>"
msgstr "<link=\"PUFT\">Ovo de Pufão</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.NAME"
msgid "<link=\"PUFT\">Puft</link>"
msgstr "<link=\"PUFT\">Pufão</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.BABY.DESC"
msgid ""
"A gassy little Puftlet Prince.\n"
"\n"
"One day it will grow into an adult Puft morph, the <link=\"PUFTALPHA\">Puft Prince</link>.\n"
"\n"
"It seems a bit snobby..."
msgstr ""
"Um pequeno Pufinho Príncipe gasoso.\n"
"\n"
"Um dia ele se tornará um morfo Puf adulto, o <link=\"PUFTALPHA\">Pufão Príncipe</link>.\n"
"\n"
"Parece um pouco esnobe..."

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.BABY.NAME"
msgid "<link=\"PUFTALPHA\">Puftlet Prince</link>"
msgstr "<link=\"PUFTALPHA\">Pufinho Príncipe</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.DESC"
msgid ""
"The Puft Prince is a lazy critter that excretes little <link=\"SOLID\">Solid</link> lumps of whatever it has been breathing."
msgstr ""
"O Pufão Príncipe é uma criatura preguiçosa que excreta pequenos pedaços <link=\"SOLID\">Sólidos</link> de tudo o que tem "
"respirado."

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.EGG_NAME"
msgid "<link=\"PUFTALPHA\">Puft Prince Egg</link>"
msgstr "<link=\"PUFTALPHA\">Ovo de Pufão Príncipe</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_ALPHA.NAME"
msgid "<link=\"PUFTALPHA\">Puft Prince</link>"
msgstr "<link=\"PUFTALPHA\">Pufão Príncipe</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.BABY.DESC"
msgid ""
"A frazzled little Squeaky Puftlet.\n"
"\n"
"One day it will grow into an adult Puft morph, the <link=\"PUFTBLEACHSTONE\">Squeaky Puft</link>."
msgstr ""
"Um pequeno Pufinho Estridente exausto.\n"
"\n"
"Um dia ele se tornará um Pufão adulto, da raça <link=\"PUFTBLEACHSTONE\">Pufão Estridente</link>."

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.BABY.NAME"
msgid "<link=\"PUFTBLEACHSTONE\">Squeaky Puftlet</link>"
msgstr "<link=\"PUFTBLEACHSTONE\">Pufinho Estridente</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.DESC"
msgid ""
"Squeaky Pufts are non-aggressive critters that excrete lumps of <link=\"BLEACHSTONE\">Bleachstone</link> with each breath."
msgstr ""
"Pufões Estridentes são criaturas não agressivas que excretam pedaços de <link=\"BLEACHSTONE\">Lixívia</link> a cada "
"respiração."

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.EGG_NAME"
msgid "<link=\"PUFTBLEACHSTONE\">Squeaky Puft Egg</link>"
msgstr "<link=\"PUFTBLEACHSTONE\">Ovo de Pufão Estridente</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_BLEACHSTONE.NAME"
msgid "<link=\"PUFTBLEACHSTONE\">Squeaky Puft</link>"
msgstr "<link=\"PUFTBLEACHSTONE\">Pufão Estridente</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.DESC"
msgid ""
"A stocky little Dense Puftlet.\n"
"\n"
"One day it will grow into an adult Puft morph, the <link=\"PUFTOXYLITE\">Dense Puft</link>."
msgstr ""
"Um pequeno Pufinho Denso atarracado.\n"
"\n"
"Um dia, ele crescerá e se tornará um Pufão adulto, o <link=\"PUFTOXYLITE\">Pufão Denso</link>."

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.BABY.NAME"
msgid "<link=\"PUFTOXYLITE\">Dense Puftlet</link>"
msgstr "<link=\"PUFTOXYLITE\">Pufinho Denso</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.DESC"
msgid "Dense Pufts are non-aggressive critters that excrete condensed <link=\"OXYROCK\">Oxylite</link> with each breath."
msgstr ""
"Pufões Densos são criaturas não agressivas que excretam <link=\"OXYROCK\">Oxilito</link> condensada a cada respiração."

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.EGG_NAME"
msgid "<link=\"PUFTOXYLITE\">Dense Puft Egg</link>"
msgstr "<link=\"PUFTOXYLITE\">Ovo de Pufão Denso</link>"

#. STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.PUFT.VARIANT_OXYLITE.NAME"
msgid "<link=\"PUFTOXYLITE\">Dense Puft</link>"
msgstr "<link=\"PUFTOXYLITE\">Pufão Denso</link>"

#. STRINGS.CREATURES.SPECIES.RAPTOR.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.BABY.DESC"
msgid ""
"A feathery little Rhex fledgling.\n"
"\n"
"One day, it will grow into a fearsome <link=\"RAPTOR\">Rhex</link>."
msgstr ""
"Um pequeno filhote de Rex emplumado.\n"
"\n"
"Um dia, ele se tornará um temível <link=\"RAPTOR\">Rex</link>."

#. STRINGS.CREATURES.SPECIES.RAPTOR.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.BABY.NAME"
msgid "<link=\"RAPTOR\">Rhex Baby</link>"
msgstr "<link=\"RAPTOR\">Bebê Rex</link>"

#. STRINGS.CREATURES.SPECIES.RAPTOR.DESC
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.DESC"
msgid ""
"Rhexes are carnivorous critters that feed on smaller <link=\"CREATURES\">Critters</link> and produce "
"<link=\"BRINEICE\">Brine Ice</link>.\n"
"\n"
"Their tailfeathers can be shorn for <link=\"FEATHERFABRIC\">Feather Fiber</link>."
msgstr ""
"Rexes são criaturas carnívoras que se alimentam de <link=\"CREATURES\">Criaturas</link> menores e produzem "
"<link=\"BRINEICE\">Salmoura Congelada</link>.\n"
"\n"
"Suas penas da cauda podem ser tosadas para obter <link=\"FEATHERFABRIC\">Fibra de Pena</link>."

#. STRINGS.CREATURES.SPECIES.RAPTOR.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.EGG_NAME"
msgid "<link=\"RAPTOR\">Rhex Egg</link>"
msgstr "<link=\"RAPTOR\">Ovo de Rex</link>"

#. STRINGS.CREATURES.SPECIES.RAPTOR.NAME
msgctxt "STRINGS.CREATURES.SPECIES.RAPTOR.NAME"
msgid "<link=\"RAPTOR\">Rhex</link>"
msgstr "<link=\"RAPTOR\">Rex</link>"

#. STRINGS.CREATURES.SPECIES.SALTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SALTPLANT.DESC"
msgid ""
"Dasha Saltvines consume small amounts of <link=\"CHLORINEGAS\">Chlorine Gas</link> and form sodium deposits as they grow, "
"producing harvestable <link=\"SALT\">Salt</link>."
msgstr ""
"Vinha Salina consome pequenas quantidades de <link=\"CHLORINEGAS\">Cloro</link> e forma depósitos de sódio à medida que "
"cresce, produzindo <link=\"SALT\">Sal</link> colhível."

#. STRINGS.CREATURES.SPECIES.SALTPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SALTPLANT.DOMESTICATEDDESC"
msgid "This plant produces unrefined <link=\"SALT\">Salt</link>."
msgstr "Esta planta produz <link=\"SALT\">Sal</link> não refinado."

#. STRINGS.CREATURES.SPECIES.SALTPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SALTPLANT.NAME"
msgid "<link=\"SALTPLANT\">Dasha Saltvine</link>"
msgstr "<link=\"SALTPLANT\">Vinha Salina</link>"

#. STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.DESC"
msgid ""
"Sodicane produces <link=\"SALTYSTICKSFOOD\">Salty Sticks</link>, a sodium-rich <link=\"FOOD\">Food</link> that leaves "
"Duplicants feeling quite parched."
msgstr ""
"Cana de Sal produz <link=\"SALTYSTICKSFOOD\">Palitos Salgados</link>, um <link=\"FOOD\">Alimento</link> rico em sódio que "
"deixa os Duplicantes com bastante sede."

#. STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"SALTYSTICKSFOOD\">Salty Sticks</link>."
msgstr "Esta planta produz <link=\"SALTYSTICKSFOOD\">Palitos Salgados</link> comestíveis."

#. STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SALTYSTICKSPLANT.NAME"
msgid "<link=\"SALTYSTICKSPLANT\">Sodicane</link>"
msgstr "<link=\"SALTYSTICKSPLANT\">Cana de Sal</link>"

#. STRINGS.CREATURES.SPECIES.SAPTREE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SAPTREE.DESC"
msgid ""
"A <link=\"RESIN\">Sap</link>-producing cybernetic tree that shows signs of sentience.\n"
"\n"
"It is rooted firmly in place, and is waiting for some brave soul to bring it food."
msgstr ""
"Uma árvore cibernética produtora de <link=\"RESIN\">Látex</link> que mostra sinais de senciência.\n"
"\n"
"Está firmemente enraizada no lugar, esperando que alguma alma corajosa lhe traga alimento."

#. STRINGS.CREATURES.SPECIES.SAPTREE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SAPTREE.NAME"
msgid "<link=\"SAPTREE\">Experiment 52B</link>"
msgstr "<link=\"SAPTREE\">Experimento 52B</link>"

#. STRINGS.CREATURES.SPECIES.SEAFAIRY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAFAIRY.DESC"
msgid ""
"Kelpoles are non-hostile aquatic critters that spawn along <link=\"SEATREE\">Tower Kelp</link> stalks.\n"
"\n"
"They can be harvested for <link=\"NORI\">Nori</link>."
msgstr ""
"Alguinos são criaturas aquáticas não hostis que surgem ao longo dos caules de <link=\"SEATREE\">Algas Torre</link>.\n"
"\n"
"Eles podem ser colhidos para obter <link=\"NORI\">Nori</link>."

#. STRINGS.CREATURES.SPECIES.SEAFAIRY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAFAIRY.NAME"
msgid "<link=\"SEAFAIRY\">Kelpole</link>"
msgstr "<link=\"SEAFAIRY\">Alguino</link>"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.BABY.DESC"
msgid ""
"A flouncy little Seaquine Fry.\n"
"\n"
"In time, it will mature into an adult <link=\"SEAHORSE\">Seaquine</link>."
msgstr ""
"Um pequeno filhote de Marvalo cheio de energia.\n"
"\n"
"Com o tempo, vai crescer e virar um <link=\"SEAHORSE\">Marvalo</link> adulto."

#. STRINGS.CREATURES.SPECIES.SEAHORSE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.BABY.NAME"
msgid "<link=\"SEAHORSE\">Seaquine Fry</link>"
msgstr "<link=\"SEAHORSE\">Filhote de Marvalo</link>"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.DESC"
msgid ""
"Seaquines are aquatic critters that live in liquid pools.\n"
"\n"
"They feed on <link=\"PEARL\">Pearl</link> and produce <link=\"FISHMILK\">Ovolene</link> at the "
"<link=\"UNDERWATERMILKINGSTATION\">Aquatic Milking Station</link>."
msgstr ""
"Marvalos são criaturas aquáticas que vivem em poças de líquido.\n"
"\n"
"Alimentam-se de <link=\"PEARL\">Pérola</link> e produzem <link=\"FISHMILK\">Ovoleno</link> na "
"<link=\"UNDERWATERMILKINGSTATION\">Estação de Ordenha Aquática</link>."

#. STRINGS.CREATURES.SPECIES.SEAHORSE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.EGG_NAME"
msgid "<link=\"SEAHORSE\">Seaquine Egg</link>"
msgstr "<link=\"SEAHORSE\">Ovo de Marvalo</link>"

#. STRINGS.CREATURES.SPECIES.SEAHORSE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAHORSE.NAME"
msgid "<link=\"SEAHORSE\">Seaquine</link>"
msgstr "<link=\"SEAHORSE\">Marvalo</link>"

#. STRINGS.CREATURES.SPECIES.SEAL.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.BABY.DESC"
msgid ""
"A wobbly little Spigot Pup.\n"
"\n"
"In time, it will mature into an adult <link=\"SEAL\">Spigot Seal</link>."
msgstr ""
"Uma minúscula Foquinha-Sifão, bambante e adorável\n"
"\n"
"Com o tempo, vai crescer e virar uma <link=\"SEAL\">Foca-Sifão</link> adulta."

#. STRINGS.CREATURES.SPECIES.SEAL.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.BABY.NAME"
msgid "<link=\"SEAL\">Spigot Pup</link>"
msgstr "<link=\"SEAL\">Foquinha-Sifão</link>"

#. STRINGS.CREATURES.SPECIES.SEAL.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.DESC"
msgid ""
"Spigot Seals are charismatic creatures who produce <link=\"ETHANOL\">Ethanol</link>.\n"
"\n"
"They eat <link=\"SUCROSE\">Sucrose</link>, and drink <link=\"SUGARWATER\">Nectar</link> straight from the "
"<link=\"SPACETREE\">Bonbon Tree</link>."
msgstr ""
"Focas-Sifão são criaturas carismáticas que produzem <link=\"ETHANOL\">Etanol</link>.\n"
"\n"
"Elas comem <link=\"SUCROSE\">Sacarose</link>, e bebem <link=\"SUGARWATER\">Néctar</link> diretamente da "
"<link=\"SPACETREE\">Árvore Docinha</link>."

#. STRINGS.CREATURES.SPECIES.SEAL.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.EGG_NAME"
msgid "<link=\"SEAL\">Spigot Seal Egg</link>"
msgstr "<link=\"SEAL\">Ovo de Foca-Sifão</link>"

#. STRINGS.CREATURES.SPECIES.SEAL.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.NAME"
msgid "<link=\"SEAL\">Spigot Seal</link>"
msgstr "<link=\"SEAL\">Foca-Sifão</link>"

#. STRINGS.CREATURES.SPECIES.SEALETTUCE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEALETTUCE.DESC"
msgid "Waterweeds thrive in liquid environments and can be harvested for fresh, edible <link=\"LETTUCE\">Lettuce</link>."
msgstr ""
"Alfaces do Mar prosperam em ambientes líquidos e podem ser colhidas para produzir <link=\"LETTUCE\">Alface</link> fresca e "
"comestível."

#. STRINGS.CREATURES.SPECIES.SEALETTUCE.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SEALETTUCE.DOMESTICATEDDESC"
msgid "This plant produces <link=\"LETTUCE\">Lettuce</link>."
msgstr "Esta planta produz <link=\"LETTUCE\">Alface</link>."

#. STRINGS.CREATURES.SPECIES.SEALETTUCE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEALETTUCE.NAME"
msgid "<link=\"SEALETTUCE\">Waterweed</link>"
msgstr "<link=\"SEALETTUCE\">Alface do Mar</link>"

#. STRINGS.CREATURES.SPECIES.SEATREE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATREE.DESC"
msgid ""
"Tower Kelp is an aquatic plant that grows in temperate pools.\n"
"\n"
"It can be harvested for <link=\"NORI\">Nori</link>."
msgstr ""
"Algaime é uma planta aquática que cresce em poças temperadas.\n"
"\n"
"Pode ser colhida para obter <link=\"NORI\">Nori</link>."

#. STRINGS.CREATURES.SPECIES.SEATREE.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATREE.DOMESTICATEDDESC"
msgid "This plant produces <link=\"NORI\">Nori</link>."
msgstr "Esta planta produz <link=\"NORI\">Nori</link>."

#. STRINGS.CREATURES.SPECIES.SEATREE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEATREE.NAME"
msgid "<link=\"SEATREE\">Tower Kelp</link>"
msgstr "<link=\"SEATREE\">Algaime</link>"

#. STRINGS.CREATURES.SPECIES.SEATREEBRANCH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATREEBRANCH.DESC"
msgid ""
"These stalks are the individual shoots of the <link=\"SEATREE\">Tower Kelp</link> plant.\n"
"\n"
"They act as cross-species nurseries for <link=\"SEATREEFAIRY\">Kelpoles</link> that can be harvested for "
"<link=\"NORI\">Nori</link>."
msgstr ""
"Estes caules são os brotos individuais da planta <link=\"SEATREE\">Algaime</link>.\n"
"\n"
"Eles atuam como viveiros interespecíficos para <link=\"SEATREEFAIRY\">Alguinos</link> que podem ser colhidos para obter "
"<link=\"NORI\">Nori</link>."

#. STRINGS.CREATURES.SPECIES.SEATREEBRANCH.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATREEBRANCH.DOMESTICATEDDESC"
msgid "This plant produces <link=\"NORI\">Nori</link>."
msgstr "Esta planta produz <link=\"NORI\">Nori</link>."

#. STRINGS.CREATURES.SPECIES.SEATREEBRANCH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEATREEBRANCH.NAME"
msgid "<link=\"SEATREE\">Tower Kelp</link>"
msgstr "<link=\"SEATREE\">Algaime</link>"

#. STRINGS.CREATURES.SPECIES.SEATURTLE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEATURTLE.BABY.DESC"
msgid "A chubby baby <link=\"SEATURTLE\">Orehull</link>"
msgstr "Um bebê gordinho de <link=\"SEATURTLE\">Cascórinho</link>"

#. STRINGS.CREATURES.SPECIES.SEATURTLE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEATURTLE.BABY.NAME"
msgid "<link=\"SEATURTLE\">Orehull Spawn</link>"
msgstr "<link=\"SEATURTLE\">Cascórinho</link>"

#. STRINGS.CREATURES.SPECIES.SEATURTLE.DESC
#| msgid ""
#| "Orehulls are shy aquatic critters that eat <link=\"SEAFAIRYSPECIES\">Kelpoles</link> and excrete "
#| "<link=\"TOXICSAND\">Polluted Dirt</link>.\n"
#| "\n"
#| "They can be sheared for <link=\"IRONORE\">Iron Ore</link>."
msgctxt "STRINGS.CREATURES.SPECIES.SEATURTLE.DESC"
msgid ""
"Orehulls are shy aquatic critters that eat <link=\"SEAFAIRYSPECIES\">Kelpoles</link> and excrete "
"<link=\"TOXICMUD\">Polluted Mud</link>.\n"
"\n"
"They can be sheared for <link=\"IRONORE\">Iron Ore</link>."
msgstr ""
"Cascóreos são criaturas aquáticas tímidas que comem <link=\"SEAFAIRYSPECIES\">Alguinos</link> e excretam "
"<link=\"TOXICMUD\">Lama Poluída</link>.\n"
"\n"
"Eles podem ser tosquiados para obter <link=\"IRONORE\">Minério de Ferro</link>."

#. STRINGS.CREATURES.SPECIES.SEATURTLE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEATURTLE.EGG_NAME"
msgid "<link=\"SEATURTLE\">Orehull Egg</link>"
msgstr "<link=\"SEATURTLE\">Ovo de Cascórinho</link>"

#. STRINGS.CREATURES.SPECIES.SEATURTLE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEATURTLE.NAME"
msgid "<link=\"SEATURTLE\">Orehull</link>"
msgstr "<link=\"SEATURTLE\">Cascóreo</link>"

#. STRINGS.CREATURES.SPECIES.SEAURCHIN.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAURCHIN.DESC"
msgid ""
"Pinpoki grow in <link=\"URCHINPLANT\">Pinpokets</link>.\n"
"\n"
"They can be harvested for <link=\"URCHINMEAT\">Uni</link> and <link=\"DIAMOND\">Diamond</link>."
msgstr ""
"Ouriços crescem em <link=\"URCHINPLANT\">Ouriçeiras</link>.\n"
"\n"
"Podem ser colhidos para obter <link=\"URCHINMEAT\">Uni</link> e <link=\"DIAMOND\">Diamante</link>."

#. STRINGS.CREATURES.SPECIES.SEAURCHIN.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SEAURCHIN.DOMESTICATEDDESC"
msgid "This plant produces <link=\"URCHINMEAT\">Uni</link>."
msgstr "Esta planta produz <link=\"URCHINMEAT\">Uni</link>."

#. STRINGS.CREATURES.SPECIES.SEAURCHIN.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAURCHIN.NAME"
msgid "<link=\"URCHIN\">Pinpoki</link>"
msgstr "<link=\"URCHIN\">Ouriço</link>"

#. STRINGS.CREATURES.SPECIES.SEEDS.BASICFABRICMATERIALPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SEEDS.BASICFABRICMATERIALPLANT.DESC"
msgid ""
"The <link=\"PLANTS\">Seed</link> of a <link=\"BASICFABRICPLANT\">Thimble Reed</link>.\n"
"\n"
"Digging up Buried Objects may uncover a Thimble Reed Seed."
msgstr ""
"A <link=\"PLANTS\">Semente</link> de um <link=\"BASICFABRICPLANT\">Junco</link>.\n"
"\n"
"Escavar objetos enterrados pode revelar uma Semente de Junco."

#. STRINGS.CREATURES.SPECIES.SEEDS.BASICFABRICMATERIALPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEEDS.BASICFABRICMATERIALPLANT.NAME"
msgid "<link=\"BASICFABRICPLANT\">Thimble Reed Seed</link>"
msgstr "<link=\"BASICFABRICPLANT\">Semente de Junco</link>"

#. STRINGS.CREATURES.SPECIES.SEEDS.BASICSINGLEHARVESTPLANT.DESC
