"<link=\"COLDWHEATSEED\">Grão de Trigo Boreal</link> estourado em um <link=\"GAMMARAYOVEN\">Forno de Raios Gama</link>.\n"
"\n"
"Totalmente desprovido de qualquer sabor especial."

#. STRINGS.ITEMS.FOOD.POPCORN.NAME
msgctxt "STRINGS.ITEMS.FOOD.POPCORN.NAME"
msgid "<link=\"POPCORN\">Popcorn</link>"
msgstr "<link=\"POPCORN\">Pipoca</link>"

#. STRINGS.ITEMS.FOOD.POPCORN.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.POPCORN.RECIPEDESC"
msgid "Gamma-radiated <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>."
msgstr "<link=\"COLDWHEATSEED\">Grão de Trigo Boreal</link> irradiado por raios gama."

