#. STRINGS.DUPLICANTS.MODEL.BIONIC.DESC
msgctxt "STRINGS.DUPLICANTS.MODEL.BIONIC.DESC"
msgid ""
"Bionic Duplicants run on <link=\"ELECTROBANK\">Power Banks</link>, <link=\"LUBRICATINGOIL\">Gear Oil</link> and unbridled "
"enthusiasm.\n"
"\n"
"They should not be permitted to use standard <link=\"MISCELLANEOUSTIPS\">Toilets</link>."
msgstr ""
"Duplicantes Biônicos funcionam com <link=\"ELECTROBANK\">Baterias Biônicas</link>, <link=\"LUBRICATINGOIL\">Óleo de "
"Engrenagem</link> e entusiasmo desenfreado.\n"
"\n"
"Eles não devem ser autorizados a usar um <link=\"MISCELLANEOUSTIPS\">Vaso Sanitário</link> padrão."

#. STRINGS.DUPLICANTS.MODEL.BIONIC.NAME
msgctxt "STRINGS.DUPLICANTS.MODEL.BIONIC.NAME"
