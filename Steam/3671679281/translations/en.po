msgstr "energy to/from this battery"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.GRID_END_TO_BATTERY"
msgstr "energy to this battery"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.GRID_END_FROM_BATTERY"
msgstr "energy from this battery"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.GRID_END_NEEDED_BATTERY"
msgstr "for this battery to be needed"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.GRID_BOTH_PREFIX"
msgstr "both {State}"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.POWER_WORD"
