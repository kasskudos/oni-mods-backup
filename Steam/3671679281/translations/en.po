msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.CONNECTION_BATTERY_ONLINE"
msgstr "Battery is connected to the {Grid}."

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.CONNECTION_BATTERY_OFFLINE"
msgstr "Battery is disconnected and non-operational.\n\nBuild either a <b>{Receiver}</b> or <b>{Sender}</b> to make this battery operational."

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.CHANNEL_EXPLAIN"
