msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.RECEIVING"
msgstr "Receiving"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.SENDING_RECEIVING"
msgstr "Sending & Receiving"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.CONNECTION_SENDER_ONLINE"
msgstr "Sender is connected to the {Grid}."

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.CONNECTION_SENDER_OFFLINE"
msgstr "Sender is disconnected and non-operational.\n\nBuild a <b>{Battery}</b> to make this sender operational."

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.CONNECTION_RECEIVER_ONLINE"
msgstr "Receiver is connected to the {Grid}."

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.CONNECTION_RECEIVER_OFFLINE"
