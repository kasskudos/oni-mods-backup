msgstr "Online"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.OFFLINE"
msgstr "Offline"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.STANDBY"
msgstr "Standby"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.NA"
