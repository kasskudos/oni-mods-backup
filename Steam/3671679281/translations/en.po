msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.TITLE"
msgstr "Wireless Channel Configuration"

msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.CHANNELLABEL.NAME"
msgstr "Channel:"

msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.CHANNELLABEL.TOOLTIP"
msgstr "Select a channel for this device to operate on the Wireless Power Grid."

msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.TRANSFERLABEL.NAME"
msgstr "Transfer Amount:"

msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.TRANSFERLABEL.TOOLTIP"
msgstr "Select how much Power is transfered to/from the Wireless Power Grid."

msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.WIRELESSTHRESHOLDLABEL.NAME"
msgstr "Grid Transfer Threshold:"

msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.WIRELESSTHRESHOLDLABEL.TOOLTIP"
msgstr "Select the percentage needed to refill/take from the Wireless Batteries on the connected Wireless Power Grid."

msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.INTERNALTHRESHOLDLABEL.NAME"
msgstr "Battery Refill Threshold:"

msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.INTERNALTHRESHOLDLABEL.TOOLTIP"
msgstr "Select the percentage to refill batteries to on this receiver's current power curcuit."

msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.SENDER_TITLE"
msgstr "Sender Configuration"

msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.RECEIVER_TITLE"
msgstr "Receiver Configuration"

msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.BATTERYTHRESHOLDLABEL.NAME"
msgstr "Battery Threshold:"

msgid "STRINGS.UI.UISIDESCREENS.WIRELESSPOWER.BATTERYTHRESHOLDLABEL.TOOLTIP"
msgstr "Target battery refill threshold on the local power circuit."

msgid "STRINGS.BUILDINGS.PREFABS.WIRELESSPOWERSENDER.NAME"
msgstr "Wireless Sender"

msgid "STRINGS.BUILDINGS.PREFABS.WIRELESSPOWERSENDER.DESC"
msgstr "Wireless Senders have many states of operation outlined below:\n\n<b>Online:</b> Denoted by green, this state indicates the building is connected and sending power.\n\n<b>Standby:</b> Denoted by yellow, this state indicates the building is connected and awaiting power transfer (all connected batteries are full).\n\n<b>Offline:</b> Denoted by red, this indicates the building is disconnected from the wirless grid (no wireless batteries exist on the specified channel)."

msgid "STRINGS.BUILDINGS.PREFABS.WIRELESSPOWERSENDER.EFFECT"
msgstr "Sends Power to wireless batteries on the same channel of the Wireless Power Grid.\n\nPower is sent from the current circuit in the amount specified."

msgid "STRINGS.BUILDINGS.PREFABS.WIRELESSPOWERRECEIVER.NAME"
msgstr "Wireless Receiver"

msgid "STRINGS.BUILDINGS.PREFABS.WIRELESSPOWERRECEIVER.DESC"
msgstr "Wireless Receivers have many states of operation outlined below:\n\n<b>Online:</b> Denoted by green, this state indicates the building is connected and receiving power.\n\n<b>Standby:</b> Denoted by yellow, this state indicates the building is connected and awaiting power transfer. This occurs when either all wireless batteries on the specified channel are empty or all batteries on the connected circuit are at their capacity thresholds.\n\n<b>Offline:</b> Denoted by red, this indicates the building is disconnected from the wirless grid (no wireless batteries exist on the specified channel)."

msgid "STRINGS.BUILDINGS.PREFABS.WIRELESSPOWERRECEIVER.EFFECT"
msgstr "Fetches Power from wireless batteries on the Wireless Power Grid.\n\nInputs the specified amount of power into the connected circuit."

msgid "STRINGS.BUILDINGS.PREFABS.WIRELESSPOWERBATTERY.NAME"
msgstr "Wireless Battery"

msgid "STRINGS.BUILDINGS.PREFABS.WIRELESSPOWERBATTERY.DESC"
msgstr "Wireless Batteries have many states of operation outlined below:\n\n<b>Online:</b> Denoted by green, this state indicates the building is connected and is actively sending or receiving power.\n\n<b>Standby:</b> Denoted by yellow, this state indicates the building is connected and awaiting power transfer.\n\n<b>Offline:</b> Denoted by red, this indicates the building is disconnected from the wirless grid (no wireless senders/receivers exist on the specified channel)."

msgid "STRINGS.BUILDINGS.PREFABS.WIRELESSPOWERBATTERY.EFFECT"
msgstr "Stores Power for later access on the Wireless Power Grid.\n\nLoses power over time."

