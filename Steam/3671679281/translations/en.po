msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.GRIDSTATUS.NAME"
msgstr "Grid Status: {Status}"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.GRIDSTATUS.TOOLTIP"
