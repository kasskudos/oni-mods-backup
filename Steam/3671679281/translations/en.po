msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.TRANSFER_SENDER_ONLINE"
msgstr "Sender is beaming {Amount} of {Power}{FalloffPhrase} to the {Grid}."

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.TRANSFER_SENDER_OFFLINE"
msgstr "Sender is non-operational.\n\nOnce operational: it will send {Amount} of {Power}{FalloffPhrase} from the {Grid}."

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.TRANSFER_RECEIVER_ONLINE"
msgstr "Receiver is drawing {Amount} of {Power}{FalloffPhrase} from the {Grid}."

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.TRANSFER_RECEIVER_OFFLINE"
msgstr "Receiver is non-operational.\n\nOnce operational: it will draw {Amount} of {Power}{FalloffPhrase} from the {Grid}."

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.DYNAMIC.TRANSFER_FALLOFF_PHRASE"
