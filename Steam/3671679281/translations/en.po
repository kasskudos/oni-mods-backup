msgstr "{Status}"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.TRANSFER.TOOLTIP"
msgstr "{Explanation}"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.BATTERYCAPACITY.NAME"
msgstr "Battery Power Available: {Available} / {Capacity}  {Percentage}"

msgid "STRINGS.BUILDING.STATUSITEMS.WIRELESSPOWER.BATTERYCAPACITY.TOOLTIP"
