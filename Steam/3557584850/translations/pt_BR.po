msgstr "<link=\"STORAGEPODB\">Pod de stockage marron</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.STORAGEPOD.FACADES.STORAGEPOD_C.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.STORAGEPOD.FACADES.STORAGEPOD_C.DESC"
