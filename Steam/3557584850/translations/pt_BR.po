#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.AIO_MOSAICTILE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.AIO_MOSAICTILE.DESC"
msgid "A fine tile made from glazed stones."
msgstr "Um lindo azulejo feito de pedras esmaltadas."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.AIO_MOSAICTILE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.AIO_MOSAICTILE.EFFECT"
msgid "Used as floor and wall tile to build rooms.\n\nSignificantly increases Duplicant runspeed."
msgstr ""
"Usado como piso e revestimento para construção de ambientes.\n"
"\n"
"Aumenta significativamente a velocidade de execução do Duplicante."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.AIO_MOSAICTILE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.AIO_MOSAICTILE.NAME"
msgid "<link=\"AIOMOSAICTILE\">Mosaic Tile</link>"
msgstr "<link=\"AIOMOSAICTILE\">Ladrilho de Mosaico</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.AIO_WOODENDOOR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.AIO_WOODENDOOR.DESC"
msgid "Be careful with splinters!"
msgstr "Cuidado com as farpas!"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.AIO_WOODENDOOR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.AIO_WOODENDOOR.EFFECT"
msgid "A pretty wooden door that encloses areas without blocking Liquid or Gas flow. Sets Duplicant Access Permissions for area restriction."
msgstr ""
"Uma atraente porta de madeira que fecha áreas sem bloquear o fluxo de "
"líquidos ou gases. Define permissões de acesso duplicadas para restrição de "
"zona."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.AIO_WOODENDOOR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.AIO_WOODENDOOR.NAME"
msgid "<link=\"AIOWOODENDOOR\">Wooden Door</link>"
msgstr "<link=\"AIOWOODENDOOR\">Porta de Madeira</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.ALGAEVAT.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.ALGAEVAT.DESC"
msgid "An advanced biological vat that grows algae. Due to the controlled atmospheric condition, this algae formation produces oxygen more efficiently than the standard terrarium. This unit also uses advanced filter to extract Carbon Dioxide from its surroundings, albeit its not necessary for it to function."
msgstr ""
"Um tanque biológico avançado para o cultivo de algas. Graças às condições "
"atmosféricas controladas, esta formação de algas produz oxigénio de forma "
"mais eficiente do que um terrário padrão. Este dispositivo também utiliza um"
" filtro avançado para extrair dióxido de carbono do seu entorno, embora isso"
" não seja essencial para o seu funcionamento."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.ALGAEVAT.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.ALGAEVAT.EFFECT"
msgid "Algae patch needs <link=\"WATER\">Water</link> to grow, producing a fair amount of clean <link=\"OXYGEN\">Oxygen</link> as result of its biological functions. Excess water is expelled in the form of <link=\"DIRTYWATER\">Polluted Water</link>."
msgstr "A colônia de algas precisa de <link=\"WATER\">Água</link> para crescer, produzindo uma boa quantidade de <link=\"OXYGEN\">Oxigênio</link> limpo como resultado de suas funções biológicas. O excesso de água é expelido na forma de <link=\"DIRTYWATER\">Água Poluída</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.ALGAEVAT.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.ALGAEVAT.NAME"
msgid "<link=\"ALGAEVAT\">Algae Vat</link>"
msgstr "<link=\"ALGAEVAT\">Tanque de Algas</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_ALGAEGROWINGBASIN.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_ALGAEGROWINGBASIN.DESC"
msgid "A wide, automated biological tank design to grow organic masses of algae."
msgstr ""
"Um projeto de tanque biológico grande e automatizado para o cultivo de "
"massas orgânicas de algas."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_ALGAEGROWINGBASIN.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_ALGAEGROWINGBASIN.EFFECT"
msgid "Grows <link=\"ALGAE\">Algae</link> using a constant supply of  <link=\"LIQUIDVEGEOIL\">Vegetable Oil</link> that serves as serves as nourishment for the photosynthetic organisms within.\nRequires <link=\"LIGHT\">Light</link> and a strict control of <link=\"HEAT\">Temperature</link> as to provide proper environment for the production."
msgstr "Cultiva <link=\"ALGAE\">Algas</link> usando um suprimento constante de <link=\"LIQUIDVEGEOIL\">Óleo Vegetal</link> que serve de alimento para os organismos fotossintéticos em seu interior.\nRequer <link=\"LIGHT\">Luz</link> e um controle rigoroso da <link=\"HEAT\">Temperatura</link> para fornecer o ambiente adequado à produção."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_ALGAEGROWINGBASIN.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_ALGAEGROWINGBASIN.NAME"
msgid "<link=\"BIOCHEMISTRYALGAEGROWINGBASIN\">Algae Growing Basin</link>"
msgstr "<link=\"BIOCHEMISTRYALGAEGROWINGBASIN\">Bacia de Cultivo de Algas</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_ANAEROBICDIGESTER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_ANAEROBICDIGESTER.DESC"
msgid "Anaerobic digestion is processes by which microorganisms break down biodegradable organic materials in the absence of oxygen."
msgstr ""
"A digestão anaeróbica é um processo pelo qual microrganismos decompõem "
"materiais orgânicos biodegradáveis ​​na ausência de oxigênio."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_ANAEROBICDIGESTER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_ANAEROBICDIGESTER.EFFECT"
msgid "Breaks down most basic <link=\"FOOD\">Food</link> stored within to  <link=\"METHANE\">Natural Gas</link>\nThe amount produced depends of the ingredient choosen."
msgstr "Decompõe a maioria dos <link=\"FOOD\">Alimentos</link> básicos armazenados em <link=\"METHANE\">Gás Natural</link>\nA quantidade produzida depende do ingrediente escolhido."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_ANAEROBICDIGESTER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_ANAEROBICDIGESTER.NAME"
msgid "<link=\"BIOCHEMISTRYANAEROBICDIGESTER\">Anaerobic Digester</link>"
msgstr "<link=\"BIOCHEMISTRYANAEROBICDIGESTER\">Digestor Anaeróbico</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIODIESELGENERATOR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIODIESELGENERATOR.DESC"
msgid "An advanced power generator that uses biofuel. Has a built-in scrubber system that allows it to produce no gaseous exhaust."
msgstr ""
"Um gerador de energia avançado que utiliza biocombustível. Possui um sistema"
" de purificação integrado que permite não produzir gases de exaustão."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIODIESELGENERATOR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIODIESELGENERATOR.EFFECT"
msgid "Converts <link=\"LIQUIDBIODIESEL\">Renewable Diesel</link> into electrical <link=\"POWER\">Power</link>.\n\nProduces only <link=\"DIRTYWATER\">Polluted Water</link>."
msgstr "Converte <link=\"LIQUIDBIODIESEL\">Diesel Renovável</link> em <link=\"POWER\">Energia</link> elétrica.\n\nProduz apenas <link=\"DIRTYWATER\">Água Poluída</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIODIESELGENERATOR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIODIESELGENERATOR.NAME"
msgid "<link=\"BIOCHEMISTRYBIODIESELGENERATOR\">Eco Diesel Generator</link>"
msgstr "<link=\"BIOCHEMISTRYBIODIESELGENERATOR\">Gerador de Diesel Ecológico</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIODIESELREFINERY.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIODIESELREFINERY.DESC"
msgid "A refinery capable of transesterification of organic oils into a mix of mono-alkyl esters of long chain fatty acids."
msgstr ""
"Refinaria capaz de transesterificar óleos orgânicos em uma mistura de "
"ésteres monoalquílicos de ácidos graxos de cadeia longa."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIODIESELREFINERY.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIODIESELREFINERY.EFFECT"
msgid "Transesterify <link=\"LIQUIDBIODIESEL\">Renewable Diesel</link> from <link=\"LIQUIDVEGEOIL\">Vegetable Oil</link> and <link=\"ETHANOL\">Ethanol</link>."
msgstr ""
"Transesterifique <link=\"LIQUIDBIODIESEL\">Diesel Renovável</link> de "
"<link=\"LIQUIDVEGEOIL\">Óleo Vegetal</link> e "
"<link=\"ETHANOL\">Etanol</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIODIESELREFINERY.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIODIESELREFINERY.NAME"
msgid "<link=\"BIOCHEMISTRYBIODIESELREFINERY\">Biodiesel Refinery</link>"
msgstr "<link=\"BIOCHEMISTRYBIODIESELREFINERY\">Refinaria de Biodiesel</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIOPLASTICPRINTER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIOPLASTICPRINTER.DESC"
msgid "A device that uses organic oil and bacterial enzymes to print small sheets of lipid derived biopolymers which are compressed in to a solid block."
msgstr ""
"Um dispositivo que utiliza óleo orgânico e enzimas bacterianas para imprimir"
" pequenas folhas de biopolímeros derivados de lipídios que são comprimidos "
"em um bloco sólido."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIOPLASTICPRINTER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIOPLASTICPRINTER.EFFECT"
msgid "Synthesizes <link=\"BIOPLASTIC\">Bioplastic</link> from <link=\"PHYTOOIL\">Phyto Oil</link> and <link=\"CARBONDIOXIDE\">Carbon Dioxide</link>.\nThe enzymes requires a microbial medium in the form of <link=\"MUSHBAR\">Mush Bar</link>."
msgstr ""
"Sintetiza <link=\"BIOPLASTIC\">Bioplástico</link> de <link=\"PHYTOOIL\">Óleo Fito</link> e <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link>.\n"
"As enzimas requerem um meio microbiano na forma de <link=\"MUSHBAR\">Barra de Papa</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIOPLASTICPRINTER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_BIOPLASTICPRINTER.NAME"
msgid "<link=\"BIOCHEMISTRYBIOPLASTICPRINTER\">Bioplastic Printer</link>"
msgstr "<link=\"BIOCHEMISTRYBIOPLASTICPRINTER\">Impressora de Bioplástico</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_EXPELLERPRESS.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_EXPELLERPRESS.DESC"
msgid "A mechanical device built to extract oil from raw materials. The raw materials are squeezed under high pressure through a caged barrel-like cavity."
msgstr ""
"Dispositivo mecânico projetado para extrair óleo de matérias-primas. Estes "
"são comprimidos sob alta pressão através de uma cavidade em forma de barril."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_EXPELLERPRESS.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_EXPELLERPRESS.EFFECT"
msgid "Extract <link=\"LIQUIDVEGEOIL\">Vegetable Oil</link> from raw food ingredients. The amount of oil, and the solid waste in the form of <link=\"SOLIDBIOMASS\">Compressed Biomass</link> depend of the ingredient choosen.\nCan be diluted with water to produce <link=\"PHYTOOIL\">Óleo Fito</link>"
msgstr ""
"Extraia <link=\"LIQUIDVEGEOIL\">Óleo Vegetal</link> de ingredientes alimentares crus. A quantidade de óleo e os resíduos sólidos na forma de <link=\"SOLIDBIOMASS\">Biomassa Comprimida</link> dependem do ingrediente escolhido.\n"
"Pode ser diluído com água para produzir <link=\"PHYTOOIL\">Óleo Fito</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_EXPELLERPRESS.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_EXPELLERPRESS.NAME"
msgid "<link=\"BIOCHEMISTRYEXPELLERPRESS\">Expeller Press</link>"
msgstr "<link=\"BIOCHEMISTRYEXPELLERPRESS\">Prensa Expulsora</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_SYNTHESIZERPHYTOOIL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_SYNTHESIZERPHYTOOIL.DESC"
msgid "A simple device capable of producing high-quality phyto oil."
msgstr "Um dispositivo simples capaz de produzir fitoóleo de alta qualidade."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_SYNTHESIZERPHYTOOIL.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_SYNTHESIZERPHYTOOIL.EFFECT"
msgid "Produces <link=\"PHYTOOIL\">Phyto Oil</link> by diluting <link=\"LIQUIDVEGEOIL\">Vegetable Oil</link> with <link=\"WATER\">Water</link>."
msgstr ""
"Produz <link=\"PHYTOOIL\">Óleo Fito</link> diluindo "
"<link=\"LIQUIDVEGEOIL\">Óleo Vegetal</link> com "
"<link=\"WATER\">Água</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_SYNTHESIZERPHYTOOIL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.BIOCHEMISTRY_SYNTHESIZERPHYTOOIL.NAME"
msgid "<link=\"BIOCHEMISTRYSYNTHESIZERPHYTOOIL\">Phyto Oil Mixer</link>"
msgstr "<link=\"BIOCHEMISTRYSYNTHESIZERPHYTOOIL\">Misturador de Óleo Fito</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CABINETFROZEN.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CABINETFROZEN.DESC"
msgid "Store solids and other industrial materials at a constant temperature moderation."
msgstr ""
"Armazene sólidos e outros materiais industriais a uma temperatura constante "
"e moderada."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CABINETFROZEN.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CABINETFROZEN.EFFECT"
msgid "Store the <link=\"ELEMENTSSOLID\">Solid Materials</link> of your choosing.\n\nConsumes <link=\"POWER\">Power</link> to cool the contents down to 24°C.\n\nCannot store any liquefiable solids.\nTakes items from conveyor rails based on its filters."
msgstr "Armazena os <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> de sua escolha.\n\nConsome <link=\"POWER\">Energia</link> para resfriar o conteúdo a 24°C.\n\nNão pode armazenar sólidos liquefazíveis.\nRetira itens dos trilhos transportadores conforme seus filtros."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CABINETFROZEN.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CABINETFROZEN.NAME"
msgid "<link=\"CABINETFROZEN\">Refrigerated Storage Cabinet</link>"
msgstr "<link=\"CABINETFROZEN\">Armário de Armazenamento Refrigerado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CABINETNORMAL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CABINETNORMAL.DESC"
msgid "Store solids and other industrial materials at a constant temperature moderation."
msgstr ""
"Armazene sólidos e outros materiais industriais a uma temperatura constante "
"e moderada."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CABINETNORMAL.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CABINETNORMAL.EFFECT"
msgid "Store the <link=\"ELEMENTSSOLID\">Solid Materials</link> of your choosing.\nThe cabinet prevents temperature exchange with the environment, as well gas leakage.\nTakes items from conveyor rails based on its filters."
msgstr "Armazena os <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> de sua escolha.\nO armário evita a troca de temperatura com o ambiente, bem como o vazamento de gases.\nRetira itens dos trilhos transportadores conforme seus filtros."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CABINETNORMAL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CABINETNORMAL.NAME"
msgid "<link=\"CABINETNORMAL\">Insulated Storage Cabinet</link>"
msgstr "<link=\"CABINETNORMAL\">Armário de Armazenamento Isolado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CEMENTMIXER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CEMENTMIXER.DESC"
msgid "Cement is a quite old building material, but still pretty much useful."
msgstr ""
"O cimento é um material de construção bastante antigo, mas ainda muito útil."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CEMENTMIXER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CEMENTMIXER.EFFECT"
msgid "A device that can homogeneously combine several solid and liquid ingredients used in the production of cement."
msgstr ""
"Dispositivo capaz de combinar homogeneamente diversos ingredientes sólidos e"
" líquidos utilizados na produção de cimento."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CEMENTMIXER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CEMENTMIXER.NAME"
msgid "<link=\"CEMENTMIXER\">Cement Mixer</link>"
msgstr "<link=\"CEMENTMIXER\">Betoneira</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ADVANCEDKILN.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ADVANCEDKILN.DESC"
msgid "Address a wide range of industrial and chemical applications."
msgstr "Aborde uma ampla gama de aplicações industriais e químicas."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ADVANCEDKILN.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ADVANCEDKILN.EFFECT"
msgid "An advanced insulated electrical kiln in which the heat is applied by induction heating of metal.\nThe advantage of the induction kiln is a clean, energy-efficient and well-controllable heating process compared to most other means of fuel heating."
msgstr ""
"Um forno elétrico isolado avançado no qual o calor é aplicado por aquecimento por indução do metal.\n"
"A vantagem do forno de indução é um processo de aquecimento limpo, energeticamente eficiente e bem controlável em comparação com a maioria dos outros meios de aquecimento de combustível."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ADVANCEDKILN.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ADVANCEDKILN.NAME"
msgid "<link=\"CHEMICALADVANCEDKILN\">Advanced Kiln</link>"
msgstr "<link=\"CHEMICALADVANCEDKILN\">Forno Avançado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ADVANCEDMETALREFINERY.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ADVANCEDMETALREFINERY.DESC"
msgid "An improved refinery capable of bulk smelting process, as well exclusive metal production."
msgstr ""
"Uma refinaria atualizada, capaz de realizar um processo de fundição em "
"massa, além de produção exclusiva de metal."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ADVANCEDMETALREFINERY.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ADVANCEDMETALREFINERY.EFFECT"
msgid "An advanced method for production of <link=\"REFINEDMETAL\">Refined Metals</link> from raw <link=\"RAWMETAL\">Metal Ore</link>.\n\nSignificantly <link=\"HEAT\">Heats</link> and strongly prefers <link=\"SUPERCOOLANT\">Super Coolant</link> piped into it.\n\nUsing other coolants will cause the refinery to operate at reduced speeds.\n\nDuplicants will not fabricate items unless recipes are queued."
msgstr "Um método avançado para a produção de <link=\"REFINEDMETAL\">Metais Refinados</link> a partir de <link=\"RAWMETAL\">Minério Metálico</link> bruto.\n\n<link=\"HEAT\">Aquece</link> significativamente e usa exclusivamente <link=\"SUPERCOOLANT\">Superrefrigerante</link> canalizado para dentro dela.\n\nOs Duplicantes não fabricarão itens a menos que as receitas estejam na fila."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ADVANCEDMETALREFINERY.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ADVANCEDMETALREFINERY.NAME"
msgid "<link=\"CHEMICALADVANCEDMETALREFINERY\">Advanced Metal Refinery</link>"
msgstr ""
"<link=\"CHEMICALADVANCEDMETALREFINERY\">Fundição de Metais Avançada</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AIO_CHLORINEPUMP.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AIO_CHLORINEPUMP.DESC"
msgid "A fancy pump capable to detect Chlorine Gas and pump it."
msgstr "Uma bomba sofisticada capaz de detectar gás cloro e bombeá-lo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AIO_CHLORINEPUMP.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AIO_CHLORINEPUMP.EFFECT"
msgid "Automatically detects trace of <link=\"CHLORINEGAS\">Chlorine Gas</link> and extract it out of the surroudings."
msgstr ""
"Detecta automaticamente vestígios de <link=\"CHLORINEGAS\">Gás Cloro</link> "
"e extrai-os do ambiente."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AIO_CHLORINEPUMP.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AIO_CHLORINEPUMP.NAME"
msgid "<link=\"CHEMICALAIOCHLORINEPUMP\">Chlorine Gas Filter</link>"
msgstr "<link=\"CHEMICALAIOCHLORINEPUMP\">Filtro de Gás Cloro</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AMMONIABREAKER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AMMONIABREAKER.DESC"
msgid "An advanced catalytic cracking furnace which the ammonia synthesis reaction is reversed at elevated temperatures."
msgstr ""
"Um forno de craqueamento catalítico avançado no qual a reação de síntese de "
"amônia é revertida em temperaturas elevadas."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AMMONIABREAKER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AMMONIABREAKER.EFFECT"
msgid "Break down <link=\"AMMONIAGAS\">Ammonia</link> into <link=\"HYDROGEN\">Hydrogen</link> and <link=\"NITROGENGAS\">Nitrogen</link> using <link=\"IRON\">Iron</link> as catalyst. \nThe cracking process exudes a lot of heat.\n\nIMPORTANT: The building require all pipes ports to be connected with their respective pipes in order for it to operate."
msgstr "Decompõe <link=\"AMMONIAGAS\">Amônia</link> em <link=\"HYDROGEN\">Hidrogênio</link> e <link=\"NITROGENGAS\">Nitrogênio</link> usando <link=\"IRON\">Ferro</link> como catalisador. \nO processo de quebra libera muito calor.\n\nIMPORTANTE: A construção exige que todas as portas de canos estejam conectadas a seus respectivos canos para operar."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AMMONIABREAKER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AMMONIABREAKER.NAME"
msgid "<link=\"CHEMICALAMMONIABREAKER\">Ammonia Breaker</link>"
msgstr "<link=\"CHEMICALAMMONIABREAKER\">Descompostor de Amônia</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AMMONIACOMPRESSOR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AMMONIACOMPRESSOR.DESC"
msgid "An industrial grade rotatory compressor unit that criticaly increase the pressure of a gas by reducing its volume, while cooling it down until liquid state is reached."
msgstr ""
"Uma unidade de compressor rotativo de nível industrial que aumenta "
"criticamente a pressão de um gás, reduzindo seu volume, enquanto o resfria "
"até atingir o estado líquido."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AMMONIACOMPRESSOR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AMMONIACOMPRESSOR.EFFECT"
msgid "Compresses Ammonia gas and cool it down to liquid Ammonia. This device is also capable of storing liquid with complete insulation."
msgstr ""
"Ele comprime a amônia gasosa e a resfria para transformá-la em amônia "
"líquida. Este dispositivo também permite o armazenamento de líquidos com "
"isolamento completo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AMMONIACOMPRESSOR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_AMMONIACOMPRESSOR.NAME"
msgid "<link=\"CHEMICALAMMONIACOMPRESSOR\">Ammonia Compressor</link>"
msgstr "<link=\"CHEMICALAMMONIACOMPRESSOR\">Compressor de Amônia</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_BALLCRUSHERMILL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_BALLCRUSHERMILL.DESC"
msgid "A large sized industrial mill that crushes raw ores using steel balls and special mixture of acids. It is capable to process much more than the standard mill, as well as more efficient in the extraction of valuable minerals from the raw ore sludge."
msgstr "Um moinho industrial de grande porte que tritura minérios brutos usando esferas de aço e uma mistura especial de ácidos. É capaz de processar muito mais que o moinho padrão, além de ser mais eficiente na extração de minerais valiosos da lama de minério bruto."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_BALLCRUSHERMILL.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_BALLCRUSHERMILL.EFFECT"
msgid "Crush down <link=\"BUILDABLERAW\">Raw Minerals</link> in to useful materials and industrial ingredients."
msgstr ""
"Esmague <link=\"BUILDABLERAW\">Minerais Brutos</link> em materiais úteis e "
"ingredientes industriais."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_BALLCRUSHERMILL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_BALLCRUSHERMILL.NAME"
msgid "<link=\"CHEMICALBALLCRUSHERMILL\">Ball Crusher Mill (Chemical Washing)</link>"
msgstr ""
"<link=\"CHEMICALBALLCRUSHERMILL\">Moinho de Bolas (Lavagem Química)</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CARBONDIOXIDECOMPRESSOR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CARBONDIOXIDECOMPRESSOR.DESC"
msgid "An industrial grade rotatory compressor unit that criticaly increase the pressure of a gas by reducing its volume, while cooling it down until liquid state is reached."
msgstr ""
"Uma unidade de compressor rotativo de nível industrial que aumenta "
"criticamente a pressão de um gás, reduzindo seu volume, enquanto o resfria "
"até atingir o estado líquido."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CARBONDIOXIDECOMPRESSOR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CARBONDIOXIDECOMPRESSOR.EFFECT"
msgid "Compresses <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> gas and cool it down to<link=\"LIQUIDCARBONDIOXIDE\">Liquid Carbon Dioxide</link>. This device is also capable of storing liquid with complete insulation."
msgstr ""
"Ele comprime o gás <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link> e o "
"esfria até <link=\"LIQUIDCARBONDIOXIDE\">Dióxido de Carbono líquido</link>. "
"Este dispositivo também permite o armazenamento de líquidos com isolamento "
"completo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CARBONDIOXIDECOMPRESSOR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CARBONDIOXIDECOMPRESSOR.NAME"
msgid "<link=\"CHEMICALCARBONDIOXIDECOMPRESSOR\">Carbon Dioxide Compressor</link>"
msgstr ""
"<link=\"CHEMICALCARBONDIOXIDECOMPRESSOR\">Compressor de Dióxido de "
"Carbono</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2PUMP.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2PUMP.DESC"
msgid "A fancy pump capable to detect Carbon Dioxide and pump it."
msgstr ""
"Uma bomba sofisticada capaz de detectar dióxido de carbono e bombeá-lo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2PUMP.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2PUMP.EFFECT"
msgid "Automatically detects trace of <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and extract it out of the surroudings."
msgstr ""
"Detecta automaticamente vestígios de <link=\"CARBONDIOXIDE\">Dióxido de "
"Carbono</link> e os extrai do ambiente."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2PUMP.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2PUMP.NAME"
msgid "<link=\"CHEMICALCO2PUMP\">CO2 Filter</link>"
msgstr "<link=\"CHEMICALCO2PUMP\">Filtro de CO2</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLER.BASEGAME_RECIPE
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLER.BASEGAME_RECIPE"
msgid "Sabatier Reaction: \n <link=\"LIQUIDCARBONDIOXIDE\">Liquid Carbon Dioxide</link>, <link=\"HYDROGEN\">Hydrogen</link> and <link=\"IRON\">Iron</link> as catalyst. The Sabatier Reaction produce <link=\"WATER\">Water</link>, <link=\"METHANE\">Natural Gas</link> and <link=\"RUST\">Rust</link> as waste product.\n\nBosch Reaction: \n<link=\"CARBONDIOXIDE\">Carbon Dioxide</link>, <link=\"HYDROGEN\">Hydrogen</link> and <link=\"IRON\">Iron</link> as catalyst. The Bosch Reaction produce <link=\"STEAM\">Steam</link>, <link=\"FULLERENE\">Fullerene</link> and <link=\"RUST\">Rust</link> as waste product."
msgstr "Reação de Sabatier: \n <link=\"LIQUIDCARBONDIOXIDE\">Dióxido de Carbono Líquido</link>, <link=\"HYDROGEN\">Hidrogênio</link> e <link=\"IRON\">Ferro</link> como catalisador. A Reação de Sabatier produz <link=\"WATER\">Água</link>, <link=\"METHANE\">Gás Natural</link> e <link=\"RUST\">Ferrugem</link> como resíduo.\n\nReação de Bosch: \n<link=\"CARBONDIOXIDE\">Dióxido de Carbono</link>, <link=\"HYDROGEN\">Hidrogênio</link> e <link=\"IRON\">Ferro</link> como catalisador. A Reação de Bosch produz <link=\"STEAM\">Vapor</link>, <link=\"FULLERENE\">Fulereno</link> e <link=\"RUST\">Ferrugem</link> como resíduo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLER.DESC"
msgid "An autonomous chemical device capable of executing both Bosch and Sabatier Reactions based on the input conditions."
msgstr ""
"Um dispositivo químico independente capaz de executar reações Bosch e "
"Sabatier com base nas condições de entrada."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLER.EFFECT"
msgid "Sabatier Reaction: \n <link=\"LIQUIDCARBONDIOXIDE\">Liquid Carbon Dioxide</link>, <link=\"HYDROGEN\">Hydrogen</link> and <link=\"IRON\">Iron</link> as catalyst. The Sabatier Reaction produce <link=\"WATER\">Water</link>, <link=\"METHANE\">Natural Gas</link> and <link=\"RUST\">Rust</link> as waste product.\n\nBosch Reaction: \n<link=\"CARBONDIOXIDE\">Carbon Dioxide</link>, <link=\"HYDROGEN\">Hydrogen</link> and <link=\"IRON\">Iron</link> as catalyst. The Bosch Reaction produce <link=\"STEAM\">Steam</link>, <link=\"GRAPHITE\">Graphite</link> and <link=\"RUST\">Rust</link> as waste product."
msgstr "Reação de Sabatier: \n <link=\"LIQUIDCARBONDIOXIDE\">Dióxido de Carbono Líquido</link>, <link=\"HYDROGEN\">Hidrogênio</link> e <link=\"IRON\">Ferro</link> como catalisador. A Reação de Sabatier produz <link=\"WATER\">Água</link>, <link=\"METHANE\">Gás Natural</link> e <link=\"RUST\">Ferrugem</link> como resíduo.\n\nReação de Bosch: \n<link=\"CARBONDIOXIDE\">Dióxido de Carbono</link>, <link=\"HYDROGEN\">Hidrogênio</link> e <link=\"IRON\">Ferro</link> como catalisador. A Reação de Bosch produz <link=\"STEAM\">Vapor</link>, <link=\"GRAPHITE\">Grafite</link> e <link=\"RUST\">Ferrugem</link> como resíduo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLER.NAME"
msgid "<link=\"CHEMICALCO2RECYCLER\">Carbon Recycling Unit</link>"
msgstr "<link=\"CHEMICALCO2RECYCLER\">Unidade de Reciclagem de Carbono</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLER.SPACEDOUT_RECIPE
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLER.SPACEDOUT_RECIPE"
msgid "Sabatier Reaction: \n <link=\"LIQUIDCARBONDIOXIDE\">Liquid Carbon Dioxide</link>, <link=\"HYDROGEN\">Hydrogen</link> and <link=\"IRON\">Iron</link> as catalyst. The Sabatier Reaction produce <link=\"WATER\">Water</link>, <link=\"METHANE\">Natural Gas</link> and <link=\"RUST\">Rust</link> as waste product.\n\nBosch Reaction: \n<link=\"CARBONDIOXIDE\">Carbon Dioxide</link>, <link=\"HYDROGEN\">Hydrogen</link> and <link=\"IRON\">Iron</link> as catalyst. The Bosch Reaction produce <link=\"STEAM\">Steam</link>, <link=\"GRAPHITE\">Graphite</link> and <link=\"RUST\">Rust</link> as waste product."
msgstr "Reação de Sabatier: \n <link=\"LIQUIDCARBONDIOXIDE\">Dióxido de Carbono Líquido</link>, <link=\"HYDROGEN\">Hidrogênio</link> e <link=\"IRON\">Ferro</link> como catalisador. A Reação de Sabatier produz <link=\"WATER\">Água</link>, <link=\"METHANE\">Gás Natural</link> e <link=\"RUST\">Ferrugem</link> como resíduo.\n\nReação de Bosch: \n<link=\"CARBONDIOXIDE\">Dióxido de Carbono</link>, <link=\"HYDROGEN\">Hidrogênio</link> e <link=\"IRON\">Ferro</link> como catalisador. A Reação de Bosch produz <link=\"STEAM\">Vapor</link>, <link=\"GRAPHITE\">Grafite</link> e <link=\"RUST\">Ferrugem</link> como resíduo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLERDLC1.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLERDLC1.DESC"
msgid "An autonomous chemical device capable of executing both Bosch and Sabatier Reactions based on the input conditions."
msgstr ""
"Um dispositivo químico independente capaz de executar reações Bosch e "
"Sabatier com base nas condições de entrada."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLERDLC1.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLERDLC1.EFFECT"
msgid "THIS BUILDING HAS BEEN DEPRECATED AND CANNOT BE BUILT. INSTEAD, USE THE REGULAR <link=\"CHEMICALCO2RECYCLER\">Carbon Recycling Unit</link>\n\nSabatier Reaction: \n <link=\"LIQUIDCARBONDIOXIDE\">Liquid Carbon Dioxide</link>, <link=\"HYDROGEN\">Hydrogen</link> and <link=\"IRON\">Iron</link> as catalyst. The Sabatier Reaction produce <link=\"WATER\">Water</link>, <link=\"METHANE\">Natural Gas</link> and <link=\"RUST\">Rust</link> as waste product.\n\nBosch Reaction: \n<link=\"CARBONDIOXIDE\">Carbon Dioxide</link>, <link=\"HYDROGEN\">Hydrogen</link> and <link=\"IRON\">Iron</link> as catalyst. The Bosch Reaction produce <link=\"STEAM\">Steam</link>, <link=\"GRAPHITE\">Graphite</link> and <link=\"RUST\">Rust</link> as waste product."
msgstr "ESTA CONSTRUÇÃO ESTÁ OBSOLETA E NÃO PODE SER CONSTRUÍDA. USE A <link=\"CHEMICALCO2RECYCLER\">Unidade de Reciclagem de Carbono</link>\n\nReação de Sabatier: \n <link=\"LIQUIDCARBONDIOXIDE\">Dióxido de Carbono Líquido</link>, <link=\"HYDROGEN\">Hidrogênio</link> e <link=\"IRON\">Ferro</link> como catalisador. A Reação de Sabatier produz <link=\"WATER\">Água</link>, <link=\"METHANE\">Gás Natural</link> e <link=\"RUST\">Ferrugem</link> como resíduo.\n\nReação de Bosch: \n<link=\"CARBONDIOXIDE\">Dióxido de Carbono</link>, <link=\"HYDROGEN\">Hidrogênio</link> e <link=\"IRON\">Ferro</link> como catalisador. A Reação de Bosch produz <link=\"STEAM\">Vapor</link>, <link=\"GRAPHITE\">Grafite</link> e <link=\"RUST\">Ferrugem</link> como resíduo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLERDLC1.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CO2RECYCLERDLC1.NAME"
msgid "<link=\"CHEMICALCO2RECYCLERDLC1\">[DEPRECATED] SpacedOut Carbon Recycling Unit</link>"
msgstr ""
"<link=\"CHEMICALCO2RECYCLERDLC1\">[OBSOLETE] Unidade de Reciclagem de "
"Carbono SpacedOut</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_COAL_BOILER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_COAL_BOILER.DESC"
msgid "An industrial grade boiler that generates thermal energy by burning solid fossil fuels."
msgstr ""
"Uma caldeira de nível industrial que gera energia térmica através da queima "
"de combustíveis fósseis sólidos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_COAL_BOILER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_COAL_BOILER.EFFECT"
msgid "Boils <link=\"WATER\">Water</link> to <link=\"STEAM\">Steam</link> at 200 °C.\nThis particular boiler uses <link=\"COMBUSTIBLESOLID\">Combustustable Solids</link> as fuel."
msgstr "Ferve <link=\"WATER\">Água</link> em <link=\"STEAM\">Vapor</link> a 200 °C.\nEsta caldeira específica usa <link=\"COMBUSTIBLESOLID\">Sólidos Combustíveis</link> como combustível."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_COAL_BOILER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_COAL_BOILER.NAME"
msgid "<link=\"CHEMICALCOALBOILER\">Carbon fueled Steam Boiler</link>"
msgstr "<link=\"CHEMICALCOALBOILER\">Caldeira a Vapor a Carvão</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CRUDEOILREFINERY.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CRUDEOILREFINERY.DESC"
msgid "An industrial process plant responsible for refining raw oil extracted from wells."
msgstr ""
"Planta de processamento industrial responsável pelo refino do petróleo bruto"
" extraído de poços."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CRUDEOILREFINERY.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CRUDEOILREFINERY.EFFECT"
msgid "This refinement plant is capable of the following production from <link=\"CRUDEOIL\">Crude Oil</link>: \n- 50% <link=\"PETROLEUM\">Petroleum</link>\n- 25% <link=\"NAPHTHA\">Naphtha</link>\n- 10% <link=\"METHANE\">Natural Gas</link>\n- 10% <link=\"SOURWATER\">Sour Water</link> waste.\n- 5% <link=\"BITUMEN\">Bitumen</link> waste.\n\nThe process requires <link=\"STEAM\">Steam</link> for the operation.\n\nIMPORTANT: The building require all pipes ports to be connected with their respective pipes in order for it to operate."
msgstr "Esta planta de refino é capaz da seguinte produção a partir de <link=\"CRUDEOIL\">Petróleo Bruto</link>: \n- 50% <link=\"PETROLEUM\">Petróleo</link>\n- 25% <link=\"NAPHTHA\">Nafta</link>\n- 10% <link=\"METHANE\">Gás Natural</link>\n- 10% de <link=\"SOURWATER\">Água Ácida</link> como resíduo.\n- 5% de <link=\"BITUMEN\">Betume</link> como resíduo.\n\nO processo requer <link=\"STEAM\">Vapor</link> para a operação.\n\nIMPORTANTE: A construção exige que todas as portas de canos estejam conectadas a seus respectivos canos para operar."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CRUDEOILREFINERY.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CRUDEOILREFINERY.NAME"
msgid "<link=\"CHEMICALCRUDEOILREFINERY\">Crude Oil Refinery</link>"
msgstr "<link=\"CHEMICALCRUDEOILREFINERY\">Refinaria de Petróleo Bruto</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CRUDEOILREFINERYSTAGED.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CRUDEOILREFINERYSTAGED.DESC"
msgid "An industrial process plant responsible for refining raw oil extracted from wells."
msgstr ""
"Planta de processamento industrial responsável pelo refino do petróleo bruto"
" extraído de poços."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CRUDEOILREFINERYSTAGED.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CRUDEOILREFINERYSTAGED.EFFECT"
msgid "The refinery has two stages: \n\nFirst Stage: <link=\"CRUDEOIL\">Crude Oil</link> is first refined to:\n- 50% <link=\"PETROLEUM\">Petroleum</link>\n- 25% <link=\"NAPHTHA\">Naphtha</link>\n- 10% <link=\"METHANE\">Natural Gas</link>\n- 10% <link=\"SOURWATER\">Sour Water</link> waste.\n- 5% <link=\"BITUMEN\">Bitumen</link>.\n\nSecond Stage: <link=\"NAPHTHA\">Naphtha</link> is further refined:\n- 45% <link=\"PETROLEUM\">Petroleum</link>\n- 10% <link=\"METHANE\">Natural Gas</link>\n- 45% <link=\"BITUMEN\">Bitumen</link>.\n\nThe first stage uses <link=\"STEAM\">Steam</link> for the distillation process, while the second Stage uses <link=\"HYDROGEN\">Hydrogen</link> to buffer the reaction."
msgstr "A refinaria possui dois estágios: \n\nPrimeiro Estágio: o <link=\"CRUDEOIL\">Petróleo Bruto</link> é primeiro refinado em:\n- 50% <link=\"PETROLEUM\">Petróleo</link>\n- 25% <link=\"NAPHTHA\">Nafta</link>\n- 10% <link=\"METHANE\">Gás Natural</link>\n- 10% de <link=\"SOURWATER\">Água Ácida</link> como resíduo.\n- 5% <link=\"BITUMEN\">Betume</link>.\n\nSegundo Estágio: a <link=\"NAPHTHA\">Nafta</link> é refinada ainda mais:\n- 45% <link=\"PETROLEUM\">Petróleo</link>\n- 10% <link=\"METHANE\">Gás Natural</link>\n- 45% <link=\"BITUMEN\">Betume</link>.\n\nO primeiro estágio usa <link=\"STEAM\">Vapor</link> para o processo de destilação, enquanto o segundo estágio usa <link=\"HYDROGEN\">Hidrogênio</link> para amortecer a reação."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CRUDEOILREFINERYSTAGED.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_CRUDEOILREFINERYSTAGED.NAME"
msgid "<link=\"CHEMICALCRUDEOILREFINERYSTAGED\">Multi-Stage Crude Oil Refinery</link>"
msgstr "<link=\"CHEMICALCRUDEOILREFINERYSTAGED\">Refinaria de Petróleo Bruto Multi-Estágio</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ELECTRICBOILER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ELECTRICBOILER.DESC"
msgid "A small sized eletric boiler."
msgstr "Uma pequena caldeira elétrica."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ELECTRICBOILER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ELECTRICBOILER.EFFECT"
msgid "Boils <link=\"WATER\">Water</link> to <link=\"STEAM\">Steam</link> at 120°C. This particular boiler uses electricity."
msgstr "Ferve <link=\"WATER\">Água</link> em <link=\"STEAM\">Vapor</link> a 120°C. Esta caldeira específica usa eletricidade."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ELECTRICBOILER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ELECTRICBOILER.NAME"
msgid "<link=\"CHEMICALELECTRICBOILER\">Electric Steam Boiler</link>"
msgstr "<link=\"CHEMICALELECTRICBOILER\">Caldeira Elétrica a Vapor</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ENDOTHERMICUNIT.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ENDOTHERMICUNIT.DESC"
msgid "A device that uses endothermical chemical reaction to cool itself and its surroundings."
msgstr ""
"Um dispositivo que utiliza uma reação química endotérmica para resfriar a si"
" mesmo e ao ambiente."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ENDOTHERMICUNIT.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ENDOTHERMICUNIT.EFFECT"
msgid "Creates an endothermical reaction from a mixture of <link=\"AMMONIUMSALT\">Nitrate Nodules</link> and <link=\"WATER\">Water</link>. \nOutputs <link=\"AMMONIUMWATER\">Ammonium Water</link> as result."
msgstr "Cria uma reação endotérmica a partir de uma mistura de <link=\"AMMONIUMSALT\">Nódulos de Nitrato</link> e <link=\"WATER\">Água</link>. \nProduz <link=\"AMMONIUMWATER\">Água de Amônio</link> como resultado."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ENDOTHERMICUNIT.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_ENDOTHERMICUNIT.NAME"
msgid "<link=\"CHEMICALENDOTHERMICUNIT\">Endothermic Unit</link>"
msgstr "<link=\"CHEMICALENDOTHERMICUNIT\">Unidade Endotérmica</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_GAS_BOILER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_GAS_BOILER.DESC"
msgid "An industrial grade boiler that generates thermal energy by burning Combustible Gases."
msgstr ""
"Caldeira de nível industrial que gera energia térmica pela queima de gases "
"combustíveis."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_GAS_BOILER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_GAS_BOILER.EFFECT"
msgid "Boils <link=\"WATER\">Water</link> to <link=\"STEAM\">Steam</link> at 200 °C. This particular boiler uses <link=\"COMBUSTIBLEGAS\">Combustible Gases</link> as fuel."
msgstr "Ferve <link=\"WATER\">Água</link> em <link=\"STEAM\">Vapor</link> a 200 °C. Esta caldeira específica usa <link=\"COMBUSTIBLEGAS\">Gases Combustíveis</link> como combustível."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_GAS_BOILER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_GAS_BOILER.NAME"
msgid "<link=\"CHEMICALGASBOILER\">Gas-fueled Steam Boiler</link>"
msgstr "<link=\"CHEMICALGASBOILER\">Caldeira a Vapor a Gás</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_GLASSFOUNDRY.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_GLASSFOUNDRY.DESC"
msgid "Glass can be used to construct window tiles."
msgstr "O vidro pode ser usado para construir azulejos de janela."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_GLASSFOUNDRY.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_GLASSFOUNDRY.EFFECT"
msgid "This technologically advanced glass foundry has a wide range of other applications beyond simply melting <link=\"SAND\">Sand</link> into <link=\"MOLTENGLASS\">Molten Glass</link>."
msgstr ""
"Esta fundição de vidro tecnologicamente avançada tem uma ampla gama de "
"outras aplicações além da simples fusão de <link=\"SAND\">Areia</link> em "
"<link=\"MOLTENGLASS\">Vidro Fundido</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_GLASSFOUNDRY.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_GLASSFOUNDRY.NAME"
msgid "<link=\"CHEMICALGLASSFOUNDRY\">Glass Foundry</link>"
msgstr "<link=\"CHEMICALGLASSFOUNDRY\">Fundição de Vidro</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_LIQUID_BOILER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_LIQUID_BOILER.DESC"
msgid "An industrial grade boiler that generates thermal energy by burning Combustible Liquids."
msgstr ""
"Caldeira de nível industrial que gera energia térmica pela queima de "
"Líquidos Combustíveis."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_LIQUID_BOILER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_LIQUID_BOILER.EFFECT"
msgid "Boils <link=\"WATER\">Water</link> to <link=\"STEAM\">Steam</link> at 200 °C. This particular boiler uses <link=\"COMBUSTIBLELIQUID\">Combustible Liquids</link> as fuel."
msgstr "Ferve <link=\"WATER\">Água</link> em <link=\"STEAM\">Vapor</link> a 200 °C. Esta caldeira específica usa <link=\"COMBUSTIBLELIQUID\">Líquidos Combustíveis</link> como combustível."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_LIQUID_BOILER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_LIQUID_BOILER.NAME"
msgid "<link=\"CHEMICALGASBOILER\">Liquid-fueled Steam Boiler</link>"
msgstr "<link=\"CHEMICALGASBOILER\">Caldeira a Vapor a Combustível Líquido</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_MIXINGUNIT.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_MIXINGUNIT.DESC"
msgid "This chemical fabricator has several functions in petrochemical industry."
msgstr ""
"Este fabricante de produtos químicos desempenha diversas funções na "
"indústria petroquímica."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_MIXINGUNIT.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_MIXINGUNIT.EFFECT"
msgid "An industrial aparatus capable to address several chemical reactions. Its large array of pipes allows safe handling of dangerous liquids and gases."
msgstr ""
"Um dispositivo industrial capaz de lidar com múltiplas reações químicas. Sua"
" grande rede de tubulações permite o manuseio seguro de líquidos e gases "
"perigosos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_MIXINGUNIT.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_MIXINGUNIT.NAME"
msgid "<link=\"CHEMICALMIXINGUNIT\">Chemical Mixing Unit</link>"
msgstr "<link=\"CHEMICALMIXINGUNIT\">Unidade de Mistura Química</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_NAPHTHAREFORMER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_NAPHTHAREFORMER.DESC"
msgid "An industrial petrochemical plant responsible for rearranging hydrocarbon molecules of Naphtha in to Petroleum."
msgstr ""
"Uma planta industrial petroquímica responsável por reorganizar as moléculas "
"de hidrocarbonetos da nafta em petróleo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_NAPHTHAREFORMER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_NAPHTHAREFORMER.EFFECT"
msgid "This second stage refinement plant is capable of further refining <link=\"NAPHTHA\">Naphtha</link>:\n- 45% <link=\"PETROLEUM\">Petroleum</link>\n- 10% <link=\"METHANE\">Natural Gas</link>\n- 45% <link=\"BITUMEN\">Bitumen</link>.\n\nThe process requires <link=\"HYDROGEN\">Hydrogen</link> to buffer the reaction.\nIMPORTANT: The building require all pipes ports to be connected with their respective pipes in order for it to operate.\nCan be constructed above refinery buildings with vertical structure beams"
msgstr "Esta planta de refino de segundo estágio é capaz de refinar ainda mais a <link=\"NAPHTHA\">Nafta</link>:\n- 45% <link=\"PETROLEUM\">Petróleo</link>\n- 10% <link=\"METHANE\">Gás Natural</link>\n- 45% <link=\"BITUMEN\">Betume</link>.\n\nO processo requer <link=\"HYDROGEN\">Hidrogênio</link> para amortecer a reação.\nIMPORTANTE: A construção exige que todas as portas de canos estejam conectadas a seus respectivos canos para operar.\nPode ser construída acima de construções de refinaria com vigas de estrutura vertical"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_NAPHTHAREFORMER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_NAPHTHAREFORMER.NAME"
msgid "<link=\"CHEMICALNAPHTHAREFORMER\">Naphtha Reformer</link>"
msgstr "<link=\"CHEMICALNAPHTHAREFORMER\">Reformador de Nafta</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_PROPANEREFORMER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_PROPANEREFORMER.DESC"
msgid "An industrial petrochemical plant responsible for oxidative steam reforming process of Propane to Hydrogen."
msgstr ""
"Uma planta industrial petroquímica responsável pelo processo de reforma "
"oxidativa a vapor do propano em hidrogênio."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_PROPANEREFORMER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_PROPANEREFORMER.EFFECT"
msgid "Reforming process of <link=\"PROPANE\">Propane</link> in to:\n- 60% <link=\"HYDROGEN\">Hydrogen</link>\n- 30% <link=\"DIRTYWATER\">Polluted Water</link> waste\n- 10% <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> waste\nThe process require <link=\"STEAM\">Steam</link> for the operation.\n\nIMPORTANT: The building require all pipes ports to be connected with their respective pipes in order for it to operate.\nCan be constructed above refinery buildings with vertical structure beams"
msgstr ""
"Processo de reforma de <link=\"PROPANE\">Propano</link> em:\n"
"- 60% <link=\"HYDROGEN\">Hidrogênio</link>\n"
"- 30% <link=\"DIRTYWATER\">Água Poluída</link> desperdício\n"
"- 10% <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link> desperdício\n"
"O processo requer <link=\"STEAM\">Vapor</link> para a operação.\n"
"\n"
"IMPORTANTE: O edifício exige que todas as portas das tubulações estejam conectadas às suas respectivas tubulações para que possa funcionar.\n"
"Pode ser construído acima de edifícios de refinaria com vigas estruturais verticais"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_PROPANEREFORMER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_PROPANEREFORMER.NAME"
msgid "<link=\"CHEMICALPROPANEREFORMER\">Propane Reformer</link>"
msgstr "<link=\"CHEMICALPROPANEREFORMER\">Reformador de Propano</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAWGASREFINERY.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAWGASREFINERY.DESC"
msgid "An industrial process plant responsible for refining the impure raw natural gas extracted from wells."
msgstr ""
"Uma planta de processamento industrial responsável pelo refino de gás "
"natural bruto impuro extraído de poços."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAWGASREFINERY.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAWGASREFINERY.EFFECT"
msgid "This refinement plant is capable of the following production: \n - 50% <link=\"METHANE\">Natural Gas</link>\n- 35% <link=\"PROPANE\">Propane</link>\n- 15% <link=\"SOURWATER\">Sour Water</link> waste\nThe process requires <link=\"STEAM\">Steam</link> for the operation.\n\nIMPORTANT: The building require all pipes ports to be connected with their respective pipes in order for it to operate."
msgstr "Esta planta de refino é capaz da seguinte produção: \n - 50% <link=\"METHANE\">Gás Natural</link>\n- 35% <link=\"PROPANE\">Propano</link>\n- 15% de <link=\"SOURWATER\">Água Ácida</link> como resíduo\nO processo requer <link=\"STEAM\">Vapor</link> para a operação.\n\nIMPORTANTE: A construção exige que todas as portas de canos estejam conectadas a seus respectivos canos para operar."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAWGASREFINERY.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAWGASREFINERY.NAME"
msgid "<link=\"CHEMICALRAWGASREFINERY\">Raw Gas Refinery</link>"
msgstr "<link=\"CHEMICALRAWGASREFINERY\">Refinaria de Gás Bruto</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAWGASREFINERYSTAGED.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAWGASREFINERYSTAGED.DESC"
msgid "An industrial process plant responsible for refining the impure raw natural gas extracted from wells."
msgstr ""
"Uma planta de processamento industrial responsável pelo refino de gás "
"natural bruto impuro extraído de poços."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAWGASREFINERYSTAGED.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAWGASREFINERYSTAGED.EFFECT"
msgid "The refinery has three stages:\n\nFirst Stage: Raw Natural Gas is first refined to: \n- 33% <link=\"METHANE\">Natural Gas</link>\n- 27% <link=\"PROPANE\">Propane</link>\n- 40% <link=\"SOURGAS\">Sour Gas</link>\nSecond Stage: <link=\"PROPANE\">Propane</link> is mixed with <link=\"HYDROGEN\">Hydrogen</link> resulting in a complete conversion to <link=\"METHANE\">Methane</link>\nThird Stage reacts the remaining <link=\"SOURGAS\">Sour Gas</link> with Nitric Acid, producing Ammonia Gas."
msgstr "A refinaria possui três estágios:\n\nPrimeiro Estágio: o Gás Natural Bruto é primeiro refinado em: \n- 33% <link=\"METHANE\">Gás Natural</link>\n- 27% <link=\"PROPANE\">Propano</link>\n- 40% <link=\"SOURGAS\">Gás Ácido</link>\nSegundo Estágio: o <link=\"PROPANE\">Propano</link> é misturado com <link=\"HYDROGEN\">Hidrogênio</link>, resultando em uma conversão completa para <link=\"METHANE\">Gás Natural</link>\nTerceiro Estágio: reage o <link=\"SOURGAS\">Gás Ácido</link> restante com Ácido Nítrico, produzindo Gás Amônia."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAWGASREFINERYSTAGED.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAWGASREFINERYSTAGED.NAME"
msgid "<link=\"CHEMICALRAWGASREFINERYSTAGED\">Multi-Stage Raw Gas Refinery</link>"
msgstr "<link=\"CHEMICALRAWGASREFINERYSTAGED\">Refinaria de Gás Bruto em Várias Etapas</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAYONLOOM.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAYONLOOM.DESC"
msgid "A chemical loom capable of producing celulose fibers with Viscose process."
msgstr ""
"Tear químico capaz de produzir fibras de celulose pelo processo Viscose."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAYONLOOM.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAYONLOOM.EFFECT"
msgid "Produces <link=\"RAYONFIBER\">Rayon Fiber</link> from <link=\"WOOD\">Madeira</link> pulp through a complex chemical reaction. Requires <link=\"SYNGAS\">Synthetic Gas</link> and constantly outputs <link=\"STEAM\">Steam</link> while operational."
msgstr ""
"Produz <link=\"RAYONFIBER\">Fibra de Rayon</link> a partir de polpa de "
"<link=\"WOOD\">Madeira</link> através de uma reação química complexa. "
"Requer <link=\"SYNGAS\">Gás Sintético</link> e gera "
"<link=\"STEAM\">Vapor</link> constantemente enquanto estiver operacional."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAYONLOOM.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_RAYONLOOM.NAME"
msgid "<link=\"CHEMICALRAYONLOOM\">Rayon Loom</link>"
msgstr "<link=\"CHEMICALRAYONLOOM\">Tear de Raiom</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.DESC"
msgid "A specialized furnace that heats material by means of an electric arc. Its delicate heat control structure allows mixture of metal alloys, as well separating metals from an homogeneous mixture of scraps. Since the furnace electronics are air-cooled, it releases a lot of heat into its surroundings."
msgstr ""
"Forno especializado que aquece materiais por meio de arco elétrico. Sua "
"delicada estrutura de controle de calor permite a mistura de ligas "
"metálicas, bem como a separação de metais de uma mistura homogênea de "
"sucatas. Como a parte eletrônica do forno é resfriada a ar, ela libera muito"
" calor no ambiente."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.EFFECT"
msgid "Specialy designed to work with <link=\"REFINEDMETAL\">Refined Metals</link> and conduct the manufacturing of metal alloys.\n\nThe building has an insulated internal thermal capacitor that stores the heat produced in recipes.\nHeat from the capacitor is dispersed by heating the passing coolant until it is near its boiling point.\n\nIf the maximum heat capacity is exceeded, it will be rendered nonfunctional until all heat is dispersed again."
msgstr ""
"Especialmente projetado para trabalhar com <link=\"REFINEDMETAL\">Metais Refinados</link> e realizar a fabricação de ligas metálicas.\n"
"\n"
"O prédio possui um capacitor térmico interno isolado que armazena o calor produzido nas receitas.\n"
"O calor do capacitor é disperso aquecendo o refrigerante que passa até que esteja próximo do ponto de ebulição.\n"
"\n"
"Se a capacidade máxima de calor for excedida, ele ficará inoperante até que todo o calor seja novamente disperso."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.NAME"
msgid "<link=\"CHEMICALSELECTIVEARCFURNACE\">Selective Arc-Furnace</link>"
msgstr "<link=\"CHEMICALSELECTIVEARCFURNACE\">Forno a Arco Seletivo</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.REFINEMENT_HEAT_EXHAUST
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.REFINEMENT_HEAT_EXHAUST"
msgid "Refinement exhaust heat"
msgstr "Calor de exaustão de refinamento"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.REFINEMENT_HEAT_TOOLTIP
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.REFINEMENT_HEAT_TOOLTIP"
msgid "<style=\"produced\">{0}</style> of <style=\"KKeyword\">Heat</style> will be produced to cool off the fabricated item\n\nThis heat is then stored in the buildings thermal capacitor and transfered over to the coolant thats pumped through the building.\nCoolant near its boiling point will be prevented from boiling, but have reduced heat dispersion."
msgstr "<style=\"produced\">{0}</style> de <style=\"KKeyword\">Calor</style> será produzido para resfriar o item fabricado\n\nEsse calor é então armazenado no capacitor térmico da construção e transferido para o refrigerante bombeado através dela.\nO refrigerante próximo ao ponto de ebulição será impedido de ferver, mas terá dispersão de calor reduzida."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.REFINEMENT_HEAT_TOOLTIP_CONTINUOUS
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.REFINEMENT_HEAT_TOOLTIP_CONTINUOUS"
msgid "During refinement of this recipe, the machine will produce a total of <style=\"produced\">{0}</style> in additional refinement <style=\"KKeyword\">heat</style>.\nAt normal refinement speed, this amounts to {1} produced per second."
msgstr ""
"Durante o refinamento desta receita, a máquina produzirá um total de <style=\"produced\">{0}</style> em refinamento adicional <style=\"KKeyword\">calor</style>.\n"
"Na velocidade normal de refinamento, isso equivale a {1} produzidos por segundo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.REFINEMENT_SELF_HEAT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SELECTIVEARCFURNACE.REFINEMENT_SELF_HEAT"
msgid "Refinement heat"
msgstr "Calor de refinamento"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SMALLCRUSHERMILL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SMALLCRUSHERMILL.DESC"
msgid "A jaw crusher uses compressive force for breaking of stone and other raw minerals."
msgstr "Um britador de mandíbulas usa força compressiva para quebrar pedras e outros minerais brutos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SMALLCRUSHERMILL.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SMALLCRUSHERMILL.EFFECT"
msgid "Crush down <link=\"BUILDABLERAW\">Raw Minerals</link> in to useful materials and industrial ingredients."
msgstr ""
"Esmague <link=\"BUILDABLERAW\">Minerais Brutos</link> em materiais úteis e "
"ingredientes industriais."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SMALLCRUSHERMILL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SMALLCRUSHERMILL.NAME"
msgid "<link=\"CHEMICALSMALLCRUSHERMILL\">Jaw Crusher Mill</link>"
msgstr "<link=\"CHEMICALSMALLCRUSHERMILL\">Moinho de Mandíbulas</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOILMIXER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOILMIXER.DESC"
msgid "A mixer designed for uniform blending of a wide variety of solid materials, while treating them with chemicals."
msgstr ""
"Um misturador projetado para misturar uniformemente uma ampla variedade de "
"materiais sólidos, enquanto os trata com produtos químicos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOILMIXER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOILMIXER.EFFECT"
msgid "A solid material mixer designed for agricultural purpose, mainly for the production of <link=\"DIRT\">Dirt</link> and <link=\"FERTILIZER\">Fertilizer</link>."
msgstr "Um misturador de materiais sólidos projetado para fins agrícolas, principalmente para a produção de <link=\"DIRT\">Terra</link> e <link=\"FERTILIZER\">Fertilizante</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOILMIXER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOILMIXER.NAME"
msgid "<link=\"CHEMICALSOILMIXER\">Soil Mixer</link>"
msgstr "<link=\"CHEMICALSOILMIXER\">Misturador de Solo</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOURGASSWEETENER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOURGASSWEETENER.DESC"
msgid "A treatment plant that uses activated carbon beds for de-acidification of sour gas."
msgstr ""
"Uma estação de tratamento que utiliza leitos de carvão ativado para "
"desacidificação de gases ácidos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOURGASSWEETENER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOURGASSWEETENER.EFFECT"
msgid "Uses <link=\"REFINEDCARBON\">\"Activated Carbon\"</link> for the adsorbtion the sulphuric compounds from <link=\"SOURGAS\">Sour Gas</link>, yielding <link=\"METHANE\">Natural Gas</link> and elemental <link=\"SULPHUR\">Sulphur</link>.\nActivated carbon requires periodic replacing."
msgstr ""
"Usa <link=\"REFINEDCARBON\">\"Carbono Ativado\"</link> para a adsorção dos compostos sulfúricos de <link=\"SOURGAS\">Gás Ácido</link>, produzindo <link=\"METHANE\">Gás Natural</link> e elementar <link=\"SULPHUR\">Enxofre</link>.\n"
"O carvão ativado requer substituição periódica."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOURGASSWEETENER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOURGASSWEETENER.NAME"
msgid "<link=\"CHEMICALSOURGASSWEETENER\">Sour Gas Sweetener</link>"
msgstr "<link=\"CHEMICALSOURGASSWEETENER\">Adoçante de Gás Ácido</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOURWATERSTRIPPER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOURWATERSTRIPPER.DESC"
msgid "A heavy industrial device that uses a combination of pH control and heat, direct injection of steam to drives off the ammonia and hydrogen sulfide from the water. Also fitted with a filter mechanism to ensure the quality of the stripped water."
msgstr ""
"Um dispositivo industrial pesado que combina controle de pH, aquecimento e "
"injeção direta de vapor para remover amônia e sulfeto de hidrogênio da água."
" Também é equipado com mecanismo de filtração para garantir a qualidade da "
"água purificada."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOURWATERSTRIPPER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOURWATERSTRIPPER.EFFECT"
msgid "Separate clean <link=\"WATER\">Water</link> from <link=\"SOURWATER\">Sour Water</link> using hot <link=\"STEAM\">Steam</link>.\n The stripping process also produces <link=\"SOURGAS\">Sour Gas</link> from the separation.\n<link=\"SAND\">Sand</link> is required to further filter the water from any other contaminants it may still have, which is then released as  <link=\"TOXICSAND\">Polluted Dirt</link> afterwards.\nIMPORTANT: The building require all pipes ports to be connected with their respective pipes in order for it to operate."
msgstr "Separa <link=\"WATER\">Água</link> limpa da <link=\"SOURWATER\">Água Ácida</link> usando <link=\"STEAM\">Vapor</link> quente.\n O processo de separação também produz <link=\"SOURGAS\">Gás Ácido</link>.\n É necessária <link=\"SAND\">Areia</link> para filtrar ainda mais a água de quaisquer outros contaminantes que ela ainda possa ter, que depois é liberada como <link=\"TOXICSAND\">Terra Poluída</link>.\nIMPORTANTE: A construção exige que todas as portas de canos estejam conectadas a seus respectivos canos para operar."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOURWATERSTRIPPER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SOURWATERSTRIPPER.NAME"
msgid "<link=\"CHEMICALSOURWATERSTRIPPER\">Sour Water Stripper</link>"
msgstr "<link=\"CHEMICALSOURWATERSTRIPPER\">Removedor de Água Ácida</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNGASREFINERY.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNGASREFINERY.DESC"
msgid "A refinery capable of catalytic partial oxidation reactions to produce Syngas."
msgstr ""
"Uma refinaria capaz de reações catalíticas de oxidação parcial para produzir"
" gás de síntese."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNGASREFINERY.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNGASREFINERY.EFFECT"
msgid "Produce Synthetic Gas from a variety of Organic and Mineral materials."
msgstr "Produz Gás Sintético a partir de uma variedade de materiais orgânicos e minerais."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNGASREFINERY.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNGASREFINERY.NAME"
msgid "<link=\"CHEMICALSYNGASREFINERY\">Syngas Refinery</link>"
msgstr "<link=\"CHEMICALSYNGASREFINERY\">Refinaria de Gás de Síntese</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERNITRIC.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERNITRIC.DESC"
msgid "A chemical synthesizer device capable of producing Nitric Acid."
msgstr "Um dispositivo de síntese química capaz de produzir ácido nítrico."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERNITRIC.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERNITRIC.EFFECT"
msgid "Produces industrial grade <link=\"LIQUIDNITRIC\">Nitric Acid</link> via the selected chemical reaction, using either <link=\"LIQUIDSULFURIC\">Sulfuric Acid</link> or <link=\"AMMONIAGAS\">Ammonia</link>."
msgstr "Produz <link=\"LIQUIDNITRIC\">Ácido Nítrico</link> de grau industrial por meio da reação química selecionada, usando <link=\"LIQUIDSULFURIC\">Ácido Sulfúrico</link> ou <link=\"AMMONIAGAS\">Amônia</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERNITRIC.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERNITRIC.NAME"
msgid "<link=\"CHEMICALSYNTHESIZERNITRIC\">Nitric Acid Synthesizer</link>"
msgstr "<link=\"CHEMICALSYNTHESIZERNITRIC\">Sintetizador de Ácido Nítrico</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERSALTWATER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERSALTWATER.DESC"
msgid "A simple device capable of producing high-quality salt water."
msgstr ""
"Um dispositivo simples capaz de produzir água salgada de alta qualidade."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERSALTWATER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERSALTWATER.EFFECT"
msgid "Produces <link=\"SALTWATER\">Salt Water</link> using provided <link=\"WATER\">Water</link> and <link=\"SALT\">Salt</link>."
msgstr "Produz <link=\"SALTWATER\">Água Salgada</link> usando <link=\"WATER\">Água</link> e <link=\"SALT\">Sal</link> fornecidos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERSALTWATER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERSALTWATER.NAME"
msgid "<link=\"CHEMICALSYNTHESIZERSALTWATER\">Salt Water Mixer</link>"
msgstr "<link=\"CHEMICALSYNTHESIZERSALTWATER\">Misturador de Água Salgada</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERSULFURIC.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERSULFURIC.DESC"
msgid "A chemical synthesizer device capable of producing Sulfuric Acid."
msgstr "Um dispositivo de síntese química capaz de produzir ácido sulfúrico."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERSULFURIC.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERSULFURIC.EFFECT"
msgid "Produces industrial grade <link=\"LIQUIDSULFURIC\">Sulfuric Acid</link> using provided <link=\"STEAM\">Steam</link> and <link=\"SULFUR\">Sulfur</link>."
msgstr "Produz <link=\"LIQUIDSULFURIC\">Ácido Sulfúrico</link> de grau industrial usando <link=\"STEAM\">Vapor</link> e <link=\"SULFUR\">Enxofre</link> fornecidos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERSULFURIC.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_SYNTHESIZERSULFURIC.NAME"
msgid "<link=\"CHEMICALSYNTHESIZERSULFURIC\">Sulfuric Acid Synthesizer</link>"
msgstr "<link=\"CHEMICALSYNTHESIZERSULFURIC\">Sintetizador de Ácido Sulfúrico</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_THERMALDESALINATOR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_THERMALDESALINATOR.DESC"
msgid "A basic desalinator that uses Vapor-compression evaporation to archive the separation of clean, usable water from the solution it is currently mixed."
msgstr ""
"Um gerador de água básico que utiliza evaporação por compressão de vapor "
"para arquivar a separação da água limpa e utilizável da solução na qual está"
" atualmente misturada."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_THERMALDESALINATOR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_THERMALDESALINATOR.EFFECT"
msgid "Uses <link=\"STEAM\">Steam</link> as buffer for the Desalination process of either <link=\"SALTWATER\">Salt Water</link> or Ammonium Water, releasing fresh <link=\"WATER\">Water</link> and concentrated <link=\"BRINE\">Brine</link> in return."
msgstr "Usa <link=\"STEAM\">Vapor</link> como amortecedor para o processo de dessalinização de <link=\"SALTWATER\">Água Salgada</link> ou Água de Amônio, liberando <link=\"WATER\">Água</link> fresca e <link=\"BRINE\">Salmoura</link> concentrada em troca."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_THERMALDESALINATOR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_THERMALDESALINATOR.NAME"
msgid "<link=\"CHEMICALTHERMALDESALINATOR\">Thermal Desalinator</link>"
msgstr "<link=\"CHEMICALTHERMALDESALINATOR\">Dessalinizador Térmico</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_WOODEN_BOILER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_WOODEN_BOILER.DESC"
msgid "An industrial grade boiler that generates thermal energy by burning wood."
msgstr ""
"Caldeira de nível industrial que gera energia térmica a partir da queima de "
"madeira."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_WOODEN_BOILER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_WOODEN_BOILER.EFFECT"
msgid "Boils <link=\"WATER\">Water</link> to <link=\"STEAM\">Steam</link> at 200 °C. This particular boiler uses <link=\"WOODLOG\">Wood</link> as fuel."
msgstr "Ferve <link=\"WATER\">Água</link> em <link=\"STEAM\">Vapor</link> a 200 °C. Esta caldeira específica usa <link=\"WOODLOG\">Madeira</link> como combustível."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_WOODEN_BOILER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CHEMICAL_WOODEN_BOILER.NAME"
msgid "<link=\"CHEMICALWOODENBOILER\">Wood-fueled Steam Boiler</link>"
msgstr "<link=\"CHEMICALWOODENBOILER\">Caldeira a Vapor a Lenha</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CORALVAT.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CORALVAT.DESC"
msgid "An advanced biological vat that grows a special colony of marine invertebrates, engineered from the Earth species of the class Anthozoa. This unit also uses advanced filter to extract Chlorine Gas from its surroundings, albeit its not necessary for it to function."
msgstr ""
"Um tanque biológico avançado que cultiva uma colônia especial de "
"invertebrados marinhos, derivados de espécies terrestres da classe anthozoa."
" Esta unidade também utiliza um filtro avançado para extrair gás cloro do "
"ambiente, embora isso não seja essencial para o seu funcionamento."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CORALVAT.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CORALVAT.EFFECT"
msgid "Coral colony needs <link=\"SALTWATER\">Salt Water</link> or <link=\"BRINE\">Brine</link> to grow, producing a fair amount of clean <link=\"WATER\">Water</link> as result of its biological functions. The coral colony will also excreate tiny particles of <link=\"BLEACHSTONE\">Bleach Stone</link>, which are filtered from the water and later released as a solid mass."
msgstr "A colônia de coral precisa de <link=\"SALTWATER\">Água Salgada</link> ou <link=\"BRINE\">Salmoura</link> para crescer, produzindo uma boa quantidade de <link=\"WATER\">Água</link> limpa como resultado de suas funções biológicas. A colônia de coral também excreta partículas minúsculas de <link=\"BLEACHSTONE\">Pedra de Cloro</link>, que são filtradas da água e depois liberadas como uma massa sólida."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CORALVAT.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CORALVAT.NAME"
msgid "<link=\"CORALVAT\">Coral Vat</link>"
msgstr "<link=\"CORALVAT\">Cuba de Coral</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_METALREFINERY.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_METALREFINERY.DESC"
msgid "Metais refinados são necessários para construir tecnologias e eletrônicos avançados."
msgstr ""
"Metais refinados são necessários para construir eletrônicos e tecnologias "
"avançadas."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_METALREFINERY.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_METALREFINERY.EFFECT"
msgid "THIS BUILDING HAS BEEN DEPRECATED AND CANNOT BE BUILT. INSTEAD, USE THE REGULAR <link=\"METALREFINERY\">METAL REFINERY</link>\n\nProduz <link=\"REFINEDMETAL\">Metais Refinados</link> a partir de <link=\"RAWMETAL\">Minérios de Metal</link>.\n\n<link=\"HEAT\">Esquenta</link> bastante o <link=\"ELEMENTSLIQUID\">Líquido</link> recebido e o descarrega.\n\nDuplicantes não irão fabricar enquanto receitas não forem colocadas na fila."
msgstr ""
"ESTA CONSTRUÇÃO ESTÁ OBSOLETA E NÃO PODE SER CONSTRUÍDA. USE A <link=\"METALREFINERY\">Fundição de Metais</link>\n"
"\n"
"Produz <link=\"REFINEDMETAL\">Metais Refinados</link> a partir de <link=\"RAWMETAL\">Minérios de Metais</link>.\n"
"\n"
"Gera <link=\"HEAT\">Calor</link> e libera o <link=\"ELEMENTSLIQUID\">Líquido</link> canalizado.\n"
"\n"
"Duplicantes não fabricarão itens a menos que as receitas estejam na fila."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_METALREFINERY.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_METALREFINERY.NAME"
msgid "<link=\"CUSTOMMETALREFINERY\">[DEPRECATED] Custom Metal Refinery</link>"
msgstr ""
"<link=\"CUSTOMMETALREFINERY\">[OBSOLETO] Fundição de Metais "
"Personalizada</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_OILWELLCAP.ANY_WATER_DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_OILWELLCAP.ANY_WATER_DESC"
msgid "Extracts <link=\"CRUDEOIL\">Crude Oil</link> using any form of water.\n\nMust be built atop an <link=\"OILWELL\">Oil Reservoir</link>."
msgstr "Extrai <link=\"CRUDEOIL\">Petróleo Bruto</link> usando qualquer forma de água.\n\nDeve ser construído sobre um <link=\"OILWELL\">Reservatório de Petróleo</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_OILWELLCAP.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_OILWELLCAP.DESC"
msgid "A large device capable to extract oil from the attached well using liquid pumped in. Liquid pumped into an oil reservoir cannot be recovered."
msgstr ""
"Grande dispositivo capaz de extrair petróleo do poço adjacente utilizando o "
"líquido bombeado. O líquido bombeado para um tanque de óleo não pode ser "
"recuperado."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_OILWELLCAP.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_OILWELLCAP.EFFECT"
msgid "THIS BUILDING HAS BEEN DEPRECATED AND CANNOT BE BUILT. INSTEAD, USE THE REGULAR <link=\"OILWELLCAP\">Oil Well</link>\n\nExtracts <link=\"CRUDEOIL\">Crude Oil</link> using any form of water.\n\nMust be built atop an <link=\"OILWELL\">Oil Reservoir</link>."
msgstr "ESTA CONSTRUÇÃO ESTÁ OBSOLETA E NÃO PODE SER CONSTRUÍDA. USE O <link=\"OILWELLCAP\">Poço de Petróleo</link>\n\nExtrai <link=\"CRUDEOIL\">Petróleo Bruto</link> usando qualquer forma de água.\n\nDeve ser construído sobre um <link=\"OILWELL\">Reservatório de Petróleo</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_OILWELLCAP.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_OILWELLCAP.NAME"
msgid "<link=\"CUSTOMOILWELLCAP\">[DEPRECATED] Custom Oil Well Pump</link>"
msgstr ""
"<link=\"CUSTOMOILWELLCAP\">[OBSOLETO] Bomba de Poço de Petróleo "
"Personalizada</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_POLYMERIZER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_POLYMERIZER.DESC"
msgid "A custom polymerization press capable of producing polymer from Ethanol."
msgstr ""
"Uma prensa de polimerização personalizada capaz de produzir polímero a "
"partir de etanol."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_POLYMERIZER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_POLYMERIZER.EFFECT"
msgid "Special modifications allows the polymerization of <link=\"ETHANOL\">Ethanol</link> into raw <link=\"POLYPROPYLENE\">Plastic</link>with the addition of <link=\"CHLORINE\">Chlorine Gas</link>."
msgstr ""
"Modificações especiais permitem a polimerização de "
"<link=\"ETHANOL\">Etanol</link> em <link=\"POLYPROPYLENE\">Plástico</link> "
"bruto com a adição de <link=\"CHLORINE\">Gás Cloro</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_POLYMERIZER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOM_POLYMERIZER.NAME"
msgid "<link=\"CUSTOMPOLYMERIZER\">Ethanol Polymer Press</link>"
msgstr "<link=\"CUSTOMPOLYMERIZER\">Prensa de Polímero de Etanol</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMBRICKTILE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMBRICKTILE.DESC"
msgid "A notable tile made exclusively out of Bricks."
msgstr "Um notável azulejo feito exclusivamente de tijolos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMBRICKTILE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMBRICKTILE.EFFECT"
msgid "A smooth tile made with several bricks carefully placed together."
msgstr ""
"Um ladrilho liso feito de vários tijolos cuidadosamente colocados juntos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMBRICKTILE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMBRICKTILE.NAME"
msgid "<link=\"CUSTOMBRICKTILE\">Compacted Brick Tile</link>"
msgstr "<link=\"CUSTOMBRICKTILE\">Ladrilho de Tijolo Compactado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMGRANITETILE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMGRANITETILE.DESC"
msgid "Granite tiles are aesthetically pleasing while remaining a good insulator."
msgstr "As telhas de granito são estéticas, mas permanecem um bom isolante."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMGRANITETILE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMGRANITETILE.EFFECT"
msgid "A smooth tile made with several granite stones carefully placed together."
msgstr ""
"Ladrilho liso feito de diversas pedras de granito cuidadosamente colocadas "
"juntas."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMGRANITETILE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMGRANITETILE.NAME"
msgid "<link=\"CUSTOMGRANITETILE\">Compacted Granite Tile</link>"
msgstr "<link=\"CUSTOMGRANITETILE\">Ladrilho de Granito Compactado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMIGNEOUSROCKTILE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMIGNEOUSROCKTILE.DESC"
msgid "A notable tile made exclusively with Igneous Rock."
msgstr "Um notável azulejo feito exclusivamente com rocha ígnea."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMIGNEOUSROCKTILE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMIGNEOUSROCKTILE.EFFECT"
msgid "Igneous tiles enhance not only the environmental beauty, but also increases duplicants walking speed."
msgstr ""
"As telhas ígneas não só melhoram a beleza do ambiente, mas também aumentam a"
" velocidade de caminhada das duplicatas."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMIGNEOUSROCKTILE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMIGNEOUSROCKTILE.NAME"
msgid "<link=\"CUSTOMIGNEOUSROCKTILE\">Compacted Igneous Tile</link>"
msgstr "<link=\"CUSTOMIGNEOUSROCKTILE\">Ladrilho Ígneo Compactado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMMETHANEGENERATOR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMMETHANEGENERATOR.DESC"
msgid "A small, custom Combustible Gas generator. This rather versatile generator has piped outputs."
msgstr ""
"Um pequeno gerador de gás combustível pequeno. Versátil, é equipado "
"com saídas canalizadas."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMMETHANEGENERATOR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMMETHANEGENERATOR.EFFECT"
msgid "Converts <link=\"COMBUSTIBLEGAS\">Combustible Gas</link> into Power.\nThe waste products are either released into the world or inserted into pipes."
msgstr "Converte <link=\"COMBUSTIBLEGAS\">Gás Combustível</link> em Energia.\nOs resíduos são liberados no ambiente ou inseridos em canos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMMETHANEGENERATOR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMMETHANEGENERATOR.NAME"
msgid "<link=\"CUSTOMMETHANEGENERATOR\">Custom Gas Generator</link>"
msgstr "<link=\"CUSTOMMETHANEGENERATOR\">Gerador de Gás Pequeno</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMOBSIDIANTILE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMOBSIDIANTILE.DESC"
msgid "A notable tile made exclusively with Obsidian, a form of volcanic glass."
msgstr ""
"Um notável azulejo feito exclusivamente com obsidiana, uma forma de vidro "
"vulcânico."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMOBSIDIANTILE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMOBSIDIANTILE.EFFECT"
msgid "Obsidian tiles enhance not only the environmental beauty, but also increases duplicants walking speed."
msgstr ""
"As telhas de obsidiana não só realçam a beleza do ambiente, mas também "
"aumentam a velocidade de caminhada das duplicatas."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMOBSIDIANTILE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMOBSIDIANTILE.NAME"
msgid "<link=\"CUSTOMOBSIDIANTILE\">Compacted Obsidian Tile</link>"
msgstr "<link=\"CUSTOMOBSIDIANTILE\">Ladrilho de Obsidiana Compactado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMPETROLEUMGENERATOR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMPETROLEUMGENERATOR.DESC"
msgid "A small, custom Combustible Liquid generator. This rather versatile generator has piped outputs."
msgstr ""
"Um pequeno gerador de líquido combustível pequeno. Versátil, este "
"gerador possui saídas canalizadas."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMPETROLEUMGENERATOR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMPETROLEUMGENERATOR.EFFECT"
msgid "Converts <link=\"COMBUSTIBLELIQUID\">Combustable Fuel</link> into Power.\nThe waste products are either released into the world or inserted into pipes."
msgstr ""
"Converte <link=\"COMBUSTIBLELIQUID\">combustible</link> em energia.\n"
"Os resíduos são lançados no mundo ou inseridos em tubulações."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMPETROLEUMGENERATOR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMPETROLEUMGENERATOR.NAME"
msgid "<link=\"CUSTOMPETROLEUMGENERATOR\">Custom Combustion Generator</link>"
msgstr ""
"<link=\"CUSTOMPETROLEUMGENERATOR\">Gerador de Combustão Pequeno</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSANDSTONETILE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSANDSTONETILE.DESC"
msgid "A notable tile made exclusively with Sandstone."
msgstr "Um notável azulejo feito exclusivamente em grés."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSANDSTONETILE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSANDSTONETILE.EFFECT"
msgid "Sandstone tiles enhance not only the environmental beauty, but also increases duplicants walking speed."
msgstr ""
"As telhas de arenito não só melhoram a beleza do ambiente, mas também "
"aumentam a velocidade de caminhada dos duplicados."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSANDSTONETILE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSANDSTONETILE.NAME"
msgid "<link=\"CUSTOMSANDSTONETILE\">Compacted Sandstone Tile</link>"
msgstr "<link=\"CUSTOMSANDSTONETILE\">Ladrilho de Arenito Compactado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSOLARPANEL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSOLARPANEL.DESC"
msgid "Solar panels convert high intensity sunlight into power and produce zero waste."
msgstr ""
"Os painéis solares convertem a luz solar de alta intensidade em energia e "
"não produzem resíduos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSOLARPANEL.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSOLARPANEL.EFFECT"
msgid "Converts <link=\"LIGHT\">Sunlight</link> into electrical <link=\"POWER\">Power</link>.\n\nCan be rotated."
msgstr "Converte <link=\"LIGHT\">Luz Solar</link> em <link=\"POWER\">Energia</link> elétrica.\n\nPode ser rotacionado."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSOLARPANEL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSOLARPANEL.NAME"
msgid "<link=\"CUSTOMSOLARPANEL\">Custom Solar Panel</link>"
msgstr "<link=\"CUSTOMSOLARPANEL\">Painel Solar Pequeno</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSOLIDGENERATOR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSOLIDGENERATOR.DESC"
msgid "A small, custom Refined Carbon generator. This rather versatile generator has piped outputs."
msgstr ""
"Um pequeno gerador em carbono refinado. Versátil, este gerador"
" possui saídas canalizadas."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSOLIDGENERATOR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSOLIDGENERATOR.EFFECT"
msgid "Converts <link=\"REFINEDCARBON\">Refined Carbon</link> into Power.\nThe waste products are either released into the world or inserted into pipes."
msgstr ""
"Converte <link=\"REFINEDCARBON\">carbone raffiné</link> em energia.\n"
"Os resíduos são lançados no mundo ou inseridos em tubulações."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSOLIDGENERATOR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSOLIDGENERATOR.NAME"
msgid "<link=\"CUSTOMSOLIDGENERATOR\">Custom Carbon Generator</link>"
msgstr "<link=\"CUSTOMSOLIDGENERATOR\">Gerador de Carbono Pequeno</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSTEAMGENERATOR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSTEAMGENERATOR.DESC"
msgid "Useful for converting the geothermal energy into usable power."
msgstr "Útil para converter energia geotérmica em energia utilizável."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSTEAMGENERATOR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSTEAMGENERATOR.EFFECT"
msgid "Draws in <link=\"STEAM\">Steam</link> from the tiles directly below the machine's foundation and uses it to generate electrical <link=\"POWER\">Power</link>.\n\nOutputs <link=\"WATER\">Water</link>."
msgstr "Suga <link=\"STEAM\">Vapor</link> dos ladrilhos diretamente abaixo da base da máquina e o usa para gerar <link=\"POWER\">Energia</link> elétrica.\n\nProduz <link=\"WATER\">Água</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSTEAMGENERATOR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.CUSTOMSTEAMGENERATOR.NAME"
msgid "<link=\"CUSTOMSTEAMGENERATOR\">Custom Steam Turbine</link>"
msgstr "<link=\"CUSTOMSTEAMGENERATOR\">Turbina a Vapor Pequeno</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.DECOMPRESSIONGASVALVE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.DECOMPRESSIONGASVALVE.DESC"
msgid "A mechanical valve capable of reducing the flow of gas from a pressurized pipe to a normal pipe, avoiding it to break."
msgstr ""
"Válvula mecânica capaz de reduzir o fluxo de gás de uma tubulação "
"pressurizada para uma tubulação normal, evitando assim sua ruptura."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.DECOMPRESSIONGASVALVE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.DECOMPRESSIONGASVALVE.EFFECT"
msgid "Allows <link=\"ELEMENTSGAS\">Gases</link> to be transfered from <link=\"HIGHPRESSUREGASCONDUIT\">High Pressure Gas Pipe</link> to normal <link=\"GASCONDUIT\">Pipes</link>."
msgstr ""
"Permite transferir <link=\"ELEMENTSGAS\">Gás</link> de "
"<link=\"HIGHPRESSUREGASCONDUIT\">Conduto de Gás de Alta Pressão</link> para "
"<link=\"GASCONDUIT\">Tubos</link> normal."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.DECOMPRESSIONGASVALVE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.DECOMPRESSIONGASVALVE.NAME"
msgid "<link=\"DECOMPRESSIONGASVALVE\">Decompression Gas Valve</link>"
msgstr "<link=\"DECOMPRESSIONGASVALVE\">Válvula de Descompressão de Gás</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.DECOMPRESSIONLIQUIDVALVE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.DECOMPRESSIONLIQUIDVALVE.DESC"
msgid "A mechanical valve capable of reducing the flow of liquid from a pressurized pipe to a normal pipe, avoiding it to break."
msgstr ""
"Válvula mecânica capaz de reduzir o fluxo de líquido de um tubo de pressão "
"para um tubo normal, evitando assim a sua ruptura."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.DECOMPRESSIONLIQUIDVALVE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.DECOMPRESSIONLIQUIDVALVE.EFFECT"
msgid "Allows <link=\"ELEMENTSLIQUID\">Liquid</link> to be transfered from <link=\"HIGHPRESSURELIQUIDCONDUIT\">High Pressure Liquid Pipe</link> to normal <link=\"LIQUIDCONDUIT\">Pipes</link>."
msgstr ""
"Permite transferir <link=\"ELEMENTSLIQUID\">líquido</link> de "
"<link=\"HIGHPRESSURELIQUIDCONDUIT\">Conduto de Líquido de Alta "
"Pressão</link> para <link=\"LIQUIDCONDUIT\">Tubos</link> normal."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.DECOMPRESSIONLIQUIDVALVE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.DECOMPRESSIONLIQUIDVALVE.NAME"
msgid "<link=\"DECOMPRESSIONLIQUIDVALVE\">Decompression Liquid Valve</link>"
msgstr ""
"<link=\"DECOMPRESSIONLIQUIDVALVE\">Válvula de Descompressão de "
"Líquido</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.ETHANOLSTILL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.ETHANOLSTILL.DESC"
msgid "A solid metal still capable of distillation by selective temperature."
msgstr "Um alambique de metal sólido capaz de destilação por temperatura seletiva."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.ETHANOLSTILL.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.ETHANOLSTILL.EFFECT"
msgid "Distills <link=\"ETHANOL\">Ethanol</link> from a fermented mixture of <link=\"SUCROSE\">Sucrose</link> and <link=\"WATER\">Water</link>. The fermenting process occurs with <link=\"SLIMEMOLD\">Slime</link> bacterias by the degradation of organic nutrients anaerobically."
msgstr "Destila <link=\"ETHANOL\">Etanol</link> a partir de uma mistura fermentada de <link=\"SUCROSE\">Sacarose</link> e <link=\"WATER\">Água</link>. O processo de fermentação ocorre com bactérias de <link=\"SLIMEMOLD\">Limo</link> pela degradação anaeróbica de nutrientes orgânicos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.ETHANOLSTILL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.ETHANOLSTILL.NAME"
msgid "<link=\"ETHANOLSTILL\">Ethanol Stil</link>"
msgstr "<link=\"ETHANOLSTILL\">Alambique de Etanol</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.FLOCCULATIONSIEVE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.FLOCCULATIONSIEVE.DESC"
msgid "A dedicated industrial sieve that flocculates colloidal particles out of suspension to sediment under the form of floc. Strong filter media further improves the cleaning process of liquids."
msgstr ""
"Uma peneira industrial dedicada que flocula partículas coloidais suspensas "
"para transformá-las em sedimentos na forma de flocos. O meio filtrante "
"robusto melhora ainda mais o processo de limpeza de líquidos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.FLOCCULATIONSIEVE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.FLOCCULATIONSIEVE.EFFECT"
msgid "Treat <link=\"DIRTYWATER\">Polluted Water</link> or <link=\"TOXICSLURRY\">Toxic Slurry</link> using special filter and chemicals. Sieve process also completely removes <link=\"DISEASE\">Germs</link>."
msgstr ""
"Trate <link=\"DIRTYWATER\">Água Poluída</link> ou "
"<link=\"TOXICSLURRY\">Lama Tóxica</link> usando filtros e produtos químicos"
" especiais. O processo de peneira também remove completamente "
"<link=\"DISEASE\">Germes</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.FLOCCULATIONSIEVE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.FLOCCULATIONSIEVE.NAME"
msgid "<link=\"FLOCCULATIONSIEVE\">Flocculation Sieve</link>"
msgstr "<link=\"FLOCCULATIONSIEVE\">Peneira de Floculação</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.FRIDGEPOD.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.FRIDGEPOD.DESC"
msgid "A tiny wall pod capable of preserving food at low temperatures."
msgstr ""
"Uma pequena cápsula de parede capaz de conservar alimentos a baixa "
"temperatura."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.FRIDGEPOD.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.FRIDGEPOD.EFFECT"
msgid "The sealed storage of this pod keeps food very cold, but not in sterile atmospheric conditions."
msgstr ""
"O armazenamento hermético desta cápsula permite que os alimentos sejam "
"mantidos muito frios, mas não em condições atmosféricas estéreis."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.FRIDGEPOD.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.FRIDGEPOD.NAME"
msgid "<link=\"FRIDGEPOD\">Fridge Pod</link>"
msgstr "<link=\"FRIDGEPOD\">Geladeira Pod</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.GLASSDOORCOMPLEX.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.GLASSDOORCOMPLEX.DESC"
msgid "Functions as a Manual Airlock when no Power is available."
msgstr ""
"Opera como uma câmara de descompressão manual quando não há energia "
"disponível."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.GLASSDOORCOMPLEX.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.GLASSDOORCOMPLEX.EFFECT"
msgid "A mechanized airlock door made with <link=\"GLASS\">Glass</link> panels. Blocks Liquid and Gas flow, maintaining pressure between areas. Sets Duplicant Access Permissions for area restriction."
msgstr "Uma porta de câmara de ar mecanizada feita com painéis de <link=\"GLASS\">Vidro</link>. Bloqueia o fluxo de Líquidos e Gases, mantendo a pressão entre as áreas. Define as Permissões de Acesso dos Duplicantes para restrição de área."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.GLASSDOORCOMPLEX.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.GLASSDOORCOMPLEX.NAME"
msgid "<link=\"GLASSDOORCOMPLEX\">Security Glass Door</link>"
msgstr "<link=\"GLASSDOORCOMPLEX\">Porta de Segurança de Vidro</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.GLASSDOORSIMPLE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.GLASSDOORSIMPLE.DESC"
msgid "Pips love pressing their face against the glass.\nThe same can be said about Meep."
msgstr ""
"Pips adoram pressionar o rosto contra o vidro.\n"
"O mesmo pode ser dito do Meep."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.GLASSDOORSIMPLE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.GLASSDOORSIMPLE.EFFECT"
msgid "A simple door made with <link=\"GLASS\">Glass</link> panels. Encloses areas without blocking Liquid or Gas flow. Sets Duplicant Access Permissions for area restriction."
msgstr "Uma porta simples feita com painéis de <link=\"GLASS\">Vidro</link>. Cerca áreas sem bloquear o fluxo de Líquidos ou Gases. Define as Permissões de Acesso dos Duplicantes para restrição de área."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.GLASSDOORSIMPLE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.GLASSDOORSIMPLE.NAME"
msgid "<link=\"GLASSDOORSIMPLE\">Simple Glass Door</link>"
msgstr "<link=\"GLASSDOORSIMPLE\">Porta de Vidro Simples</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPCALCINATOR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPCALCINATOR.DESC"
msgid "Voloxidation process can separate uranium oxides from nuclear waste, along with other heavy elements. Produces waves of contaminating radiation while operational."
msgstr ""
"O processo de voloxidação separa os óxidos de urânio dos resíduos nucleares,"
" bem como de outros elementos pesados. Produz ondas de radiação contaminante"
" durante a operação."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPCALCINATOR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPCALCINATOR.EFFECT"
msgid "An advanced kiln capable of volumetric oxidation with heavy nuclear waste by alternating different stages of oxidation and reduction."
msgstr ""
"Um forno avançado capaz de realizar oxidação volumétrica com resíduos "
"nucleares pesados, alternando diferentes estágios de oxidação e redução."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPCALCINATOR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPCALCINATOR.NAME"
msgid "<link=\"HEPCALCINATOR\">Voloxidation Calcinator</link>"
msgstr "<link=\"HEPCALCINATOR\">Calcinador de Voloxidação</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPCENTRIFUGE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPCENTRIFUGE.DESC"
msgid "A gas centrifuge is a device that performs isotope separation of gases. A centrifuge relies on the principles of centripetal force accelerating molecules so that particles of different masses are physically separated in a gradient along the radius of a rotating container."
msgstr ""
"Uma centrífuga a gás é um dispositivo que realiza a separação isotópica de "
"gases. Baseia-se no princípio da força centrípeta que acelera as moléculas "
"de modo que partículas de diferentes massas sejam fisicamente separadas ao "
"longo de um gradiente ao longo do raio de um recipiente rotativo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPCENTRIFUGE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPCENTRIFUGE.EFFECT"
msgid "The Zippe-type centrifuge is a gas device designed to enrich the rare fissile <link=\"ENRICHEDURANIUM\">Enriched Uranium</link> from the mixture of isotopes found in the manufactured <link=\"YELLOWCAKE\">Yellow Cake</link>. The separation process releases small amounts of <link=\"DEPLETEDURANIUM\">Depleted Uranium</link> as waste product."
msgstr ""
"A centrífuga tipo Zippe é um dispositivo movido a gás projetado para "
"enriquecer o raro urânio físsil <link=\"ENRICHEDURANIUM\">enrichi</link> a "
"partir da mistura de isótopos presentes no <link=\"YELLOWCAKE\">Yellow "
"Cake</link> fabricado. O processo de separação libera pequenas quantidades "
"de urânio empobrecido <link=\"DEPLETEDURANIUM\">appauvri</link> como "
"resíduo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPCENTRIFUGE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPCENTRIFUGE.NAME"
msgid "<link=\"HEPCENTRIFUGE\">Zippe-Type Centrifuge</link>"
msgstr "<link=\"HEPCENTRIFUGE\">Centrifugeuse de type Zippe</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPPROJECTOR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPPROJECTOR.DESC"
msgid "A radiactive source containing radionuclids which emits ionizing radiation."
msgstr ""
"Uma fonte radioativa contendo radionuclídeos que emite radiação ionizante."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPPROJECTOR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPPROJECTOR.EFFECT"
msgid "This device uses <link=\"URANIUMORE\">Uranium Ore</link>. As the fuel decays, it turns to liquid <link=\"NUCLEARWASTE\">Nuclear Waste</link>, which is piped out of the source."
msgstr "Este dispositivo usa <link=\"URANIUMORE\">Minério de Urânio</link>. À medida que o combustível decai, ele se transforma em <link=\"NUCLEARWASTE\">Resíduo Nuclear</link> líquido, que é canalizado para fora da fonte."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPPROJECTOR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HEPPROJECTOR.NAME"
msgid "<link=\"HEPPROJECTOR\">Rad Projector</link>"
msgstr "<link=\"HEPPROJECTOR\">Projecteur Rad</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSUREGASCONDUIT.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSUREGASCONDUIT.DESC"
msgid "A reinforced gas pipe capable of handling high pressure flow.\nComposite nature of the pipe prevents gas contents from significantly changing temperature in transit."
msgstr ""
"Uma mangueira de gás reforçada capaz de lidar com fluxo de alta pressão. A "
"natureza composta do tubo evita que o conteúdo do gás altere "
"significativamente a temperatura durante o transporte."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSUREGASCONDUIT.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSUREGASCONDUIT.EFFECT"
msgid "Carries a maximum of {CAPACITY} of <link=\"ELEMENTSGAS\">Gas</link> with minimal change in <link=\"HEAT\">Temperature</link>.\n\nCan be run through wall and floor tile."
msgstr ""
"Carrega uma {CAPACITY} máxima de <link=\"ELEMENTSGAS\">Gás</link> com uma alteração mínima de <link=\"HEAT\">température</link>.\n"
"\n"
"Pode ser instalado através de azulejos e pisos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSUREGASCONDUIT.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSUREGASCONDUIT.NAME"
msgid "<link=\"HIGHPRESSUREGASCONDUIT\">High Pressure Gas Conduit</link>"
msgstr "<link=\"HIGHPRESSUREGASCONDUIT\">Conduto de Gás de Alta Pressão</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSUREGASCONDUITBRIDGE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSUREGASCONDUITBRIDGE.DESC"
msgid "A reinforced gas pipe bridge capable of handling high pressure flow.\nComposite nature of the pipe prevents gas contents from significantly changing temperature in transit."
msgstr ""
"Uma ponte de linha de gás reforçada capaz de lidar com fluxo de alta "
"pressão. A natureza composta do tubo evita que o conteúdo do gás altere "
"significativamente a temperatura durante o transporte."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSUREGASCONDUITBRIDGE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSUREGASCONDUITBRIDGE.EFFECT"
msgid "Runs one High Pressure Gas Pipe section over another without joining them.\n\nCan be run through wall and floor tile."
msgstr ""
"Permite que uma seção do tubo de gás de alta pressão passe sobre outra sem juntá-las.\n"
"\n"
"Pode ser usado em azulejos e pisos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSUREGASCONDUITBRIDGE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSUREGASCONDUITBRIDGE.NAME"
msgid "<link=\"HIGHPRESSUREGASCONDUITBRIDGE\">High Pressure Gas Conduit Bridge</link>"
msgstr ""
"<link=\"HIGHPRESSUREGASCONDUITBRIDGE\">Ponte de Conduto de Gás de Alta "
"Pressão</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSURELIQUIDCONDUIT.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSURELIQUIDCONDUIT.DESC"
msgid "A reinforced liquid pipe capable of handling high pressure flow. Composite nature of the pipe prevents liquid contents from significantly changing temperature in transit."
msgstr ""
"Uma mangueira de líquido reforçada capaz de lidar com fluxo de alta pressão."
" A sua natureza compósita evita variações significativas de temperatura do "
"conteúdo líquido durante o transporte."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSURELIQUIDCONDUIT.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSURELIQUIDCONDUIT.EFFECT"
msgid "Carries a maximum of {CAPACITY} of <link=\"ELEMENTSLIQUID\">Liquid</link> with minimal change in <link=\"HEAT\">Temperature</link>.\n\nCan be run through wall and floor tile."
msgstr ""
"Carrega uma {CAPACITY} máxima de <link=\"ELEMENTSLIQUID\">líquido</link> com uma alteração mínima de <link=\"HEAT\">température</link>.\n"
"\n"
"Pode ser usado em azulejos e pisos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSURELIQUIDCONDUIT.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSURELIQUIDCONDUIT.NAME"
msgid "<link=\"HIGHPRESSURELIQUIDCONDUIT\">High Pressure Liquid Pipe</link>"
msgstr ""
"<link=\"HIGHPRESSURELIQUIDCONDUIT\">Conduto de Líquido de Alta "
"Pressão</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSURELIQUIDCONDUITBRIDGE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSURELIQUIDCONDUITBRIDGE.DESC"
msgid "A reinforced liquid pipe bridge capable of handling high pressure flow. Composite nature of the pipe prevents liquid contents from significantly changing temperature in transit."
msgstr ""
"Uma plataforma de tubos reforçada capaz de lidar com fluxo de alta pressão. "
"A natureza compósita do tubo evita variações significativas de temperatura "
"do líquido durante o transporte."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSURELIQUIDCONDUITBRIDGE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSURELIQUIDCONDUITBRIDGE.EFFECT"
msgid "Runs one High Pressure Liquid Pipe section over another without joining them.\n\nCan be run through wall and floor tile."
msgstr ""
"Permite que uma seção do tubo de líquido de alta pressão passe sobre outra sem juntá-las.\n"
"\n"
"Pode ser usado em azulejos e pisos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSURELIQUIDCONDUITBRIDGE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHPRESSURELIQUIDCONDUITBRIDGE.NAME"
msgid "<link=\"HIGHPRESSURELIQUIDCONDUITBRIDGE\">High Pressure Liquid Conduit Bridge</link>"
msgstr ""
"<link=\"HIGHPRESSURELIQUIDCONDUITBRIDGE\">Ponte para Condutos de Líquido "
"Alta Pressão</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHTECHBIGFRIDGE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHTECHBIGFRIDGE.DESC"
msgid "A fancy refrigerator with a sci-fi design."
msgstr "Uma geladeira sofisticada com design de ficção científica."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHTECHBIGFRIDGE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHTECHBIGFRIDGE.EFFECT"
msgid "The sealed storage of this fridge keeps food very cold, but not in sterile atmospheric conditions\nProvides water bottles as long there a pipe linked to it.\nTakes food items from conveyor rails based on its filters."
msgstr "O armazenamento vedado desta geladeira mantém a comida bem fria, mas não em condições atmosféricas estéreis\nFornece garrafas de água desde que haja um cano conectado a ela.\nRetira itens de comida dos trilhos transportadores conforme seus filtros."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHTECHBIGFRIDGE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHTECHBIGFRIDGE.NAME"
msgid "<link=\"HIGHTECHBIGFRIDGE\">Large Hightech Refrigerator</link>"
msgstr "<link=\"HIGHTECHBIGFRIDGE\">Geladeira High-Tech Grande</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHTECHSMALLFRIDGE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHTECHSMALLFRIDGE.DESC"
msgid "A fancy fridge with a sci-fi design"
msgstr "Uma geladeira sofisticada com design de ficção científica"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHTECHSMALLFRIDGE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHTECHSMALLFRIDGE.EFFECT"
msgid "The sealed storage of this fridge keeps food very cold, but not in sterile atmospheric conditions.\nTakes food items from conveyor rails based on its filters."
msgstr ""
"O armazenamento hermético deste refrigerador mantém os alimentos muito frios, mas não em condições atmosféricas estéreis.\n"
"Retira os alimentos dos trilhos transportadores com base em seus filtros."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHTECHSMALLFRIDGE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HIGHTECHSMALLFRIDGE.NAME"
msgid "<link=\"HIGHTECHSMALLFRIDGE\">Hightech Fridge</link>"
msgstr "<link=\"HIGHTECHSMALLFRIDGE\">Geladeira High-Tech</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_INBOX.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_INBOX.DESC"
msgid "Material filters can be used to determine what resources are sent down the rail."
msgstr ""
"Filtros de materiais podem ser usados ​​para determinar quais recursos são "
"enviados no trilho."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_INBOX.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_INBOX.EFFECT"
msgid "Loads <link=\"ELEMENTSSOLID\">Solid Materials</link> onto <link=\"HPASOLIDRAIL\">Heavy-Duty Rail</link> for transport.\n\nOnly loads the resources of your choosing."
msgstr ""
"Carrega <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> em <link=\"HPASOLIDRAIL\">Trilho Robusto</link> para transporte.\n"
"\n"
"Carregue apenas os recursos que você deseja."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_INBOX.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_INBOX.NAME"
msgid "<link=\"HPAINBOX\">Heavy-Duty Loader</link>"
msgstr "<link=\"HPAINBOX\">Carregador Pesado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTIGASFILTER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTIGASFILTER.DESC"
msgid "All gases are sent into the building's output pipe, except those chosen for filtering."
msgstr "Todos os gases são enviados ao cano de saída da construção, exceto os escolhidos para filtragem."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTIGASFILTER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTIGASFILTER.EFFECT"
msgid "Filters all selected <link=\"ELEMENTSGAS\">Gases</link> from the air, sending it into a dedicated <link=\"GASPIPING\">Filtered Output Pipe</link>.\n\nAble to work with all gas pipe types."
msgstr "Filtra todos os <link=\"ELEMENTSGAS\">Gases</link> selecionados do ar, enviando-os a um <link=\"GASPIPING\">Cano de Saída Filtrado</link> dedicado.\n\nCapaz de funcionar com todos os tipos de cano de gás."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTIGASFILTER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTIGASFILTER.NAME"
msgid "<link=\"HPAMULTIGASFILTER\">High Pressure Gas Filter</link>"
msgstr "<link=\"HPAMULTIGASFILTER\">Filtro de Gás de Alta Pressão</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTILIQUIDFILTER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTILIQUIDFILTER.DESC"
msgid "All liquids are sent into the building's output pipe, except those chosen for filtering."
msgstr "Todos os líquidos são enviados ao cano de saída da construção, exceto os escolhidos para filtragem."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTILIQUIDFILTER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTILIQUIDFILTER.EFFECT"
msgid "Filters all selected <link=\"ELEMENTSLIQUID\">Liquids</link> out of a mix, sending it into a dedicated <link=\"LIQUIDPIPING\">Filtered Output Pipe</link>.\n\nAble to work with all liquid pipe types."
msgstr "Filtra todos os <link=\"ELEMENTSLIQUID\">Líquidos</link> selecionados de uma mistura, enviando-os a um <link=\"LIQUIDPIPING\">Cano de Saída Filtrado</link> dedicado.\n\nCapaz de funcionar com todos os tipos de cano de líquido."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTILIQUIDFILTER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTILIQUIDFILTER.NAME"
msgid "<link=\"HPAMULTIGASFILTER\">High Pressure Liquid Filter</link>"
msgstr "<link=\"HPAMULTIGASFILTER\">Filtro de Líquido de Alta Pressão</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTISOLIDFILTER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTISOLIDFILTER.DESC"
msgid "All solids are sent into the building's output conveyor, except those chosen for filtering."
msgstr "Todos os sólidos são enviados ao transportador de saída da construção, exceto os escolhidos para filtragem."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTISOLIDFILTER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTISOLIDFILTER.EFFECT"
msgid "Separates all selected <link=\"ELEMENTSSOLID\">Solid Materials</link> from the conveyor, sending it into a dedicated <link=\"SOLIDCONDUIT\">Conveyor Rail</link>.\n\nAble to work with all rail types."
msgstr "Separa todos os <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> selecionados do transportador, enviando-os a um <link=\"SOLIDCONDUIT\">Trilho Transportador</link> dedicado.\n\nCapaz de funcionar com todos os tipos de trilho."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTISOLIDFILTER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_MULTISOLIDFILTER.NAME"
msgid "<link=\"HPAMULTISOLIDFILTER\">Heavy-Duty Rail Filter</link>"
msgstr "<link=\"HPAMULTISOLIDFILTER\">Filtro para Trilhos Robustos</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_RAILMERGER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_RAILMERGER.DESC"
msgid "Compression leads to higher rail throughput!"
msgstr "A compressão leva a uma maior vazão do trilho!"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_RAILMERGER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_RAILMERGER.EFFECT"
msgid "Merges chunks of <link=\"ELEMENTSSOLID\">Solid Materials</link> from incoming rails and ouputs them onto a <link=\"HPASOLIDRAIL\">Heavy-Duty Rail</link>."
msgstr ""
"Mescla pedaços de <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> dos "
"trilhos recebidos e os envia para um <link=\"HPASOLIDRAIL\">Trilho "
"Robusto</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_RAILMERGER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_RAILMERGER.NAME"
msgid "<link=\"HPARAILMERGER\">Heavy-Duty Rail Compressor</link>"
msgstr "<link=\"HPARAILMERGER\">Mesclador de Trilho Robusto</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAIL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAIL.DESC"
msgid "Rails move materials where they'll be needed most, saving Duplicants the walk."
msgstr ""
"Os trilhos movem os materiais para onde são mais necessários, evitando que "
"os Duplicantes tenham que se mover."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAIL.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAIL.EFFECT"
msgid "Transports large quantities of <link=\"ELEMENTSSOLID\">Solid Materials</link> on a track between <link=\"HPAINBOX\">Heavy-Duty Loaders</link> and <link=\"SOLIDVENT\">Conveyor Chutes</link>.\n\nCan not be run through wall and floor tiles."
msgstr "Transporta grandes quantidades de <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> em uma pista entre <link=\"HPAINBOX\">Carregadores Pesados</link> e <link=\"SOLIDVENT\">Calhas Transportadoras</link>.\n\nNão pode passar através de ladrilhos de parede e piso."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAIL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAIL.NAME"
msgid "<link=\"HPASOLIDRAIL\">Heavy-Duty Rail</link>"
msgstr "<link=\"HPASOLIDRAIL\">Trilho Pesado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAIL_INSULATED.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAIL_INSULATED.DESC"
msgid "Rails move materials where they'll be needed most, saving Duplicants the walk."
msgstr ""
"Os trilhos movem os materiais para onde são mais necessários, evitando que "
"os Duplicantes tenham que se mover."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAIL_INSULATED.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAIL_INSULATED.EFFECT"
msgid "Transports large quantities of <link=\"ELEMENTSSOLID\">Solid Materials</link>.\n\nCan not be run through wall and floor tiles.\n\nBeing held in a vaccuum, transported items fully insulated and sealed from their surroundings (prevents offgassing)."
msgstr "Transporta grandes quantidades de <link=\"ELEMENTSSOLID\">Materiais Sólidos</link>.\n\nNão pode passar através de ladrilhos de parede e piso.\n\nMantidos em vácuo, os itens transportados ficam totalmente isolados e vedados do ambiente (evita a liberação de gases)."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAIL_INSULATED.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAIL_INSULATED.NAME"
msgid "<link=\"HPASOLIDRAILINSULATED\">Insulated Heavy-Duty Rail</link>"
msgstr "<link=\"HPASOLIDRAILINSULATED\">Trilho Pesado Isolado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILBRIDGE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILBRIDGE.DESC"
msgid "Separating rail systems helps ensure materials go to the intended destinations."
msgstr "Separar os sistemas de trilhos ajuda a garantir que os materiais cheguem aos destinos pretendidos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILBRIDGE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILBRIDGE.EFFECT"
msgid "Allows <link=\"HPASOLIDRAIL\">Heavy-Duty Rail</link> and <link=\"HPASOLIDRAILINSULATED\">Insulated Heavy-Duty Rail</link> to run one section over another without joining them.\n\nCanot be run through wall and floor tile."
msgstr "Permite que o <link=\"HPASOLIDRAIL\">Trilho Pesado</link> e o <link=\"HPASOLIDRAILINSULATED\">Trilho Pesado Isolado</link> passem uma seção sobre a outra sem se juntarem.\n\nNão pode passar através de ladrilhos de parede e piso."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILBRIDGE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILBRIDGE.NAME"
msgid "<link=\"HPASOLIDRAILBRIDGE\">Heavy-Duty Bridge</link>"
msgstr "<link=\"HPASOLIDRAILBRIDGE\">Ponte Pesada</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILBRIDGETILE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILBRIDGETILE.DESC"
msgid "Joint plates can run Heavy-Duty rails through walls without leaking gas or liquid."
msgstr ""
"As placas de junção permitem que trilhos resistentes passem pelas paredes "
"sem vazamentos de gás ou líquido."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILBRIDGETILE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILBRIDGETILE.EFFECT"
msgid "Allows <link=\"HPASOLIDRAIL\">Heavy-Duty Rail</link> and <link=\"HPASOLIDRAILINSULATED\">Insulated Heavy-Duty Rail</link> to be run through wall and floor tile.\n\nFunctions as regular insulated tile."
msgstr "Permite que o <link=\"HPASOLIDRAIL\">Trilho Pesado</link> e o <link=\"HPASOLIDRAILINSULATED\">Trilho Pesado Isolado</link> passem através de ladrilhos de parede e piso.\n\nFunciona como um ladrilho isolado normal."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILBRIDGETILE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILBRIDGETILE.NAME"
msgid "<link=\"HPASOLIDRAILBRIDGETILE\">Heavy-Duty Joint Plate</link>"
msgstr "<link=\"HPASOLIDRAILBRIDGETILE\">Placa de Junção Pesada</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILVALVE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILVALVE.DESC"
msgid "A mechanical valve capable of reducing the flow of mass from a Heavy-Duty rail to to a conveyor rail, to avoid dropping items."
msgstr ""
"Uma válvula mecânica capaz de reduzir o fluxo de massa de um trilho de "
"serviço pesado para um trilho transportador, para evitar a queda de objetos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILVALVE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILVALVE.EFFECT"
msgid "Allows <link=\"ELEMENTSSOLID\">Solid Materials</link> to be transfered from <link=\"HPASOLIDRAIL\">Heavy-Duty Rails</link> to normal <link=\"SOLIDCONDUIT\">Conveyor Rails</link>."
msgstr "Permite transferir <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> dos <link=\"HPASOLIDRAIL\">Trilhos Pesados</link> para os <link=\"SOLIDCONDUIT\">Trilhos Transportadores</link> normais."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILVALVE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_SOLIDRAILVALVE.NAME"
msgid "<link=\"HPASOLIDRAILVALVE\">Heavy-Duty Reduction Valve</link>"
msgstr "<link=\"HPASOLIDRAILVALVE\">Válvula de Redução Robusta</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_TRANSFERARM.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_TRANSFERARM.DESC"
msgid "An auto-sweeper's range can be viewed at any time by clicking on the building."
msgstr ""
"O alcance de uma varredora automática pode ser visualizado a qualquer "
"momento clicando no edifício."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_TRANSFERARM.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_TRANSFERARM.EFFECT"
msgid "Automates <link=\"CHORES\">Sweeping</link> and <link=\"CHORES\">Supplying</link> errands by sucking up all nearby <link=\"DECOR\">Debris</link>.\n\nMaterials are automatically delivered to any <link=\"HPAINBOX\">Heavy-Duty Loader</link>, <link=\"HPAOUTBOX\">Heavy-Duty Receptacle</link>, storage, or buildings within range.\n\nComes with increased range, capacity and rotation speed."
msgstr "Automatiza as tarefas de <link=\"CHORES\">Varredura</link> e <link=\"CHORES\">Suprimento</link> sugando todos os <link=\"DECOR\">Detritos</link> próximos.\n\nOs materiais são entregues automaticamente a qualquer <link=\"HPAINBOX\">Carregador Pesado</link>, <link=\"HPAOUTBOX\">Receptáculo Pesado</link>, armazenamento ou construção dentro do alcance.\n\nVem com alcance, capacidade e velocidade de rotação aumentados."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_TRANSFERARM.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPA_TRANSFERARM.NAME"
msgid "<link=\"HPATRANSFERARM\">Heavy-Duty Auto-Sweeper</link>"
msgstr "<link=\"HPATRANSFERARM\">Braço Robusto Automatizado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPAVENTGAS.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPAVENTGAS.DESC"
msgid "A reinforced gas vent with a built in compression pump, capable of dispensing gases even in high pressure environments."
msgstr ""
"Ventilador de gás reforçado com bomba de compressão integrada, capaz de "
"distribuir gases mesmo em ambientes de alta pressão."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPAVENTGAS.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPAVENTGAS.EFFECT"
msgid "Dispenses <link=\"ELEMENTSGAS\">Gases</link> in high pressure environments.\n\nMust be connected to a <link=\"HIGHPRESSUREGASCONDUIT\">High Pressure Gas Pipe</link>.\n\nRequires power to function."
msgstr ""
"Dispensa <link=\"ELEMENTSGAS\">Gás</link> em ambientes de alta pressão.\n"
"\n"
"Deve estar conectado a um <link=\"HIGHPRESSUREGASCONDUIT\">Conduto de Gás de Alta Pressão</link>.\n"
"\n"
"Requer fonte de alimentação para funcionar."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPAVENTGAS.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPAVENTGAS.NAME"
msgid "<link=\"HPAVENTGAS\">Compressor Gas Vent</link>"
msgstr "<link=\"HPAVENTGAS\">Ventilação de Gás do Compressor</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPAVENTLIQUID.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPAVENTLIQUID.DESC"
msgid "A reinforced liquid vent with a built in compression pump, capable of dispensing liquids even in high pressure environments."
msgstr ""
"Ventilador de líquido reforçado com bomba de compressão integrada, capaz de "
"dispensar líquidos mesmo em ambientes de alta pressão."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPAVENTLIQUID.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPAVENTLIQUID.EFFECT"
msgid "Dispenses <link=\"ELEMENTSLIQUID\">Liquids</link> in high pressure environments.\n\nMust be connected to a <link=\"HIGHPRESSURELIQUIDCONDUIT\">High Pressure Liquid Pipe</link>.\n\nRequires power to function."
msgstr ""
"Dispensa <link=\"ELEMENTSLIQUID\">líquidos</link> em ambientes de alta pressão.\n"
"\n"
"Deve estar conectado a um <link=\"HIGHPRESSURELIQUIDCONDUIT\">Conduto de Líquido de Alta Pressão</link>.\n"
"\n"
"Requer fonte de alimentação para funcionar."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPAVENTLIQUID.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.HPAVENTLIQUID.NAME"
msgid "<link=\"HPAVENTLIQUID\">Compressor Liquid Vent</link>"
msgstr "<link=\"HPAVENTLIQUID\">Ventilação de Líquido do Compressor</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INSULATIONCOMPOSITIONTILE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INSULATIONCOMPOSITIONTILE.DESC"
msgid "Used to build the walls and floors of rooms. Reduces heat transfer between walls, retaining ambient heat in an area."
msgstr ""
"Usado para construir paredes e pisos de quartos. Reduz a transferência de "
"calor entre as paredes e retém o calor ambiente."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INSULATIONCOMPOSITIONTILE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INSULATIONCOMPOSITIONTILE.EFFECT"
msgid "A solid tile assembled in a range of materials and radiative pattern that reduce the heat transfer.\nIt has the same insulating properties as the regular insulated tile, but offers a small run speed bonus to duplicants."
msgstr ""
"Uma telha sólida montada em uma variedade de materiais e padrões radiativos que reduzem a transferência de calor.\n"
"Tem as mesmas propriedades isolantes que o ladrilho isolado normal, mas oferece um pequeno bônus de velocidade de execução para duplicantes."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INSULATIONCOMPOSITIONTILE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INSULATIONCOMPOSITIONTILE.NAME"
msgid "<link=\"INSULATIONCOMPOSITIONTILE\">Insulation Composite Tile</link>"
msgstr "<link=\"INSULATIONCOMPOSITIONTILE\">Ladrilho Composto de Isolamento</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INVERTEDSMALLGASRESERVOIR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INVERTEDSMALLGASRESERVOIR.DESC"
msgid "A small sized reservoir. This variant has bottom to top flow."
msgstr "Tanque pequeno. Essa variação flui de baixo para cima."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INVERTEDSMALLGASRESERVOIR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INVERTEDSMALLGASRESERVOIR.EFFECT"
msgid "Stores any <link=\"ELEMENTSGAS\">Gas</link> resources piped into it."
msgstr ""
"Armazena todos os <link=\"ELEMENTSGAS\">Gás</link> recursos roteados para "
"lá."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INVERTEDSMALLGASRESERVOIR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INVERTEDSMALLGASRESERVOIR.NAME"
msgid "<link=\"INVERTEDSMALLGASRESERVOIR\">Small Gas Reservoir A</link>"
msgstr "<link=\"INVERTEDSMALLGASRESERVOIR\">Reservatório de Gás Pequeno A</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INVERTEDSMALLLIQUIDRESERVOIR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INVERTEDSMALLLIQUIDRESERVOIR.DESC"
msgid "A small sized reservoir. This variant has bottom to top flow"
msgstr "Um pequeno tanque. Essa variação flui de baixo para cima."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INVERTEDSMALLLIQUIDRESERVOIR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INVERTEDSMALLLIQUIDRESERVOIR.EFFECT"
msgid "Stores any <link=\"ELEMENTSLIQUID\">Liquid</link> resources piped into it."
msgstr ""
"Armazena todos os <link=\"ELEMENTSLIQUID\">Líquido</link> recursos roteados "
"para lá."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INVERTEDSMALLLIQUIDRESERVOIR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.INVERTEDSMALLLIQUIDRESERVOIR.NAME"
msgid "<link=\"INVERTEDSMALLLIQUIDRESERVOIR\">Small Liquid Reservoir A</link>"
msgstr "<link=\"INVERTEDSMALLLIQUIDRESERVOIR\">Reservatório de Líquido Pequeno A</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LIGHTREACTOR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LIGHTREACTOR.DESC"
msgid "The advanced boiling water reactor (ABWR) uses non-pressurized coolant for steam production. Its comparative small size favors for a quicker heating of the coolant, however, it also increases the odds of a Meltdown in the absence of cooling. Releases Steam in the area directly below its central tile segment."
msgstr "O reator avançado de água fervente (ABWR) usa refrigerante não pressurizado para a produção de vapor. Seu tamanho relativamente pequeno favorece um aquecimento mais rápido do refrigerante, porém também aumenta as chances de uma Fusão na ausência de resfriamento. Libera Vapor na área diretamente abaixo de seu segmento de ladrilho central."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LIGHTREACTOR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LIGHTREACTOR.EFFECT"
msgid "Uses <link=\"ENRICHEDURANIUM\">Enriched Uranium</link> to produce <link=\"STEAM\">Steam</link> for electrical purpose."
msgstr ""
"Usa <link=\"ENRICHEDURANIUM\">uranium enrichi</link> para produzir "
"<link=\"STEAM\">Vapor</link> para fins elétricos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LIGHTREACTOR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LIGHTREACTOR.NAME"
msgid "<link=\"LIGHTREACTOR\">ABWR Reactor</link>"
msgstr "<link=\"LIGHTREACTOR\">Reator ABWR</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.DESC"
msgid "A white colored alert light."
msgstr "Uma luz de advertência branca."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.EFFECT"
msgid "A led light that serves as an alert. Produces no significant luminosity."
msgstr ""
"Uma luz led que serve como alerta. Não produz luminosidade significativa."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.FACADES.LOGICALERTLIGHTGREEN.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.FACADES.LOGICALERTLIGHTGREEN.DESC"
msgid "A green colored alert light."
msgstr "Uma luz de aviso verde."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.FACADES.LOGICALERTLIGHTGREEN.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.FACADES.LOGICALERTLIGHTGREEN.NAME"
msgid "<link=\"LOGICALERTLIGHTGREEN\">Green Alert LED</link>"
msgstr "<link=\"LOGICALERTLIGHTGREEN\">LED d'alerte verte</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.FACADES.LOGICALERTLIGHTRED.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.FACADES.LOGICALERTLIGHTRED.DESC"
msgid "A red colored alert light."
msgstr "Uma luz vermelha de alerta."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.FACADES.LOGICALERTLIGHTRED.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.FACADES.LOGICALERTLIGHTRED.NAME"
msgid "<link=\"LOGICALERTLIGHTRED\">Red Alert LED</link>"
msgstr "<link=\"LOGICALERTLIGHTRED\">LED d'alerte rouge</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.FACADES.LOGICALERTLIGHTYELLOW.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.FACADES.LOGICALERTLIGHTYELLOW.DESC"
msgid "A yellow colored alert light."
msgstr "Uma luz de advertência amarela."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.FACADES.LOGICALERTLIGHTYELLOW.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.FACADES.LOGICALERTLIGHTYELLOW.NAME"
msgid "<link=\"LOGICALERTLIGHTYELLOW\">Yellow Alert LED</link>"
msgstr "<link=\"LOGICALERTLIGHTYELLOW\">LED d'alerte jaune</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGICALERTLIGHT.NAME"
msgid "<link=\"LOGICALERTLIGHT\">Alert LED</link>"
msgstr "<link=\"LOGICALERTLIGHT\">LED d'alerte</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICBRIDGE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICBRIDGE.DESC"
msgid "Separating rail systems helps ensure materials go to the intended destinations."
msgstr "Separar os sistemas de trilhos ajuda a garantir que os materiais cheguem aos destinos pretendidos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICBRIDGE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICBRIDGE.EFFECT"
msgid "Runs one <link=\"LOGISTICRAIL\">Logistic Rail</link> section over another without joining them.\n\nCan be run through wall and floor tile."
msgstr ""
"Executa uma seção <link=\"LOGISTICRAIL\">Trilho Logístico</link> sobre outra sem juntá-las.\n"
"\n"
"Pode ser aplicado em paredes e pisos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICBRIDGE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICBRIDGE.NAME"
msgid "<link=\"LOGISTICBRIDGE\">Logistic Solid Bridge</link>"
msgstr "<link=\"LOGISTICBRIDGE\">Ponte Logística de Sólidos</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICFILTER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICFILTER.DESC"
msgid "All solids are sent into the building's output conveyor, except the solid chosen for filtering."
msgstr ""
"Todos os sólidos são enviados para a esteira de saída do prédio, exceto o "
"sólido escolhido para filtragem."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICFILTER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICFILTER.EFFECT"
msgid "Separates one <link=\"ELEMENTSSOLID\">Solid Material</link> from the conveyor, sending it into a dedicated solid conduit."
msgstr ""
"Separa um <link=\"ELEMENTSSOLID\">Material Sólido</link> do transportador, "
"enviando-o para um conduíte sólido dedicado."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICFILTER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICFILTER.NAME"
msgid "<link=\"LOGISTICFILTER\">Logistic Solid Filter</link>"
msgstr "<link=\"LOGISTICFILTER\">Filtro Logístico de Sólidos</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICLOADER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICLOADER.DESC"
msgid "Material filters can be used to determine what resources are sent down the rail."
msgstr ""
"Filtros de materiais podem ser usados ​​para determinar quais recursos são "
"enviados no trilho."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICLOADER.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICLOADER.EFFECT"
msgid "Loads <link=\"ELEMENTSSOLID\">Solid Materials</link> onto <link=\"LOGISTICRAIL\">Logistic Conveyor Rails</link> for transport.\n\nOnly loads the resources of your choosing."
msgstr ""
"Coloque o <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> no <link=\"LOGISTICRAIL\">Trilhos Logísticos</link> para transporte.\n"
"\n"
"Carregue apenas os recursos que você deseja."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICLOADER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICLOADER.NAME"
msgid "<link=\"LOGISTICLOADER\">Logistic Loader</link>"
msgstr "<link=\"LOGISTICLOADER\">Carregador Logístico</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICOUTBOX.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICOUTBOX.DESC"
msgid "When materials reach the end of a rail they enter a receptacle to be used by Duplicants."
msgstr ""
"Quando os materiais chegam ao final de um trilho, eles entram em um "
"receptáculo para uso dos Duplicantes."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICOUTBOX.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICOUTBOX.EFFECT"
msgid "Unloads <link=\"ELEMENTSSOLID\">Solid Materials</link> from a <link=\"LOGISTICRAIL\">Logistic Rail</link> into storage."
msgstr ""
"Descarrega o <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> de um "
"<link=\"LOGISTICRAIL\">Trilho Logístico</link> para o armazenamento."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICOUTBOX.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICOUTBOX.NAME"
msgid "<link=\"LOGISTICOUTBOX\">Logistic Receptacle</link>"
msgstr "<link=\"LOGISTICOUTBOX\">Receptáculo Logístico</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICRAIL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICRAIL.DESC"
msgid "Rails move materials where they'll be needed most, saving Duplicants the walk."
msgstr ""
"Os trilhos movem os materiais para onde são mais necessários, evitando que "
"os Duplicantes tenham que se mover."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICRAIL.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICRAIL.EFFECT"
msgid "Transports small amounts of <link=\"ELEMENTSSOLID\">Solid Materials</link> on a track between <link=\"LOGISTICLOADER\">Logistic Loader</link> and <link=\"LOGISTICOUTBOX\">Logistic Receptacle</link>.\n\nCan be run through wall and floor tile."
msgstr "Transporta pequenas quantidades de <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> em uma pista entre o <link=\"LOGISTICLOADER\">Carregador Logístico</link> e o <link=\"LOGISTICOUTBOX\">Receptáculo Logístico</link>.\n\nPode passar através de ladrilhos de parede e piso."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICRAIL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICRAIL.NAME"
msgid "<link=\"LOGISTICRAIL\">Logistic Rail</link>"
msgstr "<link=\"LOGISTICRAIL\">Trilho Logístico</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICRAILVALVE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICRAILVALVE.DESC"
msgid "A mechanical valve capable of reducing the flow of mass from a conveyor rail to to a logistic rail, to avoid dropping items."
msgstr ""
"Válvula mecânica capaz de reduzir o fluxo de massa de um trilho "
"transportador para um trilho logístico, evitando a queda de itens."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICRAILVALVE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICRAILVALVE.EFFECT"
msgid "Allows <link=\"ELEMENTSSOLID\">Solid Materials</link> to be transfered from normal <link=\"SOLIDCONDUIT\">Conveyor Rails</link> to <link=\"LOGISTICRAIL\">Logistic Rails</link>."
msgstr ""
"Permite transferir <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> do "
"<link=\"SOLIDCONDUIT\">rails de transport</link> normal para "
"<link=\"LOGISTICRAIL\">Trilhos Logísticos</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICRAILVALVE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICRAILVALVE.NAME"
msgid "<link=\"LOGISTICRAILVALVE\">Logistic Reduction Valve</link>"
msgstr "<link=\"LOGISTICRAILVALVE\">Válvula de Redução Logística</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICTRANSFERARM.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICTRANSFERARM.DESC"
msgid "An auto-sweeper's range can be viewed at any time by clicking on the building."
msgstr ""
"O alcance de uma varredora automática pode ser visualizado a qualquer "
"momento clicando no edifício."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICTRANSFERARM.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICTRANSFERARM.EFFECT"
msgid "Automates <link=\"CHORES\">Sweeping</link> and <link=\"CHORES\">Supplying</link> errands by sucking up all nearby <link=\"DECOR\">Debris</link>.\n\nMaterials are automatically delivered to any <link=\"LOGISTICLOADER\">Logistic Loader</link>, <link=\"LOGISTICOUTBOX\">Logistic Receptacle</link>, storage, or buildings within range."
msgstr "Automatiza as tarefas de <link=\"CHORES\">Varredura</link> e <link=\"CHORES\">Suprimento</link> sugando todos os <link=\"DECOR\">Detritos</link> próximos.\n\nOs materiais são entregues automaticamente a qualquer <link=\"LOGISTICLOADER\">Carregador Logístico</link>, <link=\"LOGISTICOUTBOX\">Receptáculo Logístico</link>, armazenamento ou construção dentro do alcance."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICTRANSFERARM.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICTRANSFERARM.NAME"
msgid "<link=\"LOGISTICTRANSFERARM\">Logistic Auto-Sweeper</link>"
msgstr "<link=\"LOGISTICTRANSFERARM\">Braço Logístico Automatizado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICVENT.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICVENT.DESC"
msgid "When materials reach the end of a rail, they are dropped back into the world."
msgstr ""
"Quando os materiais chegam ao fim de um trilho, eles são enviados de volta "
"para o mundo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICVENT.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICVENT.EFFECT"
msgid "Unloads <link=\"ELEMENTSSOLID\">Solid Materials</link> from a <link=\"LOGISTICRAIL\">Logistic Rail</link> onto the floor."
msgstr ""
"Descarrega o <link=\"ELEMENTSSOLID\">Materiais Sólidos</link> de um "
"<link=\"LOGISTICRAIL\">Trilho Logístico</link> no chão."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICVENT.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.LOGISTICVENT.NAME"
msgid "<link=\"LOGISTICVENT\">Logistic Chute</link>"
msgstr "<link=\"LOGISTICVENT\">Calha Logística</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MARBLETILESTRINGS.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MARBLETILESTRINGS.DESC"
msgid "A fine tile made from polished quality stones."
msgstr "Um lindo azulejo feito de pedra polida de qualidade."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MARBLETILESTRINGS.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MARBLETILESTRINGS.EFFECT"
msgid "Used as floor and wall tile to build rooms.\n\nSignificantly increases Duplicant runspeed."
msgstr ""
"Usado como piso e revestimento para construção de ambientes.\n"
"\n"
"Aumenta significativamente a velocidade de execução do Duplicante."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MARBLETILESTRINGS.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MARBLETILESTRINGS.NAME"
msgid "<link=\"MOULDINGTILE\">Marble Tile</link>"
msgstr "<link=\"MOULDINGTILE\">Ladrilho de Mármore</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MEDGASRESERVOIR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MEDGASRESERVOIR.DESC"
msgid "A medium sized reservoir with double amount of input and output ports."
msgstr ""
"Um tanque de tamanho médio com o dobro do número de portas de entrada e "
"saída."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MEDGASRESERVOIR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MEDGASRESERVOIR.EFFECT"
msgid "Stores any <link=\"ELEMENTSGAS\">Gas</link> resources piped into it."
msgstr ""
"Armazena todos os <link=\"ELEMENTSGAS\">Gás</link> recursos roteados para "
"lá."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MEDGASRESERVOIR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MEDGASRESERVOIR.NAME"
msgid "<link=\"MEDGASRESERVOIR\">Medium Gas Reservoir</link>"
msgstr "<link=\"MEDGASRESERVOIR\">Reservatório de Gás Médio</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MEDLIQUIDRESERVOIR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MEDLIQUIDRESERVOIR.DESC"
msgid "A medium sized reservoir with double amount of input and output ports."
msgstr ""
"Um tanque de tamanho médio com o dobro do número de portas de entrada e "
"saída."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MEDLIQUIDRESERVOIR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MEDLIQUIDRESERVOIR.EFFECT"
msgid "Stores any <link=\"ELEMENTSLIQUID\">Liquid</link> resources piped into it."
msgstr ""
"Armazena todos os <link=\"ELEMENTSLIQUID\">Líquido</link> recursos roteados "
"para lá."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MEDLIQUIDRESERVOIR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MEDLIQUIDRESERVOIR.NAME"
msgid "<link=\"MEDLIQUIDRESERVOIR\">Medium Liquid Reservoir</link>"
msgstr "<link=\"MEDLIQUIDRESERVOIR\">Reservatório de Líquido Médio</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_BALLCRUSHERMILL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_BALLCRUSHERMILL.DESC"
msgid "A large sized industrial mill that crushes raw ores using steel balls and special vibrating separation device to sort out possible useful resources."
msgstr ""
"Um grande moinho industrial que tritura minérios brutos usando esferas de "
"aço e um dispositivo especial de separação vibratória para classificar "
"recursos potencialmente úteis."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_BALLCRUSHERMILL.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_BALLCRUSHERMILL.EFFECT"
msgid "Crush down <link=\"BUILDABLERAW\">Raw Minerals</link> in to useful materials and industrial ingredients."
msgstr ""
"Esmague <link=\"BUILDABLERAW\">Minerais Brutos</link> em materiais úteis e "
"ingredientes industriais."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_BALLCRUSHERMILL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_BALLCRUSHERMILL.NAME"
msgid "<link=\"METALLURGYBALLCRUSHERMILL\">Ball Crusher Mill (Mechanical Separation)</link>"
msgstr ""
"<link=\"METALLURGYBALLCRUSHERMILL\">Moinho de Bolas (Separação "
"Mecânica)</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_BASICOILREFINERY.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_BASICOILREFINERY.DESC"
msgid "A basic oil refinery that uses burning solids as heat source."
msgstr ""
"Uma refinaria de petróleo básico que utiliza a queima de sólidos como fonte "
"de calor."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_BASICOILREFINERY.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_BASICOILREFINERY.EFFECT"
msgid "Refines <link=\"CRUDEOIL\">Crude Oil</link> to <link=\"PETROLEUM\">Petroleum</link> using <link=\"CARBON\">Coal</link> as heat source. \nThe refinement process produces <link=\"METHANE\">Natural Gas</link> and <link=\"CARBONDIOXIDE\">Carbon Dioxide</link>.\n\nIMPORTANT: The Gases output ports piping is optional. If no Gas Pipe is attached to them, the output gases will be released directly on the environment."
msgstr "Refina <link=\"CRUDEOIL\">Petróleo Bruto</link> em <link=\"PETROLEUM\">Petróleo</link> usando <link=\"CARBON\">Carvão</link> como fonte de calor. \nO processo de refino produz <link=\"METHANE\">Gás Natural</link> e <link=\"CARBONDIOXIDE\">Dióxido de Carbono</link>.\n\nIMPORTANTE: A tubulação das portas de saída de gases é opcional. Se nenhum Cano de Gás estiver conectado a elas, os gases de saída serão liberados diretamente no ambiente."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_BASICOILREFINERY.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_BASICOILREFINERY.NAME"
msgid "<link=\"METALLURGYBASICOILREFINERY\">Basic Oil Refinery</link>"
msgstr "<link=\"METALLURGYBASICOILREFINERY\">Refinaria de Petróleo Básica</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_PLASMAFURNACE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_PLASMAFURNACE.DESC"
msgid "An advanced pyrometallurgical furnace that uses an extremely hot thermal plasma generated by a carrier gas jet. The high energy consumption is compensated by the quality and the yield of the refining process."
msgstr ""
"Um forno pirometalúrgico avançado que utiliza plasma térmico extremamente "
"quente gerado por um jato de gás de arraste. O alto consumo de energia é "
"compensado pela qualidade e eficiência do processo de refino."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_PLASMAFURNACE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_PLASMAFURNACE.EFFECT"
msgid "An advanced method for the refinement of <link=\"RAWMETAL\">Metal Ores</link> and other <link=\"BUILDABLERAW\">Raw Minerals</link>.\n\nProduces significant amounts of <link=\"HEAT\">Heat</link> and consumes <link=\"AIOCARRIERGAS\">carrier gases</link> during manufacturing.\n\nMain products are dispensed in molten state directly in the floor below the building while the liquid waste is released in a separated port."
msgstr "Um método avançado para o refinamento de <link=\"RAWMETAL\">Minérios Metálicos</link> e outros <link=\"BUILDABLERAW\">Minerais Brutos</link>.\n\nProduz quantidades significativas de <link=\"HEAT\">Calor</link> e consome <link=\"AIOCARRIERGAS\">Gases de Arraste</link> durante a fabricação.\n\nOs principais produtos são dispensados em estado fundido diretamente no piso abaixo do edifício, enquanto os resíduos líquidos são liberados em uma porta separada."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_PLASMAFURNACE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_PLASMAFURNACE.NAME"
msgid "<link=\"METALLURGYPLASMAFURNACE\">Plasma Furnace</link>"
msgstr "<link=\"METALLURGYPLASMAFURNACE\">Forno de Plasma</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_PYROLYSISKILN.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_PYROLYSISKILN.DESC"
msgid "A basic kiln that uses pyrolysis process to convert woodlogs to usable coal."
msgstr ""
"Um forno básico que utiliza um processo de pirólise para converter toras de "
"madeira em carvão utilizável."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_PYROLYSISKILN.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_PYROLYSISKILN.EFFECT"
msgid "Cook <link=\"WOOD\">Madeira</link> to <link=\"CARBON\">Coal</link>."
msgstr "Cozinhe de <link=\"WOOD\">Madeira</link> a <link=\"CARBON\">Carvão</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_PYROLYSISKILN.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.METALLURGY_PYROLYSISKILN.NAME"
msgid "<link=\"METALLURGYPYROLYSISKILN\">Pyrolysis Kiln</link>"
msgstr "<link=\"METALLURGYPYROLYSISKILN\">Forno de Pirólise</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_AUGERDRILL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_AUGERDRILL.DESC"
msgid "A giant machinery engineered in the old world for asteroid mining. Has a self propelled drilling head fitted with a sensorial system and actuators that helps it to travel through the asteroid crust in search for resources of interest."
msgstr ""
"Uma máquina gigante, projetada na Antiguidade para a mineração de "
"asteroides. Está equipado com uma cabeça de perfuração autopropulsada dotada"
" de sistema sensorial e atuadores que lhe permitem atravessar a crosta do "
"asteróide em busca de recursos interessantes."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_AUGERDRILL.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_AUGERDRILL.EFFECT"
msgid "This rig uses specialized Drillbits to mine useful resources from the asteroid crust.\nRetrived resources are released upon the Drill Head return.\n\nRequire a constant supply of <link=\"COMBUSTIBLELIQUID\">Combustable Fuel</link> to function.\n\nResults: resources that are delivered upon Drillhead return.\nOccurrence: resources that are generated during Drillhead operation."
msgstr ""
"Esta plataforma utiliza brocas especializadas para extrair recursos úteis da crosta do asteroide.\n"
"Os recursos recuperados são liberados quando o cabeçote de perfuração retorna.\n"
"\n"
"Requer um fornecimento constante de <link=\"COMBUSTIBLELIQUID\">combustible</link> para funcionar.\n"
"\n"
"Resultados: recursos entregues para retorno do cabeçote de perfuração.\n"
"Ocorrência: recursos gerados durante a operação da cabeça de perfuração."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_AUGERDRILL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_AUGERDRILL.NAME"
msgid "<link=\"MININGAUGERDRILL\">Asteroid Drill Rig Mk-II</link>"
msgstr ""
"<link=\"MININGAUGERDRILL\">Plataforma de Perfuração de Asteroide Mk-"
"II</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_CNCMACHINE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_CNCMACHINE.DESC"
msgid "An advanced CNC (Computer Numerical Control) Machining production station. Capable of managing different tools using specific directives by graphical computer-aided design software."
msgstr "Uma estação avançada de produção por usinagem CNC (Controle Numérico Computadorizado). Capaz de gerenciar diferentes ferramentas usando diretrizes específicas por meio de software de desenho assistido por computador."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_CNCMACHINE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_CNCMACHINE.EFFECT"
msgid "Capable of producing specialty gadgets and other advanced tools. Requires the Mechatronics Engineering knowledge skill to be built."
msgstr "Capaz de produzir engenhocas especiais e outras ferramentas avançadas. Requer a habilidade de conhecimento em Engenharia Mecatrônica para ser construída."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_CNCMACHINE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_CNCMACHINE.NAME"
msgid "<link=\"MININGCNCMACHINE\">CNC Machining Station</link>"
msgstr "<link=\"MININGCNCMACHINE\">Station d'usinage CNC</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_MINERALDRILL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_MINERALDRILL.DESC"
msgid "Drills into Deep Mineral Deposits to extract solid resources."
msgstr "Perfura Depósitos Minerais Profundos para extrair recursos sólidos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_MINERALDRILL.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_MINERALDRILL.EFFECT"
msgid "A strong drilling apparatus engineered with self guidance sensors for mineral ores, and retrieval of resources while operational.\nThe type of the drill head determines the dept of the drilling, retriving resources from other parts of the Asteroid that are inaccessible by normal means.\nThe drill sensors have a limited range, and retrieval of useful ores are not guaranteed."
msgstr "Um forte aparelho de perfuração projetado com sensores de autoguiamento para minérios minerais e recuperação de recursos durante a operação.\nO tipo da broca determina a profundidade da perfuração, recuperando recursos de outras partes do Asteroide que são inacessíveis por meios normais.\nOs sensores da broca têm alcance limitado, e a recuperação de minérios úteis não é garantida."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_MINERALDRILL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MINING_MINERALDRILL.NAME"
msgid "<link=\"MININGMINERALDRILL\">Asteroid Auger Drill</link>"
msgstr "<link=\"MININGMINERALDRILL\">Broca Helicoidal de Asteroide</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MONOELEMENTTILE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MONOELEMENTTILE.DESC"
msgid "A fine tile made from compacted stones."
msgstr "Azulejo fino feito de pedras compactadas."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MONOELEMENTTILE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MONOELEMENTTILE.EFFECT"
msgid "A tile composed out of compacted minerals\n\nIncreases Duplicant runspeed."
msgstr "Um ladrilho composto de minerais compactados\n\nAumenta a velocidade de corrida dos Duplicantes."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MONOELEMENTTILE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.MONOELEMENTTILE.NAME"
msgid "<link=\"MONOELEMENTTILE\">Compacted Tile</link>"
msgstr "<link=\"MONOELEMENTTILE\">Ladrilho Compactado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.PRESSUREGASPUMP.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.PRESSUREGASPUMP.DESC"
msgid "An advanced pump that performs mechanical work to compress and move gases. More powerful than the standard pump, this one is capable of moving large amounts of gases, although this is only archived through the <link=\"HIGHPRESSUREGASCONDUIT\">High Pressure Gas Pipe</link>."
msgstr ""
"Uma bomba avançada que realiza trabalho mecânico para comprimir e mover "
"gases. Mais potente que a bomba padrão, esta é capaz de movimentar grandes "
"quantidades de gases, embora isso só seja arquivado através do "
"<link=\"HIGHPRESSUREGASCONDUIT\">Cano de Gás de Alta Pressão</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.PRESSUREGASPUMP.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.PRESSUREGASPUMP.EFFECT"
msgid "Draws in <link=\"ELEMENTSGAS\">Gas</link> and runs it through <link=\"HIGHPRESSUREGASCONDUIT\">High Pressure Gas Pipe</link>.\n\nMust be submerged in <link=\"ELEMENTSGAS\">Gas</link>."
msgstr ""
"Aspire o <link=\"ELEMENTSGAS\">Gás</link> e passe pelo <link=\"HIGHPRESSUREGASCONDUIT\">Conduto de Gás de Alta Pressão</link>.\n"
"\n"
"Deve ser imerso em <link=\"ELEMENTSGAS\">Gás</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.PRESSUREGASPUMP.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.PRESSUREGASPUMP.NAME"
msgid "<link=\"PRESSUREGASPUMP\">High Pressure Gas Pump</link>"
msgstr "<link=\"PRESSUREGASPUMP\">Bomba de Gás de Alta Pressão</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.PRESSURELIQUIDPUMP.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.PRESSURELIQUIDPUMP.DESC"
msgid "An advanced pump that performs mechanical work to compress and move fluids. More powerful than the standard pump, this one is capable of moving large amounts of liquids, although this is only archived through the <link=\"HIGHPRESSURELIQUIDCONDUIT\">High Pressure Liquid Pipe</link>."
msgstr ""
"Uma bomba avançada que realiza trabalho mecânico para comprimir e mover "
"fluidos. Mais potente que a bomba standard, esta é capaz de movimentar "
"grandes quantidades de líquidos, embora este só seja arquivado através do "
"botão <link=\"HIGHPRESSURELIQUIDCONDUIT\">Cano de Líquido de Alta Pressão</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.PRESSURELIQUIDPUMP.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.PRESSURELIQUIDPUMP.EFFECT"
msgid "Draws in <link=\"ELEMENTSLIQUID\">Liquid</link> and runs it through <link=\"HIGHPRESSURELIQUIDCONDUIT\">High Pressure Liquid Pipe</link>.\n\nMust be submerged in <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr ""
"Aspirar de <link=\"ELEMENTSLIQUID\">líquido</link> e passar para um <link=\"HIGHPRESSURELIQUIDCONDUIT\">Conduto de Líquido de Alta Pressão</link>.\n"
"\n"
"Deve ser imerso em <link=\"ELEMENTSLIQUID\">líquido</link>."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.PRESSURELIQUIDPUMP.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.PRESSURELIQUIDPUMP.NAME"
msgid "<link=\"PRESSURELIQUIDPUMP\">High Pressure Liquid Pump</link>"
msgstr "<link=\"PRESSURELIQUIDPUMP\">Bomba de Líquido de Alta Pressão</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.REINFORCEDCONCRETETILE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.REINFORCEDCONCRETETILE.DESC"
msgid "Concrete tiles are not aesthetically pleasing, but they make up for strength and thermal resistance."
msgstr ""
"As telhas de concreto não são esteticamente agradáveis, mas compensam com "
"sua resistência e resistência térmica."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.REINFORCEDCONCRETETILE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.REINFORCEDCONCRETETILE.EFFECT"
msgid "A rock hard composite tile made with coarse aggregate bonded together with a fluid cement.\nThe concrete's relatively low tensile strength and ductility are compensated for by the inclusion of a internal rebar reinforcement having higher tensile strength or ductility.\n\nImmune against meteor impact damage."
msgstr ""
"Uma telha composta dura como rocha feita com agregado graúdo unido com um cimento fluido.\n"
"A resistência à tração e ductilidade relativamente baixas do concreto são compensadas pela inclusão de um reforço interno de vergalhão com maior resistência à tração ou ductilidade.\n"
"\n"
"Imune contra danos de impacto de meteoros."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.REINFORCEDCONCRETETILE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.REINFORCEDCONCRETETILE.NAME"
msgid "<link=\"REINFORCEDCONCRETETILE\">Reinforced Concrete Tile</link>"
msgstr "<link=\"REINFORCEDCONCRETETILE\">Ladrilho de Concreto Armado</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SIMPLEFRIDGE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SIMPLEFRIDGE.DESC"
msgid "A plain old-style home fridge. Still, this vintage building does the same job as a modern variant, which is preservation the of food."
msgstr ""
"Uma geladeira doméstica clássica. No entanto, este edifício vintage tem a "
"mesma função que uma versão moderna: preservação de alimentos."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SIMPLEFRIDGE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SIMPLEFRIDGE.EFFECT"
msgid "The sealed storage of this fridge keeps food very cold, but not in sterile atmospheric conditions."
msgstr ""
"O armazenamento hermético deste refrigerador mantém os alimentos muito "
"frios, mas não em condições atmosféricas estéreis."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SIMPLEFRIDGE.FACADES.SIMPLEFRIDGE_STICKERS.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SIMPLEFRIDGE.FACADES.SIMPLEFRIDGE_STICKERS.DESC"
msgid "A variant of the Home Fridge that has been plastered with a large variety of stickers"
msgstr "Uma variante da Geladeira Doméstica coberta com uma grande variedade de adesivos"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SIMPLEFRIDGE.FACADES.SIMPLEFRIDGE_STICKERS.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SIMPLEFRIDGE.FACADES.SIMPLEFRIDGE_STICKERS.NAME"
msgid "<link=\"SIMPLEFRIDGESTICKERS\">Stickered Home Fridge</link>"
msgstr "<link=\"SIMPLEFRIDGESTICKERS\">Geladeira Doméstica Adesivada</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SIMPLEFRIDGE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SIMPLEFRIDGE.NAME"
msgid "<link=\"SIMPLEFRIDGE\">Home Fridge</link>"
msgstr "<link=\"SIMPLEFRIDGE\">Geladeira Doméstica</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SLIMEVAT.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SLIMEVAT.DESC"
msgid "An advanced biological vat that grows a culture of mucopolysaccharides and multicelular fungi mould. This unit also uses advanced filter to extract Polluted Oxygen from its surroundings, albeit its not necessary for it to function."
msgstr ""
"Uma cuba biológica avançada que cultiva mucopolissacarídeos e fungos "
"fúngicos multicelulares. Esta unidade também utiliza um filtro avançado para"
" extrair oxigênio poluído do ambiente, embora isso não seja essencial para o"
" seu funcionamento."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SLIMEVAT.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SLIMEVAT.EFFECT"
msgid "Slime Vat needs <link=\"WATER\">Water</link> and <link=\"MUSHBAR\">Mush Bar</link> to grow, producing <link=\"SLIMEMOLD\">Slime</link> outgrowth that is collected from the botton. Due to its nature, the slime its produce will be contaminated with Slimelung."
msgstr "A Cuba de Limo precisa de <link=\"WATER\">Água</link> e <link=\"MUSHBAR\">Barra de Papa</link> para crescer, produzindo um excesso de <link=\"SLIMEMOLD\">Limo</link> que é coletado pela parte de baixo. Devido à sua natureza, o limo produzido estará contaminado com Pulmolodo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SLIMEVAT.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SLIMEVAT.NAME"
msgid "<link=\"SLIMEVAT\">Slime Vat</link>"
msgstr "<link=\"SLIMEVAT\">Tanque de Slime</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLGASRESERVOIR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLGASRESERVOIR.DESC"
msgid "A small sized reservoir. This variant has top to bottom flow."
msgstr "Tanque pequeno. Essa variação flui de cima para baixo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLGASRESERVOIR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLGASRESERVOIR.EFFECT"
msgid "Stores any <link=\"ELEMENTSGAS\">Gas</link> resources piped into it."
msgstr ""
"Armazena todos os <link=\"ELEMENTSGAS\">Gás</link> recursos roteados para "
"lá."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLGASRESERVOIR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLGASRESERVOIR.NAME"
msgid "<link=\"SMALLGASRESERVOIR\">Small Gas Reservoir B</link>"
msgstr "<link=\"SMALLGASRESERVOIR\">Reservatório de Gás Pequeno B</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLGASRESERVOIRDEFAULT.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLGASRESERVOIRDEFAULT.DESC"
msgid "A small sized reservoir. Reservoirs cannot receive manually delivered resources."
msgstr ""
"Um pequeno tanque. Os tanques não podem receber recursos entregues "
"manualmente."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLGASRESERVOIRDEFAULT.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLGASRESERVOIRDEFAULT.EFFECT"
msgid "Stores any <link=\"ELEMENTSGAS\">Gas</link> resources piped into it."
msgstr ""
"Armazena todos os <link=\"ELEMENTSGAS\">Gás</link> recursos roteados para "
"lá."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLGASRESERVOIRDEFAULT.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLGASRESERVOIRDEFAULT.NAME"
msgid "<link=\"SMALLGASRESERVOIRDEFAULT\">Small Gas Reservoir</link>"
msgstr "<link=\"SMALLGASRESERVOIRDEFAULT\">Reservatório de Gás Pequeno</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLLIQUIDRESERVOIR.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLLIQUIDRESERVOIR.DESC"
msgid "A small sized reservoir. This variant has top to bottom flow"
msgstr "Um pequeno tanque. Essa variação flui de cima para baixo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLLIQUIDRESERVOIR.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLLIQUIDRESERVOIR.EFFECT"
msgid "Stores any <link=\"ELEMENTSLIQUID\">Liquid</link> resources piped into it."
msgstr ""
"Armazena todos os <link=\"ELEMENTSLIQUID\">Líquido</link> recursos roteados "
"para lá."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLLIQUIDRESERVOIR.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLLIQUIDRESERVOIR.NAME"
msgid "<link=\"SMALLLIQUIDRESERVOIR\">Small Liquid Reservoir B</link>"
msgstr "<link=\"SMALLLIQUIDRESERVOIR\">Reservatório de Líquido Pequeno B</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLLIQUIDRESERVOIRDEFAULT.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLLIQUIDRESERVOIRDEFAULT.DESC"
msgid "A small sized reservoir. Reservoirs cannot receive manually delivered resources."
msgstr ""
"Um pequeno tanque. Os tanques não podem receber recursos entregues "
"manualmente."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLLIQUIDRESERVOIRDEFAULT.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLLIQUIDRESERVOIRDEFAULT.EFFECT"
msgid "Stores any <link=\"ELEMENTSLIQUID\">Liquid</link> resources piped into it."
msgstr ""
"Armazena todos os <link=\"ELEMENTSLIQUID\">Líquido</link> recursos roteados "
"para lá."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLLIQUIDRESERVOIRDEFAULT.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SMALLLIQUIDRESERVOIRDEFAULT.NAME"
msgid "<link=\"SMALLLIQUIDRESERVOIRDEFAULT\">Small Liquid Reservoir</link>"
msgstr "<link=\"SMALLLIQUIDRESERVOIRDEFAULT\">Reservatório de Líquido Pequeno</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACEBOX.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACEBOX.DESC"
msgid "A high-grade polymer box used for storing food inside spacecraft. Requires placement inside Space Module."
msgstr ""
"Uma caixa de polímero de alta qualidade usada para armazenar alimentos a "
"bordo de naves espaciais. para ser colocado dentro do módulo espacial."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACEBOX.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACEBOX.EFFECT"
msgid "The sealed storage compartment of this box allows complete vacuum through connection with the spacecraft hulk, thus completely preserving the food within."
msgstr "O compartimento de armazenamento vedado desta caixa permite vácuo completo por meio da conexão com o casco da nave, preservando completamente a comida em seu interior."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACEBOX.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACEBOX.NAME"
msgid "<link=\"SPACEBOX\">Spacefaring Food Box</link>"
msgstr "<link=\"SPACEBOX\">Caixa de Comida Espacial</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERTILESOLID.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERTILESOLID.DESC"
msgid "A durable tile made for vacuum-exposed environments."
msgstr "Um ladrilho durável projetado para ambientes expostos ao vácuo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERTILESOLID.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERTILESOLID.EFFECT"
msgid "This solid tile is specially engineered to withstand the harsh conditions of space.\n\nBlocks Gas and Liquid while offering minimal thermal insulation."
msgstr ""
"Este ladrilho forte foi especialmente projetado para suportar as duras condições do espaço.\n"
"\n"
"Bloqueia gases e líquidos, proporcionando isolamento térmico mínimo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERTILESOLID.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERTILESOLID.NAME"
msgid "<link=\"SPACERTILESOLID\">Solid Spacer Tile</link>"
msgstr "<link=\"SPACERTILESOLID\">Ladrilho Espaçador Sólido</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERTILEWINDOW.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERTILEWINDOW.DESC"
msgid "A transparent tile designed for external observation in vacuum-exposed environments."
msgstr ""
"Placa transparente projetada para observação externa em ambientes expostos "
"ao vácuo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERTILEWINDOW.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERTILEWINDOW.EFFECT"
msgid "This windowed tile allows light and visibility through while maintaining a strong barrier against the vacuum of space.\n\nBlocks Gas and Liquid while offering minimal thermal insulation."
msgstr ""
"Este azulejo permite a passagem de luz e visibilidade, mantendo uma barreira sólida contra o vazio do espaço.\n"
"\n"
"Bloqueia gases e líquidos, proporcionando isolamento térmico mínimo."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERTILEWINDOW.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERTILEWINDOW.NAME"
msgid "<link=\"SPACERTILEWINDOW\">Transparent Spacer Tile</link>"
msgstr "<link=\"SPACERTILEWINDOW\">Ladrilho Espaçador Transparente</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.DESC"
msgid "A small sized spacer wall."
msgstr "Uma pequena parede espaçadora."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.EFFECT"
msgid "A solid wall panel wrought from steel. Hermetically sealed joints prevent gas leakage into space."
msgstr ""
"Um painel de parede de aço sólido. Vedações herméticas evitam vazamentos de "
"gás no espaço."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.FACADES.SPACERDANGER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.FACADES.SPACERDANGER.DESC"
msgid "This spacer wall is fitted with a perimeter stripped demarcation. Can be flipped around."
msgstr ""
"Esta parede espaçadora está equipada com um limite periférico despojado. É "
"reversível."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.FACADES.SPACERDANGER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.FACADES.SPACERDANGER.NAME"
msgid "<link=\"SPACERDANGER\">Spacer Perimeter Wall</link>"
msgstr "<link=\"SPACERDANGER\">Parede de Perímetro Espaçadora</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.FACADES.SPACERDANGERCORNER.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.FACADES.SPACERDANGERCORNER.DESC"
msgid "This spacer wall is fitted with a corner perimeter stripped demarcation destined to corners. Can be flipped around."
msgstr ""
"Esta parede espaçadora está equipada com uma demarcação periférica simples "
"destinada aos cantos. É reversível."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.FACADES.SPACERDANGERCORNER.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.FACADES.SPACERDANGERCORNER.NAME"
msgid "<link=\"SPACERDANGERCORNER\">Spacer Perimeter Wall Corner</link>"
msgstr "<link=\"SPACERDANGERCORNER\">Canto de Parede Perimetral Espaçador</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.FACADES.SPACERPANEL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.FACADES.SPACERPANEL.DESC"
msgid "A small sized spacer panel."
msgstr "Um pequeno painel espaçador."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.FACADES.SPACERPANEL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.FACADES.SPACERPANEL.NAME"
msgid "<link=\"SPACERPANEL\">Spacer Panel</link>"
msgstr "<link=\"SPACERPANEL\">Painel Espaçador</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALL.NAME"
msgid "<link=\"SPACERWALL\">Spacer Wall</link>"
msgstr "<link=\"SPACERWALL\">Parede Espaçadora</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALLLARGE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALLLARGE.DESC"
msgid "A large sized spacer panel."
msgstr "Um grande painel espaçador."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALLLARGE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALLLARGE.EFFECT"
msgid "A large solid wall wrought from steel. Hermetically sealed joints prevent gas leakage into space."
msgstr ""
"Uma grande e sólida parede de aço. Vedações herméticas evitam vazamentos de "
"gás no espaço."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALLLARGE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWALLLARGE.NAME"
msgid "<link=\"SPACERWALLLARGE\">Large Spacer Panel</link>"
msgstr "<link=\"SPACERWALLLARGE\">Painel de Espaçamento Grande</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWINDOWLARGE.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWINDOWLARGE.DESC"
msgid "A large sized spacer window."
msgstr "Uma grande janela de espaçamento."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWINDOWLARGE.EFFECT
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWINDOWLARGE.EFFECT"
msgid "A solid window wrought from steel and fitted with thick layers of glass. Hermetically sealed joints prevent gas leakage into space."
msgstr ""
"Uma janela sólida feita de aço e com espessas camadas de vidro. Vedações "
"herméticas evitam vazamentos de gás."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWINDOWLARGE.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWINDOWLARGE.NAME"
msgid "<link=\"SPACERWINDOWLARGE\">Large Spacer Window</link>"
msgstr "<link=\"SPACERWINDOWLARGE\">Janela Espaçadora Grande</link>"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWINDOWWALL.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWINDOWWALL.DESC"
msgid "A small sized spacer window.."
msgstr "Uma pequena janela de espaçamento."

