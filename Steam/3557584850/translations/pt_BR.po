msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWINDOWWALL.EFFECT"
msgid "A solid wall wrought from steel and fitted with thick layers of glass. Hermetically sealed joints prevent gas leakage into space."
msgstr ""
"Uma sólida parede de aço coberta por espessas camadas de vidro. Vedações "
"herméticas evitam vazamentos de gás no espaço."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWINDOWWALL.FACADES.SPACERWINDOW_B.DESC
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDINGS.PREFABS.SPACERWINDOWWALL.FACADES.SPACERWINDOW_B.DESC"
msgid "A small sized spacer window. This is the B model."
msgstr "Uma pequena janela de espaçamento. Este é o modelo B."

