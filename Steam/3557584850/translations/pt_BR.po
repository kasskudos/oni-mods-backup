msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDING.STATUSITEMS.THERMALBATTERY_STORAGEFULL.NAME"
msgid "Thermal capacitor overloaded!"
msgstr "Capacitor térmico sobrecarregado!"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDING.STATUSITEMS.THERMALBATTERY_STORAGEFULL.TOOLTIP
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDING.STATUSITEMS.THERMALBATTERY_STORAGEFULL.TOOLTIP"
msgid "Insufficient cooling has overloaded the buildings internal heat capacitor.\nIt needs to be fully cooled down before the building can be operational again."
msgstr ""
"O resfriamento insuficiente sobrecarregou o capacitor de calor interno do edifício.\n"
"Ele precisa ser totalmente resfriado antes que o edifício possa voltar a funcionar."

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDING.STATUSITEMS.THERMALBATTERY_STORAGELEVEL.NAME
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDING.STATUSITEMS.THERMALBATTERY_STORAGELEVEL.NAME"
msgid "Thermal capacitor level: {0}"
msgstr "Nível do capacitor térmico: {0}"

#. RonivansLegacy_ChemicalProcessing.STRINGS.BUILDING.STATUSITEMS.THERMALBATTERY_STORAGELEVEL.TOOLTIP
msgctxt "RonivansLegacy_ChemicalProcessing.STRINGS.BUILDING.STATUSITEMS.THERMALBATTERY_STORAGELEVEL.TOOLTIP"
msgid "This buildings internal heat capacitor stores heat energy to transfer it to the piped in coolant.\nCapillary structures will prevent coolant from boiling at the cost of reduced heat transfer.\nIf the capacitor fills up completely, the building will be rendered inoperational until its fully cooled down again."
msgstr "O capacitor de calor interno desta construção armazena energia térmica para transferi-la ao refrigerante canalizado.\nEstruturas capilares evitam que o refrigerante ferva, ao custo de uma transferência de calor reduzida.\nSe o capacitor encher completamente, a construção ficará inoperante até esfriar totalmente de novo."

