msgid "Toggle on Printer"
msgstr "Alternar para a impressora"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.CAREPACKAGESONLY.PRINTERCHECKBOX.TOOLTIP
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.CAREPACKAGESONLY.PRINTERCHECKBOX.TOOLTIP"
msgid ""
"When the (new) checkbox in the sidescreen of the printing pod is checked, it"
" will only print care packages."
msgstr ""
"Quando a caixa de seleção (nova) na tela lateral da Cápsula de Impressão for"
" verificada, ela só irá imprimir pacotes de cuidados."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.CAREPACKAGESONLY.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.CAREPACKAGESONLY.TOOLTIP"
msgid ""
"When enabled, the printing pod will only give care packages when the configured condition has been satisfied\n"
"Overrides the care package configuration of a save game (no care package difficulty setting is ignored)."
msgstr ""
"Quando habilitado, o Cápsula de Impressão só dará pacotes de cuidados quando a condição configurada estiver satisfeita\n"
"Sobrepõe a configuração do pacote de cuidados de um jogo de salvamento (nenhuma configuração de dificuldade do pacote de cuidados é ignorada)."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.CAREPACKAGESONLYDUPECAP.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.CAREPACKAGESONLYDUPECAP.NAME"
msgid "Duplicant Threshold for care packages only"
msgstr "Limiar Duplicante apenas para pacotes de cuidados"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.CAREPACKAGESONLYDUPECAP.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.CAREPACKAGESONLYDUPECAP.TOOLTIP"
msgid ""
"Only has an effect if \"Print Care Packages only\" is enabled and configured to use the option \"Duplicant Count\".\n"
"While above or at this number of duplicants, the printer will only give care packages."
msgstr ""
"Só tem efeito se \"Print Care Packages only\" estiver habilitado e configurado para usar a opção \"Duplicant Count\".\n"
"Enquanto estiver acima ou com este número de duplicantes, a impressora só dará pacotes de cuidados."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.CAREPACKAGESONLYPACKAGECAP.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.CAREPACKAGESONLYPACKAGECAP.NAME"
msgid "Number of care packages for care packages only"
msgstr "Número de pacotes de cuidados apenas para pacotes de cuidados"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.CAREPACKAGESONLYPACKAGECAP.TOOLTIP
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.CAREPACKAGESONLYPACKAGECAP.TOOLTIP"
msgid ""
"Only has an effect if \"Print Care Packages only\" is enabled.\n"
"Set the number of care packages that generate when the cap is in effect."
msgstr ""
"Só tem um efeito se \"Print Care Packages only\" estiver habilitado.\n"
"Defina o número de pacotes de cuidados que geram quando a tampa está em vigor."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.CATEGORIES.A_GAMESTART
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.CATEGORIES.A_GAMESTART"
msgid "Options for Game Start"
msgstr "Opções para o início do jogo"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.CATEGORIES.B_PRINTINGPOD
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.CATEGORIES.B_PRINTINGPOD"
msgid "Options for Printing Pod"
msgstr "Opções da Cápsula de Impressão"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.CATEGORIES.C_EXTRAS
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.CATEGORIES.C_EXTRAS"
msgid "Options for Traits and Interests Selection"
msgstr "Opções de características e interesses"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.CATEGORIES.D_SKINSETTINGS
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.CATEGORIES.D_SKINSETTINGS"
msgid "Skin Options"
msgstr "Opções de aparência"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.CATEGORIES.E_UTIL
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.CATEGORIES.E_UTIL"
msgid "Extra Settings"
msgstr "Configurações adicionais"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.DIRECTATTRIBUTEEDITING.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.DIRECTATTRIBUTEEDITING.NAME"
msgid "Direct Attribute Editing"
msgstr "Edição direta de atributos"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.DIRECTATTRIBUTEEDITING.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.DIRECTATTRIBUTEEDITING.TOOLTIP"
msgid ""
"Allows to directly edit the starting attributes of duplicants.\n"
"Can be overpowered."
msgstr ""
"Permite editar diretamente os atributos iniciais dos duplicantes.\n"
"Pode ser dominado."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.DUPLICANTSTARTAMOUNT.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.DUPLICANTSTARTAMOUNT.NAME"
msgid "Number of Starting Duplicants"
msgstr "Número de Duplicantes de Início"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.DUPLICANTSTARTAMOUNT.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.DUPLICANTSTARTAMOUNT.TOOLTIP"
msgid "Choose the amount of duplicants you want to start with."
msgstr "Escolha a quantidade de duplicantes que você deseja começar."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.EXTRA_SKILL_POINTS.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.EXTRA_SKILL_POINTS.NAME"
msgid "Extra starting skill points"
msgstr "Pontos de habilidade adicionais"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.EXTRA_SKILL_POINTS.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.EXTRA_SKILL_POINTS.TOOLTIP"
msgid ""
"Add extra skill points to new duplicant via a selection in the modification window.\n"
"Requires printing pod duplicant modification to be active to add extra skillpoints to printing pod duplicants."
msgstr ""
"Adicione pontos de habilidade extras para novo duplicante através de uma seleção na janela de modificação.\n"
"Requer modificação duplicante do Cápsula de Impressão para ser ativo para adicionar pontos de habilidade extras para imprimir duplicantes do pod."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.FORCEPRINTINGMODEL.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.FORCEPRINTINGMODEL.NAME"
msgid "Print only specific duplicant models"
msgstr "Imprimir apenas modelos duplicantes específicos"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.FORCEPRINTINGMODEL.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.FORCEPRINTINGMODEL.TOOLTIP"
msgid ""
"Force the printing pod to only produce duplicants of the selected model"
msgstr ""
"Forçar a Cápsula de Impressão a produzir apenas duplicantes do modelo "
"selecionado"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.HERMITSKIN.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.HERMITSKIN.NAME"
msgid "Hermit Skin"
msgstr "Aparência de Eremita"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.HERMITSKIN.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.HERMITSKIN.TOOLTIP"
msgid ""
"Adds the Hermit to the pool of selectable skins\n"
"once the story trait has been completed atleast once on any savegame."
msgstr ""
"Adiciona o Eremita ao conjunto de aparências selecionáveis\n"
"uma vez que o traço da história tenha sido concluído pelo menos uma vez em qualquer jogo salvo."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.INTERESTPOINTSBALANCING.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.INTERESTPOINTSBALANCING.NAME"
msgid "Interest Point Balancing"
msgstr "Balanceamento dos pontos de interesse"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.INTERESTPOINTSBALANCING.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.INTERESTPOINTSBALANCING.TOOLTIP"
msgid ""
"Use the vanilla interest point bonus for active interests determined by active traits.\n"
"Deactivate to override this point limit."
msgstr ""
"Use o bônus de ponto de interesses de jogo base para interesses ativos determinados por características ativos.\n"
"Desativar para anular este limite de ponto."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.LIVEDUPESKINCHANGE.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.LIVEDUPESKINCHANGE.NAME"
msgid "Skins for active Duplicants"
msgstr "Aparências para duplicantes ativos"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.LIVEDUPESKINCHANGE.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.LIVEDUPESKINCHANGE.TOOLTIP"
msgid "Change the Skin of already existing duplicants"
msgstr "Mudar a Aparência dos duplicantes já existentes"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.LIVEDUPESTATCHANGE.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.LIVEDUPESTATCHANGE.NAME"
msgid "Enable Duplicity-style Duplicant Editor"
msgstr "Ativar editor de Duplicantes no estilo Duplicity"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.LIVEDUPESTATCHANGE.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.LIVEDUPESTATCHANGE.TOOLTIP"
msgid ""
"Edit your active duplicants in a new editor similar to the Duplicity-"
"savegame editor"
msgstr ""
"Edite seus duplicantes ativos em um novo editor semelhante ao editor "
"Duplicity-jogo salvo"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.MINNOWSKIN.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.MINNOWSKIN.NAME"
msgid "Minnow Skin"
msgstr "Aparência de Minnow"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.MINNOWSKIN.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.MINNOWSKIN.TOOLTIP"
msgid ""
"Adds Minnow to the pool of selectable skins\n"
"once the aquatic initiative has been completed atleast once on any savegame.\n"
"Requires Aquatic Planet Pack DLC."
msgstr ""
"Adiciona Minnow ao conjunto de aparências selecionáveis\n"
"uma vez concluída a iniciativa aquática pelo menos uma vez em qualquer jogo de salvamento.\n"
"Requer DLC Aquatic Planet Pack."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.MODIFYDURINGGAME_CAREPACKAGES.NAME
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.MODIFYDURINGGAME_CAREPACKAGES.NAME"
msgid "Care Package selection menu"
msgstr "Menu de seleção de pacotes de cuidados"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.MODIFYDURINGGAME_CAREPACKAGES.TOOLTIP
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.MODIFYDURINGGAME_CAREPACKAGES.TOOLTIP"
msgid ""
"Enable this option allows replacing printing pod care packages from a list of all at that time unlocked care packages.\n"
"Enable Sandbox or Debug to ignore the unlock condition and make ALL packages available to select, regardless of unlock status."
msgstr ""
"Ativar esta opção permite substituir os pacotes de cuidados de Cápsula de Impressão a partir de uma lista de todos os pacotes de cuidados desbloqueados nessa altura.\n"
"Habilite Sandbox ou Debug para ignorar a condição de desbloqueio e disponibilizar TODOS os pacotes para selecionar, independentemente do status de desbloqueio."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.MODIFYDURINGGAME_MINIONS.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.MODIFYDURINGGAME_MINIONS.NAME"
msgid "Modification of printing pod Duplicants"
msgstr "Modificação da Cápsula de Impressão Duplicantes"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.MODIFYDURINGGAME_MINIONS.TOOLTIP
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.MODIFYDURINGGAME_MINIONS.TOOLTIP"
msgid ""
"Enable this option to add the modify button to printing pod dupes\n"
"When disabled, the feature only appears on the starter dupe selection.\n"
"This also enables the use of presets."
msgstr ""
"Ative esta opção para adicionar o botão modificar aos duplicantes de impressão do pod\n"
"Quando desabilitado, o recurso só aparece na seleção de duplicante inicial.\n"
"Isso também permite o uso de predefinições."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.MORECAREPACKAGES.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.MORECAREPACKAGES.NAME"
msgid "Enable Care Package Editor"
msgstr "Habilitar editor de pacotes de cuidados"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.MORECAREPACKAGES.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.MORECAREPACKAGES.TOOLTIP"
msgid ""
"Additional types of care packages become available to print.\n"
"These can be viewed and modified in the care package editor.\n"
"By default it contains a small selection of items that can potentially become unavailable.\n"
"Also allows disabling of vanilla care packages."
msgstr ""
"Outros tipos de pacotes de cuidados ficam disponíveis para impressão.\n"
"Estes podem ser visualizados e modificados no editor de pacotes de cuidados.\n"
"Por padrão, contém uma pequena seleção de itens que podem potencialmente ficar indisponível.\n"
"Também permite desativar os pacotes de cuidados de jogo base."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.MYSTERIOUSMINIONMODE.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.MYSTERIOUSMINIONMODE.NAME"
msgid "Mysterious Minion Mode"
msgstr "Modo Duplicante Misterioso"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.MYSTERIOUSMINIONMODE.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.MYSTERIOUSMINIONMODE.TOOLTIP"
msgid "All Interests and Traits are hidden until printed"
msgstr "Todos os Interesses e Características estão escondidos até impresso"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.NEWGAMEPLUS.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.NEWGAMEPLUS.NAME"
msgid "NewGame+"
msgstr "Novo Jogo+"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.NEWGAMEPLUS.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.NEWGAMEPLUS.TOOLTIP"
msgid ""
"Start your game with dupes you sent through the tear in previous "
"playthroughs."
msgstr ""
"Comece seu jogo com duplicantes que você enviou através do rasgo em partidas"
" anteriores."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.NOJOYREACTION.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.NOJOYREACTION.NAME"
msgid "Disable Overjoyed Responses"
msgstr "Desativar reações de euforia"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.NOJOYREACTION.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.NOJOYREACTION.TOOLTIP"
msgid "Deactivates Overjoyed Responses on newly generated duplicants"
msgstr "Desativa as reações de euforia dos novos Duplicantes."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.NORMALTRAITSONBIONICS.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.NORMALTRAITSONBIONICS.NAME"
msgid "Allow normal traits on Bionic Duplicants"
msgstr "Permitir características normais em Duplicantes Biônicos"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.NORMALTRAITSONBIONICS.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.NORMALTRAITSONBIONICS.TOOLTIP"
msgid ""
"When active, allows adding regular traits to bionic duplicants.\n"
"Warning: adding certain traits to bionics can cause crashes (e.g. small bladder due to the pee-amount missing for bionics)."
msgstr ""
"Quando ativo, permite adicionar características regulares aos duplicantes biônicos.\n"
"Aviso: adicionar certas características à biônica pode causar quebras (por exemplo, bexiga pequena devido à quantidade de urina faltando para biônica)."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.NOSTRESSREACTION.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.NOSTRESSREACTION.NAME"
msgid "Disable Stress Reactions"
msgstr "Desativar reações de estresse"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.NOSTRESSREACTION.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.NOSTRESSREACTION.TOOLTIP"
msgid "Deactivates Stress Reactions on newly generated duplicants"
msgstr "Desativa as reações de estresse dos novos Duplicantes."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.OVERRIDEPRINTERCAREPACKAGECOUNT.NAME
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.OVERRIDEPRINTERCAREPACKAGECOUNT.NAME"
msgid "Override printing pod care package count"
msgstr ""
"Sobrescrever a quantidade de pacotes de cuidados de Cápsula de Impressão"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.OVERRIDEPRINTERCAREPACKAGECOUNT.TOOLTIP
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.OVERRIDEPRINTERCAREPACKAGECOUNT.TOOLTIP"
msgid ""
"Override the number of care packages offered in the printing pod.\n"
"A value of 0 or lower disables this feature.\n"
"Disabling care packages in the difficulty settings disables this feature.\n"
"No effect if care packages only mode is active."
msgstr ""
"Sobrescrever o número de pacotes de cuidados oferecidos na Cápsula de Impressão.\n"
"Um valor igual ou inferior a 0 desativa esta funcionalidade.\n"
"Desativar pacotes de cuidados nas configurações de dificuldade desabilita esse recurso.\n"
"Sem efeito se o modo apenas de pacotes de cuidados estiver ativo."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.OVERRIDEPRINTERDUPECOUNT.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.OVERRIDEPRINTERDUPECOUNT.NAME"
msgid "Override printing pod dupe count"
msgstr "Substituir a contagem do duplicante da Cápsula de Impressão"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.OVERRIDEPRINTERDUPECOUNT.TOOLTIP
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.OVERRIDEPRINTERDUPECOUNT.TOOLTIP"
msgid ""
"Override the number of duplicants offered in the printing pod.\n"
"A value of 0 or lower disables this feature."
msgstr ""
"Sobreponha o número de duplicantes oferecidos na Cápsula de Impressão.\n"
"Um valor igual ou inferior a 0 desativa esta funcionalidade."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.PAUSEONREADYTOPRING.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.PAUSEONREADYTOPRING.NAME"
msgid "Pause on \"ready to print\""
msgstr "Pausar quando estiver pronta para imprimir"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.PAUSEONREADYTOPRING.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.PAUSEONREADYTOPRING.TOOLTIP"
msgid "Pause the game when the printing pod has recharged for a new print"
msgstr ""
"Pausa o jogo quando a Cápsula de Impressão estiver carregada e pronta para "
"uma nova impressão."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.PODDUPESKINCHANGE.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.PODDUPESKINCHANGE.NAME"
msgid "Skin selection for Printing Pod Duplicants"
msgstr "Seleção de aparência para impressão de Duplicantes Pod"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.PODDUPESKINCHANGE.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.PODDUPESKINCHANGE.TOOLTIP"
msgid "Change the Skin of printing pod duplicants"
msgstr "Mudar a Aparência dos duplicantes de Cápsulas de Impressão"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.PRINTINGPODRECHARGETIME.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.PRINTINGPODRECHARGETIME.NAME"
msgid "Printing pod cooldown time"
msgstr "Tempo de recarga da Cápsula de Impressão"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.PRINTINGPODRECHARGETIME.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.PRINTINGPODRECHARGETIME.TOOLTIP"
msgid ""
"Time it takes for the printing pod to recharge for the next print in cycles.\n"
"Default is 3 cycles."
msgstr ""
"O tempo que leva para a Cápsula de Impressão recarregar para a próxima impressão em ciclos.\n"
"O padrão é de 3 ciclos."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.PRINTINGPODRECHARGETIMEFIRST.NAME
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.PRINTINGPODRECHARGETIMEFIRST.NAME"
msgid "First print time"
msgstr "Tempo até a primeira impressão"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.PRINTINGPODRECHARGETIMEFIRST.TOOLTIP
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.PRINTINGPODRECHARGETIMEFIRST.TOOLTIP"
msgid ""
"Time after the printing pod offers its first print, in cycles.\n"
"Default is 2.5 cycles."
msgstr ""
"Tempo após a Cápsula de Impressão oferece sua primeira impressão, em ciclos.\n"
"O padrão é 2,5 ciclos."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLCRYOPODANDJORGE.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLCRYOPODANDJORGE.NAME"
msgid "Hermit/Minnow/Cryopod Modification"
msgstr "Modificar Eremita, Minnow e Duplicante da Criocápsula"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLCRYOPODANDJORGE.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLCRYOPODANDJORGE.TOOLTIP"
msgid ""
"Allows modifying of the Hermit, Minnow and Cryopod Duplicants.\n"
"\"Ancient Knowledge\"-Trait takes the slot of a positive trait during generation of these duplicants."
msgstr ""
"Permite modificar os Duplicantes de Eremita, Minnow e Criópode.\n"
"\"Conhecimento antigo\"-Traço toma o espaço de um traço positivo durante a geração destes duplicantes."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLDURINGGAME_CAREPACKAGES.NAME
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLDURINGGAME_CAREPACKAGES.NAME"
msgid "Reroll Care Packages"
msgstr "Sortear novamente os Pacotes de Cuidados"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLDURINGGAME_CAREPACKAGES.TOOLTIP
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLDURINGGAME_CAREPACKAGES.TOOLTIP"
msgid ""
"Enable this option to add the reroll button to printing pod care packages."
msgstr ""
"Ative esta opção para adicionar o botão de sortear novamente aos pacotes de "
"cuidados do Cápsula de Impressão."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLDURINGGAME_LIMITCOUNTER.NAME
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLDURINGGAME_LIMITCOUNTER.NAME"
msgid "Limit Reroll Count"
msgstr "Limite de Contagem de Rerolos"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLDURINGGAME_LIMITCOUNTER.TOOLTIP
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLDURINGGAME_LIMITCOUNTER.TOOLTIP"
msgid ""
"Limit how many times you can reroll in tge printing pod each time the it becomes ready.\n"
"\n"
"Only has an effect if any of the printing pod reroll options are enabled\n"
"\n"
"A value of 0 disables any limiting.\n"
"\n"
"Does not affect direct editing options, play with those disabled if you want to avoid temptation."
msgstr ""
"Limitar quantas vezes você pode sortear novamente na Cápsula de Impressão tge cada vez que o fica pronto.\n"
"\n"
"Só tem um efeito se alguma das opções do sortear novamente da Cápsula de Impressão estiver habilitada\n"
"\n"
"Um valor de 0 desativa qualquer limitação.\n"
"\n"
"Não afeta as opções de edição direta, jogue com aqueles desativados se você quiser evitar a tentação."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLDURINGGAME_MINIONS.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLDURINGGAME_MINIONS.NAME"
msgid "Reroll printing pod duplicants"
msgstr "Sortear novamente os Duplicantes da Cápsula"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLDURINGGAME_MINIONS.TOOLTIP
msgctxt ""
"SetStartDupes.STRINGS.UI.DSS_OPTIONS.REROLLDURINGGAME_MINIONS.TOOLTIP"
msgid ""
"Enable this option to add the reroll button to printing pod Duplicants."
msgstr ""
"Ative esta opção para adicionar o botão de sortear novamente ao Cápsula de "
"Impressão Duplicantes."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.SKINSDOREACTS.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.SKINSDOREACTS.NAME"
msgid "Skins include reactions"
msgstr "Aparências incluem reações"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.SKINSDOREACTS.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.SKINSDOREACTS.TOOLTIP"
msgid ""
"When applying a skin, the inherited overjoyed response and stress reaction "
"get applied in addition to the skin."
msgstr ""
"Ao aplicar uma aparência, a resposta herdada e a reação de estresse são "
"aplicadas além da aparência."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.SORTEDCAREPACKAGES.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.SORTEDCAREPACKAGES.NAME"
msgid "Sorted Care Package Lists"
msgstr "Listas de Pacotes de Cuidados Ordenados"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.SORTEDCAREPACKAGES.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.SORTEDCAREPACKAGES.TOOLTIP"
msgid ""
"Care packages listings are sorted alphabetically.\n"
"Affects care package editor and printing pod selection\n"
"Care packages in the editor can be sorted manually when this option is turned off."
msgstr ""
"As listas de pacotes de cuidados são ordenadas alfabeticamente.\n"
"Afeta o editor de pacotes de cuidados e a seleção de pods de impressão\n"
"Os pacotes de cuidados no editor podem ser ordenados manualmente quando esta opção estiver desligada."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.SORTEDPRINTINGPOD.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.SORTEDPRINTINGPOD.NAME"
msgid "Sorted Printing Pod"
msgstr "Cápsula de Impressão Ordenado"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.SORTEDPRINTINGPOD.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.SORTEDPRINTINGPOD.TOOLTIP"
msgid ""
"Printing pod entries are sorted by their type, dupes come first, then care "
"packages."
msgstr ""
"Impressão entradas pod são ordenadas por seu tipo, duplicantes vêm primeiro,"
" em seguida, pacotes de cuidados."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.STARTUPRESOURCES.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.STARTUPRESOURCES.NAME"
msgid "Extra Starting Resources"
msgstr "Recursos de Início Extra"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.STARTUPRESOURCES.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.STARTUPRESOURCES.TOOLTIP"
msgid ""
"Add some extra startup resources for your additional duplicants.\n"
"Only goes in effect with more than 3 dupes.\n"
"Only accounts for extra dupes above 3."
msgstr ""
"Adicione alguns recursos extras de inicialização para seus duplicantes adicionais.\n"
"Só vai em vigor com mais de 3 duplicantes.\n"
"Só é responsável por duplicantes extras acima de 3."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.SUPPORTEDDAYS.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.SUPPORTEDDAYS.NAME"
msgid "Supported Days"
msgstr "Dias Suportados"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.SUPPORTEDDAYS.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.SUPPORTEDDAYS.TOOLTIP"
msgid ""
"Amount of days the extra starting resources should last.\n"
"No effect if \"Extra Starting Resources\" is disabled."
msgstr ""
"Quantidade de dias que os recursos adicionais devem durar.\n"
"Sem efeito se \"Recursos de Início Extra\" estiver desativado."

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.XP_LEVEL_CAP_MOD.NAME
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.XP_LEVEL_CAP_MOD.NAME"
msgid "Attribute Leveling Cap"
msgstr "Tampa de Nivelamento de Atributos"

#. SetStartDupes.STRINGS.UI.DSS_OPTIONS.XP_LEVEL_CAP_MOD.TOOLTIP
msgctxt "SetStartDupes.STRINGS.UI.DSS_OPTIONS.XP_LEVEL_CAP_MOD.TOOLTIP"
msgid ""
"Changes the maximum level up to which duplicants can gain levels in attributes.\n"
"If other mods add a higher target, it will be used instead of the configured value.\n"
"Default Vanilla Cap: 20"
msgstr ""
"Muda o nível máximo até o qual duplicantes podem ganhar níveis em atributos.\n"
"Se outros mods adicionarem um alvo maior, ele será usado em vez do valor configurado.\n"
"Tampa padrão de jogo base: 20"

