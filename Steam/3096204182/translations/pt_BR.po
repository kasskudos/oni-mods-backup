#. GigaWattWire.WIRE_STRINGS.GIGAWATTWIRE.DESC
msgctxt "GigaWattWire.WIRE_STRINGS.GIGAWATTWIRE.DESC"
msgid ""
"By using special superconductive materials and low temperatures this wire "
"can carry up to 1000 MW."
msgstr ""
"Ao usar materiais supercondutores especiais e baixas temperaturas, este fio "
"pode transportar até 1000 MW."

#. GigaWattWire.WIRE_STRINGS.GIGAWATTWIRE.EFFECT
msgctxt "GigaWattWire.WIRE_STRINGS.GIGAWATTWIRE.EFFECT"
msgid ""
"Carries even more <link=\"POWER\">Wattage</link> than a "
"<link=\"MEGAWATTWIRE\">Mega - Watt Wire</link>.\n"
"\n"
"Cannot be run through wall and floor tile."
msgstr ""
"Transporta ainda mais <link=\"POWER\">Potência</link> do que um "
"<link=\"MEGAWATTWIRE\">Fio Mega-Watt</link>.\n"
"\n"
"Não pode passar por ladrilhos de parede e piso."

#. GigaWattWire.WIRE_STRINGS.GIGAWATTWIRE.NAME
msgctxt "GigaWattWire.WIRE_STRINGS.GIGAWATTWIRE.NAME"
msgid "<link=\"GIGAWATTWIRE\">Giga-Watt Wire</link>"
msgstr "<link=\"GIGAWATTWIRE\">Fio Giga-Watt</link>"

#. GigaWattWire.WIRE_STRINGS.GIGAWATTWIREBRIDGE.DESC
msgctxt "GigaWattWire.WIRE_STRINGS.GIGAWATTWIREBRIDGE.DESC"
msgid ""
"Joint plates can run Giga-Watt wires through walls without leaking gas or "
"liquid."
msgstr ""
"Placas de junção permitem passar fios Giga-Watt pelas paredes sem vazar gás "
"ou líquido."

#. GigaWattWire.WIRE_STRINGS.GIGAWATTWIREBRIDGE.EFFECT
msgctxt "GigaWattWire.WIRE_STRINGS.GIGAWATTWIREBRIDGE.EFFECT"
msgid ""
"Carries even more <link=\"POWER\">Wattage</link> than a "
"<link=\"MEGAWATTWIREBRIDGE\">Mega - Watt Conductive Joint Plate</link>.\n"
"\n"
"Allows <link=\"MEGAWATTWIRE\"> Mega-Watt Wire</link> to be run through wall "
"and floor tile."
msgstr ""
"Transporta ainda mais <link=\"POWER\">Potência</link> do que uma "
"<link=\"MEGAWATTWIREBRIDGE\">Placa de Junção Condutiva Mega-Watt</link>.\n"
"\n"
"Permite passar <link=\"MEGAWATTWIRE\">Fio Mega-Watt</link> por ladrilhos de "
"parede e piso."

#. GigaWattWire.WIRE_STRINGS.GIGAWATTWIREBRIDGE.NAME
msgctxt "GigaWattWire.WIRE_STRINGS.GIGAWATTWIREBRIDGE.NAME"
msgid "<link=\"GIGAWATTWIREBRIDGE\">Giga-Watt Joint Plate</link>"
msgstr "<link=\"GIGAWATTWIREBRIDGE\">Placa de Junção Giga-Watt</link>"

#. GigaWattWire.WIRE_STRINGS.JACKETED_WIRE.DESC
msgctxt "GigaWattWire.WIRE_STRINGS.JACKETED_WIRE.DESC"
msgid "By coating the wires in plastic they suddenly became much safer."
msgstr "Ao revestir os fios com plástico, eles de repente ficaram muito mais seguros."

#. GigaWattWire.WIRE_STRINGS.JACKETED_WIRE.EFFECT
msgctxt "GigaWattWire.WIRE_STRINGS.JACKETED_WIRE.EFFECT"
msgid ""
"Connects buildings to <link=\"POWER\">Power</link> sources. \n"
"\n"
"Can be run through wall and floor tile."
msgstr ""
"Conecta construções a fontes de <link=\"POWER\">Energia</link>.\n"
"\n"
"Pode passar por ladrilhos de parede e piso."

#. GigaWattWire.WIRE_STRINGS.JACKETED_WIRE.NAME
msgctxt "GigaWattWire.WIRE_STRINGS.JACKETED_WIRE.NAME"
msgid "<link=\"JACKETEDWIRE\">Insulated Wire</link>"
msgstr "<link=\"JACKETEDWIRE\">Fio Isolado</link>"

#. GigaWattWire.WIRE_STRINGS.JACKETEDWIREBRIDGE.DESC
msgctxt "GigaWattWire.WIRE_STRINGS.JACKETEDWIREBRIDGE.DESC"
msgid "By coating the wires in plastic they suddenly became much safer."
msgstr "Ao revestir os fios com plástico, eles de repente ficaram muito mais seguros."

#. GigaWattWire.WIRE_STRINGS.JACKETEDWIREBRIDGE.EFFECT
msgctxt "GigaWattWire.WIRE_STRINGS.JACKETEDWIREBRIDGE.EFFECT"
msgid ""
"Carries even more <link=\"POWER\">Wattage</link> than a "
"<link=\"WIREREFINEDBRIDGE\">Conductive Wire Bridge</link> without "
"overloading."
msgstr ""
"Transporta ainda mais <link=\"POWER\">Potência</link> do que uma "
"<link=\"WIREREFINEDBRIDGE\">Ponte de Fio Condutor</link> sem sobrecarga."

#. GigaWattWire.WIRE_STRINGS.JACKETEDWIREBRIDGE.NAME
msgctxt "GigaWattWire.WIRE_STRINGS.JACKETEDWIREBRIDGE.NAME"
msgid "<link=\"JACKETEDWIREBRIDGE\">Insulated Wire Bridge</link>"
msgstr "<link=\"JACKETEDWIREBRIDGE\">Ponte de Fio Isolado</link>"

#. GigaWattWire.WIRE_STRINGS.MEGAWATTWIRE.DESC
msgctxt "GigaWattWire.WIRE_STRINGS.MEGAWATTWIRE.DESC"
msgid "This one goes up to 1000 kW."
msgstr "Este aqui vai até 1000 kW."

#. GigaWattWire.WIRE_STRINGS.MEGAWATTWIRE.EFFECT
msgctxt "GigaWattWire.WIRE_STRINGS.MEGAWATTWIRE.EFFECT"
msgid ""
"Carries even more <link=\"POWER\">Wattage</link> than a "
"<link=\"WIREREFINEDHIGHWATTAGE\">Jacked Wire</link> without overloading.\n"
"\n"
"Cannot be run through wall and floor tile."
msgstr ""
"Transporta ainda mais <link=\"POWER\">Potência</link> do que um "
"<link=\"WIREREFINEDHIGHWATTAGE\">Fio Reforçado</link> sem sobrecarga.\n"
"\n"
"Não pode passar por ladrilhos de parede e piso."

#. GigaWattWire.WIRE_STRINGS.MEGAWATTWIRE.NAME
msgctxt "GigaWattWire.WIRE_STRINGS.MEGAWATTWIRE.NAME"
msgid "<link=\"MEGAWATTWIRE\">Mega-Watt Wire</link>"
msgstr "<link=\"MEGAWATTWIRE\">Fio Mega-Watt</link>"

