msgstr "Galhos de Bonbon: Colher Madeira"

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEBONBONBRANCHES.OFF"
msgid "Bonbon Branches: Keep for Nectar"
msgstr "Galhos de Bonbon: Manter para Néctar"

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEBONBONBRANCHES.TOOLTIP"
msgid "Keep: Bonbon Tree branches stay on the tree and make Nectar. Harvest: Duplicants cut grown branches for 75 kg of Lumber each, like a vanilla branch harvest; a cut branch makes no Nectar until it has grown back."
msgstr "Manter: os galhos da Árvore Bonbon permanecem na árvore e produzem Néctar. Colher: Duplicantes cortam galhos crescidos para obter 75 kg de Madeira por galho, como na colheita original; um galho cortado não produz Néctar até crescer novamente."

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEINSULATE.ON"
msgid "Insulation: On"
msgstr "Isolamento: Ligado"

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEINSULATE.OFF"
msgid "Insulation: Off"
msgstr "Isolamento: Desligado"

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEINSULATE.TOOLTIP"
msgid "Insulated: the inside takes the temperature of the gas piped in instead of the room's, and what the crops breathe out stays inside."
msgstr "Isolado: o interior assume a temperatura do gás fornecido por tubulação em vez da temperatura da sala, e os gases liberados pelas plantas ficam dentro da estufa."

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEREGULATE.ON"
msgid "Thermal Regulation: On"
msgstr "Regulação Térmica: Ligada"

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEREGULATE.OFF"
msgid "Thermal Regulation: Off"
msgstr "Regulação Térmica: Desligada"

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEREGULATE.TOOLTIP"
msgid "A built-in Space Heater and Thermo Regulator keep the insulated inside at the target temperature (set on the slider). Heating takes 120 W, cooling 240 W and pushes the heat into the room."
msgstr "Um Aquecedor de Ambiente e um Termorregulador integrados mantêm o interior isolado na temperatura desejada (definida no controle deslizante). O aquecimento consome 120 W; o resfriamento consome 240 W e libera calor na sala."

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEEMPTYGAS.NAME"
msgid "Empty Gases"
msgstr "Esvaziar Gases"

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEEMPTYGAS.TOOLTIP"
msgid "Let every stored gas out into the room. The crops then grow in the room's atmosphere."
msgstr "Libera na sala todos os gases armazenados. As plantas passam a utilizar a atmosfera da sala."

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEREGULATETANK.ON"
msgid "Thermal Regulation: On"
msgstr "Regulação Térmica: Ligada"

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEREGULATETANK.OFF"
msgid "Thermal Regulation: Off"
msgstr "Regulação Térmica: Desligada"

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEREGULATETANK.TOOLTIP"
msgid "A built-in Liquid Tepidizer and Thermo Aquatuner keep the tank's liquid at the target temperature (set on the slider). Heating takes 960 W, cooling 1,200 W and pushes the heat into the room."
msgstr "Um Aquecedor de Líquidos e um Aquarregulador integrados mantêm o líquido do tanque na temperatura desejada (definida no controle deslizante). O aquecimento consome 960 W; o resfriamento consome 1.200 W e libera calor na sala."

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEEMPTYTANK.NAME"
msgid "Empty Tank"
msgstr "Esvaziar Tanque"

msgctxt "STRINGS.UI.USERMENUACTIONS.GREENHOUSEEMPTYTANK.TOOLTIP"
msgid "Bottle every liquid in the tank beside the building for Duplicants to carry away. Without liquid the crops dry out."
msgstr "Engarrafa todo o líquido do tanque ao lado da construção para os Duplicantes transportarem. Sem líquido, as plantas ressecam."

msgctxt "STRINGS.UI.GREENHOUSE.FILL_TITLE"
msgid "Fill Level"
msgstr "Nível de Enchimento"

msgctxt "STRINGS.UI.GREENHOUSE.CELLS"
msgid "cells"
msgstr "células"

msgctxt "STRINGS.UI.GREENHOUSE.FILL_TOOLTIP"
msgid "The tank takes liquid up to {0} cells (1000 kg of water is one cell). Crops on a shelf above the waterline don't grow."
msgstr "O tanque recebe líquido até atingir {0} células (1.000 kg de água equivalem a uma célula). Plantas em prateleiras acima da superfície da água não crescem."

msgctxt "STRINGS.UI.GREENHOUSE.HEATER_SLIDER_TITLE"
msgid "Target Temperature"
msgstr "Temperatura Desejada"

msgctxt "STRINGS.UI.GREENHOUSE.HEATER_SLIDER_TOOLTIP"
msgid "Thermal regulation keeps the inside at {0}."
msgstr "A regulação térmica mantém o interior a {0}."

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.TITLE"
msgid "Crops"
msgstr "Plantas"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.CROP"
msgid "Crop"
msgstr "Planta"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.SLOT_TOOLTIP"
msgid "What grows in all 18 slots, like a farm tile. Duplicants deliver the seeds; changing it uproots what grows and drops the seeds at the building. A wide plant takes several slots."
msgstr "A planta cultivada nos 18 espaços, como em um ladrilho de cultivo. Duplicantes entregam as sementes; mudar a seleção arranca as plantas atuais e deixa suas sementes junto à construção. Plantas largas ocupam vários espaços."

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.VARIANT"
msgid "Variant"
msgstr "Variante"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.VARIANTS_TOOLTIP"
msgid "Which mutation to grow: the Original, any identified variant, or one in particular. A chosen variant fills up as its seeds arrive; Originals grow in the empty slots until then."
msgstr "A mutação que será cultivada: a Original, qualquer variante identificada ou uma variante específica. A variante escolhida ocupa os espaços conforme suas sementes chegam; plantas Originais crescem nos espaços restantes até lá."

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.EMPTY"
msgid "None"
msgstr "Nenhuma"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.MIXED"
msgid "Mixed"
msgstr "Mistas"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.WIDE"
msgid "{0} ({1} slots)"
msgstr "{0} ({1} espaços)"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.ORIGINAL"
msgid "Original"
msgstr "Original"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.ANY"
msgid "Any variant"
msgstr "Qualquer variante"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.NONE"
msgid "Nothing planted"
msgstr "Nada plantado"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.STATUS"
msgid "{0} planted, {1} growing"
msgstr "{0} plantadas, {1} crescendo"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.FILLING"
msgid "{0} mutated, {1} Original\nfor now (replaced as seeds arrive)"
msgstr "{0} mutantes, {1} Originais\npor enquanto (substituídas conforme as sementes chegam)"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.WAITING"
msgid "Waiting for seeds"
msgstr "Aguardando sementes"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.RADIATION"
msgid "Radiation inside: {0} rads"
msgstr "Radiação interna: {0} rads"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.LAMP"
msgid "Radiation lamp adds {0} rads\n({1} Phosphorite)"
msgstr "A lâmpada de radiação acrescenta {0} rads\n({1} de Fosforita)"

msgctxt "STRINGS.UI.GREENHOUSE.CROPS.MUTATION_CHANCE"
msgid "Mutated seed per harvest: {0}\n(seed drop {1}, mutates {2};\nbest at {3} rads)"
msgstr "Semente mutante por colheita: {0}\n(chance de semente: {1}, mutação: {2};\nmelhor em {3} rads)"
