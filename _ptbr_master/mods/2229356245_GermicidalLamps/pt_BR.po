#. STRINGS.BUILDINGS.PREFABS.SMALLGERMICIDELAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SMALLGERMICIDELAMP.NAME"
msgid "<link=\"SMALLGERMICIDELAMP\">Germicidal Ceiling Light</link>"
msgstr "<link=\"SMALLGERMICIDELAMP\">Luminária Germicida de Teto</link>"

#. STRINGS.BUILDINGS.PREFABS.SMALLGERMICIDELAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SMALLGERMICIDELAMP.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.SMALLGERMICIDELAMP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SMALLGERMICIDELAMP.EFFECT"
msgid "Provides a small amount of light while killing germs beneath them with UVC radiation."
msgstr "Fornece uma pequena quantidade de luz enquanto elimina germes abaixo dela com radiação UVC."

#. STRINGS.BUILDINGS.PREFABS.GERMICIDELAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GERMICIDELAMP.NAME"
msgid "<link=\"GERMICIDELAMP\">Germicidal UV Lamp</link>"
msgstr "<link=\"GERMICIDELAMP\">Lâmpada UV Germicida</link>"

#. STRINGS.BUILDINGS.PREFABS.GERMICIDELAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GERMICIDELAMP.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.GERMICIDELAMP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GERMICIDELAMP.EFFECT"
msgid "Germicidal UV Lamps give off UVC radiation that quickly kills germs in a large area."
msgstr "Lâmpadas UV Germicidas emitem radiação UVC que elimina rapidamente germes em uma grande área."

