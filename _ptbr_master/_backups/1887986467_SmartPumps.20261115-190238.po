msgid "Filtered Gas Pump"
msgstr "Bomba de Gás Filtrante"

msgctxt "PeterHan.SmartPumps.SmartPumpsStrings.UI.FRONTEND.SMARTPUMPS.CATEGORY_LARGELIQUIDPUMP"
msgid "Filtered Liquid Pump"
msgstr "Bomba de Líquido Filtrante"

msgctxt "PeterHan.SmartPumps.SmartPumpsStrings.UI.FRONTEND.SMARTPUMPS.CATEGORY_SMALLGASPUMP"
msgid "Vacuum Pump"
msgstr "Bomba de Vácuo"

msgctxt "PeterHan.SmartPumps.SmartPumpsStrings.UI.FRONTEND.SMARTPUMPS.POWER"
msgid "Power Consumption"
msgstr "Consumo de Energia"

msgctxt "PeterHan.SmartPumps.SmartPumpsStrings.UI.FRONTEND.SMARTPUMPS.RATE"
msgid "Pump Rate (kg/s)"
msgstr "Vazão da Bomba (kg/s)"
