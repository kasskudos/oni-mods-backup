#. STRINGS.BUILDINGS.PREFABS.AUTOCONDESNER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.AUTOCONDESNER.NAME"
msgid "<link=\"AUTOCONDESNER\">Auto Condenser</link>"
msgstr "<link=\"AUTOCONDESNER\">Condensador Automático</link>"

#. STRINGS.BUILDINGS.PREFABS.AUTOCONDESNER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.AUTOCONDESNER.DESC"
msgid "Cools and condenses gases."
msgstr "Resfria e condensa gases."

#. STRINGS.BUILDINGS.PREFABS.AUTOCONDESNER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.AUTOCONDESNER.EFFECT"
msgid "Cools piped Gases and condenses them into their Liquid form.\n\nGases with transition byproducts damage the machine. Gases that are too hot will be dumped."
msgstr "Resfria os Gases canalizados e os condensa em sua forma Líquida.\n\nGases que geram subprodutos durante a transição danificam a máquina. Gases quentes demais serão despejados."

#. STRINGS.BUILDINGS.PREFABS.AUTOEVAPORTATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.AUTOEVAPORTATOR.NAME"
msgid "<link=\"AUTOEVAPORTATOR\">Auto Evaporator</link>"
msgstr "<link=\"AUTOEVAPORTATOR\">Evaporador Automático</link>"

#. STRINGS.BUILDINGS.PREFABS.AUTOEVAPORTATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.AUTOEVAPORTATOR.DESC"
msgid "Heats and evaporates liquids."
msgstr "Aquece e evapora líquidos."

#. STRINGS.BUILDINGS.PREFABS.AUTOEVAPORTATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.AUTOEVAPORTATOR.EFFECT"
msgid "Heats piped Liquids and evaporates them into their Gaseous form.\n\nLiquids with transition byproducts damage the machine. Liquids that are too cold will be dumped."
msgstr "Aquece os Líquidos canalizados e os evapora em sua forma Gasosa.\n\nLíquidos que geram subprodutos durante a transição danificam a máquina. Líquidos frios demais serão despejados."

#. STRINGS.BUILDINGS.PREFABS.GASREFRIGERATIONUNIT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASREFRIGERATIONUNIT.NAME"
msgid "<link=\"GASREFRIGERATIONUNIT\">Thermo Conditioner</link>"
msgstr "<link=\"GASREFRIGERATIONUNIT\">Termo-Aquecedor de Gás</link>"

#. STRINGS.BUILDINGS.PREFABS.GASREFRIGERATIONUNIT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GASREFRIGERATIONUNIT.DESC"
msgid "A thermo conditioner doesn't remove chill, but relocates it to a new area."
msgstr "Um termo-aquecedor não elimina o frio, apenas o transfere para outra área."

#. STRINGS.BUILDINGS.PREFABS.GASREFRIGERATIONUNIT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GASREFRIGERATIONUNIT.EFFECT"
msgid "Heats the Gas piped through it, cooling its immediate vicinity."
msgstr "Aquece o Gás canalizado através dele, resfriando a área ao seu redor."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDREFRIGERATIONUNIT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDREFRIGERATIONUNIT.NAME"
msgid "<link=\"LIQUIDREFRIGERATIONUNIT\">Thermo Aquacooler</link>"
msgstr "<link=\"LIQUIDREFRIGERATIONUNIT\">Termo-Aquecedor de Líquido</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDREFRIGERATIONUNIT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDREFRIGERATIONUNIT.DESC"
msgid "A thermo aquacooler heats liquids and outputs the chill elsewhere."
msgstr "Um termo-aquecedor aquece líquidos e libera o frio em outro lugar."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDREFRIGERATIONUNIT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDREFRIGERATIONUNIT.EFFECT"
msgid "Heats the Liquid piped through it, cooling its immediate vicinity."
msgstr "Aquece o Líquido canalizado através dele, resfriando a área ao seu redor."

#. STRINGS.MISC.TAGS.FULLYCONDENSABLE
msgctxt "STRINGS.MISC.TAGS.FULLYCONDENSABLE"
msgid "Fully Condensable"
msgstr "Totalmente Condensável"

#. STRINGS.MISC.TAGS.FULLYEVAPORATABLE
